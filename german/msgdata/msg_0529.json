{
  "key": 17195,
  "messages": [
    {
      "id": "msg_0529_00000",
      "de_DE": [
        "Über unsere Stadt wurde mal\n",
        "im Radio berichtet!\r",
        "Ich freue mich zwar über das Lob\n",
        "für meine Heimatstadt, aber es\f",
        "ist mir auch ein klein wenig peinlich."
      ]
    },
    {
      "id": "msg_0529_00001",
      "de_DE": [
        "Als ich die Pokémon-Arena betreten\n",
        "habe, war ich wild entschlossen, mir ein\f",
        "paar fremde Trainer vorzuknöpfen...\r",
        "Aber ich musste mir ausgerechnet diese\n",
        "verlassene Arena dafür aussuchen...\f",
        "Mann, ist mir das peinlich..."
      ]
    },
    {
      "id": "msg_0529_00002",
      "de_DE": [
        "Hier wohnt die junge Nachahmerin.\n",
        "Wenn du mit ihr sprichst, ahmt sie\r",
        "immer andere Leute nach. Das kann\n",
        "ziemlich verwirrend sein!"
      ]
    },
    {
      "id": "msg_0529_00003",
      "de_DE": [
        "Die junge Nachahmerin hat ihre\n",
        "geliebte Poképuppe verloren, eine\f",
        "Nachbildung eines PIEPI. Das scheint\f",
        "sie sehr mitzunehmen..."
      ]
    },
    {
      "id": "msg_0529_00004",
      "de_DE": [
        "Ich bin immer aufgeregt, wenn ich das\n",
        "erste Mal einen neuen Gang betrete!"
      ]
    },
    {
      "id": "msg_0529_00005",
      "de_DE": [
        "Mampf... mampf...\r",
        "Der Direktor des Kraftwerks soll\n",
        "früher mal in einer kleinen Fabrik\f",
        "Maschinen repariert haben.\r",
        "Mampf... mampf...\r",
        "Es von so einem Job bis zum Direktor\n",
        "dieses großen Kraftwerks zu schaffen,\f",
        "ist eine unglaubliche Erfolgsgeschichte!\r",
        "Mampf... mampf...\r",
        "Ein Mordskerl, dieser Typ!\n",
        "Ah, jetzt bin ich satt!"
      ]
    },
    {
      "id": "msg_0529_00006",
      "de_DE": [
        "Das ist die Silph Co., berühmt für\n",
        "ihre Pokémon-Artikel!\r",
        "Deshalb hatte es vor einiger Zeit\n",
        "auch Team Rocket auf sie abgesehen."
      ]
    },
    {
      "id": "msg_0529_00007",
      "de_DE": [
        "In Vertania City gibt es ein Trainer-\n",
        "Haus, wo sich Pokémon-Trainer\f",
        "aus der ganzen Welt treffen."
      ]
    },
    {
      "id": "msg_0529_00008",
      "de_DE": [
        "Du kommst aus Johto?\r",
        "Mit dem Magnetzug gelangst du\n",
        "schneller zurück nach Johto als du\f",
        "“Schwupps!” sagen kannst!"
      ]
    },
    {
      "id": "msg_0529_00009",
      "de_DE": [
        "Saffronia City, Bahnhof für die Magnet-\n",
        "zugstrecke zwischen Kanto und Johto"
      ]
    },
    {
      "id": "msg_0529_00010",
      "de_DE": [
        "Saffronia City\n",
        "Die strahlende Stadt im Licht"
      ]
    },
    {
      "id": "msg_0529_00011",
      "de_DE": "Willkommen im Karate Dojo!"
    },
    {
      "id": "msg_0529_00012",
      "de_DE": [
        "Pokémon-Arena von Saffronia City\n",
        "Leiterin: Sabrina\f",
        "Die Meisterin der Psycho-Pokémon"
      ]
    },
    {
      "id": "msg_0529_00013",
      "de_DE": [
        "Silph Co.\n",
        "Bürogebäude"
      ]
    },
    {
      "id": "msg_0529_00014",
      "de_DE": [
        "Hier wohnt Mr. Psycho.\n",
        "Und wehe, jemand nennt mich alt!"
      ]
    }
  ]
}
