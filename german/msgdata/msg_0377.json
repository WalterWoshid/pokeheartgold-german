    {
      "id": "msg_0377_00022",
      "de_DE": [
        "Hallo {STRVAR_1 3, 0, 0}!\r",
        "Gerade wollte ich Professor Eich in\n",
        "einem Brief benachrichtigen, dass ich\f",
        "etwas habe, das ich dir geben möchte!\r"
      ]
    },
    {
      "id": "msg_0377_00023",
      "de_DE": [
        "Hier, schau mal...\n",
        "Das hat mir ein Freund aus\f",
        "Hoenn mitgebracht!\r"
      ]
    },
    {
      "id": "msg_0377_00024",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält\n",
        "Blaue Kugel!\r"
      ]
    },
    {
      "id": "msg_0377_00025",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält\n",
        "Rote Kugel!\r"
      ]
    },
    {
      "id": "msg_0377_00026",
      "de_DE": [
        "Diese Kugel stammt aus einem alten\n",
        "Gemäuer, das man den Felsenherzturm\f",
        "nennt, direkt hinter Anemonia City.\r",
        "Aber mittelmäßige Trainer können\n",
        "diesen Ort auf keinen Fall erreichen...\r",
        "Deshalb dachte ich mir, du wärst der\n",
        "geeignete Besitzer für die Kugel.\r",
        "Du genießt immerhin Professor Eichs\n",
        "Vertrauen und hast dir auf wundersame\f",
        "Weise den Titel des Champs erarbeitet.\r",
        "Du wirst das Geheimnis um diese seltsame\n",
        "Kugel und den Turm sicher lösen!\f",
        "Davon bin ich überzeugt!"
      ]
    },
    {
      "id": "msg_0377_00027",
      "de_DE": [
        "Der Felsenherzturm liegt irgendwo tief\n",
        "in den Steilwänden hinter Anemonia City!\r",
        "So erzählt man es sich üblicherweise.\r",
        "Habe ich zumindest gehört.\r",
        "Na ja, glaube ich."
      ]
    },
    {
      "id": "msg_0377_00028",
      "de_DE": [
        "Das sind Zeitungen aus aller Welt.\r",
        "Ich kann die Schlagzeilen nicht lesen..."
      ]
    },
    {
      "id": "msg_0377_00029",
      "de_DE": [
        "Das ist ein großer Computer.\n",
        "Hm, er ist kaputt..."
      ]
    },
    {
      "id": "msg_0377_00030",
      "de_DE": [
        "Ein ganzer Stapel seltsamer Münzen!\n",
        "Vielleicht stammen sie ja aus einem\f",
        "anderen Land?"
      ]
    }
