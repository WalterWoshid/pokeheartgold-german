{
  "key": 35639,
  "messages": [
    {
      "id": "msg_0646_00000",
      "de_DE": "Erika"
    },
    {
      "id": "msg_0646_00001",
      "de_DE": [
        "Entschuldige, ich verstehe dich kaum!\n",
        "Das liegt wohl an der Verbindung!\r",
        "Versuch es noch einmal von woanders!"
      ]
    },
    {
      "id": "msg_0646_00002",
      "de_DE": [
        "Hallo?\n",
        "Geht es dir gut?\f",
        "Ich bin putzmunter!\r"
      ]
    },
    {
      "id": "msg_0646_00003",
      "de_DE": [
        "Es gibt außer mir noch viele unglaublich\n",
        "starke Arenaleiter!\f",
        "Also gib dein Bestes!"
      ]
    },
    {
      "id": "msg_0646_00004",
      "de_DE": [
        "Nun, der Sonntagmorgen wäre mir recht.\n",
        "Ruf mich dann doch bitte einmal an!"
      ]
    },
    {
      "id": "msg_0646_00005",
      "de_DE": [
        "Oh, welch ein Zufall! Ich habe mich\n",
        "gerade ein wenig gelangweilt!\r",
        "Möchtest du nicht noch einen Kampf\n",
        "mit mir austragen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0646_00006",
      "de_DE": [
        "Oh, wie schön! Damit hast du mir eine\n",
        "große Freude gemacht!\r",
        "Ich erwarte dich im Dojo von Saffronia\n",
        "City!"
      ]
    },
    {
      "id": "msg_0646_00007",
      "de_DE": "Oh, wie schade..."
    },
    {
      "id": "msg_0646_00008",
      "de_DE": [
        "Oh, anscheinend hast du schon einer\n",
        "ganzen Reihe von Leuten ein Rematch\f",
        "versprochen..."
      ]
    },
    {
      "id": "msg_0646_00009",
      "de_DE": [
        "Ich warte auf dich im Dojo von Saffronia\n",
        "City.\f",
        "Vergiss es bitte nicht!"
      ]
    },
    {
      "id": "msg_0646_00010",
      "de_DE": [
        "Hallo, hier spricht Erika!\n",
        "Wie geht es dir?\r"
      ]
    },
    {
      "id": "msg_0646_00011",
      "de_DE": [
        "Du wirst doch hoffentlich dein Wort\n",
        "halten und dich mir im Dojo von Saffronia\f",
        "City stellen, oder?"
      ]
    },
    {
      "id": "msg_0646_00012",
      "de_DE": [
        "Magst du Pflanzen? Du musst wissen,\n",
        "Pflanzen sind äußerst empfindliche\f",
        "Lebewesen!\r",
        "Selbst kleinste Veränderungen in ihrer\n",
        "Umgebung, wie etwa die tägliche\f",
        "Wassermenge, die Qualität des Bodens,\f",
        "leichte Schwankungen der Temperatur\f",
        "und natürlich auch das Wetter,\f",
        "haben großen Einfluss auf sie!"
      ]
    },
    {
      "id": "msg_0646_00013",
      "de_DE": [
        "Magst du eigentlich Wahrsagerei?\n",
        "Nun, Blütenblätter abzureißen oder\f",
        "Blätter klein zu schneiden und daraus\f",
        "die Zukunft lesen zu wollen, halte ich\f",
        "zwar für Humbug... \r",
        "Den Namenbewerter von Lavandia\n",
        "schätze ich jedoch sehr!"
      ]
    },
    {
      "id": "msg_0646_00014",
      "de_DE": [
        "Was machst du in deiner Freizeit?\r",
        "Ich topfe in der Arena zum Beispiel\n",
        "Pflanzen um oder befreie Blüten und\f",
        "Blätter mit einem kleinen Pinsel vom\f",
        "Staub.\r",
        "Oh, es tut mir leid, ich muss wieder hin!"
      ]
    }
  ]
}
