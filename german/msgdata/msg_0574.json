{
  "key": 63972,
  "messages": [
    {
      "id": "msg_0574_00000",
      "de_DE": [
        "Hartwig: Huaaargh! Dieser unerbittliche\n",
        "Druck der Wassermassen, die Tropfen\f",
        "für Tropfen und Schwall für Schwall auf\f",
        "mein Haupt niederregnen...\r",
        "Dieser unbeschreib... hey, Moment mal!\r",
        "Du kannst doch nicht einfach so den\n",
        "Wasserfluss stoppen und mich bei\f",
        "meinem Training stören!\r",
        "Ich will ja nicht angeben, aber ich bin\n",
        "ein wirklich harter Brocken!\r",
        "Sieben Tage in der Woche stehe ich\n",
        "unter diesem Wasserfall und stähle mich.\r",
        "Was sagst du da? Das macht meine\n",
        "Pokémon auch nicht stärker?\r",
        "... ... ...\n",
        "D-da hast du natürlich nicht unrecht...\r",
        "... ... ...\n",
        "... ... ...\r",
        "Egal, lass uns endlich kämpfen!\r"
      ]
    },
    {
      "id": "msg_0574_00001",
      "de_DE": [
        "Urrrgh!\n",
        "... ... ...\r",
        "Huaaargh!"
      ]
    },
    {
      "id": "msg_0574_00002",
      "de_DE": [
        "Na, da staunst du, was?\r",
        "Was sagst du da? Mit Pokémon\n",
        "hat das herzlich wenig zu tun?\f",
        "Klar, da hast du natürlich recht!\f",
        "Komm schon, lass uns kämpfen!\r"
      ]
    },
    {
      "id": "msg_0574_00003",
      "de_DE": [
        "Hartwig: Hmpf, wie konnte das bloß\n",
        "passieren? Du hast gewonnen...\r",
        "Aber na gut! Damit hast du dir den\n",
        "Faustorden verdient!\r"
      ]
    },
    {
      "id": "msg_0574_00004",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält den\n",
        "Faustorden!"
      ]
    },
    {
      "id": "msg_0574_00005",
      "de_DE": [
        "Hartwig: Der Faustorden erlaubt es dir,\n",
        "mithilfe der Attacke Fliegen an Orte zu\f",
        "düsen, die du bereits besucht hast.\r",
        "Und wo ich schon mal dabei bin, kann\n",
        "ich dir eigentlich auch das hier geben.\r"
      ]
    },
    {
      "id": "msg_0574_00006",
      "de_DE": [
        "Hartwig: In der TM01 findest du die\n",
        "Attacke Power-Punch!\r",
        "Nimmt dein Pokémon Schaden, bevor es\n",
        "angreifen konnte, verlierst du damit die\f",
        "Chance auf einen Angriff.\r",
        "Gelingt es ihm aber, einen Treffer zu\n",
        "landen, erzeugt diese Attacke schier\f",
        "unglaubliche Kräfte in ihm!"
      ]
    },
    {
      "id": "msg_0574_00007",
      "de_DE": "Hm, du kannst nicht mehr tragen!"
    },
    {
      "id": "msg_0574_00008",
      "de_DE": [
        "Hartwig: Hahaha! Es war mir ein großes\n",
        "Vergnügen, gegen dich zu kämpfen!\r",
        "Aber das ändert nichts daran, dass ich\n",
        "verloren habe. Von nun an werde ich\f",
        "24 Stunden am Tag trainieren!"
      ]
    },
    {
      "id": "msg_0574_00009",
      "de_DE": [
        "Er ist so in sein Training vertieft,\n",
        "dass er dich gar nicht bemerkt."
      ]
    },
    {
      "id": "msg_0574_00010",
      "de_DE": [
        "Da ist eine große Kurbel. Willst du\n",
        "daran drehen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0574_00011",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} dreht mit voller Wucht\n",
        "an der Kurbel!\r"
      ]
    },
    {
      "id": "msg_0574_00012",
      "de_DE": [
        "Weiter lässt sie sich offenbar\n",
        "nicht mehr drehen."
      ]
    },
    {
      "id": "msg_0574_00013",
      "de_DE": "Pokémon-Arena von Anemonia City"
    },
    {
      "id": "msg_0574_00014",
      "de_DE": [
        "Pokémon-Arena von Anemonia City\r",
        "Leiter: Hartwig\n",
        "Anerkannte Trainer:\f",
        "{STRVAR_1 3, 0, 0}"
      ]
    }
  ]
}
