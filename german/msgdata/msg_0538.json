    {
      "id": "msg_0538_00000",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} klettert in den Motor.\r",
        "{STRVAR_1 0, 0, 0} versucht\n",
        "{STRVAR_1 6, 1, 0} zu erlernen.\r",
        "{STRVAR_1 0, 0, 0} kann aber nicht\n",
        "mehr als vier Attacken erlernen!\r",
        "Attacke vergessen, um\n",
        "{STRVAR_1 6, 1, 0} zu lernen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0538_00001",
      "de_DE": [
        "{STRVAR_1 6, 1, 0} doch nicht\n",
        "erlernen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0538_00002",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} hat\n",
        "{STRVAR_1 6, 1, 0} nicht erlernt.\r",
        "{STRVAR_1 0, 0, 0} klettert aus dem Motor."
      ]
    },
    {
      "id": "msg_0538_00003",
      "de_DE": [
        "Die Attacke {STRVAR_1 6, 1, 0} wird\n",
        "vergessen. Einverstanden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0538_00004",
      "de_DE": "1,{PAUSE 20} 2{PAUSE 20} und...{PAUSE 20} ...{PAUSE 20} schwupp!"
    },
    {
      "id": "msg_0538_00005",
      "de_DE": [
        "{STRVAR_1 1, 0, 0} hat die Attacke\n",
        "{STRVAR_1 6, 1, 0} vergessen.\r",
        "Und..."
      ]
    },
    {
      "id": "msg_0538_00006",
      "de_DE": [
        "{STRVAR_1 1, 0, 0} erlernte die\n",
        "Attacke {STRVAR_1 6, 1, 0}!"
      ]
    },
    {
      "id": "msg_0538_00007",
      "de_DE": [
        "Für welches ROTOM entscheidest du\n",
        "dich?\r"
      ]
    },
    {
      "id": "msg_0538_00008",
      "de_DE": "Ein Ei kann nicht in den Motor klettern."
    },
    {
      "id": "msg_0538_00009",
      "de_DE": [
        "Dieses Pokémon kann nicht in Motoren\n",
        "klettern."
      ]
    },
    {
      "id": "msg_0538_00010",
      "de_DE": "{STRVAR_1 0, 0, 0} klettert in den Motor.\r"
    },
    {
      "id": "msg_0538_00011",
      "de_DE": "{STRVAR_1 0, 0, 0} klettert aus dem Motor.\r"
    },
    {
      "id": "msg_0538_00012",
      "de_DE": [
        "Welchem ROTOM möchtest du seine\n",
        "ursprüngliche Form zurückgeben? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0538_00013",
      "de_DE": [
        "Oh! Anscheinend möchte das ROTOM seine\n",
