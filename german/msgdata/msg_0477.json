{
  "key": 44786,
  "messages": [
    {
      "id": "msg_0477_00000",
      "de_DE": [
        "Wenn du den Felstunnel im Norden\n",
        "von Lavandia durchquerst, gelangst\f",
        "du zum Kraftwerk."
      ]
    },
    {
      "id": "msg_0477_00001",
      "de_DE": [
        "Es soll einen Radiosender geben, der\n",
        "nur Pokéflötenmusik sendet.\r",
        "Aber um den empfangen zu können,\n",
        "benötigst du ein Zusatzset."
      ]
    },
    {
      "id": "msg_0477_00002",
      "de_DE": [
        "Wenn das Kraftwerk ausfällt, läuft\n",
        "auch der Magnetzug nicht mehr.\r",
        "Die Radiosender können dann auch\n",
        "nicht mehr auf Sendung gehen."
      ]
    },
    {
      "id": "msg_0477_00003",
      "de_DE": [
        "Der Intendant des Radiosenders war\n",
        "hocherfreut. Er sagte, sie seien wieder\f",
        "auf Sendung, weil das Kraftwerk\f",
        "wieder einwandfrei arbeite."
      ]
    }
  ]
}
