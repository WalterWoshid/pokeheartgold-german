{
  "key": 46231,
  "messages": [
    {
      "id": "msg_0124_00000",
      "de_DE": [
        "Die Strudelinseln waren vor langer Zeit\n",
        "einmal ein einziges großes Eiland.\r",
        "Doch es lebten dort zwei Völker, die\n",
        "das Land mit ihren ständigen\f",
        "Streitereien spalteten.\r",
        "LUGIA, der Schutzpatron dieser Insel,\n",
        "war darüber so erbost, dass es\f",
        "einen Blitz herabfahren ließ, der\f",
        "das Land in vier Teile aufbrach.\r",
        "LUGIA selbst versteckte sich tief\n",
        "am Grund des Wasserfalls\f",
        "unter den Strudelinseln...\r",
        "Wenn du den Silberflügel\n",
        "mitbringst, der dabei angeblich\f",
        "von LUGIAs Körper fiel,\f",
        "lasse ich dich hier durch.\r",
        "Aber damit ist noch nicht\n",
        "gesagt, dass du LUGIA auch\f",
        "wirklich zu Gesicht bekommst!\r",
        "Das, wonach LUGIA sich wirklich sehnt,\n",
        "ist eine Form von Vertrauenswürdigkeit,\f",
        "die sich weder uns Menschen noch den\f",
        "Pokémon mit bloßem Auge erschließt...\r",
        "Ja, ich glaube, LUGIA wartet auf eine\n",
        "Person mit der Gabe, seinen Glauben an\f",
        "die Menschheit wiederherzustellen..."
      ]
    },
    {
      "id": "msg_0124_00001",
      "de_DE": [
        "Das Pokémon dieser Insel,\n",
        "LUGIA also, zog sich tief an den\f",
        "Grund des Wasserfalls zurück\f",
        "und ließ sich seitdem nie wieder blicken.\r",
        "Aber wenn eine Person mit der Fähigkeit,\n",
        "eine tiefe Freundschaft mit einem\f",
        "Pokémon einzugehen, etwas mitbringt,\f",
        "mit dem sich LUGIA verbunden fühlt,\r",
        "antwortet es vielleicht auf das Anrufen\n",
        "dieser Person und zeigt sich wieder..."
      ]
    },
    {
      "id": "msg_0124_00002",
      "de_DE": "A-aber das ist doch...\r"
    },
    {
      "id": "msg_0124_00003",
      "de_DE": [
        "Wunderbar! Du hast ihn gefunden!\n",
        "Hier, du darfst passieren!\r"
      ]
    },
    {
      "id": "msg_0124_00004",
      "de_DE": [
        "Wunderbar! Du hast ihn gefunden!\n",
        "Hier, du darfst passieren!"
      ]
    },
    {
      "id": "msg_0124_00005",
      "de_DE": [
        "Der Silberflügel ist ein bisschen wie ein\n",
        "Passierschein, der es dir jederzeit\f",
        "erlaubt, den Wasserfall hinabzureisen.\r",
        "Aber solange du nicht für dich allein\n",
        "die Gabe besitzt, das Band der\f",
        "Freundschaft zwischen Menschen\f",
        "und Pokémon wieder aufzuspannen,\f",
        "wird LUGIA auf keinen Fall\f",
        "vor dir erscheinen..."
      ]
    },
    {
      "id": "msg_0124_00006",
      "de_DE": [
        "Nun gut, nun gut! Der Rest liegt\n",
        "jetzt bei dir und der Gischtglocke!"
      ]
    },
    {
      "id": "msg_0124_00007",
      "de_DE": [
        "Für jemanden in deinem Alter hast\n",
        "du es wirklich weit gebracht..."
      ]
    }
  ]
}
