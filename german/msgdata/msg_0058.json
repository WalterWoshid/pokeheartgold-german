{
  "key": 49191,
  "messages": [
    {
      "id": "msg_0058_00000",
      "de_DE": [
        "Tamao: Dies ist der Ort, an dem wir\n",
        "mit HO-OH in Kontakt treten werden.\r",
        "Wenn hier gleichzeitig der Klang des\n",
        "Tanzes, den wir täglich proben, und der\f",
        "Klang der Klarglocke, die Ihr erhalten\f",
        "habt, ertönt, wird HO-OH wieder vom\r",
        "weiten Himmelszelt zu uns\n",
        "herabsteigen!\r"
      ]
    },
    {
      "id": "msg_0058_00001",
      "de_DE": [
        "Mehr können wir nicht für Euch tun...\n",
        "Was nun geschieht, liegt ganz allein\f",
        "in Euren Händen..."
      ]
    },
    {
      "id": "msg_0058_00002",
      "de_DE": [
        "Was Ihr da vor Euch seht, ist HO-OH...\n",
        "Seit Urzeiten erzählt man sich hier\f",
        "von ihm, dem Schutzpatron der Lüfte...\r",
        "Schon viele vor Euch haben sich daran\n",
        "versucht, das Gleiche zu erreichen,\f",
        "doch alle scheiterten sie kläglich...\r",
        "{STRVAR_1 3, 0, 0}, Ihr hattet endlich Erfolg\n",
        "damit, weil Euer Herz und die Klarglocke\f",
        "in Einklang miteinander standen...\r"
      ]
    },
    {
      "id": "msg_0058_00003",
      "de_DE": [
        "Seht nur, {STRVAR_1 3, 0, 0}!\r",
        "HO-OH...\n",
        "...scheint darauf, dass jemand wie Ihr\f",
        "in Erscheinung tritt...\f",
        "...gewartet zu haben.\r"
      ]
    },
    {
      "id": "msg_0058_00004",
      "de_DE": "HO-OH: Hooo Oooh!!!\r"
    },
    {
      "id": "msg_0058_00005",
      "de_DE": [
        "Wir danken Euch für alles.\n",
        "Wenn Ihr Professor Lind begegnet,\f",
        "richtet ihm bitte unsere Grüße aus."
      ]
    },
    {
      "id": "msg_0058_00006",
      "de_DE": [
        "Ihr habt HO-OH nicht nur hierher\n",
        "gerufen, sondern Ihr konntet es auch\f",
        "wie durch ein Wunder einfangen...\r",
        "Das war wirklich eine Glanzleistung.\n",
        "Es gibt nun nichts mehr, was\f",
        "wir Euch noch erzählen könnten.\r",
        "Wir wünschen Euch auch für den Rest\n",
        "Eurer Reise alles Gute..."
      ]
    },
    {
      "id": "msg_0058_00007",
      "de_DE": [
        "Wenn es das ist, worauf Ihr aus wart,\n",
        "so gibt es nichts mehr, was wir\f",
        "Euch noch sagen könnten.\r",
        "Bis auf eines... \n",
        "Solltet Ihr HO-OH erneut sehen\f",
        "wollen, dann kommt noch einmal\f",
        "an diesen Ort zurück,\f",
        "wenn Ihr alles weitere erledigt habt..."
      ]
    },
    {
      "id": "msg_0058_00008",
      "de_DE": [
        "Wenn wir ihm jetzt den Rücken zuwenden,\n",
        "wird HO-OH wahrscheinlich eine Weile lang\f",
        "nicht mehr hierher zurückkehren...\r",
        "Ihr solltet dann noch\n",
        "einmal an diesen Ort\f",
        "zurückkommen, wenn\f",
        "Ihr alles weitere erledigt habt..."
      ]
    }
  ]
}
