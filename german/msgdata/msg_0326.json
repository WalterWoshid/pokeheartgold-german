  "messages": [
    {
      "id": "msg_0326_00000",
      "de_DE": [
        "Zum Mondberg\r",
        "Unterwegs wirst du am Vorplatz\n",
        "zum Mondberg vorbeikommen!"
      ]
    },
    {
      "id": "msg_0326_00001",
      "de_DE": [
        "So einen Stein hab ich noch nie gesehen!\r",
        "Ist das am Ende etwa...\n",
        "ein Meteorit? Aus dem Weltraum?"
      ]
    },
    {
      "id": "msg_0326_00002",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "wird die Initiative eines\f",
        "bestimmten Pokémon erhöht."
      ]
    },
    {
      "id": "msg_0326_00003",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "wird die Verteidigung eines\f",
        "bestimmten Pokémon erhöht."
      ]
    },
    {
      "id": "msg_0326_00004",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "wird der Angriff eines\f",
        "bestimmten Pokémon erhöht.\n"
      ]
    },
    {
      "id": "msg_0326_00005",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "werden die Attribute eines\f",
        "bestimmten Pokémon ausbalanciert."
      ]
    }
  ]
}
