    {
      "id": "msg_0021_00049",
      "de_DE": [
        "~Rezept für Aprikodrink~\n",
        "Hau ein paar Aprikokos in\n",
        "den Shaker!\r",
        "Eine Aprikoko reicht schon -\n",
        "doch für Drinks gilt: je mehr\n",
        "Aprikokos, desto stärker!\r",
        "Dann schnappe dir den Shaker\n",
        "und schüttele das Ganze, indem\n",
        "du in die nächste Stadt läufst!"
      ]
    },
    {
      "id": "msg_0021_00050",
      "de_DE": "Der Aprikodrink ist fertig!"
    },
    {
      "id": "msg_0021_00051",
