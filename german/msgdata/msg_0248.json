      "de_DE": "Das ist weicher Lehmboden."
    },
    {
      "id": "msg_0248_00011",
      "de_DE": "Hier wurde {STRVAR_1 8, 2, 0} verteilt."
    },
    {
      "id": "msg_0248_00012",
      "de_DE": [
