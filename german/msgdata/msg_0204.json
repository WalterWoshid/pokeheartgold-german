{
  "key": 36501,
  "messages": [
    {
      "id": "msg_0204_00000",
      "de_DE": [
        "Hi!\n",
        "Wie geht’s?\r",
        "Du bist in der {STRVAR_34 3, 1, 0}-Gruppe,\n",
        "mit {STRVAR_1 3, 0, 0} als Leiter, oder?\r",
        "Möchtest du diese Gruppe verlassen\n",
        "und einer anderen beitreten? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00001",
      "de_DE": [
        "Hi!\n",
        "Wie geht’s?\r",
        "Du bist in der {STRVAR_34 3, 1, 0}-Gruppe,\n",
        "mit {STRVAR_1 3, 0, 0} als Leiter, oder?\r",
        "Möchtest du diese Gruppe verlassen\n",
        "und eine neue gründen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00002",
      "de_DE": [
        "He da! Ich weiß, das kommt jetzt ein\n",
        "bisschen plötzlich, aber hast\f",
        "du nicht Interesse an einer Gruppe?\r",
        "In einer Gruppe kannst du dich mit\n",
        "anderen messen und viel Spaß haben.\f",
        "Nun, was meinst du? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00003",
      "de_DE": [
        "Welcher Gruppe möchtest\n",
        "du beitreten? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00004",
      "de_DE": [
        "Oh.\n",
        "Das ist aber schade!"
      ]
    },
    {
      "id": "msg_0204_00005",
      "de_DE": [
        "Oh, du möchtest eine neue\n",
        "Gruppe gründen? Klar doch!\r",
        "Aber die Gruppe, die du vorher gegrün-\n",
        "det hast, wird sich dann auflösen.\f",
        "Bist du damit einverstanden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00006",
      "de_DE": [
        "Yay, coool! Und wie soll deine\n",
        "Gruppe heißen?!?"
      ]
    },
    {
      "id": "msg_0204_00007",
      "de_DE": [
        "{STRVAR_34 3, 0, 0}-Gruppe, ja?\n",
        "Toller Name!\r",
        "Ihr Leiter ist {STRVAR_1 3, 1, 0}.\n",
        "Ich hoffe, die Gruppe bekommt\f",
        "viele Mitglieder!"
      ]
    },
    {
      "id": "msg_0204_00008",
      "de_DE": [
        "Die {STRVAR_34 3, 0, 0}-Gruppe?\n",
        "Der Leiter ist {STRVAR_1 3, 1, 0}.\f",
        "Möchtest du der Gruppe beitreten? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00009",
      "de_DE": [
        "Gut! {STRVAR_1 3, 0, 0} gehört nun zur\n",
        "{STRVAR_34 3, 1, 0}-Gruppe."
      ]
    },
    {
      "id": "msg_0204_00010",
      "de_DE": [
        "Bildest du eine neue Gruppe oder\n",
        "trittst einer bei, dann solltest du\f",
        "unbedingt den Konnex-Klub besuchen!\r",
        "Dort kannst du Statistiken mit anderen\n",
        "Gruppenmitgliedern tauschen und\f",
        "so gehörst du schon bald richtig dazu.\r",
        "In einer Gruppe teilst du mit deinen\n",
        "Freunden alle möglichen Erlebnisse.\r",
        "Genau das macht das Spielen\n",
        "in einer Gruppe so lustig und\f",
        "interessant.\r",
        "Jeder kann eine Gruppe bilden und\n",
        "jeder kann dieser Gruppe beitreten.\r",
        "Ich hoffe, deine Gruppe wächst\n",
        "fix und du hast viel Spaß dabei! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0204_00011",
      "de_DE": "GRUPPE BILDEN"
    },
    {
      "id": "msg_0204_00012",
      "de_DE": "GRUPPE BEITRETEN"
    },
