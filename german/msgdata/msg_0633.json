  "key": 13438,
  "messages": [
    {
      "id": "msg_0633_00000",
      "de_DE": [
        "Ebenholz City ist die Heimat eines alten\n",
        "Klans, der die tiefsten Geheimnisse\f",
        "der Drachen-Pokémon ergründet hat.\r",
        "Aus diesem Grund sind über diesen Ort\n",
        "zahlreiche Legenden überliefert, die\f",
        "sich um die Drachen-Pokémon ranken."
      ]
    },
    {
      "id": "msg_0633_00001",
      "de_DE": [
        "Sowohl Sandra als auch Siegfried haben\n",
        "hier ihre Grundausbildung bestritten\f",
        "und ihren Fähigkeiten als Trainer\f",
        "den nötigen Feinschliff verpasst."
      ]
    },
    {
      "id": "msg_0633_00002",
      "de_DE": "DRATINI: Draaa!"
    }
  ]
}
