{
  "key": 49263,
  "messages": [
    {
      "id": "msg_0703_00000",
      "de_DE": "Lorenz"
    },
    {
      "id": "msg_0703_00001",
      "de_DE": [
        "Wenn du in unsere Klasse gingst,\n",
        "wäre ich nur noch die Nummer 2!\f",
        "Nein, das geht nun gar nicht!\r",
        "So weit lasse ich es nicht kommen!\n",
        "Ich werde fleißig trainieren!\f",
        "Tauschen wir Telefonnummern?\r",
        "Dann können wir öfter\n",
        "miteinander üben! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0703_00002",
      "de_DE": [
        "Wenn ich kampfbereit bin,\n",
        "melde ich mich wieder bei dir!\r",
        "Lass auch du ab und zu von dir hören!"
      ]
    },
    {
      "id": "msg_0703_00003",
      "de_DE": [
        "Sag bloß, du hast wirklich vor,\n",
        "auf meine Schule zu wechseln?!?"
      ]
    },
    {
      "id": "msg_0703_00004",
      "de_DE": [
        "Wenn du in unsere Klasse gingst,\n",
        "wäre ich nur noch die Nummer 2!\r",
        "Und das geht nun gar nicht!\n",
        "Tauschen wir Telefonnummern?\r",
        "Ich will noch einmal gegen dich\n",
        "kämpfen, um noch besser zu werden! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0703_00005",
      "de_DE": [
        "Ich möchte dir danken, dass du dir Zeit\n",
        "für mich genommen hast.\f",
        "Hier, bitte, eine Beere!\r"
      ]
    },
    {
      "id": "msg_0703_00006",
      "de_DE": [
        "Seltsam? Wo steckst du gerade?\n",
        "Doch nicht etwa in der Nähe?\r",
        "Dann kannst du wohl auch die letzten\n",
        "paar Meter gehen und zu mir kommen!"
      ]
    },
    {
      "id": "msg_0703_00007",
      "de_DE": [
        "Ich habe mir deine Kampftechnik\n",
        "zu Herzen genommen und ordentlich\f",
        "mit meinem {STRVAR_1 0, 10, 0} trainiert.\r",
        "Dank dir sind wir schon viel\n",
        "besser geworden!\r",
        "Allerdings...\n",
        "Wenn wir uns verbessert haben,\f",
        "hast du dich in der Zwischenzeit\f",
        "sicherlich noch viel mehr verbessert!\r",
        "...Sekunde mal!\n",
        "Das bedeutet ja, wir werden dich\f",
        "unser Leben lang nicht schlagen!"
      ]
    },
    {
      "id": "msg_0703_00008",
      "de_DE": [
        "Ich habe mir deine Kampftechnik\n",
        "als Vorbild genommen und damit\f",
        "ein {STRVAR_1 0, 11, 0} besiegt!\r",
        "Dank dir ist mein Pokémon-Team\n",
        "nun viel stärker als vorher!\r",
        "Zeigst du mir wieder ein paar Tricks,\n",
        "wenn wir uns das nächste Mal sehen?"
      ]
    },
    {
      "id": "msg_0703_00009",
      "de_DE": [
        "Hör mal kurz zu!\r",
        "Neulich, da dachte ich, ich könnte mir\n",
        "endlich ein {STRVAR_1 0, 11, 0} schnappen!\r",
        "Aber im allerletzten Augenblick\n",
        "ist es mir entkommen!\r",
        "Man muss eben immer genug\n",
        "Pokébälle dabeihaben,\f",
        "sonst schaut man in die Röhre."
      ]
    },
    {
      "id": "msg_0703_00010",
      "de_DE": [
        "Hör mal... so langsam würde ich gern\n",
        "wieder einmal gegen dich kämpfen.\f",
        "Was meinst du dazu?\r",
        "Bist du bereit? Unser\n",
        "Treffpunkt heißt: {STRVAR_1 4, 3, 0}!"
      ]
    },
    {
      "id": "msg_0703_00011",
      "de_DE": [
        "Haaallo! {STRVAR_1 4, 3, 0}, schon\n",
        "vergessen?\r",
        "Du hattest mir einen Kampf\n",
        "versprochen! Trödel nicht so."
      ]
    },
    {
      "id": "msg_0703_00012",
      "de_DE": [
        "Kannst du dir denken, wieso\n",
        "ich immer nur Shorts trage?\r",
        "Na, weil sie cool aussehen!\r",
        "Denn wenn ich mir das Knie aufschürfe\n",
        "und ein Pflaster trage,\f",
        "kann man es sehen!\f",
        "Dann denken alle, ich sei ein wilder Typ!"
      ]
    }
  ]
}
