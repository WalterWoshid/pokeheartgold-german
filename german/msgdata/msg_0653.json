{
  "key": 43357,
  "messages": [
    {
      "id": "msg_0653_00000",
      "de_DE": "Jens"
    },
    {
      "id": "msg_0653_00001",
      "de_DE": [
        "Bitte? Ich verstehe dich kaum!\n",
        "Die Verbindung ist so schlecht!\r",
        "Ruf bitte noch einmal von woanders an!"
      ]
    },
    {
      "id": "msg_0653_00002",
      "de_DE": [
        "Hallo?\n",
        "Was gibt es?\f",
        "Mir geht es gut!\r"
      ]
    },
    {
      "id": "msg_0653_00003",
      "de_DE": [
        "Außer mir gibt es noch viele andere\n",
        "starke Arenaleiter!\r",
        "Ich drücke dir auf jeden Fall die\n",
        "Daumen! Gib dein Bestes!"
      ]
    },
    {
      "id": "msg_0653_00004",
      "de_DE": [
        "Hm, ich hätte am Dienstagabend Zeit für\n",
        "ein Rematch!\r",
        "Ruf mich doch dann einfach an!"
      ]
    },
    {
      "id": "msg_0653_00005",
      "de_DE": [
        "Ich habe den ganzen Tag Zeit!\n",
        "Nun? Lust auf ein Rematch? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0653_00006",
      "de_DE": [
        "Super!\r",
        "Kennst du das Dojo von Saffronia City?\n",
        "Ich warte dort auf dich!"
      ]
    },
    {
      "id": "msg_0653_00007",
      "de_DE": [
        "Schade...\n",
        "Aber du bist sicherlich auch ziemlich\f",
        "beschäftigt, nicht wahr!"
      ]
    },
    {
      "id": "msg_0653_00008",
      "de_DE": [
        "Moment! Hast du nicht vielleicht noch\n",
        "anderen Trainern ein Rematch\f",
        "versprochen?"
      ]
    },
    {
      "id": "msg_0653_00009",
      "de_DE": [
        "Ich erwarte dich im Dojo von Saffronia\n",
        "City!\f",
        "Bereite dich gut vor!"
      ]
    },
    {
      "id": "msg_0653_00010",
      "de_DE": [
        "Ich bin’s, Jens!\n",
        "Ist bei dir alles in Ordnung?\r"
      ]
    },
    {
      "id": "msg_0653_00011",
      "de_DE": [
        "Wir haben eine Verabredung im Dojo von\n",
        "Saffronia City!\f",
        "Ich werde da sein!\f",
        "Vergiss es ja nicht!"
      ]
    },
    {
      "id": "msg_0653_00012",
      "de_DE": [
        "Welches dieser Legendären Pokémon\n",
        "magst du am liebsten, SUICUNE, ENTEI\f",
        "oder RAIKOU?\r",
        "Ich persönlich bin ja kein so großer Fan\n",
        "von SUICUNE wie zum Beispiel Eusin.\r",
        "Hm, ich mag ENTEI am liebsten, aber\n",
        "RAIKOU ist auch nicht zu verachten...\f",
        "Ach, ich kann mich nicht entscheiden!"
      ]
    },
    {
      "id": "msg_0653_00013",
      "de_DE": [
        "Ich habe ENTEI einmal direkt\n",
        "gegenübergestanden!\r",
        "Den Blick, mit dem es mich ansah, werde\n",
        "ich niemals vergessen!\r",
        "Es kam mir vor, als würde es in mir lesen\n",
        "wie in einem offenen Buch!"
      ]
    },
    {
      "id": "msg_0653_00014",
      "de_DE": [
        "Na, was gibt es Neues bei dir?\n",
        "Bei mir ist alles beim Alten.\f",
        "Ich bin immer noch Arenaleiter, aber\f",
        "ich habe seit dir mit keinem\f",
        "anspruchsvollen Trainer mehr\f",
        "gekämpft!\r",
        "Jemanden wie dich trifft man eben nicht\n",
        "alle Tage!\r",
        "Nein, das sage ich nicht nur so!\n",
        "Das ist mein voller Ernst!"
      ]
    }
  ]
}
