  "messages": [
    {
      "id": "msg_0498_00000",
      "de_DE": [
        "Ich möchte gerne Items kaufen, die den\n",
        "Status meiner Pokémon verbessern...\f",
        "Aber seufz... mein Geld reicht nicht!"
      ]
    },
    {
      "id": "msg_0498_00001",
      "de_DE": [
        "Weißt du, was AP-Plus ist?\r",
        "Das ist ein ganz tolles Item, mit dem\n",
        "man die maximalen AP eines\f",
        "Pokémon erhöhen kann!\r",
        "Ist das nicht großartig? Ja, genau\n",
        "das dachte ich mir auch! Genau\f",
        "deshalb bin ich auch hierhergeeilt.\r",
        "Aber soll ich dir was sagen? AP-Plus\n",
        "kann man gar nicht im Laden kaufen!\r",
        "Mann, war das vielleicht ein Schock!"
      ]
    },
    {
      "id": "msg_0498_00002",
      "de_DE": [
        "Pokémon freuen sich darüber, wenn\n",
        "du ihnen Items zusteckst!\f",
        "Aber auf manche Items könnten\f",
        "sie scheinbar auch verzichten..."
      ]
    },
    {
      "id": "msg_0498_00003",
      "de_DE": [
        "Nutze das Potenzial deiner Pokémon!\n",
        "4S: Alles für den Kampf"
      ]
    }
  ]
}
