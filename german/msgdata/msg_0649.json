{
  "key": 2871,
  "messages": [
    {
      "id": "msg_0649_00000",
      "de_DE": "Sandra"
    },
    {
      "id": "msg_0649_00001",
      "de_DE": [
        "Hallo? Ich verstehe dich kaum!\n",
        "Die Verbindung ist so schlecht!\r",
        "Versuch bitte, von woanders anzurufen!"
      ]
    },
    {
      "id": "msg_0649_00002",
      "de_DE": [
        "Hallo?\n",
        "Ja?\f",
        "Mir geht es gut!\r"
      ]
    },
    {
      "id": "msg_0649_00003",
      "de_DE": [
        "Es gibt außer mir noch viele andere\n",
        "starke Arenaleiter!\f",
        "Gib dein Bestes!"
      ]
    },
    {
      "id": "msg_0649_00004",
      "de_DE": [
        "Hm, mal schauen...\n",
        "Am Freitagabend hätte ich Zeit für ein\f",
        "Rematch!\r",
        "Ruf mich doch dann einfach noch mal an!"
      ]
    },
    {
      "id": "msg_0649_00005",
      "de_DE": [
        "Du rufst genau zur rechten Zeit an!\n",
        "Hast du Lust auf einen kleinen\f",
        "Kampf? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0649_00006",
      "de_DE": [
        "Hihihi...\n",
        "Ich kann es kaum noch abwarten!\r",
        "Ich warte auf dich im Dojo von Saffronia\n",
        "City!"
      ]
    },
    {
      "id": "msg_0649_00007",
      "de_DE": [
        "Wie bitte???\n",
        "Wie stehe ich denn jetzt da!?!"
      ]
    },
    {
      "id": "msg_0649_00008",
      "de_DE": [
        "Du möchtest also ein Rematch!\n",
        "Das freut mich! \r",
        "Aber du solltest zuerst deine noch\n",
        "ausstehenden Kämpfe absolvieren!"
      ]
    },
    {
      "id": "msg_0649_00009",
      "de_DE": [
        "Ich warte auf dich im Dojo von Saffronia\n",
        "City!\f",
        "Lass mich ja nicht hängen!"
      ]
    },
    {
      "id": "msg_0649_00010",
      "de_DE": [
        "Hallo, hier ist Sandra!\n",
        "Wie geht es dir?\r"
      ]
    },
    {
      "id": "msg_0649_00011",
      "de_DE": [
        "Du hast unsere kleine Verabredung zum\n",
        "Kampf doch hoffentlich nicht vergessen?\r",
        "Ich warte auf dich im Dojo von Saffronia\n",
        "City!"
      ]
    },
    {
      "id": "msg_0649_00012",
      "de_DE": [
        "Neulich sind Leute vom Radio gekommen.\n",
        "Sie haben gesagt, dass sie eine\f",
        "Reportage über mich machen wollen...\r",
        "Endlich! Die Welt will mich sehen! Und ich\n",
        "werde mich ihr zeigen!\r",
        "Moment! Das war ja bloß das Radio!!\n",
        "Dann kann ja niemand meine Schönheit\f",
        "bewundern! Was für ein Pech!"
      ]
    },
    {
      "id": "msg_0649_00013",
      "de_DE": [
        "Offenbar bewundert die ganze Stadt\n",
        "meinen Modegeschmack!\r",
        "Ach, wer will es ihnen verübeln!"
      ]
    },
    {
      "id": "msg_0649_00014",
      "de_DE": [
        "Du scheinst sehr beschäftigt zu sein.\n",
        "Bei mir ist es ganz ähnlich!\f",
        "Zum einen bin ich für die Arena\f",
        "verantwortlich...\r",
        "Zum anderen müssen wir Drachenprofis\n",
        "von Zeit zu Zeit auch dem Weisen im\f",
        "Schrein einen Besuch abstatten.\r",
        "Was ist mit dir?\n",
        "Willst du kein Drachenprofi werden?\f",
        "Das Zeug dazu scheinst du zu haben!"
      ]
    }
  ]
}
