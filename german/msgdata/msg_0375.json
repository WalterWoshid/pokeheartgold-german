{
  "key": 19231,
  "messages": [
    {
      "id": "msg_0375_00000",
      "de_DE": [
        "Los, RATTFRATZ!\r",
        "Tackle!\r"
      ]
    },
    {
      "id": "msg_0375_00001",
      "de_DE": [
        "Was willst du? Das hier ist ein sehr\n",
        "wichtiger Kampf für mich, ist das klar?\f",
        "Lass mich in Ruhe!\r"
      ]
    },
    {
      "id": "msg_0375_00002",
      "de_DE": [
        "Pokémon können Attacken nur so oft\n",
        "einsetzen, wie sie Angriffspunkte (AP)\f",
        "dafür besitzen.\r",
        "Wenn ein Pokémon keine AP mehr besitzt,\n",
        "muss es in ein Pokémon-Center gebracht\f",
        "werden."
      ]
    },
    {
      "id": "msg_0375_00003",
      "de_DE": [
        "Pokémon können Attacken nur so oft\n",
        "einsetzen, wie sie Angriffspunkte (AP)\f",
        "dafür besitzen.\r",
        "Wenn ein Pokémon keine AP mehr besitzt,\n",
        "muss es in ein Pokémon-Center gebracht\f",
        "werden.\r",
        "Wenn du das verstanden hast, solltest\n",
        "du dich jetzt mit allen anderen bei ein\f",
        "paar Pokémon-Kämpfen vergnügen!"
      ]
    },
    {
      "id": "msg_0375_00004",
      "de_DE": [
        "Ich selbst bin keine Trainerin!\r",
        "Aber wenn dir ein Trainer in die\n",
        "Augen sieht, solltest du dich auf\f",
        "einen Kampf vorbereiten!"
      ]
    },
    {
      "id": "msg_0375_00005",
      "de_DE": [
        "Einen Augenblick mal!\r",
        "Willst du etwa wirklich völlig\n",
        "unbekümmert an einer auffälligen\f",
        "Gestalt wie mir vorbeispazieren?\f",
        "Bleibe gefälligst mal stehen!\r"
      ]
    },
    {
      "id": "msg_0375_00006",
      "de_DE": [
        "Wenn du diesem Weg immer weiter nach\n",
        "Norden folgst, erreichst du das Haus\f",
        "von Mr. Pokémon.\r",
        "Aber bevor du dorthin gehst, solltest\n",
        "du dir anhören, was ich zu sagen habe.\r",
        "Hast du schon ein paar Aprikokos?\r",
        "Die Aprikokobäume tragen ein Mal pro\n",
        "Tag Frucht und können deshalb auch\f",
        "täglich abgeerntet werden.\f",
        "Aprikokos sind eine tolle Sache!\r",
        "Sie fungieren als Grundbaustoff für\n",
        "Pokébälle und lassen sich für jede\f",
        "Menge andere Dinge verwenden.\f",
        "Sie können sehr nützlich sein!\r",
        "So, und jetzt, wo wir beide Freunde\n",
        "sind, habe ich ein Geschenk für dich!\r"
      ]
    },
    {
      "id": "msg_0375_00007",
      "garbage": 21
    },
    {
      "id": "msg_0375_00008",
      "de_DE": [
        "Mit dieser Aprikokobox kannst du immer\n",
        "reichlich Aprikokos mit dir herumtragen!\r",
        "So, damit bist du jetzt auch ein\n",
        "waschechter Aprikenner!\r"
      ]
    },
    {
      "id": "msg_0375_00009",
      "de_DE": [
        "Route 30\n",
        "Südlich nach Rosalia City"
      ]
    },
    {
      "id": "msg_0375_00010",
      "de_DE": [
        "Das Haus von Mr. Pokémon?\n",
        "Immer geradeaus!"
      ]
    },
    {
      "id": "msg_0375_00011",
      "de_DE": "Das Haus von Mr. Pokémon"
    },
    {
      "id": "msg_0375_00012",
      "de_DE": [
        "Tipps für Trainer\r",
        "Wer einem anderen Trainer die\n",
        "Pokémon klaut, ist ein Dieb!\r",
        "Deshalb dürfen Pokébälle auch nur bei\n",
        "wilden Pokémon eingesetzt werden!"
      ]
    },
    {
      "id": "msg_0375_00013",
      "de_DE": [
        "Oh, das sind doch Turbotreter\n",
        "da an deinen Füßen, oder?\r",
        "Mit denen durch die Gegend zu sausen\n",
        "ist schon ein tolles Gefühl, was?\r",
        "Aber die lauten Geräusche deiner\n",
        "Schritte können dir sehr leicht\f",
        "andere Trainer und wilde Pokémon\f",
        "auf den Hals hetzen. Vorsicht also!"
      ]
    }
  ]
}
