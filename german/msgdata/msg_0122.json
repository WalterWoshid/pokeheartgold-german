  "key": 42082,
  "messages": [
    {
      "id": "msg_0122_00000",
      "de_DE": [
        "Kannst du das Item\n",
        "da drüben sehen?\r",
        "Das habe ich dort verloren. Aber von da\n",
        "kann ich es unmöglich zurückholen.\r",
        "Warum nicht?\r",
        "Ist doch klar! Wenn ich über das Eis\n",
        "laufe, frieren mir die Füße ab!\r",
        "Meine Schuhe sind so abgenutzt,\f",
        "dass keine Sohlen mehr dran sind!"
      ]
    },
    {
      "id": "msg_0122_00001",
      "de_DE": [
        "Kannst du das Item\n",
        "da drüben sehen?\r",
        "Das habe ich dort verloren. Aber von da\n",
        "kann ich es unmöglich zurückholen.\r",
        "Warum nicht?\r",
        "Ist doch klar! Wenn ich über das Eis\n",
        "laufe, frieren mir noch die Füße ab!\r",
        "Meine Schuhe sind so abgenutzt,\n",
        "dass keine Sohlen mehr dran sind!\r"
      ]
    },
    {
      "id": "msg_0122_00002",
      "de_DE": [
        "Das Item, das da drüben lag, war\n",
        "eine VM, stimmt’s?\r",
        "Eigentlich gehört sie ja mir...\n",
        "aber ist schon gut! Keine Sorge!\f",
        "Wer’s findet, darf’s auch behalten!\f",
        "Ich schenke sie dir!\r",
        "Sie enthält Kaskade. Damit kannst du\n",
        "nach Herzenslust Wasserfälle erklimmen!\r",
        "Ich?\r",
        "Bevor ich einen Wasserfall hochklettern\n",
        "kann, brauche ich erst mal neue Schuhe!"
      ]
    },
    {
      "id": "msg_0122_00003",
      "de_DE": [
        "Oh, Euch kenne ich doch! {STRVAR_1 3, 0, 0}!\n",
        "Welch eine Überraschung!\r",
        "Darf ich offen mit Euch sein?\n",
        "Das Eis hat meine Sohlen am Grund\f",
        "festgefroren! Allein bin ich verloren!\r",
        "Verloren... gefroren...\n",
        "Hihi!\r",
        "Das reimt sich sogar!\n",
        "Aber bitte, befreit mich aus meiner Not!\r",
        "Arbeitet Euch bis zu meinem Rücken vor\n",
        "und gebt mir einen Schubs!"
      ]
    },
    {
      "id": "msg_0122_00004",
      "de_DE": [
        "Oh, Euch kenne ich doch! {STRVAR_1 3, 0, 0}!\n",
        "Welch eine Überraschung!\r",
        "Darf ich offen mit Euch sein?\n",
        "Das Eis hat meine Sohlen am Grund\f",
        "festgefroren! Allein bin ich verloren!\r",
        "Verloren... gefroren...\n",
        "Hihi!\r",
        "Das reimt sich sogar!\n",
        "Bitte, gebt mir einen Schubs!\r",
        "Befreit mich aus meiner Not... {YESNO 0}"
      ]
    },
    {
      "id": "msg_0122_00005",
      "de_DE": "Rumms!\r"
    },
    {
      "id": "msg_0122_00006",
      "de_DE": [
        "Oh bitte, seid nicht so grausam zu mir!\n",
        "Bitte gebt mir einen Schubs!\f",
        "Ihr seid doch so freundlich, oder? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0122_00007",
      "de_DE": [
        "Ihr seid wirklich eine gute Seele!\r",
        "Vielen lieben Dank!\r"
      ]
