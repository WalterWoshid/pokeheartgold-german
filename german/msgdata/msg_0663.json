{
  "key": 39016,
  "messages": [
    {
      "id": "msg_0663_00000",
      "de_DE": "Lyra"
    },
    {
      "id": "msg_0663_00001",
      "de_DE": [
        "Lyra: Das habe ich ja völlig vergessen!\n",
        "Lass uns Telefonnummern austauschen!"
      ]
    },
    {
      "id": "msg_0663_00002",
      "de_DE": [
        "Lyra: Du kannst mich jederzeit\n",
        "anrufen! Wir können uns gegenseitig\f",
        "über Pokémon austauschen!"
      ]
    },
    {
      "id": "msg_0663_00003",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}, wie geht es dir?\r",
        "Wenn man telefoniert, spricht man oft\n",
        "lauter als sonst. Man hat nämlich das\f",
        "Gefühl, der andere sei weit weg, auch\f",
        "wenn er ganz in der Nähe ist!"
      ]
    },
    {
      "id": "msg_0663_00004",
      "de_DE": [
        "Oh, {STRVAR_1 3, 0, 0}?\n",
        "Guten Morgen!\r"
      ]
    },
    {
      "id": "msg_0663_00005",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}?\n",
        "Guten Tag!\r"
      ]
    },
    {
      "id": "msg_0663_00006",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}?\n",
        "Guten Abend!\r"
      ]
    },
    {
      "id": "msg_0663_00007",
      "de_DE": [
        "Hallo? Hier ist Lyra!\n",
        "Guten Morgen!\r"
      ]
    },
    {
      "id": "msg_0663_00008",
      "de_DE": [
        "Hallo? Hier ist Lyra!\n",
        "Guten Tag!\r"
      ]
    },
    {
      "id": "msg_0663_00009",
      "de_DE": [
        "Hallo? Hier ist Lyra!\n",
        "Guten Abend!\r"
      ]
    },
    {
      "id": "msg_0663_00010",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}, mein Vater sagt, dass du\n",
        "einmal ein großartiger Trainer würdest!\r",
        "Naja, er hält sich aber selbst auch für\n",
        "einen Professor mit einem Auge\f",
        "für so etwas!\r",
        "Manchmal nervt mich das schon!\n",
        "Gib auf dich acht!\f",
        "Bis bald!"
      ]
    },
    {
      "id": "msg_0663_00011",
      "de_DE": [
        "Neulich hat mein MARILL wie ein\n",
        "Putzlumpen gestunken!\f",
        "Was für ein Schock!\r",
        "Ab jetzt werde ich es immer ganz\n",
        "gründlich waschen!\r",
        "Bis dann!\n",
        "Bye-bye!"
      ]
    },
    {
      "id": "msg_0663_00012",
      "de_DE": [
        "Als ich neulich mit MARILL unterwegs war\n",
        "und mich plötzlich nach ihm umsah, hatte\f",
        "es sich doch tatsächlich zu AZUMARILL\f",
        "entwickelt!\r",
        "Kaum zu glauben, oder?\r",
        "Nun gut, {STRVAR_1 3, 0, 0}, ich warte auf\n",
        "deinen Anruf!"
      ]
    },
    {
      "id": "msg_0663_00013",
      "de_DE": [
        "Versuch einmal, ein BISASAM auf Route 1\n",
        "mitzunehmen!\r",
        "Das wird ihm sicherlich gefallen!"
      ]
    },
    {
      "id": "msg_0663_00014",
      "de_DE": [
        "Sag mal, wie wäre es, wenn du mal ein\n",
        "GLUMANDA zur Route 2 mitnimmst?\r",
        "Ich habe gehört, dass GLUMANDA diese\n",
        "Gegend sehr mögen!"
      ]
    },
    {
      "id": "msg_0663_00015",
      "de_DE": [
        "Ich habe gehört, dass SCHIGGY ins\n",
        "Stolpern geraten, wenn du sie auf\f",
        "Route 3 mitnimmst!"
      ]
    },
    {
      "id": "msg_0663_00016",
      "de_DE": [
        "Apropos: An Route 4 liegt doch der\n",
        "Mondberg, nicht wahr?\r",
        "Wenn mich nicht alles täuscht, mögen\n",
        "PIEPI den Mondberg gerne!"
      ]
    },
    {
      "id": "msg_0663_00017",
      "de_DE": [
        "Du kennst doch das Dojo von Saffronia\n",
        "City, oder?\r",
        "Alle Pokémon, die dort gewesen sind,\n",
        "waren ziemlich überrascht!"
      ]
    },
    {
      "id": "msg_0663_00018",
      "de_DE": [
        "Als ich im Hafen von Orania City war,\n",
        "haben meine Pokémon sich sehr gefreut,\f",
        "als sie an Bord der M.S. Aqua gehen\f",
        "konnten!"
      ]
    },
    {
      "id": "msg_0663_00019",
      "de_DE": [
        "Soweit ich weiß, sollen PORYGON ein\n",
        "seltsames Geräusch von sich geben,\f",
        "wenn man sie in Prismania City\f",
        "herumführt."
      ]
    },
    {
      "id": "msg_0663_00020",
      "de_DE": [
        "Du kennst doch Mr. Psycho aus\n",
        "Saffronia City, nicht wahr?\r",
        "Was wäre wohl, wenn du ein\n",
        "Psycho-Pokémon zu ihm mitnimmst?"
      ]
    },
    {
      "id": "msg_0663_00021",
      "de_DE": [
        "Bist du schon einmal zum Felstunnel\n",
        "gegangen?\r",
        "ONIX freuen sich bestimmt, wenn du sie\n",
        "dorthin mitnimmst!"
      ]
    },
    {
      "id": "msg_0663_00022",
      "de_DE": [
        "Solltest du einmal zum Kraftwerk gehen,\n",
        "dann nimm PIKACHU mit.\r",
        "Das wird bestimmt lustig!"
      ]
    },
    {
      "id": "msg_0663_00023",
      "de_DE": [
        "Hör mal, in der Nähe von Route 11 liegt\n",
        "doch DIGDAs Höhle, nicht wahr?\r",
        "Welche Pokémon du dorthin mitnehmen\n",
        "solltest, muss ich dir ja wohl nicht\f",
        "extra sagen, oder?"
      ]
    },
    {
      "id": "msg_0663_00024",
      "de_DE": [
        "Wo bist du gerade? In der Nähe von\n",
        "Route 12?\r",
        "Ah!\n",
        "Dann solltest du zum Waisenhaus von\f",
        "Lavandia gehen. Das wird dir bestimmt\f",
        "gefallen!"
      ]
    },
    {
      "id": "msg_0663_00025",
      "de_DE": [
        "Wo bist du gerade? In der Nähe von\n",
        "Route 13?\r",
        "Der Weg dort gleicht einem Labyrinth,\n",
        "nicht wahr?\r",
        "Vielleicht wirken die Pokémon dort daher\n",
        "auch ein bisschen verloren und hilflos."
      ]
    },
    {
      "id": "msg_0663_00026",
      "de_DE": [
        "Bist du jetzt gerade in der Nähe von\n",
        "Route 14?\r",
        "Die Landschaft dort ist schön,\n",
        "nicht wahr? Mit all den Windrädern!"
      ]
    },
    {
      "id": "msg_0663_00027",
      "de_DE": [
        "Wo bist du gerade? Route 15?\n",
        "Wenn ja, dann statte doch dem Wärter\f",
        "des Parks der Freunde in Fuchsania City\f",
        "einen Besuch ab!\r",
        "Zu Hause hat er ganz viele GRIFFEL, das\n",
        "wird bestimmt lustig!"
      ]
    },
    {
      "id": "msg_0663_00028",
      "de_DE": [
        "Du bist gerade auf Route 16?\n",
        "Das heißt also, dass du ganz in der Nähe\f",
        "des Radweges bist, nicht wahr?\r",
        "Es gibt nichts Schöneres, als dort mit\n",
        "seinen Pokémon entlangzufahren!\f",
        "Aber es ist nicht ganz ungefährlich!"
      ]
    },
    {
      "id": "msg_0663_00029",
      "de_DE": [
        "Du bist gerade auf Route 17?\n",
        "Das heißt also, dass du genau auf dem\f",
        "Radweg bist, nicht wahr?\r",
        "Es gibt nichts Schöneres, als dort mit\n",
        "seinen Pokémon entlangzufahren!\f",
        "Aber es ist nicht ganz ungefährlich!"
      ]
    },
    {
      "id": "msg_0663_00030",
      "de_DE": [
        "Du bist gerade auf Route 18?\n",
        "Das heißt also, dass du ganz in der Nähe\f",
        "des Radweges bist, nicht wahr?\r",
        "Es gibt nichts Schöneres, als dort mit\n",
        "seinen Pokémon entlangzufahren!\f",
        "Aber es ist nicht ganz ungefährlich!"
      ]
    },
    {
      "id": "msg_0663_00031",
      "de_DE": [
        "Also, wenn ich zur Route 19 gehen\n",
        "würde, dann würde ich dort mit meinen\f",
        "Pokémon im Wasser planschen!\f",
        "Das ist so angenehm!"
      ]
    },
    {
      "id": "msg_0663_00032",
      "de_DE": [
        "Es scheint, dass Feuer-Pokémon sich\n",
        "nur ungern am Ufer aufhalten...\f",
        "Das kann ich gut nachvollziehen!"
      ]
    },
    {
      "id": "msg_0663_00033",
      "de_DE": [
        "Zusammen mit seinem Pokémon den\n",
        "Sonnenuntergang bei Route 21\f",
        "betrachten...\f",
        "Hehehe!\f",
        "Das ist schon ganz schön romantisch!"
      ]
    },
    {
      "id": "msg_0663_00034",
      "de_DE": [
        "Route 22 führt doch zur Pokémon Liga,\n",
        "nicht wahr?\r",
        "Die Pokémon sind sicherlich nervös, wenn\n",
        "sie da entlanglaufen.."
      ]
    },
    {
      "id": "msg_0663_00035",
      "de_DE": [
        "Die Brücke an der Route 24 wird\n",
        "Goldballbrücke genannt.\r",
        "Das ist zwar kein offizieller Name, aber\n",
        "viele Menschen nennen sie so.\r",
        "Die Sonnenstrahlen werden dort vom\n",
        "Wasser reflektiert - es blendet einen\f",
        "richtig!"
      ]
    },
    {
      "id": "msg_0663_00036",
      "de_DE": [
        "Also, ich persönlich glaube ja, dass\n",
        "Pokémon gar keine Ahnung haben, wie\f",
        "sie selbst eigentlich aussehen.\r",
        "Wie sie wohl reagieren werden, wenn sie\n",
        "ihr eigenes Spiegelbild in der Pfütze auf\f",
        "der Route 25 entdecken?"
      ]
    },
    {
      "id": "msg_0663_00037",
      "de_DE": [
        "Entlang der Route 26 hat sich noch sehr\n",
        "viel unberührte Natur erhalten, was\f",
        "den Pokémon eigentlich sehr gefallen\f",
        "sollte.\r",
        "Da diese Route aber gleichzeitig auch\n",
        "zur Pokémon Liga führt, dürften sie\f",
        "sicherlich sehr aufgeregt sein..."
      ]
    },
    {
      "id": "msg_0663_00038",
      "de_DE": [
        "Ein Pokémon soll auf der Route 27\n",
        "irgendetwas aufgesammelt haben.\r",
        "Wie wäre es, wenn du einmal ein dir sehr\n",
        "nahestehendes Pokémon dorthin\f",
        "mitnimmst?"
      ]
    },
    {
      "id": "msg_0663_00039",
      "de_DE": [
        "Route 28 führt doch zum Silberberg,\n",
        "nicht wahr?\r",
        "Da werden die Pokémon sicherlich auch\n",
        "ein wenig Bammel haben..."
      ]
    },
    {
      "id": "msg_0663_00040",
      "de_DE": [
        "Warum nimmst du nicht einmal ENDIVIE mit\n",
        "auf Route 29?\r",
        "Das wird ihm sicher gefallen!"
      ]
    },
    {
      "id": "msg_0663_00041",
      "de_DE": [
        "Warum nimmst du nicht einmal KARNIMANI\n",
        "mit auf Route 30?\r",
        "Das wird ihm sicher gefallen!"
      ]
    },
    {
      "id": "msg_0663_00042",
      "de_DE": [
        "Nimm doch einmal ein FEURIGEL mit auf\n",
        "Route 31! Das könnte interessant\f",
        "werden!\r",
        "Ich habe nämlich gehört, dass FEURIGEL\n",
        "diese Gegend mögen!"
      ]
    },
    {
      "id": "msg_0663_00043",
      "de_DE": [
        "Hör mal! In den Alph-Ruinen lassen sich\n",
        "doch ICOGNITO finden, nicht wahr?\f",
        "Solltest du schon eines besitzen, dann\f",
        "nimm es doch einfach einmal dorthin mit!"
      ]
    },
    {
      "id": "msg_0663_00044",
      "de_DE": [
        "Auf Route 33 regnet es doch\n",
        "ununterbrochen, nicht wahr?\r",
        "Ich blase ja an Regentagen stets\n",
        "Trübsal... aber es gibt auch Pokémon,\f",
        "die den Regen geradezu lieben!\r",
        "Zum Beispiel KARNIMANI!"
      ]
    },
    {
      "id": "msg_0663_00045",
      "de_DE": [
        "Offenbar übt der Steineichenwald auf\n",
        "PORENTA eine so große Faszination aus,\f",
        "dass sie ganz aus dem Häuschen sind.\r",
        "Ich werde demnächst auch einmal ein\n",
        "PORENTA dorthin mitnehmen!"
      ]
    },
    {
      "id": "msg_0663_00046",
      "de_DE": [
        "Wusstest du das schon?\n",
        "Die Teilnahme am Pokéathlon macht\f",
        "deinen Pokémon Spaß und hält sie auf\f",
        "Trab! Ich werde meine demnächst auch\f",
        "einmal dorthin mitnehmen!"
      ]
    },
    {
      "id": "msg_0663_00047",
      "de_DE": [
        "Nimm einmal MOGELBAUM mit auf Route 36!\n",
        "Das wird sehr interessant!\r",
        "Inwiefern? \n",
        "Nun, das musst du schon selbst\f",
        "herausfinden..."
      ]
    },
    {
      "id": "msg_0663_00048",
      "de_DE": [
        "Hast du auf Route 37 schon einmal die\n",
        "Zwillinge getroffen?\r",
        "Bei den Pokémon sind sie sehr beliebt!\n",
        "Aber sie sind ja auch wirklich reizend!"
      ]
    },
    {
      "id": "msg_0663_00049",
      "de_DE": [
        "Neulich habe ich TAUROS auf die\n",
        "Kuhmuh-Farm mitgenommen...\r",
        "Das war vielleicht ein Durcheinander,\n",
        "kann ich dir sagen!"
      ]
    },
    {
      "id": "msg_0663_00050",
      "de_DE": [
        "Nimm doch einmal MILTANK mit auf\n",
        "Route 39!\r",
        "Es wird dort viele Freunde treffen und\n",
        "sich prächtig amüsieren!"
      ]
    },
    {
      "id": "msg_0663_00051",
      "de_DE": [
        "Versuch einmal, ein QUAPSEL auf\n",
        "Route 40 mitzunehmen!\r",
        "Das könnte interessant werden!"
      ]
    },
    {
      "id": "msg_0663_00052",
      "de_DE": [
        "Wasser-Pokémon können vom Meer gar\n",
        "nicht genug bekommen!\r",
        "Es macht mich immer wieder froh, sie\n",
        "so glücklich und zufrieden zu sehen!"
      ]
    },
    {
      "id": "msg_0663_00053",
      "de_DE": [
        "Route 42 ist sehr bergig, nicht wahr?\n",
        "Gestein-Pokémon sollte es daher dort\f",
        "besonders gut gefallen!"
      ]
    },
    {
      "id": "msg_0663_00054",
      "de_DE": [
        "Wenn du KARPADOR in Topform sehen\n",
        "möchtest, dann geh mit ihm zum\f",
        "See des Zorns!"
      ]
    },
    {
      "id": "msg_0663_00055",
      "de_DE": [
        "Du bist jetzt gerade auf Route 44,\n",
        "stimmt’s? Sag schon, habe ich recht?\r",
        "Es ist ziemlich kalt dort!\n",
        "Kälteempfindliche Pokémon können einem\f",
        "da schon leidtun!\r",
        "Eis-Pokémon hingegen werden sich\n",
        "bestimmt wohlfühlen!"
      ]
    },
    {
      "id": "msg_0663_00056",
      "de_DE": [
        "Der im Zickzack verlaufende Kurs des\n",
        "Flusses bei Route 45 ist wirklich nett\f",
        "anzusehen!\r",
        "Als ich neulich mit meinen Pokémon dort\n",
        "war, waren sie alle vom Anblick des\f",
        "Flusses hingerissen!"
      ]
    },
    {
      "id": "msg_0663_00057",
      "de_DE": [
        "An Route 46 steht viel hohes Gras,\n",
        "nicht wahr?\f",
        "Meine Pokémon und ich sind stets ein\f",
        "wenig besorgt... man weiß nie, wann sich\f",
        "ein wildes Pokémon zeigt!"
      ]
    },
    {
      "id": "msg_0663_00058",
      "de_DE": [
        "Die Landschaft bei Route 47 ist schon\n",
        "fantastisch, oder?\r",
        "Apropos...\n",
        "Kennst du DITTO?\r",
        "Sie sollen die Gegend um Route 47 sehr\n",
        "mögen...\f",
        "Seltsam..."
      ]
    },
    {
      "id": "msg_0663_00059",
      "de_DE": [
        "In der Nähe von Route 48 gibt es doch\n",
        "eine hohe Klippe, nicht wahr?\r",
        "Die Pokémon scheinen ziemliche Angst zu\n",
        "haben, wenn sie dort vorbeigehen!\r",
        "Ob ich auch?\n",
        "Nein, ich habe überhaupt keine\f",
        "Höhenangst!"
      ]
    },
    {
      "id": "msg_0663_00060",
      "de_DE": [
        "Wo bist du gerade?\n",
        "In Alabastia? Mit anderen Worten: Dort,\f",
        "wo Professor Eich lebt, nicht wahr?\r",
        "Alle Pokémon lieben den Professor!\n",
        "Nimm doch deine Pokémon mit zu ihm ins\f",
        "Forschungslabor!"
      ]
    },
    {
      "id": "msg_0663_00061",
      "de_DE": [
        "Wo bist du gerade? In Vertania City? Da\n",
        "gibt es doch das Trainer-Haus, nicht?\r",
        "Es scheint, als würden die Pokémon zur\n",
        "Höchstform auflaufen, wenn sie dorthin\f",
        "gehen!"
      ]
    },
    {
      "id": "msg_0663_00062",
      "de_DE": [
        "Wo bist du gerade?\n",
        "In der Nähe von Vertania City?\f",
        "Ach so, Marmoria City?\r",
        "In Marmoria City gibt es doch ein\n",
        "Museum, nicht wahr?\r",
        "Es macht wirklich Spaß, dem Museum\n",
        "zusammen mit seinen Pokémon einen\f",
        "Besuch abzustatten!"
      ]
    },
    {
      "id": "msg_0663_00063",
      "de_DE": [
        "Hm, wo bist du gerade?\n",
        "In Azuria City?\r",
        "Hast du dort übrigens Misty getroffen,\n",
        "die Arenaleiterin der Stadt?\r",
        "Ähm, schon gut! Ist nicht so wichtig.\n",
        "Ich musste nur gerade daran denken..."
      ]
    },
    {
      "id": "msg_0663_00064",
      "de_DE": [
        "Wo bist du gerade?\n",
        "In Lavandia?\f",
        "Dann bist du aber weit gekommen!\r",
        "Dort gibt es doch das Haus der Erinne-\n",
        "rungen mit den Grabmalen dahingegange-\f",
        "ner Pokémon, nicht wahr?\r",
        "Als Trainer solltest du mit deinen\n",
        "Pokémon einmal dorthin gehen!"
      ]
    },
    {
      "id": "msg_0663_00065",
      "de_DE": [
        "Wo bist du gerade? In Orania City?\r",
        "Wenn mich nicht alles täuscht, gibt es\n",
        "dort doch den Pokémon Fan Club, oder?\r",
        "Warum gehst du nicht dorthin und sagst\n",
        "LORBLATT einmal Guten Tag?"
      ]
    },
    {
      "id": "msg_0663_00066",
      "de_DE": [
        "Wo bist du gerade?\n",
        "Oh! In Prismania City?\r",
        "Ich habe einmal TANGELA in die dortige\n",
        "Arena mitgenommen und es hat sich sehr\f",
        "gefreut!\r",
        "Versuch es doch auch einmal!"
      ]
    },
    {
      "id": "msg_0663_00067",
      "de_DE": [
        "Wo bist du gerade? In Fuchsania City?\n",
        "Du bist ja immer woanders!\r",
        "TAUROS sollen in dieser Stadt stets\n",
        "sehr aufgeregt sein!\r",
        "Ich kann mir zwar nicht denken, weshalb\n",
        "das so ist, aber es könnte interessant\f",
        "sein, einmal ein TAUROS dorthin\f",
        "mitzunehmen!"
      ]
    },
    {
      "id": "msg_0663_00068",
      "de_DE": [
        "Wo bist du gerade? Auf der\n",
        "Zinnoberinsel? Unglaublich!!\r",
        "Von jener unter Lava begrabenen Stadt\n",
        "aus das Meer betrachten...\f",
        "Zusammen mit seinen Pokémon...\r",
        "Wäre das nicht die perfekte\n",
        "Schlussszene für einen Film?"
      ]
    },
    {
      "id": "msg_0663_00069",
      "de_DE": [
        "Als mein Bekannter zum Indigo Plateau\n",
        "aufbrach, sollen die Pokémon, die bei ihm\f",
        "waren, bester Stimmung gewesen und\f",
        "sogar ein bisschen übermütig geworden\f",
        "sein!"
      ]
    },
    {
      "id": "msg_0663_00070",
      "de_DE": [
        "Wo bist du gerade?\n",
        "In Saffronia City?\r",
        "Steht dort nicht das Haus der\n",
        "Nachahmerin?\f",
        "Nimm einmal PANTIMIMI mit zu ihr!\r",
        "Das könnte interessant werden!"
      ]
    },
    {
      "id": "msg_0663_00071",
      "de_DE": [
        "Wo bist du gerade?\n",
        "Wie bitte? Neuborkia?\r",
        "Bist du nach Hause zurückgekehrt?\n",
        "Denk daran, deiner Mutter deine\f",
        "Pokémon vorzustellen!"
      ]
    },
    {
      "id": "msg_0663_00072",
      "de_DE": [
        "Wo bist du gerade? In Rosalia City?\n",
        "Bei Rosalia City muss ich immer an den\f",
        "Strand denken!\r",
        "Was gibt es Angenehmeres, als mit\n",
        "seinen Pokémon beim Klang der Wellen\f",
        "die Dünen entlangzulaufen!"
