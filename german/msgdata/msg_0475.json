{
  "key": 18235,
  "messages": [
    {
      "id": "msg_0475_00000",
      "de_DE": [
        "Ein beeindruckendes Gebäude, was?\n",
        "Das ist der Radioturm von Kanto!"
      ]
    },
    {
      "id": "msg_0475_00001",
      "de_DE": [
        "In Kanto laufen viele gute\n",
        "Sendungen im Radio!"
      ]
    },
    {
      "id": "msg_0475_00002",
      "de_DE": [
        "Die Leute kommen von überallher,\n",
        "um hier den Seelen dahingegangener\f",
        "Pokémon Respekt zu erweisen."
      ]
    },
    {
      "id": "msg_0475_00003",
      "de_DE": [
        "Um schlafende Pokémon zu wecken, ist\n",
        "eine Pokéflöte immer noch am besten!\f",
        "Jeder Trainer sollte das wissen!"
      ]
    },
    {
      "id": "msg_0475_00004",
      "de_DE": [
        "Lavandia\n",
        "Stadt des gewissen Etwas"
      ]
    },
    {
      "id": "msg_0475_00005",
      "de_DE": [
        "Der Radioturm von Kanto\n",
        "Rund um die Uhr auf Sendung!"
      ]
    },
    {
      "id": "msg_0475_00006",
      "de_DE": [
        "Ehrenamtlich betriebenes\n",
        "Waisenhaus für Pokémon\n"
      ]
    },
    {
      "id": "msg_0475_00007",
      "de_DE": [
        "Haus der Erinnerungen\n",
        "Mögen die Seelen der Pokémon\f",
        "hier in Frieden ruhen"
      ]
    }
  ]
}
