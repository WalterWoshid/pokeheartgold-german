{
  "key": 42010,
  "messages": [
    {
      "id": "msg_0260_00000",
      "de_DE": [
        "Kapitän, spielst du mit mir?\r",
        "Mir ist langweilig!\n",
        "Ich will spiiieeelen!\r"
      ]
    },
    {
      "id": "msg_0260_00001",
      "de_DE": [
        "Hä? Heißt das, du spielst\n",
        "mit mir, und nicht er?!\r",
        "Klasse! Dann spielen wir\n",
        "zusammen Verstecken!\f",
        "Los, mach die Augen zu!\r"
      ]
    },
    {
      "id": "msg_0260_00002",
      "de_DE": [
        "Hä? Heißt das, du spielst\n",
        "mit mir, und nicht er?!\r",
        "Klasse! Dann spielen wir\n",
        "zusammen Verstecken!\f",
        "Los, mach die Augen zu!\r"
      ]
    },
    {
      "id": "msg_0260_00003",
      "de_DE": [
        "Hä? Heißt das, du spielst\n",
        "mit mir, und nicht er?!\r",
        "Klasse! Dann spielen wir\n",
        "zusammen Verstecken!\f",
        "Los, mach die Augen zu!\r"
      ]
    },
    {
      "id": "msg_0260_00004",
      "de_DE": [
        "Dieses Mädchen liegt mir die ganze\n",
        "Zeit in den Ohren, dass es mit mir\f",
        "spielen will!\r",
        "Auauau! Lass doch bitte mein Ohr los!"
      ]
    },
    {
      "id": "msg_0260_00005",
      "de_DE": [
        "Danke, dass du für mich mit ihr spielst!\r",
        "Es mag vielleicht so aussehen, als ob\n",
        "ich untätig in der Gegend stehe, aber\f",
        "als Kapitän hat man wirklich viel zu tun!\r",
        "Unser niedlicher kleiner Passagier hat\n",
        "diesen Raum verlassen, aber irgendwo\f",
        "wirst du ihr Versteck schon finden!\r",
        "Sie muss irgendwo auf diesem Schiff sein."
      ]
    },
    {
      "id": "msg_0260_00006",
      "de_DE": [
        "Hat dir die Fahrt mit der\n",
        "M.S. Aqua gefallen?\r",
        "Sie gleitet regelrecht\n",
        "über die Wellen, was?"
      ]
    },
    {
      "id": "msg_0260_00007",
      "de_DE": [
        "Oh, lange nicht gesehen! Wie geht’s dir?\n",
        "Die M.S. Aqua ist wie immer in Topform!\r",
        "Ach ja, ich war neulich in Sinnoh\n",
        "unterwegs und habe dabei etwas sehr\f",
        "Auffälliges gefunden!\r",
        "Hier, nimm du es! Wo du schon einmal\n",
        "hier bist...\r"
      ]
    },
    {
      "id": "msg_0260_00008",
      "de_DE": [
        "Oh, dein Beutel ist voll?\r",
        "{STRVAR_1 8, 1, 0}... du scheinst dieses\n",
        "Item wirklich sehr zu mögen!"
      ]
    }
  ]
}
