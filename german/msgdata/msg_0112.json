{
  "key": 25710,
  "messages": [
    {
      "id": "msg_0112_00000",
      "de_DE": [
        "He da!\n",
        "Ein Eindringling! Alarm!\r"
      ]
    },
    {
      "id": "msg_0112_00001",
      "de_DE": [
        "Als Nächster bin ich dran!\n",
        "Es gibt kein Entkommen!\r"
      ]
    },
    {
      "id": "msg_0112_00002",
      "de_DE": [
        "Eine SNOBILIKAT-Statue.\n",
        "Ihre Augen leuchten rot.\r",
        "Du fühlst dich auf eine\n",
        "unbestimmte Art beobachtet..."
      ]
    },
    {
      "id": "msg_0112_00003",
      "de_DE": [
        "Eine SNOBILIKAT-Statue.\n",
        "Ihre Augen leuchten blau.\r",
        "Das Gefühl, dass dich irgendwer\n",
        "beobachtet, ist verschwunden."
      ]
    },
    {
      "id": "msg_0112_00004",
      "de_DE": [
        "Eine SNOBILIKAT-Statue.\n",
        "Ihre Augen leuchten nicht mehr."
      ]
    },
    {
      "id": "msg_0112_00005",
      "de_DE": [
        "Sieh mal an! Ein geheimer Schalter!\r",
        "Das rote Lämpchen darauf\n",
        "blinkt verdächtig.\f",
        "Schalter betätigen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0112_00006",
      "de_DE": [
        "Sieh mal an! Ein geheimer Schalter!\r",
        "Das rote Lämpchen darauf\n",
        "leuchtet ruhig und beständig.\f",
        "Schalter betätigen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0112_00007",
      "de_DE": "...Klick!\r"
    },
    {
      "id": "msg_0112_00008",
      "de_DE": [
        "Der geheime Schalter hat\n",
        "aufgehört zu leuchten..."
      ]
    },
    {
      "id": "msg_0112_00009",
      "de_DE": [
        "Die Überwachungsanlage\n",
        "ist nun inaktiv!"
      ]
    },
    {
      "id": "msg_0112_00010",
      "de_DE": [
        "Die Überwachungsanlage\n",
        "ist nun aktiv!"
      ]
    }
  ]
}
