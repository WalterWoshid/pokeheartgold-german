{
  "key": 37911,
  "messages": [
    {
      "id": "msg_0457_00000",
      "de_DE": [
        "Willkommen im Trainer-Haus, der\n",
        "neuen Attraktion von Vertania City!\f",
        "An diesem Ort können sich Trainer\f",
        "untereinander austauschen.\r",
        "Im Untergeschoss steht auch eine\n",
        "Übungshalle für Kämpfe bereit!"
      ]
    },
    {
      "id": "msg_0457_00001",
      "de_DE": [
        "Vertania City ist die Stadt, die dem\n",
        "Indigo Plateau am nächsten liegt.\r",
        "Dieser Ort wurde speziell für die vielen\n",
        "Trainer gebaut, die hier auf ihrem Weg\f",
        "zum Indigo Plateau vorbeikommen."
      ]
    },
    {
      "id": "msg_0457_00002",
      "de_DE": [
        "Hier unten in der Übungshalle werden\n",
        "Trainingskämpfe abgehalten.\r",
        "Zeige mir doch mal, was die Trainer\n",
        "in Johto so alles draufhaben!"
      ]
    },
    {
      "id": "msg_0457_00003",
      "de_DE": [
        "Wenn du viel herumkommst und gegen\n",
        "verschiedene Trainer antrittst, hilft\f",
        "dir das nicht nur dabei, deine Pokémon\f",
        "zu trainieren. Nein!\r",
        "Du bereicherst damit auch deinen\n",
        "ganz persönlichen Erfahrungsschatz!\r",
        "Auch der Champ von Alabastia hat sicher\n",
        "einmal alle Städte in Kanto bereist."
      ]
    },
    {
      "id": "msg_0457_00004",
      "de_DE": [
        "Uff...\r",
        "Ich habe erst einmal genug vom Kämpfen.\n",
        "Jetzt ruhe ich mich hier ein wenig aus."
      ]
    },
    {
      "id": "msg_0457_00005",
      "de_DE": [
        "In der Übungshalle im Untergeschoss\n",
        "werden Trainingskämpfe abgehalten.\f",
        "Wer sich seiner Sache sicher ist,\f",
        "darf jederzeit an ihnen teilnehmen.\r",
        "Nimmst du über den Pokéwalker mit einem\n",
        "Freund Verbindung auf, kannst du ihn\f",
        "außerdem in die Übungshalle rufen!\r",
        "Aber sei vorsichtig! Wenn du dich\n",
        "bereits im Untergeschoss aufhältst,\f",
        "während du mit ihm Kontakt aufnimmst,\f",
        "wird er dort nämlich nicht auftauchen!"
      ]
    },
    {
      "id": "msg_0457_00006",
      "de_DE": [
        "Die Regeln des Trainer-Hauses\r",
        "1. Pro Person ist jeden Tag ein Trainer-\n",
        "    kampf zulässig\r",
        "2. Die Werte von PKMN über Level 50\n",
        "    werden für den Kampf auf ein Niveau\f",
        "    abgestuft, das Level 50 entspricht\r",
        "3. Items aus dem Beutel können nicht\n",
        "    eingesetzt werden\r",
        "4. Heilst du nach jedem Kampf, erhalten\n",
        "    deine PKMN auch ihre Items zurück\r",
        "5. Auch für einen gewonnenen Kampf\n",
        "    erhalten Trainer keine E.-Punkte\r",
        "6. Der Sieger eines Kampfes erhält\n",
        "    stattdessen Gewinnpunkte\r",
        "Wer sich seiner Sache sicher ist,\n",
        "darf jederzeit teilnehmen!"
      ]
    },
    {
      "id": "msg_0457_00007",
      "de_DE": [
        "...Was haben wir denn hier?\n",
        "Eine strategische Notiz?\r",
        "Die Schrift sieht so aus, als sei\n",
        "ein Onix darüberspaziert.\f",
        "Völlig unlesbar..."
      ]
    }
  ]
}
