{
  "key": 62543,
  "messages": [
    {
      "id": "msg_0073_00000",
      "de_DE": [
        "Oooh!\r",
        "Und wieder ist die Archäologie um einen\n",
        "vielversprechenden jungen Menschen\f",
        "reicher, der sich auf ihre Pfade begibt!\r"
      ]
    },
    {
      "id": "msg_0073_00001",
      "de_DE": [
        "Was sagst du? Du bist nur ein Tourist?\n",
        "A-ach so...\f",
        "Da habe ich mich wohl zu früh gefreut."
      ]
    },
    {
      "id": "msg_0073_00002",
      "de_DE": [
        "Ich habe ein sehr fähiges Team hier\n",
        "an meiner Ausgrabungsstätte!\f",
        "Die Forschungsarbeiten gehen auch ganz\f",
        "ohne mein Zutun in Windeseile voran!\r",
        "Wenn du zu irgendetwas eine Frage hast,\n",
        "wende dich damit einfach an jemanden\f",
        "aus meinem Team!"
      ]
    },
    {
      "id": "msg_0073_00003",
      "de_DE": [
        "Toll! Dank deiner Mithilfe\n",
        "sind nun fast alle Geheimnisse\f",
        "der ICOGNITO gelöst!\r",
        "Danke, danke, und\n",
        "nochmals danke!"
      ]
    },
    {
      "id": "msg_0073_00004",
      "de_DE": [
        "Wir wissen zwar, dass diese\n",
        "Ruinen vor ungefähr\f",
        "1 500 Jahren errichtet wurden...\r",
        "... aber noch nicht, von wem\n",
        "und zu welchem Zweck."
      ]
    },
    {
      "id": "msg_0073_00005",
      "de_DE": [
        "Was! Du hast ein ICOGNITO gefangen?\n",
        "Das ist echt unglaublich!\r",
        "Aber...\n",
        "wo kamen diese Pokémon bloß\f",
        "so urplötzlich her?"
      ]
    },
    {
      "id": "msg_0073_00006",
      "de_DE": [
        "Das musst du dir anhören! Wir haben\n",
        "eine unglaubliche Entdeckung gemacht!\r",
        "Die ICOGNITO sind deshalb hier\n",
        "erschienen, weil du das Puzzle mit den\f",
        "Steintafeln gelöst hast!\r",
        "Ergo: Diese Steintafeln sind Schlüssel,\n",
        "mit denen sich die ICOGNITO aus ihrem\f",
        "Schlaf erwecken lassen!\r",
        "Aber... wozu hat man überhaupt erst\n",
        "so einen Schlüssel gebraucht?\r"
      ]
    },
    {
      "id": "msg_0073_00007",
      "de_DE": [
        "Das musst du dir anhören! Wir haben\n",
        "eine unglaubliche Entdeckung gemacht!\r",
        "Offensichtlich empfängt man mysteriöse\n",
        "Wellen, wenn man in den Ruinen sein\f",
        "Radio einschaltet!\r",
        "Das ist der Beweis dafür, dass die\n",
        "ICOGNITO mit elektrischen Wellen\f",
        "untereinander kommunizieren!\r"
      ]
    },
    {
      "id": "msg_0073_00008",
      "de_DE": [
        "Das musst du dir anhören! Wir haben\n",
        "eine unglaubliche Entdeckung gemacht!\r",
        "Wir wissen nun, dass sich die Zahl der\n",
        "unterschiedlichen ICOGNITO mit der\f",
        "dieser Schriftzeichen genau deckt!\r",
        "Bisher konnten wir 26 verschiedene\n",
        "Schriftzeichen entdecken.\r",
        "Gib Vollgas und versuche, dir alle\n",
        "ICOGNITO zu schnappen!\r"
      ]
    },
    {
      "id": "msg_0073_00009",
      "de_DE": [
        "Leistet dir das Icognitoheft, das du\n",
        "von mir bekommen hast, gute Dienste?\r",
        "Wenn du ein neues ICOGNITO fängst,\n",
        "wird darin automatisch ein neuer Eintrag\f",
        "dafür angelegt. Sehr praktisch!"
      ]
    },
    {
      "id": "msg_0073_00010",
      "de_DE": [
        "Das musst du dir anhören! Wir haben\n",
        "eine unglaubliche Entdeckung gemacht!\r",
        "Wir wissen jetzt, dass es eine bestimmte\n",
        "Reihenfolge unter den ICOGNITO gibt!\f",
        "Gib mir mal eben dein Icognitoheft!\r"
      ]
    },
    {
      "id": "msg_0073_00011",
      "de_DE": [
        "Gut, fertig!\n",
        "Ich habe die ICOGNITO nun in der\f",
        "richtigen Reihenfolge neu eingetragen!\r",
        "Vielleicht führt uns das ja irgendwie\n",
        "zu einer neuen Entdeckung!\r"
      ]
    },
    {
      "id": "msg_0073_00012",
      "de_DE": [
        "Was sagst du da? Du hast in den Ruinen\n",
        "einen Raum mit ICOGNITO-Schriftzeichen\f",
        "auf dem Boden gefunden?\r",
        "Das ist eine unglaubliche Entdeckung!\n",
        "Wir werden das ebenfalls untersuchen!\r"
      ]
    },
    {
      "id": "msg_0073_00013",
      "de_DE": [
        "Das musst du dir anhören! Ich habe\n",
        "eine unglaubliche Entdeckung gemacht!\r",
        "Wir haben zwei ICOGNITO-Schriftzeichen\n",
        "entdeckt, die wir noch nicht kannten!\r",
        "Mit anderen Worten...\n",
        "irgendwo muss es noch zwei weitere\f",
        "Sorten von ICOGNITO geben!\r"
      ]
    },
    {
      "id": "msg_0073_00014",
      "de_DE": [
        "Das musst du dir anhören!\n",
        "Ich habe einige Neuigkeiten über den\f",
        "Raum mit den Schriftzeichen am Boden!\r",
        "Angeblich lebte in diesen Ruinen vor\n",
        "vielen Jahren ein Stamm von Menschen\f",
        "mit den ICOGNITO zusammen.\r",
        "Dieser Stamm war es auch, der die\n",
        "Statuen in den Gewölben anfertigte.\r",
        "Die ICOGNITO sind scheue Kreaturen und\n",
        "wollten diese Gemäuer nie verlassen.\r",
        "Dann zog es immer mehr Menschen in die\n",
        "Nähe der Ruinen, und bald hatte sich\f",
        "dort eine bunte Menge versammelt.\r",
        "Also verließ der Stamm, der dort mit den\f",
        "ICOGNITO leben wollte, die Ruinen.\r",
        "Durch unsere Nachforschungen und deine\n",
        "Unterstützung konnten wir nun all diese\f",
        "Geheimnisse lüften!\r",
        "Aber vieles bleibt uns auch jetzt\n",
        "immer noch ein Rätsel.\f",
        "Ein echter Archäologe schläft nie!\r"
      ]
    },
    {
      "id": "msg_0073_00015",
      "de_DE": [
        "Wenn wir etwas Neues entdeckt\n",
        "haben, melde ich mich bei dir!"
      ]
    },
    {
      "id": "msg_0073_00016",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} macht einen Eintrag\n",
        "in das Icognitoheft!"
      ]
    },
    {
      "id": "msg_0073_00017",
      "de_DE": [
        "Durch unsere Nachforschungen und deine\n",
        "Unterstützung konnten wir all diese\f",
        "Rätsel lösen!\r",
        "Aber vieles bleibt uns auch jetzt\n",
        "immer noch verschlossen.\f",
        "Ein echter Archäologe ruht nie!"
      ]
    },
    {
      "id": "msg_0073_00018",
      "de_DE": [
        "Die Muster an der Wand sind der\n",
        "Schlüssel zum Geheimnis der Ruinen!\r",
        "...Das ist zumindest meine Meinung."
      ]
    },
    {
      "id": "msg_0073_00019",
      "de_DE": [
        "Das Pokémon, das du da gefangen\n",
        "hast, scheint den Mustern an den\f",
        "Wänden der Ruinen zu ähneln.\r",
        "...Hmmm.\r",
        "Wenn das stimmt, muss es in den Ruinen\n",
        "noch viele andere Sorten davon geben!"
      ]
    },
    {
      "id": "msg_0073_00020",
      "de_DE": [
        "Was sagst du da? Ich sehe so aus, als\n",
        "wäre ich hier völlig untätig?\r",
        "Das ist aber gemein! Man sieht es mir\n",
        "vielleicht nicht an, aber das\f",
        "Icognitoheft war meine Erfindung!"
      ]
    },
    {
      "id": "msg_0073_00021",
      "de_DE": [
        "Die Ausgrabungen an den Alph-Ruinen.\n",
        "...Nunmehr im zehnten Jahr!"
      ]
    },
    {
      "id": "msg_0073_00022",
      "de_DE": [
        "Das mysteriöse Pokémon\n",
        "Sein Name: ICOGNITO\f",
        "Insgesamt gibt es 26 entdeckte Formen"
      ]
    },
    {
      "id": "msg_0073_00023",
      "de_DE": [
        "Forschungsbericht aus den Alph-Ruinen\r",
        "Wir widmen dieses Schriftstück dem\n",
        "Gründer unseres Forschungszentrums,\f",
        "dem ehrenwerten Professor Mimose..."
      ]
    },
    {
      "id": "msg_0073_00024",
      "de_DE": [
        "Da sind jede Menge komplizierte Bücher:\n",
        "“Die Geheimnisse uralter Zivilisationen”.\r",
        "“Eine Einführung ins Dechiffrieren”.\f",
        "“Verwitterte Ruinen”."
      ]
    }
  ]
}
