  "messages": [
    {
      "id": "msg_0604_00000",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: ... ... ...\r",
        "...Du schon wieder?\r",
        "Was stellst du dir eigentlich vor?\n",
        "Mit Verlierern wie dir gebe ich\f",
        "mich nicht ab.\r",
        "Apropos Verlierer: Die Arenaleiterin\n",
        "dieser Stadt ist gerade außer Haus.\r",
        "Sie kümmert sich wohl gerade um ein\n",
        "krankes Pokémon im Leuchtturm.\r",
        "...Hmpf! So ein Unfug!\r",
        "Ein Pokémon, das zu schwach zum\n",
        "Kämpfen ist, ist wertlos!\r",
        "Warum trainierst du nicht etwas im\n",
        "Leuchtturm?\r",
        "Wer weiß, vielleicht wird aus dir ja\n",
        "doch noch ein annehmbarer Trainer?\r"
      ]
    },
    {
      "id": "msg_0604_00001",
      "de_DE": [
        "Dunkle Straßen sind nachts gefährlich!\n",
        "Dunkle Meeresuntiefen ebenso!\r",
        "Ohne das Licht des Leuchtturms sind\n",
        "alle Schiffe auf dem Meer gefangen."
      ]
    },
    {
      "id": "msg_0604_00002",
      "de_DE": [
        "Dieses Ding da ist doch ein Pokécom!\n",
        "Wow, das ist ja sooo cool!"
      ]
    },
    {
      "id": "msg_0604_00003",
      "de_DE": [
        "Wow, du hast einen Pokédex!\n",
        "Das ist echt cool!"
      ]
    },
    {
      "id": "msg_0604_00004",
      "de_DE": [
        "Hallo, junge Trainerhoffnung!\n",
        "Die See ist wunderschön!\r",
        "Das blaue Meer,\n",
        "das Salz im Wind,\f",
        "wie schön, dass wir\f",
        "geboren sind!"
      ]
    },
