{
  "key": 5183,
  "messages": [
    {
      "id": "msg_0356_00000",
      "de_DE": [
        "Hier beginnt der Radweg.\r",
        "Mit dem Fahrrad hinunterzuzischen\n",
        "ist echt ein supertolles Gefühl!\r",
        "Viele Leute greifen zwar lieber auf\n",
        "bequemere und coolere Transportmittel\f",
        "wie die M.S. Aqua oder den Magnetzug\f",
        "zurück, aber dein Herz schlägt für\f",
        "den Drahtesel, hab ich nicht recht?"
      ]
    },
    {
      "id": "msg_0356_00001",
      "de_DE": [
        "Hey! Du da! Stehengeblieben!\r",
        "Solange du nicht auf dem Sattel\n",
        "eines Fahrrads sitzt, darfst du\f",
        "auch nicht den Radweg benutzen!\r"
      ]
    }
  ]
}
