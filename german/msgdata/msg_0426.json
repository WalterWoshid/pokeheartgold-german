    {
      "id": "msg_0426_00076",
      "de_DE": [
        "Glückwunsch, Trainer!\r",
        "In Anerkennung deiner herausragenden\n",
        "Fähigkeiten fordert dich unsere\f",
        "Kampfkoryphäe zu einem Spiel heraus.\r",
        "Dein nächstes Spiel bestreitest du\n",
        "somit gegen den Arkaden-Star.\f",
        "Keine Widerrede!\r"
      ]
    },
    {
      "id": "msg_0426_00077",
      "de_DE": [
        "Dahlia: Kein Grund zur Sorge. ♫\n",
        "Lassen wir dem Glück freie Hand.\r",
        "Das Hin und Her auf dem Spielfeld\n",
        "ist wie die Achterbahnfahrt des Lebens.\r",
        "Kein Grund zur Sorge. ♫\n",
        "Es kommt, wie es kommen muss.\r",
        "Nun aber genug davon.\n",
        "Eines weiß ich ganz sicher.\r",
        "Du bist nicht aus purem Glück\n",
        "bis hierher gekommen.\r",
        "Verschwenden wir keine Zeit.\n",
        "Lass mich dein Können selbst testen!\r"
      ]
    },
    {
      "id": "msg_0426_00078",
      "de_DE": [
        "Dahlia: Kein Grund zur Sorge. ♫\n",
        "Lassen wir dem Glück freie Hand.\r",
        "Das Hin und Her auf dem Spielfeld\n",
        "ist wie die Achterbahnfahrt des Lebens.\r",
        "Kein Grund zur Sorge. ♫\n",
        "Es kommt, wie es kommen muss.\r",
        "Nun aber genug davon.\n",
        "Du bist ein hervorragender Gegner.\r",
        "Bist du so gut, weil du das Pech einfach\n",
        "abschüttelst?\r",
        "Oder bist du so gut, dass dich weder\n",
        "Glück noch Pech beeinflussen können?\r",
        "Ich möchte selbst herausfinden, was\n",
        "dich heute zu mir geführt hat!\r"
      ]
    },
    {
      "id": "msg_0426_00079",
      "de_DE": [
        "Dahlia: Hervorragend gemacht!\r",
        "Deine Liebe zu Pokémon war deutlich\n",
        "zu erkennen und folglich glaubten auch\f",
        "deine Pokémon an dich.\r",
        "Daher konntest du jede Herausforde-\n",
        "rung mit Bravour meistern.\r",
        "Was für ein wundervoller Sieg!\r"
      ]
    },
    {
      "id": "msg_0426_00080",
      "de_DE": [
        "Dahlia: Das habt ihr alle wirklich\n",
        "hervorragend gemacht!\r",
        "Das Pech hast du verbannt und am Glück\n",
        "hast du festgehalten.\r",
        "Das allein ist der Beweis für deine\n",
        "Begabung.\r",
        "Dein Sieg über mich ist der bestmögliche\n",
        "Ausdruck deiner Meisterschaft!\r",
        "Ich bin sehr glücklich, dass ich diesen\n",
        "Kampf gegen dich austragen durfte!\r"
      ]
    }
