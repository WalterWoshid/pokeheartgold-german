{
  "key": 18215,
  "messages": [
    {
      "id": "msg_0452_00000",
      "de_DE": [
        "Hey, du da! Krächz... warte mal!\n",
        "Hör mir gefälligst zu!\r",
        "Ich sehe vielleicht alt aus, aber als\n",
        "ich noch jung war, war ich eine ziemlich\f",
        "große Nummer mit dem Pokéball!\r",
        "Nimmst du mir das ab, Kurzbein? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0452_00001",
      "de_DE": [
        "Na eben! Was denn auch sonst?\n",
        "Natürlich nimmst du mir das ab!"
      ]
    },
    {
      "id": "msg_0452_00002",
      "de_DE": [
        "Was? Du ungezogene Rotznase!\r",
        "Wenn ich nur etwas jünger wäre, würde\n",
        "ich dir schon zeigen, wo’s langgeht!"
      ]
    },
    {
      "id": "msg_0452_00003",
      "de_DE": [
        "Bis vor Kurzem gab es in dieser\n",
        "Pokémon-Arena keinen Leiter...\r",
        "Aber jetzt hat ein junger Mann aus\n",
        "Alabastia den Posten übernommen.\r",
        "Aber er ist gerade nicht da..."
      ]
    },
    {
      "id": "msg_0452_00004",
      "de_DE": [
        "Na? Hast du es geschafft, gegen den\n",
        "Arenaleiter zu kämpfen?"
      ]
    },
    {
      "id": "msg_0452_00005",
      "de_DE": [
        "Gähn! Ich bin in der Sonne eingenickt!\n",
        "Ich hatte einen ganz seltsamen Traum,\f",
        "in dem TRAUMATO meine Träume frisst!\f",
        "...Nanu? Wo kommt denn diese TM her?\r",
        "Schauder...\n",
        "Das gefällt mir nicht!\f",
        "Hier, nimm du diese TM!\r"
      ]
    },
    {
      "id": "msg_0452_00006",
      "de_DE": [
        "Die TM85 enthält... die Attacke...\n",
        "Traum... fresser...\f",
        "...Schnarch..."
      ]
    },
    {
      "id": "msg_0452_00007",
      "de_DE": [
        "Ich habe gehört, dass über den ganzen\n",
        "Vertania-Wald viele unsichtbare Items\f",
        "verstreut liegen!"
      ]
    },
    {
      "id": "msg_0452_00008",
      "de_DE": [
        "Vertania City\n",
        "Das Immergrüne Paradies"
      ]
    },
    {
      "id": "msg_0452_00009",
      "de_DE": [
        "Pokémon-Arena von Vertania City\n",
        "Leiter: ...\f",
        "Der Rest des Textes ist unlesbar!"
      ]
    },
    {
      "id": "msg_0452_00010",
      "de_DE": [
        "Willkommen in Vertania City,\n",
        "dem Tor zum Indigo Plateau"
      ]
    },
    {
      "id": "msg_0452_00011",
      "de_DE": [
        "Trainer-Haus\n",
        "Der Club, in dem die Top-Trainer kämpfen"
      ]
    }
  ]
}
