{
  "key": 54407,
  "messages": [
    {
      "id": "msg_0745_00000",
      "de_DE": [
        "Was? Ich war als Erster hier!\r",
        "Ich stehe hier schon die ganze Zeit an,\n",
        "um als Erster in die Kampfzone zu\f",
        "gelangen! Deshalb gönne ich mir nicht\f",
        "einmal Schlaf!\r",
        "Wenn es dir nichts ausmacht, die Nummer\n",
        "zwei zu sein, dann stell dich doch dazu!\r"
      ]
    },
    {
      "id": "msg_0745_00001",
      "de_DE": [
        "Zzzzz... ...\n",
        "...\r",
        "Er schläft im Stehen!\r"
      ]
    },
    {
      "id": "msg_0745_00002",
      "de_DE": [
        "Krrr... zzzz...\n",
        "...\r",
        "Der wacht so schnell nicht auf!"
      ]
    },
    {
      "id": "msg_0745_00003",
      "de_DE": [
        "Dieser Durchgang führt geradewegs\n",
        "zur Kampfzone.\f",
        "Wenn du dich also hier anstellst, dann\f",
        "komme ich in ziemliche Schwierigkeiten!"
      ]
    },
    {
      "id": "msg_0745_00004",
      "de_DE": [
        "Die Kampfzone ist eröffnet!\n",
        "Nur hereinspaziert!"
      ]
    }
  ]
}
