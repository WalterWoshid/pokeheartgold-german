{
  "key": 9367,
  "messages": [
    {
      "id": "msg_0140_00000",
      "de_DE": [
        "Dies ist das Zimmer des “Teamworks”.\n",
        "Das Thema, das ihm zugrunde liegt,\f",
        "lautet: “Die Geschichte des Pokéathlon\f",
        "und das gemeinsame Leben von Mensch\f",
        "und Pokémon”."
      ]
    },
    {
      "id": "msg_0140_00001",
      "de_DE": [
        "Nur Poké-Athleten, die in den\n",
        "fünf Turnieren den ersten Platz\f",
        "belegt haben, dürfen hier durch."
      ]
    },
    {
      "id": "msg_0140_00002",
      "de_DE": [
        "Hier gelangst du zum Zimmer des\n",
        "“Vertrauens”. Du darfst passieren!"
      ]
    },
    {
      "id": "msg_0140_00003",
      "de_DE": [
        "Der Pokéathlon kann auf eine lange\n",
        "Geschichte zurückblicken, was?"
      ]
    },
    {
      "id": "msg_0140_00004",
      "de_DE": [
        "Wenn du ein Turnier gewinnst, kann es\n",
        "sein, dass du dafür Medaillen erhältst!\f",
        "Versuche, alle Turniere zu meistern!\r"
      ]
    },
    {
      "id": "msg_0140_00005",
      "de_DE": [
        "Ich habe gehört, im Museum werden\n",
        "die Schuhe von besonders guten\f",
        "Poké-Athleten ausgestellt oder so!"
      ]
    },
    {
      "id": "msg_0140_00006",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} sieht sich\n",
        "die Turnierrekorde an!\r"
      ]
    },
    {
      "id": "msg_0140_00007",
      "de_DE": [
        "Das ist ein sehr altes Wandbild.\r",
        "Es sind ein Mensch und seine drei\n",
        "Pokémon darauf abgebildet, die\f",
        "Anweisungen aus dem Himmel erhalten.\n"
      ]
    },
    {
      "id": "msg_0140_00008",
      "de_DE": [
        "Da ist eine zerfledderte Schriftrolle.\r",
        "Die Legende vom Pokéathlon:\r",
        "Vor langer Zeit gab es einmal einen\n",
        "Menschen und seine drei Pokémon.\f",
        "Die Insel, auf der sie lebten, wurde von\f",
        "einer schlimmen Krankheit heimgesucht,\f",
        "daher machten sie sich auf die Suche\f",
        "nach einem Heilmittel. Auf ihrer Reise\f",
        "überwanden sie zehn Hindernisse und\f",
        "erreichten schließlich ihr Ziel..."
      ]
    },
    {
      "id": "msg_0140_00009",
      "de_DE": [
        "Da ist eine zerfledderte Schriftrolle.\r",
        "Die Entstehung des Pokéathlon:\r",
        "Der Mensch und seine drei Pokémon,\n",
        "die das Heilmittel gefunden hatten,\f",
        "wurden für das, was ihre Freundschaft\f",
        "vollbracht hatte, gefeiert und gingen\f",
        "als Helden in die Geschichte ein.\r",
        "... ... ...\r",
        "Und schließlich begannen die Menschen\n",
        "damit, ihre Helden zu ehren, indem sie\f",
        "die zehn Hindernisse, die sie bestanden\f",
        "hatten, nachahmten..."
      ]
    },
    {
      "id": "msg_0140_00010",
      "de_DE": "RATTFRATZ: Ratt! Ratt!"
    },
    {
      "id": "msg_0140_00011",
      "de_DE": "RATTFRATZ: Fratz!"
    },
    {
      "id": "msg_0140_00012",
      "de_DE": "ZUBAT: Zuuu!"
    },
    {
      "id": "msg_0140_00013",
      "de_DE": [
        "Die Ehrenhalle des Pokéathlon...\r",
        "Hier werden viele Poké-Athleten\n",
        "und ihre prämierten Pokémon\f",
        "über Fotos vorgestellt."
      ]
    }
  ]
}
