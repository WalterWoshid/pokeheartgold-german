    },
    {
      "id": "msg_0190_00001",
      "de_DE": [
        "Lind: Entscheidest du dich für\n",
        "{COLOR 3}ENDIVIE{COLOR 0}, das Pflanzen-Pokémon?"
      ]
    },
    {
      "id": "msg_0190_00002",
      "de_DE": [
        "Lind: Willst du {COLOR 1}FEURIGEL{COLOR 0}, das\n",
        "Feuer-Pokémon?"
      ]
    },
    {
      "id": "msg_0190_00003",
      "de_DE": [
