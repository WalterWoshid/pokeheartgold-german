{
  "key": 19247,
  "messages": [
    {
      "id": "msg_0629_00000",
      "de_DE": [
        "Es tut mir wirklich sehr leid...\r",
        "Sandra, unsere Arenaleiterin, meinte,\n",
        "sie habe etwas in der Drachenhöhle\f",
        "hinter der Pokémon-Arena zu erledigen.\r",
        "Wann sie wohl wiederkommt?"
      ]
    },
    {
      "id": "msg_0629_00001",
      "de_DE": [
        "Sandra, unsere Arenaleiterin,\n",
        "erwartet dich bereits.\r",
        "Aber ein mittelmäßiger Trainer\n",
        "könnte sie niemals besiegen!"
      ]
    },
    {
      "id": "msg_0629_00002",
      "de_DE": [
        "Du hast Sandra besiegt? Unglaublich!\r",
        "Außer Siegfried ist es noch niemandem\n",
        "gelungen, gegen sie zu gewinnen!"
      ]
    },
    {
      "id": "msg_0629_00003",
      "de_DE": [
        "Nein. Nur auserwählte Trainer dürfen\n",
        "hier trainieren.\r",
        "Ich muss dich bitten, wieder zu gehen."
      ]
    },
    {
      "id": "msg_0629_00004",
      "de_DE": [
        "Wenn Sandra nichts dagegen hat, wird\n",
        "auch ihr Großvater, unser Meister,\f",
        "sicher kein Problem damit haben.\r",
        "Bitte, tritt ein."
      ]
    },
    {
      "id": "msg_0629_00005",
      "de_DE": [
        "Ist mein Radio etwa im Eimer?\n",
        "Seit Kurzem empfange ich nur noch\f",
        "dieses eigenartige Signal..."
      ]
    },
    {
      "id": "msg_0629_00006",
      "de_DE": [
        "Aruuu! Stimmen in meinem Kopf!\r",
        "Oh... ich höre ja bloß Radio!"
      ]
    },
    {
      "id": "msg_0629_00007",
      "de_DE": [
        "Oh, sag mal, lässt du deine Pokémon\n",
        "auch manchmal Attacken vergessen?"
      ]
    },
    {
      "id": "msg_0629_00008",
      "de_DE": [
        "Alle Trainer, die den Beinamen\n",
        "Drachenprofi tragen, sind in\f",
        "Ebenholz City geboren."
      ]
    },
    {
      "id": "msg_0629_00009",
      "de_DE": [
        "Wow, du bist über den Eispfad gekommen!\n",
        "Dann musst du ein extrem talentierter\f",
        "Trainer sein!"
      ]
    },
    {
      "id": "msg_0629_00010",
      "de_DE": [
        "Ebenholz City\n",
        "Ein ruhiger Ort in den Bergen"
      ]
    },
    {
      "id": "msg_0629_00011",
      "de_DE": [
        "Pokémon-Arena von Ebenholz City\n",
        "Leiterin: Sandra\f",
        "Ein gesegneter Drachenprofi!"
      ]
    },
    {
      "id": "msg_0629_00012",
      "de_DE": [
        "Haus der Attacken\r",
        "Hier lernen deine Pokémon, Attacken zu\n",
        "vergessen oder sich wieder an sie zu\f",
        "erinnern."
      ]
    },
    {
      "id": "msg_0629_00013",
      "de_DE": [
        "Drachenhöhle\n",
        "Geradeaus"
      ]
    },
    {
      "id": "msg_0629_00014",
      "de_DE": [
        "Tipps für Trainer\r",
        "Wenn du mit normaler Geschwindigkeit\n",
        "durch das hohe Gras gehst, d. h. dabei\f",
        "nicht rennst, stößt du seltener auf\f",
        "wilde Pokémon.\r",
        "Wenn dein Pokémon-Team erschöpft ist,\n",
        "solltest du also möglichst langsam\f",
        "gehen und auf kürzestem Weg das\f",
        "nächste Pokémon-Center aufsuchen."
      ]
    }
  ]
}
