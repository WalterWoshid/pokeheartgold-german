{
  "key": 53450,
  "messages": [
    {
      "id": "msg_0674_00000",
      "de_DE": "Nepomuk"
    },
    {
      "id": "msg_0674_00001",
      "de_DE": [
        "Du hast schwer was drauf! Ich habe\n",
        "schon lange nicht mehr verloren!\r",
        "Ich weiß!\n",
        "Gib mir deine Telefonnummer.\r",
        "Meine Nase sagt mir, dass ich mit dir\n",
        "noch jede Menge spannende Kämpfe\f",
        "erleben kann! Ich melde mich, wenn\f",
        "ich ein paar Level zugelegt habe. {YESNO 0}"
      ]
    },
    {
      "id": "msg_0674_00002",
      "de_DE": "Lass uns mal wieder kämpfen!"
    },
    {
      "id": "msg_0674_00003",
      "de_DE": [
        "So was... du bist wohl doch\n",
        "nur ein Pantoffelheld."
      ]
    },
    {
      "id": "msg_0674_00004",
      "de_DE": [
        "Gib mir deine Telefonnummer.\r",
        "Meine Nase sagt mir, dass ich mit dir\n",
        "noch jede Menge spannende Kämpfe\f",
        "erleben kann! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0674_00005",
      "de_DE": [
        "Donner und Doria!\n",
        "Du bist ja immer noch so stark!\r",
        "Jetzt habe ich schon so oft gegen\n",
        "dich gekämpft, {STRVAR_1 3, 0, 0}, und immer\f",
        "noch habe ich keine Schnitte...\r",
        "Dabei trainiere ich und setze Tränke\n",
        "ein, als gäbe es kein Morgen...\f",
        "Wie kann das sein?!?\r",
        "Tränke sind eben doch nicht alles...\n",
        "Ich verstehe...\r",
        "{STRVAR_1 3, 0, 0}! Das hier schenke ich dir!\n",
        "Ich brauche es nicht mehr!\r"
      ]
    },
    {
      "id": "msg_0674_00006",
      "de_DE": [
        "Oooh! Lustig! Wir scheinen beide im\n",
        "Leuchtturm zu stehen.\f",
        "Ich kann das Echo deiner Stimme hören."
      ]
    },
    {
      "id": "msg_0674_00007",
      "de_DE": [
        "Wie geht es deinem\n",
        "Pokémon-Team?\r",
        "Meinem geht es ein wenig zu gut.\r",
        "Besonders meinem {STRVAR_1 0, 10, 0} - jedes\n",
        "Mal, wenn es einen Trainer sieht,\f",
        "stürmt es auf ihn los.\f",
        "Das wird mir langsam zu viel.\r",
        "Bis später."
      ]
    },
    {
      "id": "msg_0674_00008",
      "de_DE": [
        "Mein {STRVAR_1 0, 10, 0} hat ordentlich\n",
        "Muskeln angesetzt!\r",
        "Es stellt sogar meine Statur in\n",
        "den Schatten.\r",
        "Bis dann!"
      ]
    },
    {
      "id": "msg_0674_00009",
      "de_DE": [
        "He, du! Lass uns mal wieder unsere\n",
        "Kräfte messen!\r",
        "Komm hierher: {STRVAR_1 4, 3, 0}.\n",
        "Und gib Dampf, ich warte schon!"
      ]
    },
    {
      "id": "msg_0674_00010",
      "de_DE": [
        "He! Du wirst doch nicht unseren\n",
        "Kampf verschlafen haben?\r",
        "{STRVAR_1 4, 3, 0}!\n",
        "Los, gib Dampf! Ich warte!"
      ]
    },
    {
      "id": "msg_0674_00011",
      "de_DE": [
        "Lass uns mal wieder kämpfen!\n",
        "Ich fordere dich so lange heraus,\f",
        "bis ich gewinne."
      ]
    }
  ]
}
