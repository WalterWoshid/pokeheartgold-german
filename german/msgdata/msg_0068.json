{
  "key": 33879,
  "messages": [
    {
      "id": "msg_0068_00000",
      "de_DE": [
        "Als ich bei den Ruinen mein Radio\n",
        "angeschaltet habe, kamen sehr seltsame\f",
        "Signale aus den Lautsprechern."
      ]
    },
    {
      "id": "msg_0068_00001",
      "de_DE": [
        "Margit: Oh nein, wie konnte ich bloß in\n",
        "so einen Schlamassel geraten?\r",
        "Hilf mir, MAUZI! Hilf mir!"
      ]
    },
    {
      "id": "msg_0068_00002",
      "de_DE": [
        "Margit: Du bist der Trainer, der\n",
        "mich gerettet hat, stimmt’s?\r",
        "Hier, nimm!\n",
        "Das ist ein Zeichen meines Dankes!\r"
      ]
    },
    {
      "id": "msg_0068_00003",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält von Margit\n",
        "Blendpuder!"
      ]
    },
    {
      "id": "msg_0068_00004",
      "de_DE": [
        "Margit: Wenn du das einem Pokémon\n",
        "gibst, sinkt die Wahrscheinlichkeit,\r",
        "dass der Gegner es mit seinen\n",
        "Angriffen trifft!"
      ]
    },
    {
      "id": "msg_0068_00005",
      "de_DE": "Ach je, du kannst nichts mehr tragen!"
    },
    {
      "id": "msg_0068_00006",
      "de_DE": [
        "Margit: Und hör dir den Pokémon-Talk\n",
        "mit Prof. Eich und mir im Radio an, ja?"
      ]
    },
    {
      "id": "msg_0068_00007",
      "de_DE": "MAUZI: ...Mauz!"
    },
    {
      "id": "msg_0068_00008",
      "de_DE": "3S: Produktion"
    },
    {
      "id": "msg_0068_00009",
      "de_DE": "3S: Studio 1"
    },
    {
      "id": "msg_0068_00010",
      "de_DE": [
        "Ben: Team Rocket, was?\n",
        "Willst du wissen, was denen fehlt?\f",
        "...Musik natürlich!\r",
        "Musik bereichert die Herzen\n",
        "aller Menschen!\r",
        "Ein echter Musikliebhaber würde\n",
        "in unserem Radioturm nie solchen\f",
        "Schabernack treiben... jawollja!"
      ]
    },
    {
      "id": "msg_0068_00011",
      "de_DE": "Ben: Hörst du gerne Musik?"
    },
    {
      "id": "msg_0068_00012",
      "de_DE": [
        "Der Plan zur Befreiung des Radioturms\n",
        "war ein voller Erfolg!\f",
        "Dieser Lance muss echt cool sein...\r"
      ]
    },
    {
      "id": "msg_0068_00013",
      "de_DE": [
        "W-wer bist du denn?!\r",
        "Ich werde nicht zulassen, dass sich\n",
        "jemand Lance in den Weg stellt! Äh...\f",
        "ich meine natürlich Team Rocket!\r"
      ]
    },
    {
      "id": "msg_0068_00014",
      "de_DE": [
        "Für mich zählen nur Team Rocket\n",
        "und Lance!\r",
        "Wer schert sich schon um Pokémon?"
      ]
    }
  ]
}
