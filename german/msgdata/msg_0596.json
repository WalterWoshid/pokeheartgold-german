{
  "key": 60511,
  "messages": [
    {
      "id": "msg_0596_00000",
      "de_DE": "Hallo! Oh, dein Pokémon...\r"
    },
    {
      "id": "msg_0596_00001",
      "de_DE": [
        "Es hängt sehr an dir, nicht wahr?\n",
        "Ein eingespieltes Team, wie ihr es seid,\f",
        "weiß doch bestimmt, wie man mit dieser\f",
        "Attacke hier umzugehen hat.\r"
      ]
    },
    {
      "id": "msg_0596_00002",
      "garbage": 21
    },
    {
      "id": "msg_0596_00003",
      "de_DE": [
        "Oh, wie süß!\r",
        "Du solltest ihm gute TM-Attacken\n",
        "beibringen!"
      ]
    },
    {
      "id": "msg_0596_00004",
      "de_DE": [
        "Es sieht echt böse aus.\n",
        "Wie wär’s mit dieser TM?\r"
      ]
    },
    {
      "id": "msg_0596_00005",
      "garbage": 21
    },
    {
      "id": "msg_0596_00006",
      "de_DE": [
        "Es gibt bestimmt eine TM, die genau\n",
        "zu deinem Pokémon hier passt."
      ]
    },
    {
      "id": "msg_0596_00007",
      "de_DE": [
        "Geheimgeschehen\r",
        "Wenn du erst mal das “Piep” hörst, bist\n",
        "du auch schon um ein Geschenk reicher!"
      ]
    },
    {
      "id": "msg_0596_00008",
      "de_DE": [
        "Mit meinem Game Boy habe ich leider\n",
        "keinen Zugriff auf das Geheimgeschehen."
      ]
    },
    {
      "id": "msg_0596_00009",
      "de_DE": [
        "Ich sammele Pokémon!\n",
        "Hast du ein TRAUMATO?\r",
        "Möchtest du es gegen\n",
        "mein MACHOLLO tauschen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0596_00010",
      "de_DE": [
        "Klasse! Jetzt habe ich mein ganz\n",
        "eigenes TRAUMATO!\f",
        "Danke!"
      ]
    },
    {
      "id": "msg_0596_00011",
      "de_DE": [
        "Hä? Das ist kein TRAUMATO!\n",
        "Wie enttäuschend..."
      ]
    },
    {
      "id": "msg_0596_00012",
      "de_DE": [
        "Du möchtest also nicht tauschen?\n",
        "Schade..."
      ]
    },
    {
      "id": "msg_0596_00013",
      "de_DE": [
        "Hi! Wie geht es meinem MACHOLLO?\n",
        "Irgendwelche Probleme?"
      ]
    },
    {
      "id": "msg_0596_00014",
      "de_DE": [
        "Nanu? Du bist doch... seit wann\n",
        "gehörst du denn zu Team Rocket?"
      ]
    },
    {
      "id": "msg_0596_00015",
      "de_DE": [
        "Sonntags kommt eine Dame, um nach\n",
        "den Pokémon zu sehen.\r",
        "Sie verteilt manchmal sogar TM!"
      ]
    },
    {
      "id": "msg_0596_00016",
      "de_DE": [
        "Du gehörst zu Team Rocket...\n",
        "Was hast du hier zu suchen?"
      ]
    },
    {
      "id": "msg_0596_00017",
      "de_DE": [
        "Ein Pokémon, das du im Tausch erhalten\n",
        "hast, kannst du nicht umbenennen.\r",
        "Der Name spiegelt nämlich die Gefühle\n",
        "des Original-Trainers wider."
      ]
    },
    {
      "id": "msg_0596_00018",
      "de_DE": [
        "Wenn du schwarze Klamotten trägst,\n",
        "denken am Ende alle noch, du gehörst\f",
        "zu Team Rocket!\r",
        "Was? Du gehörst wirklich zu denen?"
      ]
    },
    {
      "id": "msg_0596_00019",
      "de_DE": [
        "Rüste deine Pokémon auf\n",
        "4S: TM-Ecke"
      ]
    }
  ]
}
