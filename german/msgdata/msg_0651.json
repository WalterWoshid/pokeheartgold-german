{
  "key": 59805,
  "messages": [
    {
      "id": "msg_0651_00000",
      "de_DE": "Pyro"
    },
    {
      "id": "msg_0651_00001",
      "de_DE": [
        "Häh? Ich versteh dich ganz schlecht!\n",
        "Das liegt an der Verbindung.\r",
        "Ruf noch mal von woanders an!"
      ]
    },
    {
      "id": "msg_0651_00002",
      "de_DE": [
        "Hallo.\n",
        "Was gibt’s?\r",
        "Mach dir keine Sorgen. Mir geht’s\n",
        "bestens!\r"
      ]
    },
    {
      "id": "msg_0651_00003",
      "de_DE": [
        "Hast du etwa schon alle Arenaleiter\n",
        "besiegt?\r",
        "Es gibt bestimmt noch welche, gegen die\n",
        "du nicht gekämpft hast!"
      ]
    },
    {
      "id": "msg_0651_00004",
      "de_DE": [
        "Hm, am Dienstagmittag habe ich nichts\n",
        "vor!\f",
        "Ruf mich dann einfach an, wenn du\f",
        "magst!"
      ]
    },
    {
      "id": "msg_0651_00005",
      "de_DE": [
        "Heeey!!!\r",
        "Dein Anruf kommt genau richtig!\n",
        "Sag schon! Trittst du gegen\f",
        "mich an? Na los! Komm schon! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0651_00006",
      "de_DE": [
        "Klasse!\r",
        "Danke!!!\n",
        "Ich warte dann auf dich im Dojo von\f",
        "Saffronia City!"
      ]
    },
    {
      "id": "msg_0651_00007",
      "de_DE": [
        "Wie bitte?\n",
        "Was für eine Enttäuschung!!!"
      ]
    },
    {
      "id": "msg_0651_00008",
      "de_DE": [
        "Es freut mich wirklich, dass du noch mal\n",
        "gegen mich kämpfen willst, aber hast du\f",
        "nicht noch eine ganze Reihe von Kämpfen\f",
        "ausstehen?"
      ]
    },
    {
      "id": "msg_0651_00009",
      "de_DE": [
        "Also, dann sieht man sich im Dojo von\n",
        "Saffronia City!"
      ]
    },
    {
      "id": "msg_0651_00010",
      "de_DE": [
        "Hallo, Pyro hier!\n",
        "Alles fit bei dir?\r"
      ]
    },
    {
      "id": "msg_0651_00011",
      "de_DE": [
        "Ich erwarte dich wie abgemacht im Dojo\n",
        "von Saffronia City!\f",
        "Ich kann es kaum noch abwarten!"
      ]
    },
    {
      "id": "msg_0651_00012",
      "de_DE": [
        "Meine Arena habe ich zwar verloren,\n",
        "nicht jedoch meine Zuversicht! \r",
        "Tag für Tag setze ich Stein auf Stein...\n",
        "Und eines Tages wird meine Arena in\f",
        "neuem Glanz erstrahlen! \r",
        "Diese Erfahrung hat mich die tiefere\n",
        "Bedeutung unseres Daseins gelehrt!"
      ]
    },
    {
      "id": "msg_0651_00013",
      "de_DE": [
        "Es freut mich sehr, wenn viele Trainer\n",
        "meine Arena aufsuchen!\r",
        "Insbesondere, wenn sie wie du von weit\n",
        "her kommen!\r",
        "Danke dir! Danke vielmals! "
      ]
    },
    {
      "id": "msg_0651_00014",
      "de_DE": [
        "Ich mag die Seeschauminseln wirklich\n",
        "sehr!\f",
        "Das Problem ist nur, dass es hier\f",
        "überhaupt keine Geschäfte gibt, in\f",
        "denen man einkaufen könnte!"
      ]
    }
  ]
}
