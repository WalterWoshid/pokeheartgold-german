  "key": 17422,
  "messages": [
    {
      "id": "msg_0496_00000",
      "de_DE": [
        "Hm, ich kann mich nicht entscheiden,\n",
        "welches Pokémon diese TM erhalten soll!"
      ]
    },
    {
      "id": "msg_0496_00001",
      "de_DE": [
        "Oh, oh! Ich habe mein Pokémon\n",
        "getauscht, ohne ihm vorher\f",
        "Up-Grade wegzunehmen!"
      ]
    },
    {
      "id": "msg_0496_00002",
      "de_DE": [
        "Klasse! Jetzt kann ich mir endlich\n",
        "doch noch ein PORYGON besorgen!\r",
        "Ich habe einfach kein Händchen für\n",
        "Münzspiele, und deshalb haben mir\f",
        "immer noch ein paar Münzen gefehlt...\r",
        "...Huch?\r",
        "Das getauschte PORYGON hat sich\n",
        "in ein anderes Pokémon verwandelt!"
      ]
    },
    {
      "id": "msg_0496_00003",
      "de_DE": [
        "Der TM-Laden hat ein paar seltene\n",
        "Attacken im Angebot!"
      ]
    },
    {
      "id": "msg_0496_00004",
      "de_DE": [
        "Wir peppen deine Pokémon auf!\n",
        "2S: TM-Laden"
      ]
    }
  ]
}
