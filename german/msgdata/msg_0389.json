{
  "key": 42110,
  "messages": [
    {
      "id": "msg_0389_00000",
      "de_DE": [
        "Beim Käferturnier treffen Liebhaber\n",
        "von Käfer-Pokémon aus dem ganzen\f",
        "Land aufeinander.\r",
        "...Ob ich selbst so einer bin?\n",
        "Nein, ich habe Angst vor ihnen!"
      ]
    },
    {
      "id": "msg_0389_00001",
      "de_DE": [
        "Das Käferturnier wird jeden Dienstag,\n",
        "Donnerstag und Samstag abgehalten.\r",
        "Du erhältst nicht nur einen Preis für\n",
        "die Teilnahme, sondern darfst auch das\f",
        "Käfer-Pokémon, das du dort fängst,\f",
        "behalten."
      ]
    },
    {
      "id": "msg_0389_00002",
      "de_DE": [
        "Tut mir leid, du darfst hier nicht durch.\r",
        "Das hier ist das Eingangsportal zu den\n",
        "Pokéathlonhallen, aber die Bauarbeiten\f",
        "sind noch nicht abgeschlossen. Sagt dir\f",
        "das Wort “Schnellbauverfahren” etwas?\r",
        "Das bedeutet, dass sich die Arbeiter\n",
        "mächtig ins Zeug legen, um mit den\f",
        "Bauarbeiten fertig zu werden.\r",
        "Aber du kannst dich freuen, denn die\n",
        "Pokéathlonhallen öffnen schon sehr\f",
        "bald ihre Pforten für die Öffentlichkeit!"
      ]
    },
    {
      "id": "msg_0389_00003",
      "de_DE": [
        "Dies ist das Eingangsportal zu\n",
        "den Pokéathlonhallen.\r",
        "Wir freuen uns über jeden, der\n",
        "am Wettkampf teilnehmen will!"
      ]
    },
    {
      "id": "msg_0389_00004",
      "de_DE": [
        "Oh neeeiiin! Der Pokéathlon wurde\n",
        "immer noch nicht eröffnet!\r",
        "Argh, ich kann nicht mehr warten!\n",
        "Ich laufe jetzt gleich einmal um Johto!"
      ]
    },
    {
      "id": "msg_0389_00005",
      "de_DE": [
        "Dann wollen wir doch mal sehen!\n",
        "Auf diesen Moment habe ich gewartet!\r",
        "Jetzt zeige ich allen die Freundschaft,\n",
        "die mein Pokémon-Team zusammenhält!"
      ]
    },
    {
      "id": "msg_0389_00006",
      "de_DE": [
        "Hm, also wenn man nicht mehr tun muss,\n",
        "als mit seinen Pokémon zu sprinten,\f",
        "nehme ich vielleicht auch teil..."
      ]
    },
    {
      "id": "msg_0389_00007",
      "de_DE": [
        "Arbeite mit deinen Pokémon zusammen,\n",
        "stärke ihr Vertrauen zu dir\f",
        "und glaube an ihr Potenzial!\r",
        "Baue eine Freundschaft mit Zukunft auf!\n",
        "Nimm auch du am Pokéathlon teil!"
      ]
    },
    {
      "id": "msg_0389_00008",
      "de_DE": [
        "Aprikodrinks geben jeder Freundschaft\n",
        "einen Schuss neue Energie!"
      ]
    },
    {
      "id": "msg_0389_00009",
      "de_DE": [
        "Kläng! Klong! Tock, tock, tock!\r",
        "Wir arbeiten im Schnellbauverfahren!\n",
        "Du kannst schon sehr bald hier durch!\f",
        "Wenn das mal kein Grund zur Freude ist!"
      ]
    },
    {
      "id": "msg_0389_00010",
      "de_DE": [
        "Halt, halt, halt! Da hinten wird gerade\n",
        "gebaut. Unsere Sicherheitsvorschriften\f",
        "lassen dort keine Passanten zu!\r",
        "Aber bald kannst du auch hier durch.\n",
        "Freue dich ruhig schon mal darauf!\r"
      ]
    }
  ]
}
