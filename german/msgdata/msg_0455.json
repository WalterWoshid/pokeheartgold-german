{
  "key": 11795,
  "messages": [
    {
      "id": "msg_0455_00000",
      "de_DE": [
        "Wo lungert der Arenaleiter von\n",
        "Vertania City eigentlich herum?\f",
        "Ich wollte ihn doch herausfordern..."
      ]
    },
    {
      "id": "msg_0455_00001",
      "de_DE": [
        "Der Arenaleiter von Vertania City\n",
        "verlässt sich nicht auf fremde Hilfe.\r",
        "Er hat noch nie verloren, und das\n",
        "obwohl er keine Assistenten hat!\f",
        "Er lehnt das wohl grundsätzlich ab.\r",
        "Aber gerade diese Einstellung ist es,\n",
        "mit der er die Trainer in Massen anzieht.\f",
        "Sie wollen alle für ihn arbeiten!"
      ]
    },
    {
      "id": "msg_0455_00002",
      "de_DE": [
        "Offensichtlich wurde die Pokémon-Arena\n",
        "auf der Zinnoberinsel zerstört.\r",
        "Ich frage mich, was wohl aus Pyro,\n",
        "dem Arenaleiter, geworden ist."
      ]
    },
    {
      "id": "msg_0455_00003",
      "de_DE": [
        "Mein großer Traum ist es,\n",
        "Arenaleiter zu werden!"
      ]
    }
  ]
}
