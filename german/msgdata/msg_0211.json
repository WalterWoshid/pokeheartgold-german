    {
      "id": "msg_0211_00000",
      "de_DE": [
        "Der Baum sieht aus, als ob er\n",
        "zerschnitten werden könnte.\r",
        "Möchtest du Zerschneider\n",
        "einsetzen?{YESNO 0}"
      ]
    },
    {
      "id": "msg_0211_00001",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} setzt\n",
        "Zerschneider ein.\r"
      ]
    },
    {
      "id": "msg_0211_00002",
      "de_DE": [
        "Der Baum sieht aus, als ob er\n",
        "zerschnitten werden könnte!"
      ]
    },
    {
      "id": "msg_0211_00003",
      "de_DE": [
