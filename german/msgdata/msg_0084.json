{
  "key": 61511,
  "messages": [
    {
      "id": "msg_0084_00000",
      "de_DE": [
        "Dies ist eine Nachbildung\n",
        "eines antiken Pokémon."
      ]
    },
    {
      "id": "msg_0084_00001",
      "de_DE": [
        "Hm...\r",
        "Ich habe während meiner Forschungen\n",
        "viele Jahre in diesen Ruinen zugebracht.\f",
        "Aber irgendetwas...\f",
        "ist hier anders als sonst...\r"
      ]
    },
    {
      "id": "msg_0084_00002",
      "de_DE": [
        "Du liebe Güte!\r",
        "Die ICOGNITO aus den\n",
        "Zeichnungen an der Wand...\r",
        "Es ist, als würden sie mich\n",
        "mit ihren Augen verfolgen!\r"
      ]
    },
    {
      "id": "msg_0084_00003",
      "de_DE": [
        "W-w-was geht hier vor sich?!?\n",
        "Durch diesen ganzen Spuk\f",
        "wollen meine Beine nicht mehr\f",
        "a-a...\f",
        "a-aufhören zu zittern!\r"
      ]
    },
    {
      "id": "msg_0084_00004",
      "de_DE": [
        "Uah! Geht es dir gut?!?\n",
        "Du warst plötzlich wie von der\f",
        "Erdoberfläche verschwunden!\f",
        "Das war echt ein Schock!\r"
      ]
    },
    {
      "id": "msg_0084_00005",
      "de_DE": [
        "Das ist also passiert, verstehe!\r",
        "Die vereinten Mächte von ARCEUS\n",
        "und den ICOGNITO müssen\f",
        "unglaubliche Energien freigesetzt\f",
        "haben, durch die du dann zu den\f",
        "Sinjoh-Ruinen katapultiert wurdest.\r",
        "ICOGNITO, die Alph-Ruinen und jetzt\n",
        "auch noch ARCEUS...\f",
        "Hier jagt ein Rätsel das andere!\r",
        "Aber jetzt brenne ich richtiggehend\n",
        "vor Wissbegierde!\r",
        "Irgendwann wird der Tag kommen, an\n",
        "dem ich all diese Geheimnisse lüfte!\r"
      ]
    }
  ]
}
