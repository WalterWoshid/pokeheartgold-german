{
  "key": 17167,
  "messages": [
    {
      "id": "msg_0351_00000",
      "de_DE": [
        "Weißt du, welches das knuddeligste\n",
        "Pokémon auf der ganzen Welt ist?\f",
        "CHANEIRA natürlich!\f",
        "Welches denn auch sonst?\r"
      ]
    },
    {
      "id": "msg_0351_00001",
      "de_DE": [
        "Wenn du ein CHANEIRA zu mir bringst,\n",
        "kriegst du was ganz Tolles von mir!"
      ]
    },
    {
      "id": "msg_0351_00002",
      "de_DE": [
        "Das ist doch... ein CHANEIRA!\r",
        "Kreisch! Ich stehe direkt neben\n",
        "einem echten CHANEIRA! Und jetzt\f",
        "rückt es mir sogar noch mal chanäher!\r",
        "Hier, ein kleines Dankeschön von mir!\r"
      ]
    },
    {
      "id": "msg_0351_00003",
      "de_DE": [
        "Diese Attacke heißt Lucky Punch!\n",
        "Wenn du sie einem CHANEIRA\f",
        "beibringst, steigt seine\f",
        "Volltrefferquote!\r",
        "Voll toll, oder?"
      ]
    },
    {
      "id": "msg_0351_00004",
      "de_DE": "Ach, CHANEIRA..."
    },
    {
      "id": "msg_0351_00005",
      "de_DE": [
        "Weißt du, welches das knuddeligste\n",
        "Pokémon auf der ganzen Welt ist?\f",
        "CHANEIRA natürlich!\f",
        "Welches denn auch sonst?"
      ]
    },
    {
      "id": "msg_0351_00006",
      "de_DE": [
        "Eusin: Das bist ja du, {STRVAR_1 3, 0, 0}!\r",
        "Aber diesmal schaffe ich es wirklich!\n",
        "Ich bin den ganzen Weg bis hierher\f",
        "gereist und weiß nun wieder etwas\f",
        "genauer, wo SUICUNE hin will!\r",
        "Eigentlich würde ich mein Wissen\n",
        "ja für mich behalten, aber\f",
        "vor SUICUNE will ich ganz offen sein.\r",
        "Daher will ich dir einen\n",
        "kleinen Hinweis geben!\r",
        "SUICUNE bevorzugt\n",
        "nördliche Ufer...\f",
        "und luftige Höhen...\f",
        "Dort soll man diesem\f",
        "Pokémon angeblich begegnen können!\r",
        "Wo genau das sein soll, weiß\n",
        "ich selbst auch noch nicht.\r",
        "Es wird also ein Wettlauf zwischen\n",
        "uns beiden, wer es zuerst herausfindet!"
      ]
    },
    {
      "id": "msg_0351_00007",
      "de_DE": [
        "Eusin: Was gibt’s, {STRVAR_1 3, 0, 0}?\n",
        "Vor SUICUNE will ich ganz offen sein.\r",
        "Deshalb werde ich dir jetzt\n",
        "einen Hinweis geben!\r",
        "SUICUNE hält sich bevorzugt an\n",
        "nördlichen Ufern auf...\f",
        "in luftigen Höhen...\f",
        "An solchen Orten soll man diesem\f",
        "Pokémon angeblich begegnen können!\r",
        "Wo genau das sein soll, weiß\n",
        "ich selbst auch noch nicht.\r",
        "Es wird also ein Wettlauf zwischen\n",
        "uns beiden, wer es zuerst herausfindet!"
      ]
    }
  ]
}
