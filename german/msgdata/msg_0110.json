{
  "key": 37979,
  "messages": [
    {
      "id": "msg_0110_00000",
      "de_DE": [
        "Willkommen in den Kampfarkaden!\r",
        "Ich stehe dir bei den Einzel- und\n",
        "Doppelkämpfen helfend zur Seite.\r",
        "Beachte bitte, dass diese Kämpfe\n",
        "nur für einen Trainer gedacht sind.\r"
      ]
    },
    {
      "id": "msg_0110_00001",
      "de_DE": [
        "Welcher Herausforderung möchtest\n",
        "du dich gern stellen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0110_00002",
      "de_DE": [
        "In den Kampfarkaden kannst du Einzel-\n",
        "oder Doppelkämpfe bestreiten.\r",
        "Hier wird vor jedem Duell ein Spielbrett\n",
        "angezeigt.\r",
        "Auf diesem Brett wird ein Umstand\n",
        "aktiviert, der einen Effekt auf das\f",
        "folgende Duell hat.\r",
        "Einige Umstände verschaffen dem\n",
        "Herausforderer einen Vorteil,\f",
        "andere nicht.\r",
        "Versuche, so lange wie möglich\n",
        "siegreich aus den Kämpfen zu gehen!\r",
        "Für die Dauer deiner Herausforderung\n",
        "werden alle Items, die deine Pokémon\f",
        "halten, aufbewahrt.\r",
        "Gewinnst du sieben Mal hintereinander,\n",
        "erhältst du Gewinnpunkte (GP).\r",
        "Willst du den Kampf unterbrechen,\n",
        "speichere bitte dein Spiel.\r",
        "Speicherst du es nicht,\n",
        "wirst du disqualifiziert.\r",
        "Bitte vergiss das nicht!\r"
      ]
    },
    {
      "id": "msg_0110_00003",
      "de_DE": [
        "Willkommen in den Kampfarkaden!\r",
        "Ich stehe dir in Sachen Multikampf\n",
        "mit Rat und Tat zur Seite.\r",
        "Bitte beachte, dass diese Art von\n",
        "Herausforderung zwei Trainer braucht.\r"
      ]
    },
    {
      "id": "msg_0110_00004",
      "de_DE": [
        "Möchtest du dich den Multikämpfen\n",
        "in den Kampfarkaden stellen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0110_00005",
      "de_DE": [
        "Hier trittst du in Multikämpfen\n",
        "zusammen mit einem Freund an.\r",
        "Hier wird vor jedem Duell ein Spielbrett\n",
        "angezeigt.\r",
        "Auf diesem Brett wird ein Umstand\n",
        "aktiviert, der einen Effekt auf das\f",
        "folgende Duell hat.\r",
        "Einige Umstände verschaffen dem\n",
        "Herausforderer einen Vorteil,\f",
        "andere nicht.\r",
        "Versucht, so lange wie möglich\n",
        "siegreich aus den Kämpfen zu gehen!\r",
        "Für die Dauer eurer Herausforderung\n",
        "werden alle Items, die eure Pokémon\f",
        "halten, aufbewahrt.\r",
        "Gelingt es euch, sieben Kämpfe in einer\n",
        "Reihe für euch zu entscheiden, dann\f",
        "erhaltet ihr Gewinnpunkte (GP).\r",
        "Beachtet bitte, dass eine Multikampf-\n",
        "Herausforderung in den Kampfarkaden\f",
        "nicht unterbrochen werden kann.\r"
      ]
    },
    {
      "id": "msg_0110_00006",
      "de_DE": "Hoffentlich bis bald mal wieder!"
    },
    {
      "id": "msg_0110_00007",
      "de_DE": "Bitte Pokémon auswählen.\r"
    },
    {
      "id": "msg_0110_00008",
      "de_DE": [
        "Entschuldigung!\r",
        "Du brauchst {STRVAR_1 50, 0, 0} zugelassene Pokémon.\r",
        "Du brauchst {STRVAR_1 50, 1, 0} verschiedene Pokémon.\r"
      ]
    },
    {
      "id": "msg_0110_00009",
      "de_DE": [
        "Hmmm... Eier dürfen hier aber auch\n",
        "nicht mitspielen.\r"
      ]
    },
    {
      "id": "msg_0110_00010",
      "de_DE": [
        "Eier und {STRVAR_1 0, 1, 0} dürfen an den\n",
        "Kämpfen nicht teilnehmen.\r"
      ]
    },
