      ]
    },
    {
      "id": "msg_0110_00028",
      "de_DE": "Komm wieder, wenn du bereit bist.\r"
    },
    {
      "id": "msg_0110_00029",
      "de_DE": [
        "Huch? Beide Trainer haben sich für das\n",
        "Pokémon {STRVAR_1 0, 0, 0} entschieden!\r",
        "Bitte berate dich mit dem anderen\n",
        "Trainer, damit jeder ein\f",
        "unterschiedliches Pokémon hat.\r"
      ]
    },
    {
      "id": "msg_0110_00030",
      "de_DE": [
        "Huch? Beide Trainer haben sich für die\n",
        "Pokémon {STRVAR_1 0, 0, 0} und {STRVAR_1 0, 1, 0}\f",
        "entschieden!\r",
        "Bitte berate dich mit dem anderen\n",
        "Trainer, damit jeder ein\f",
        "unterschiedliches Pokémon hat.\r"
      ]
    },
    {
      "id": "msg_0110_00031",
      "de_DE": [
        "Bevor ich dich hereinlasse,\n",
        "musst du das Spiel speichern.\f",
        "Einverstanden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0110_00032",
      "de_DE": "Hier entlang bitte!"
    },
    {
      "id": "msg_0110_00033",
      "de_DE": [
        "Lange nicht gesehen!\r",
        "Du musst das Spiel speichern, bevor du\n",
        "die Herausforderung wieder aufnimmst.\r",
        "Bitte habe Geduld."
      ]
    },
    {
      "id": "msg_0110_00034",
      "de_DE": [
        "Entschuldigung!\r",
        "Vorm Verlassen deiner letzten\n",
        "Herausforderung hast du nicht\f",
        "gespeichert.\r",
        "Aus diesem Grunde wurdest du\n",
        "disqualifiziert!\r"
      ]
    },
    {
      "id": "msg_0110_00035",
      "de_DE": [
        "Glückwunsch!\r",
        "Der Preis für deinen Sieg ist dieses\n",
        "schmucke Erinnerungsfoto!\r"
      ]
    },
    {
      "id": "msg_0110_00036",
      "de_DE": [
        "Das Goldfoto wurde an die Kampfkamera\n",
        "von {STRVAR_1 3, 0, 0} gesendet.\r"
      ]
    },
    {
      "id": "msg_0110_00037",
      "de_DE": [
        "Das Silberfoto wurde an die Kampfkamera\n",
        "von {STRVAR_1 3, 0, 0} gesendet.\r"
      ]
    },
    {
      "id": "msg_0110_00038",
      "de_DE": "EINZELKAMPF"
    },
    {
      "id": "msg_0110_00039",
      "de_DE": "DOPPELKAMPF"
    },
    {
      "id": "msg_0110_00040",
      "de_DE": "HERAUSFORDERN"
    },
    {
      "id": "msg_0110_00041",
      "de_DE": "INFO"
    },
    {
      "id": "msg_0110_00042",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0110_00043",
      "de_DE": [
        "Bitte legt fest, wer von euch\n",
        "“LEITER WERDEN” soll.\r",
        "Der andere Spieler wählt\n",
        "“MITSPIELER” aus. {YESNO 0}"
      ]
    },
    {
      "id": "msg_0110_00044",
      "de_DE": [
        "Drahtlose DS-Datenübertragung\n",
        "initialisieren? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0110_00045",
      "de_DE": [
        "Du musst das Spiel speichern, bevor ich\n",
        "dich hereinlasse. Bitte habe Geduld."
      ]
    },
    {
      "id": "msg_0110_00046",
      "de_DE": [
        "Dieses Spiel ähnelt unserem Leben...\r",
        "Es dreht sich beständig im Kreise,\n",
        "Glück und Pech wechseln einander ab...\r",
        "Na, wie ist das? Ich wollte mal etwas\n",
        "Tiefgründiges sagen!"
      ]
    },
    {
      "id": "msg_0110_00047",
      "de_DE": [
        "Über Sieg und Niederlage im Pokémon-\n",
        "Kampf entscheidet oftmals das Glück...\r",
        "Nirgends spürt man dies deutlicher\n",
        "als bei den Kampfarkaden...\n"
      ]
    },
    {
      "id": "msg_0110_00048",
      "de_DE": [
        "Was man braucht, um hier zu bestehen?\n",
        "Kraft?\f",
        "Verstand?\f",
        "Glück?\r",
        "NEIN!\n",
        "In Wahrheit benötigt man nichts weiter\f",
        "als Flexibilität!\f",
        "So sehe ich das zumindest..."
      ]
    },
    {
      "id": "msg_0110_00049",
      "de_DE": [
        "Gutes Timing hilft dir, das gewünschte\n",
        "Ergebnis zu erzielen, aber lass dich von\f",
        "den Bewegungen auf dem Spielbrett nicht\f",
        "durcheinanderbringen.\r",
        "Wenn du es innerhalb von 30 Sekunden\n",
        "nicht zum Stillstand bringst, stoppt es\f",
        "von selbst."
      ]
    },
    {
      "id": "msg_0110_00050",
      "de_DE": [
        "Da habe ich extra mein Lieblings-\n",
        "Pokémon-Team für den Kampf ausgewählt,\f",
        "und was passiert?\f",
        "Ich muss mit meinem Gegner tauschen!\r",
        "Mit anderen Worten: Ich muss meine\n",
        "gesamte Strategie überdenken!"
      ]
    },
    {
      "id": "msg_0110_00051",
      "de_DE": [
        "Bei der Zusammenstellung meines\n",
        "Pokémon-Teams war für mich der\f",
        "Angriffs-Wert ausschlaggebend, während\f",
        "mein Gegner alles auf die Initiative\f",
        "gesetzt hat... beim nächsten Mal werde\f",
        "ich auch auf die Initiative setzen!"
      ]
    },
    {
      "id": "msg_0110_00052",
      "de_DE": [
        "Ein gutes Timing ist der Schlüssel\n",
        "zum Sieg in diesem Spiel!\r",
        "Aber es ist auch sehr spaßig,\n",
        "sich von der Hand des Schicksals\f",
        "beeinflussen zu lassen!\n"
      ]
    },
    {
      "id": "msg_0110_00053",
      "de_DE": [
        "Je größer deine Erfolge im Spiel sind,\n",
        "desto mehr ist dir das Spielbrett\f",
        "gewogen...\f",
        "Ob es wohl lebendig ist?"
      ]
    },
    {
      "id": "msg_0110_00054",
      "de_DE": [
        "Wusstest du das schon?\n",
        "Boden-Pokémon sind von Umständen, die\f",
        "Lähmung verursachen, nicht betroffen!\f",
        "Sag es ruhig allen weiter!"
      ]
    },
    {
      "id": "msg_0110_00055",
      "de_DE": [
        "Ich hab einen wichtigen Tipp für dich:\r",
        "Umstände, die dein Team einfrieren oder\n",
        "vergiften, können unwirksam werden.\r",
        "Und weißt du, wie? Indem der Typ oder\n",
        "die Fähigkeiten eines Pokémon es vor\r",
        "solchen Statusproblemen beschützen.\n"
      ]
    }
  ]
}
