{
  "key": 60495,
  "messages": [
    {
      "id": "msg_0592_00000",
      "de_DE": [
        "Willkommen im Kaufhaus\n",
        "von Dukatia City!"
      ]
    },
    {
      "id": "msg_0592_00001",
      "de_DE": [
        "Das Kaufhaus von Dukatia City hat ein\n",
        "sehr breit gefächertes Sortiment.\r",
        "Aber einige Items erhält man nur als\n",
        "Preis in der Spielhalle in der Stadt."
      ]
    },
    {
      "id": "msg_0592_00002",
      "de_DE": [
        "Was treibt jemanden von Team Rocket\n",
        "wohl in dieses Kaufhaus?\r",
        "Es würde mich sehr wundern, wenn\n",
        "du hier irgendwo Aufrichtigkeit in\f",
        "der Auslage finden würdest!"
      ]
    },
    {
      "id": "msg_0592_00003",
      "de_DE": [
        "Dann mal ans Werk! Ich habe vor, heute\n",
        "das halbe Kaufhaus leerzukaufen!"
      ]
    },
    {
      "id": "msg_0592_00004",
      "de_DE": [
        "Solange du mich nicht beim Einkaufen\n",
        "störst, ist mir egal, ob du zu Team\f",
        "Rocket oder zu Team Pocket gehörst.\r",
        "Und jetzt kusch! Lass mich in Frieden!"
      ]
    },
    {
      "id": "msg_0592_00005",
      "de_DE": [
        "Mama ist eine echte Schnäppchenjägerin.\r",
        "Sie besorgt mir meine Items immer zu\n",
        "etwas günstigeren Preisen."
      ]
    },
    {
      "id": "msg_0592_00006",
      "de_DE": [
        "Meine Mama hat mir gesagt, ich soll mich\n",
        "von Leuten, die ganz schwarz angezogen\f",
        "sind, fernhalten!"
      ]
    },
    {
      "id": "msg_0592_00007",
      "de_DE": [
        "EG: Kundeninformation\n",
        "1S: Trainermarkt\f",
        "2S: Kampfkollektion\f",
        "3S: Arznei\f",
        "4S: TM-Ecke\f",
        "5S: Dachgeschoss"
      ]
    }
  ]
}
