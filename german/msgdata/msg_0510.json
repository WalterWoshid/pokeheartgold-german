{
  "key": 17462,
  "messages": [
    {
      "id": "msg_0510_00000",
      "de_DE": [
        "Willkommen in unserem Restaurant!\r",
        "...Leider können wir dich im Moment\n",
        "nicht bedienen, weil wir gerade mitten in\f",
        "einem Wettessen stecken.\r",
        "Aber wenn du möchtest, kannst du den\n",
        "Teilnehmern beim Essen zuschauen!"
      ]
    },
    {
      "id": "msg_0510_00001",
      "de_DE": [
        "Pffft, pffft, mampf, mampf...\n",
        "Pffft, pffft, mampf, mampf...\r",
        "Wenn ich sonst auch ein Vielfraß wäre,\n",
        "würde mir das sicher leichter fallen.\r",
        "Aber jetzt habe ich mir ganz böse die\n",
        "Zunge verbrannt! So ergeht es dir,\f",
        "wenn du dein Essen herunterschlingst!\f",
        "Au, heiß! Heiß! Ist das heiß!\r"
      ]
    },
    {
      "id": "msg_0510_00002",
      "de_DE": [
        "Mampf, mampf, mampf, mampf!\n",
        "(Ich kann jetzt nicht mir dir reden!)\r",
        "Umpf, urgs, umpf...\n",
        "(Ich muss mein Essen im Mund behalten!)\r"
      ]
    },
    {
      "id": "msg_0510_00003",
      "de_DE": [
        "Schling, schlabber, schling!\n",
        "...Hä? Bei diesem Wettbewerb geht es\f",
        "darum, möglichst viel zu essen?\r",
        "Verflixt!\r",
        "Ich dachte, ich müsste das Zeug\n",
        "möglichst schnell herunterschlingen!\r"
      ]
    },
    {
      "id": "msg_0510_00004",
      "de_DE": [
        "Schling, schlabber...\r",
        "Ich habe immer noch etwas Platz!\r",
        "Chefkoch! Nachschub!\r"
      ]
    },
    {
      "id": "msg_0510_00005",
      "de_DE": [
        "Schling, schlabber...\r",
        "Ich habe immer noch etwas Platz!\r",
        "Chefkoch! Nachschub!\r"
      ]
    },
    {
      "id": "msg_0510_00006",
      "de_DE": [
        "Hilda: Mampf, mampf, mampf!\n",
        "Ein Wettessen! Dass ich das\f",
        "noch, mampf, erleben darf!\r",
        "Ich war zwecks Training eine Weile auf\n",
        "Diät und könnte Berge verschlingen!\r",
        "Das Angebot, dass der Gewinner\n",
        "nichts für sein Essen bezahlen muss,\f",
        "ist einfach zu schön, um wahr zu sein!\r"
      ]
    },
    {
      "id": "msg_0510_00007",
      "de_DE": [
        "Wettessen! Essen bis zum Umfallen!\n",
        "Kein Zeitlimit! Der größte Vielfraß\f",
        "bekommt alles umsonst!"
      ]
    }
  ]
}
