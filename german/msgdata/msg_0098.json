{
  "key": 9318,
  "messages": [
    {
      "id": "msg_0098_00000",
      "de_DE": [
        "Vielen Dank für deine Teilnahme!\r",
        "Warte bitte, bis das Spiel gespeichert\n",
        "wurde. Schalte das System nicht aus."
      ]
    },
    {
      "id": "msg_0098_00001",
      "de_DE": "Hoffentlich bis bald!"
    },
    {
      "id": "msg_0098_00002",
      "de_DE": [
        "Wir heilen deine Pokémon und machen\n",
        "sie wieder fit!"
      ]
    },
    {
      "id": "msg_0098_00003",
      "de_DE": [
        "Das {STRVAR_1 50, 0, 0}. gegnerische Team ist bereit.\n",
        "Bist du so weit?"
      ]
    },
    {
      "id": "msg_0098_00004",
      "de_DE": [
        "Möchtest du speichern und\n",
        "das Spiel beenden?"
      ]
    },
    {
      "id": "msg_0098_00005",
      "de_DE": [
        "Möchtest du deine Herausforderung\n",
        "im Kampfraum abbrechen?"
      ]
    },
    {
      "id": "msg_0098_00006",
      "de_DE": [
        "Möchtest du deinen letzten Kampf\n",
        "als dein Kampfvideo speichern?"
      ]
    },
    {
      "id": "msg_0098_00007",
      "de_DE": [
        "Der Kampf von {STRVAR_1 3, 0, 0} wurde\n",
        "als Kampfvideo gespeichert.\r"
      ]
    },
    {
      "id": "msg_0098_00008",
      "de_DE": [
        "Ein Fehler ist aufgetreten.\n",
        "Kampfvideo wurde nicht gespeichert.\r"
      ]
    },
    {
      "id": "msg_0098_00009",
      "de_DE": [
        "Bestehendes Kampfvideo löschen\n",
        "und letzten Kampf speichern?"
      ]
    },
    {
      "id": "msg_0098_00010",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das Gerät nicht ausschalten."
      ]
    },
    {
      "id": "msg_0098_00011",
      "de_DE": [
        "Die Herausforderung in diesem\n",
        "Kampfraum wurde abgebrochen."
      ]
    },
    {
      "id": "msg_0098_00012",
      "de_DE": "Warte auf Antwort des Freundes..."
    },
    {
      "id": "msg_0098_00013",
      "de_DE": [
        "Du hast das siebte Duell gewonnen!\n",
        "Gratulation!\r",
        "Als Belohnung für dein besonderes\n",
        "Talent bekommst du GP!\r"
      ]
    },
    {
      "id": "msg_0098_00014",
      "de_DE": "{STRVAR_1 3, 0, 0} erhielt {STRVAR_1 51, 1, 0} GP!\r"
    },
    {
      "id": "msg_0098_00015",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das Gerät nicht ausschalten."
      ]
    },
    {
      "id": "msg_0098_00016",
      "de_DE": "Bitte warten."
    }
  ]
}
