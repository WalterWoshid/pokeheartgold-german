{
  "key": 42023,
  "messages": [
    {
      "id": "msg_0533_00000",
      "de_DE": [
        "Tag auch!\r",
        "Der Karate-Meister unseres\n",
        "ehrenwerten Dojos ist gerade\f",
        "nicht hier, weil er erneut auf eine\f",
        "Trainingsreise in eine der Höhlen von\f",
        "Johto aufgebrochen ist!"
      ]
    },
    {
      "id": "msg_0533_00001",
      "de_DE": [
        "Tag auch!\r",
        "Während er nicht hier ist, hat der\n",
        "Karate-Meister unser ehrenwertes\f",
        "Dojo allen Arenaleitern frei zur\f",
        "Verfügung gestellt.\r",
        "Wenn du die Telefonnummer eines\n",
        "Arenaleiters kennst, dann rufe ihn an!\r",
        "Wenn er Zeit hat, kannst du hier,\n",
        "sooft du willst, gegen ihn kämpfen!"
      ]
    },
    {
      "id": "msg_0533_00002",
      "de_DE": "“Ohne Fleiß kein Preis.”"
    },
    {
      "id": "msg_0533_00003",
      "de_DE": "“Ohne Schweiß kein Fleiß.”"
    },
    {
      "id": "msg_0533_00004",
      "de_DE": [
        "Falk: Ah, hallo! Da bist du ja!\r",
        "Es freut mich sehr, noch mal\n",
        "gegen dich kämpfen zu dürfen!\r"
      ]
    },
    {
      "id": "msg_0533_00005",
      "de_DE": [
        "Falk: ...Hmpf. Es ist wohl noch\n",
        "ein weiter Weg bis an die Spitze\f",
        "des Trainerhimmels!"
      ]
    },
    {
      "id": "msg_0533_00006",
      "de_DE": [
        "Kai: So trifft man sich wieder! Jetzt\n",
        "siehst du die Ergebnisse meiner\f",
        "Nachforschungen über Käfer-Pokémon!\r"
      ]
    },
    {
      "id": "msg_0533_00007",
      "de_DE": [
        "Kai: Du scheinst dich selbst schon\n",
        "recht gut auf dem Feld auszukennen!"
      ]
    },
    {
      "id": "msg_0533_00008",
      "de_DE": [
        "Bianka: Ah, pünktlich wie die Maurer!\n",
        "Dann legen wir doch gleich mal los!\r"
      ]
    },
    {
      "id": "msg_0533_00009",
      "de_DE": [
        "Bianka: Wow, du bist wirklich stark!\n",
        "Aber das nächste Mal gewinne ich!"
      ]
    },
    {
      "id": "msg_0533_00010",
      "de_DE": [
        "Hartwig: Oh, hallo! Da bist du ja!\r",
        "Jetzt kriegst du die Früchte von 24\n",
        "Stunden Spezialtraining zu schmecken!\r"
      ]
    },
    {
      "id": "msg_0533_00011",
      "de_DE": [
        "Hartwig: Hahaha! Kämpfe gegen dich\n",
        "sind immer ein riesiger Spaß!"
      ]
    },
    {
      "id": "msg_0533_00012",
      "de_DE": [
        "Jasmin: Pünktlich auf die Sekunde...\n",
        "Wollen wir dann gleich anfangen?\r"
      ]
    },
    {
      "id": "msg_0533_00013",
      "de_DE": "Jasmin: Das hätte mir klar sein müssen."
    },
    {
      "id": "msg_0533_00014",
      "de_DE": [
        "Jens: Oh! Da hast du dich aber beeilt!\n",
        "In Ordnung, dann lass uns kämpfen!\r"
      ]
    },
    {
      "id": "msg_0533_00015",
      "de_DE": [
        "Jens: Nein, ich konnte nur verlieren.\r",
        "Aber das liegt nicht nur daran, dass du\n",
        "so stark bist. Da ist noch irgendetwas\f",
        "anderes an dir..."
      ]
    },
    {
      "id": "msg_0533_00016",
      "de_DE": [
        "Norbert: Da bist du ja endlich!\r",
        "Nein, sage jetzt bitte nichts...\n",
        "Ein Kampf zwischen dir und mir sagt\f",
        "mehr als tausend Worte!\r"
      ]
    },
    {
      "id": "msg_0533_00017",
      "de_DE": [
        "Norbert: ...Beeindruckend.\n",
        "Das war wunderbar."
      ]
    },
    {
      "id": "msg_0533_00018",
      "de_DE": [
        "Sandra: ...Ah, da bist du ja!\n",
        "Gut, dann lass uns sofort kämpfen!\r"
      ]
    },
    {
      "id": "msg_0533_00019",
      "de_DE": [
        "Sandra: Genau so funktioniert das!\n",
        "... ... ...\f",
        "...Bleibe am Ball!"
      ]
    },
    {
      "id": "msg_0533_00020",
      "de_DE": [
        "Major Bob: Hey, Rekrut!\n",
        "Soldaten halten immer ihr Wort!\f",
        "Wir müssen noch einmal kämpfen!\r"
      ]
    },
    {
      "id": "msg_0533_00021",
      "de_DE": [
        "Major Bob: Oh nein!\r",
        "Du bist hart wie Stahl, Rekrut!\f",
        "Aber irgendwann zahle ich es dir heim!"
      ]
    },
    {
      "id": "msg_0533_00022",
      "de_DE": [
        "Sabrina: Wie vermutet, da bist du! Ich\n",
        "habe vorausgesehen, dass du kommst!\r",
        "Oh, äh... du hast recht.\r",
        "Klar, wir waren ja auch verabredet.\r"
      ]
    },
    {
      "id": "msg_0533_00023",
      "de_DE": [
        "Sabrina: Ich habe vorausgesehen, dass\n",
        "du mich wieder anrufen wirst..."
      ]
    },
    {
      "id": "msg_0533_00024",
      "de_DE": [
        "Erika: Hallohooo... schön, dich\n",
        "wiederzusehen!\r",
        "Besonders wohl fühle ich mich in diesem\n",
        "Umfeld zwar nicht, aber was soll’s...\f",
        "Augen zu und durch, sage ich!\r"
      ]
    },
    {
      "id": "msg_0533_00025",
      "de_DE": [
        "Erika: Eieiei... du wirst wirklich\n",
        "von Mal zu Mal stärker."
      ]
    },
    {
      "id": "msg_0533_00026",
      "de_DE": [
        "Misty: Ach, da bist du ja endlich!\n",
        "Seit unserem letzten Treffen hört man\f",
        "ja jede Menge tolle Dinge über dich!\r",
        "Dann zeige mir mal, was du drauf hast!\r"
      ]
    },
    {
      "id": "msg_0533_00027",
      "de_DE": "Misty: Wahnsinn! Du wirst immer besser!"
    },
    {
      "id": "msg_0533_00028",
      "de_DE": [
        "Rocko: Aha! Wie bestellt, da bist du!\n",
        "Lassen wir unsere Pokémon sprechen!\r"
      ]
    },
    {
      "id": "msg_0533_00029",
      "de_DE": [
        "Rocko: Schon wieder verloren...\n",
        "Tja, so ergeht’s einem eben, wenn\f",
        "man nie die Stadt verlässt."
      ]
    },
    {
      "id": "msg_0533_00030",
      "de_DE": [
        "Janina: Hehehe! Hier kann ich zwar\n",
        "meine Ninja-Techniken nicht einsetzen,\f",
        "aber verlieren werde ich deshalb nicht!\r"
      ]
    },
    {
      "id": "msg_0533_00031",
      "de_DE": [
        "Janina: Heute habe ich verloren, aber\n",
        "es gibt immer ein nächstes Mal!"
      ]
    },
    {
      "id": "msg_0533_00032",
      "de_DE": [
        "Pyro: Heeey! Sehr schön!\n",
        "Du bist pünktlich!\r"
      ]
    },
    {
      "id": "msg_0533_00033",
      "de_DE": [
        "Pyro: Heeey!\r",
        "Was sagst du da? Solange uns dieses\n",
        "Dojo zur freien Verfügung steht,\f",
        "müsste ich gar keine neue Arena bauen?\r",
        "Pah, das glaubst aber auch nur du!"
      ]
    },
    {
      "id": "msg_0533_00034",
      "de_DE": [
        "Blau: Sehr gut! Du bist also hier,\n",
        "um eine Abreibung zu bekommen, was?\r"
      ]
    },
    {
      "id": "msg_0533_00035",
      "de_DE": [
        "Blau: Mann, du verstehst aber\n",
        "auch echt keinen Spaß!"
      ]
    }
  ]
}
