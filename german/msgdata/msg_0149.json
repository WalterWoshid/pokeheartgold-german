{
  "key": 5294,
  "messages": [
    {
      "id": "msg_0149_00000",
      "de_DE": "KYOGRE: Kyooogre!\r"
    },
    {
      "id": "msg_0149_00001",
      "de_DE": "KYOGRE ist verschwunden..."
    },
    {
      "id": "msg_0149_00002",
      "de_DE": [
        "Oh, hallo! Mann, das hat mich gerade\n",
        "glatt umgehauen!\r",
        "Dieses Pokémon kommt in der Sage\n",
        "von der Entstehung der Hoenn-Region\f",
        "vor, habe ich nicht recht?\f",
        "Das war KYOGRE!\r",
        "Aber natürlich! Jetzt wird alles klar!\r",
        "Dann muss der Felsenherzturm\n",
        "also von Leuten aus der Hoenn-Region\f",
        "gebaut worden sein!\r"
      ]
    },
    {
      "id": "msg_0149_00003",
      "de_DE": [
        "Aber das hieße ja...\r",
        "In diesem Turm, der die See mit dem Land\n",
        "und dem Himmel verbindet, muss es...\r",
        "KYOGRE ist also nicht das einzige\n",
        "Pokémon, das in jeder Sage von Hoenn\f",
        "eine Rolle spielt!\r",
        "Allem Anschein nach gibt es hier noch\n",
        "so einige ungelöste Rätsel!\r"
      ]
    },
    {
      "id": "msg_0149_00004",
      "de_DE": [
        "Wenn du KYOGRE einem besonders\n",
        "fähigen Pokémon-Professor zeigst,\f",
        "kann er dir vielleicht weiterhelfen!\r",
        "Tjaja, die Zusammenhänge zwischen\n",
        "diesen Sagen und den Pokémon sind\f",
        "schier unendlich!\r",
        "In Ordnung! Ich hoffe, wir sehen uns\n",
        "mal irgendwo wieder!\r"
      ]
    }
  ]
}
