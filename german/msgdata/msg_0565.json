    {
      "id": "msg_0565_00000",
      "de_DE": [
        "Die Orden aus den Pokémon-Arenen\n",
        "gelten als Beweis der Stärke eines\f",
        "Pokémon-Trainers.\r",
        "Je mehr du von ihnen gesammelt hast,\n",
        "desto größer ist auch deine Auswahl\f",
        "im Pokémon-Supermarkt!"
      ]
    },
    {
      "id": "msg_0565_00001",
      "de_DE": [
        "Mit einem Superball lassen sich Pokémon\n",
        "sehr viel leichter fangen als mit einem\f",
        "regulären Pokéball.\r",
        "Aber manchmal geht einfach nichts\n",
        "über einen von Kurts Bällen!"
      ]
    }
  ]
}
