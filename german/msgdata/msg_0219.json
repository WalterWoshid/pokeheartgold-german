  "messages": [
    {
      "id": "msg_0219_00000",
      "garbage": 80
    },
    {
      "id": "msg_0219_00001",
      "de_DE": [
        "......................................\n",
        "......................................\r",
        "Guääähn......................\n",
        "......................................\r",
        "Was? Es ist ja schon\n",
        "taghell da draußen!\r"
      ]
    },
    {
      "id": "msg_0219_00002",
      "de_DE": [
        "......................................\n",
        "......................................\r",
        "Guääähn......................\n",
        "......................................\r",
        "Hm? Was? Es ist schon so spät?\n",
        "Oh nein! Ich habe verschlafen!\r"
      ]
    },
    {
      "id": "msg_0219_00003",
      "de_DE": [
        "......................................\n",
        "......................................\r",
        "Hmmm... sieht so aus, als\n",
        "wäre bald Sonnenuntergang.\r",
        "...Das nennt man dann wohl\n",
        "“Zwielicht”, oder nicht?\r"
      ]
    },
    {
      "id": "msg_0219_00004",
      "de_DE": [
        "..........................................\n",
        "..........................................\r",
        "Hmmm... faszinierend...\n",
        "..........................................\r",
        "Was? Oh! Entschuldige bitte!\n",
        "Ich habe nur gerade ein Buch gelesen!\r"
      ]
    },
    {
      "id": "msg_0219_00005",
      "de_DE": [
        "......................................\n",
        "......................................\r",
        "Guääähn......................\n",
        "......................................\r",
        "Was? Besuch? Jetzt noch?\n",
        "Zu dieser nachtschlafenden Zeit?\r"
      ]
    },
    {
      "id": "msg_0219_00006",
      "de_DE": [
        "Oh, entschuldige\n",
        "die Verspätung!\r",
        "Willkommen in der\n",
        "Welt der Pokémon!\r",
        "Mein Name ist Professor Eich!\r",
        "Man nennt mich auch\n",
        "den Pokémon-Professor.\r",
        "Ist das dein erstes Abenteuer?\r",
        "Kein Problem! Ich erzähle dir alles über\n",
        "diese Welt, was du wissen musst!\r"
      ]
    },
    {
      "id": "msg_0219_00007",
      "de_DE": [
        "Zuerst erkläre ich dir ein paar\n",
        "wichtige Dinge zu diesem Spiel.\n",
        "\n",
        "Berühre eines der Themen\n",
        "auf dem unteren Bildschirm,\n",
        "wenn du mehr dazu wissen möchtest!"
      ]
    },
    {
      "id": "msg_0219_00008",
      "garbage": 34
    },
    {
      "id": "msg_0219_00009",
      "de_DE": [
        "Ich erkläre dir nun die Steuerung.\n",
        "\n",
        "Du steuerst das Spiel, indem du\n",
        "den unteren Bildschirm berührst.\n",
        "Man sagt auch “Touchscreen” dazu.\n",
        "\n",
        "Berühre jetzt die Schaltfläche\n",
        "in der rechten unteren Ecke."
      ]
    },
    {
      "id": "msg_0219_00010",
      "de_DE": [
        "Indem du den Bildschirm berührst,\n",
        "kannst du eine Auswahl tätigen oder\n",
        "Dialoge beschleunigen."
      ]
    },
    {
      "id": "msg_0219_00011",
      "de_DE": [
        "Alternativ kannst du auch den\n",
        "A-Knopf drücken, sobald ein\n",
        "“A” im Feld erscheint."
      ]
    },
    {
      "id": "msg_0219_00012",
      "de_DE": [
        "Je nach Spielszene erscheinen\n",
        "unterschiedliche Bedienelemente\n",
        "auf dem Touchscreen."
      ]
    },
    {
      "id": "msg_0219_00013",
      "de_DE": [
        "Als Nächstes erkläre ich dir,\n",
        "wie du die Knöpfe bedienst.\n",
        "\n",
        "Deine Hauptspielfigur bewegst du\n",
        "mithilfe des Steuerkreuzes."
      ]
    },
    {
      "id": "msg_0219_00014",
      "de_DE": [
        "Als Nächstes erkläre ich dir,\n",
        "wie du die Knöpfe bedienst.\n",
        "\n",
        "Deine Hauptspielfigur bewegst du\n",
        "mithilfe des Steuerkreuzes.\n",
        "\n",
        "Mittels des Steuerkreuzes kannst\n",
        "du auch durch Listen blättern."
      ]
    },
    {
      "id": "msg_0219_00015",
      "de_DE": [
        "Alternativ kannst du die Bildschirme\n",
        "auch mittels des Steuerkreuzes\n",
        "bedienen, anstatt sie zu berühren."
      ]
    },
    {
      "id": "msg_0219_00016",
      "de_DE": [
        "Bestätigt Auswahl, überprüft\n",
        "Dinge, Dialoge, scrollt Text.\n",
        "\n",
        "Beendet eine Aktion, einen Modus\n",
        "und widerruft eine Auswahl."
      ]
    },
    {
      "id": "msg_0219_00017",
      "de_DE": [
        "Ins Menü wechseln.\n",
        "\n",
        "Item verwenden, das auf\n",
        "diese Taste gelegt wurde,\n",
        "wie zum Beispiel das Fahrrad."
      ]
    },
    {
      "id": "msg_0219_00018",
      "garbage": 20
    },
    {
      "id": "msg_0219_00019",
      "garbage": 34
    },
    {
      "id": "msg_0219_00020",
      "garbage": 107
    },
    {
      "id": "msg_0219_00021",
      "garbage": 56
    },
    {
      "id": "msg_0219_00022",
      "garbage": 69
    },
    {
      "id": "msg_0219_00023",
      "de_DE": [
        "Erscheint dieses Zeichen auf dem\n",
        "Bildschirm, stehen dir\n",
        "verschiedene Schaltflächen zur\n",
        "Verfügung, die du auf dem\n",
        "Touchscreen berühren kannst,\n",
        "um Aktionen durchzuführen."
      ]
    },
    {
      "id": "msg_0219_00024",
      "garbage": 25
    },
    {
      "id": "msg_0219_00025",
      "de_DE": "{YESNO 0}"
    },
    {
      "id": "msg_0219_00026",
      "de_DE": "Hast du das so weit verstanden?{YESNO 0}"
    },
    {
      "id": "msg_0219_00027",
      "garbage": 33
    },
    {
      "id": "msg_0219_00028",
      "de_DE": [
        "In der Welt, die dir nun offensteht,\n",
        "wartet ein großes Abenteuer\n",
        "auf dich, in dem du der Held bist."
      ]
    },
    {
      "id": "msg_0219_00029",
      "de_DE": [
        "Rede mit den Leuten und überprüfe\n",
        "Dinge, wo immer du bist. In\n",
        "Städten, auf Straßen oder in\n",
        "Höhlen.\n",
        "Sammele überall Informationen,\n",
        "nutze jede erdenkliche Quelle."
      ]
    },
    {
      "id": "msg_0219_00030",
      "de_DE": [
        "Neue Wege werden sich auftun,\n",
        "indem du Menschen in Not hilfst,\n",
        "Herausforderungen meisterst und\n",
        "Rätsel löst."
      ]
    },
    {
      "id": "msg_0219_00031",
      "de_DE": [
        "Manchmal wirst du von anderen\n",
        "herausgefordert und von wilden\n",
        "Geschöpfen angegriffen werden.\n",
        "\n",
        "Meistere diese Herausforderungen\n",
        "und gewinne an Stärke."
      ]
    },
    {
      "id": "msg_0219_00032",
      "de_DE": [
        "Dennoch geht es nicht nur\n",
        "darum, stärker zu werden!"
      ]
    },
    {
      "id": "msg_0219_00033",
      "de_DE": [
        "Während deines Abenteuers\n",
        "interagierst du hoffentlich mit\n",
        "allen möglichen Personen, um\n",
        "deinen Charakter zu festigen.\n",
        "\n",
        "Das ist das eigentliche Ziel\n",
        "dieses Abenteuers."
      ]
    },
    {
      "id": "msg_0219_00034",
      "de_DE": [
        "Diese Welt wird von Wesen bewohnt,\n",
        "die man Pokémon nennt!\r"
      ]
    },
    {
      "id": "msg_0219_00035",
      "de_DE": [
        "Wir Menschen leben mit den Pokémon\n",
        "ein Leben in Freundschaft.\r",
        "Wir teilen unsere Freizeit\n",
        "und wir arbeiten zusammen.\r",
        "Manche Menschen setzen Pokémon\n",
        "im Kampf ein und stärken so\f",
        "das Band, das sie verbindet.\r",
        "Und was ich tue, willst du wissen?\r",
        "Ich widme mich der Forschung, damit wir\n",
        "mehr und mehr über die Pokémon lernen.\r"
      ]
    },
    {
      "id": "msg_0219_00036",
      "de_DE": [
        "...Jetzt bin ich aber langsam neugierig\n",
        "darauf, wen ich da vor mir habe!\r"
      ]
    },
    {
      "id": "msg_0219_00037",
      "de_DE": [
        "Bist du ein Junge?\n",
        "Oder bist du ein Mädchen?\f",
        "Verrätst du es mir?{YESNO 0}"
      ]
    },
    {
      "id": "msg_0219_00038",
      "de_DE": "Dann bist du also ein Junge?{YESNO 0}"
    },
    {
      "id": "msg_0219_00039",
      "de_DE": "Dann bist du also ein Mädchen?{YESNO 0}"
    },
    {
      "id": "msg_0219_00040",
      "de_DE": "Verrätst du mir auch deinen Namen?"
    },
    {
      "id": "msg_0219_00041",
      "de_DE": "Ah, du bist also {STRVAR_1 3, 0, 0}?{YESNO 0}"
    },
    {
      "id": "msg_0219_00042",
      "de_DE": "Ah, du bist also {STRVAR_1 3, 0, 0}?{YESNO 0}"
    },
    {
      "id": "msg_0219_00043",
      "de_DE": [
        "Also, {STRVAR_1 3, 0, 0}!\n",
        "Bist du startklar?\r",
        "Denn gleich tauchst du\n",
        "ein in dein ganz eigenes Abenteuer!\r",
        "Viele Erfahrungen warten auf dich,\n",
        "schöne wie auch traurige!\r",
        "Große Träume und großes Abenteuer!\n",
        "Hier, in der Welt der Pokémon!\f",
        "Leg einfach los!\r",
        "Wir sehen uns später wieder!\r"
      ]
    },
    {
      "id": "msg_0219_00044",
      "de_DE": "STEUERUNG"
    },
    {
      "id": "msg_0219_00045",
      "de_DE": "ABENTEUER"
    },
    {
