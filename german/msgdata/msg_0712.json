{
  "key": 63652,
  "messages": [
    {
      "id": "msg_0712_00000",
      "de_DE": "Angelo"
    },
    {
      "id": "msg_0712_00001",
      "de_DE": [
        "Halten junge Leute denn heutzutage\n",
        "gar nichts mehr vom Angeln?\r",
        "Wart’s nur ab! Ich zeige dir die\n",
        "faszinierende Welt der Angelkunst!\f",
        "Tauschst du deine Nummer mit mir? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0712_00002",
      "de_DE": [
        "Hurra!\n",
        "Ein junger Mensch, der mir seine Nummer\f",
        "gibt! Oh, ich bin so überglücklich!"
      ]
    },
    {
      "id": "msg_0712_00003",
      "de_DE": [
        "Oh...\r",
        "Seufz... meine eigenen Kinder wollen mir\n",
        "auch nicht ihre Nummern geben...\r",
        "Sind denn alle jungen Leute\n",
        "heutzutage so?"
      ]
    },
    {
      "id": "msg_0712_00004",
      "de_DE": [
        "Hm? Oh, dir macht es also doch nichts\n",
        "aus, mit einem alten Knacker wie mir\f",
        "Freundschaft zu schließen?!? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0712_00005",
      "de_DE": [
        "Ich stehe doch gleich hier! Komm lieber\n",
        "rüber. Telefone sind so unpersönlich."
      ]
    },
    {
      "id": "msg_0712_00006",
      "de_DE": [
        "Ich verbringe mehr Zeit\n",
        "mit meinem {STRVAR_1 0, 10, 0}\f",
        "als mit meinen eigenen Kindern.\f",
        "Das ist in der Tat schade.\r",
        "Ich hoffe, du vergisst nicht, ab und zu\n",
        "auch einmal deine Mama anzurufen?"
      ]
    },
    {
      "id": "msg_0712_00007",
      "de_DE": [
        "Hör dir das an! Neulich habe\n",
        "ich ein wildes {STRVAR_1 0, 11, 0} besiegt.\f",
        "Als ich es meinem Sohn erzählte, sagte\f",
        "der nur, das könne er auch selbst.\r",
        "Er ist wirklich aufsässig geworden...\r",
        "Vergisst du auch nicht, regelmäßig deine\n",
        "Mama anzurufen?"
      ]
    },
    {
      "id": "msg_0712_00008",
      "de_DE": [
        "Gestern ist mir ein wildes {STRVAR_1 0, 11, 0}\n",
        "direkt vor den Augen\f",
        "meines Sohnes entwischt.\r",
        "Ich war total am Boden zerstört, bis\n",
        "er seine Pokébälle mit mir geteilt hat!\r",
        "Haha, das hat mir den Tag gerettet!\r",
        "Vergisst du auch nicht, regelmäßig deine\n",
        "Mama anzurufen?"
      ]
    },
    {
      "id": "msg_0712_00009",
      "de_DE": [
        "Würdest du wieder einmal gegen\n",
        "mich kämpfen?\r",
        "...Oh, das höre ich gerne!\r",
        "Du bist umgänglich für ein Kind.\n",
        "Gut, ich warte hier: {STRVAR_1 4, 3, 0}!"
      ]
    },
    {
      "id": "msg_0712_00010",
      "de_DE": [
        "Wo bist du? Wir waren doch verabredet!\n",
        "Ich bin hier: {STRVAR_1 4, 3, 0}! \r",
        "Alte Leute lässt man nicht warten!"
      ]
    },
    {
      "id": "msg_0712_00011",
      "de_DE": [
        "Na, alles fit bei dir?\r",
        "Also, meine Form ist PHÄNOMENAL!\r",
        "Ob ich vom Angeln rede?\f",
        "Oder von meinen Pokémon?\r",
        "Wahaha!\n",
        "Na, von beiden natürlich!"
      ]
    }
  ]
}
