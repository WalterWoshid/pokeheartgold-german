  "messages": [
    {
      "id": "msg_0054_00000",
      "de_DE": [
        "Leute, die es bis ganz an die Spitze\n",
        "dieses Turms schaffen, erhalten\f",
        "eine exklusive Attacke!"
      ]
    },
    {
      "id": "msg_0054_00001",
      "de_DE": [
        "Der KNOFENSA-Turm wurde vor\n",
        "langer Zeit als Trainingsstätte\f",
        "für Pokémon errichtet."
      ]
    },
    {
      "id": "msg_0054_00002",
      "de_DE": [
        "Die Trägersäule des Turms soll einst\n",
        "aus einem über 30 Meter hohen\f",
        "KNOFENSA entstanden sein."
      ]
    },
    {
      "id": "msg_0054_00003",
      "de_DE": [
        "Siehst du, wie sie sich bewegt?\n",
        "Die Mönche scheinen oben\f",
        "mitten im Training zu stecken!"
      ]
    },
    {
      "id": "msg_0054_00004",
      "de_DE": [
        "Eine Pokémon-Statue...\n",
        "Sie sieht sehr erhaben aus."
      ]
    }
  ]
}
