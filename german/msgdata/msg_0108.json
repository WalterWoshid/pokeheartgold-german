{
  "key": 5194,
  "messages": [
    {
      "id": "msg_0108_00000",
      "de_DE": [
        "Willkommen im Kampfsaal!\r",
        "Ich stehe dir bei den Einzel- und\n",
        "Doppelkämpfen helfend zur Seite.\r",
        "Beachte bitte, dass diese Kämpfe\n",
        "nur für einen Trainer gedacht sind.\r"
      ]
    },
    {
      "id": "msg_0108_00001",
      "de_DE": [
        "Welcher Herausforderung möchtest\n",
        "du dich gern stellen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_00002",
      "de_DE": [
        "Im Kampfsaal kannst du allein Einzel-\n",
        "oder Doppelkämpfe bestreiten.\r",
        "In einem Einzelkampf trittst du mit\n",
        "einem Pokémon, das mindestens Level\f",
        "30 erreicht hat, an.\r",
        "Im Doppelkampf benötigst du zwei\n",
        "Pokémon derselben Art mit wenigstens\f",
        "Level 30.\r",
        "Siegesserien werden für individuelle\n",
        "Pokémon gespeichert.\r",
        "So hat jede Pokémon-Art die Chance,\n",
        "die Nummer eins zu werden.\r",
        "Beim Betreten des Kampfsaals wirst du\n",
        "gefragt, gegen welchen Typ und Level\f",
        "von Pokémon du kämpfen möchtest.\r",
        "Gelingt es dir, zehn Kämpfe in einer\n",
        "Reihe für dich zu entscheiden, dann\f",
        "erhältst du Gewinnpunkte (GP).\r",
        "Willst du den Kampf unterbrechen,\n",
        "speichere bitte dein Spiel.\r",
        "Speicherst du es nicht,\n",
        "wirst du disqualifiziert.\r",
        "Bitte vergiss das nicht!\r"
      ]
    },
    {
      "id": "msg_0108_00003",
      "de_DE": [
        "Willkommen im Kampfsaal!\r",
        "Ich stehe dir in Sachen Multikampf\n",
        "mit Rat und Tat zur Seite.\r",
        "Bitte beachte, dass diese Art von\n",
        "Herausforderung zwei Trainer braucht.\r"
      ]
    },
    {
      "id": "msg_0108_00004",
      "de_DE": [
        "Möchtest du dich den Multikämpfen\n",
        "im Kampfsaal stellen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_00005",
      "de_DE": [
        "Hier trittst du in Multikämpfen\n",
        "zusammen mit einem Freund an.\r",
        "Ihr müsst ein Pokémon derselben\n",
        "Art verwenden, das mindestens\f",
        "Level 30 hat.\r",
        "Beim Betreten des Kampfsaals werdet ihr\n",
        "gefragt, gegen welchen Typ und Level\f",
        "von Pokémon ihr kämpfen möchtet.\r",
        "Gelingt es euch, zehn Kämpfe in einer\n",
        "Reihe für euch zu entscheiden, dann\f",
        "erhaltet ihr Gewinnpunkte (GP).\r",
        "Beachte bitte, dass eine Multikampf-\n",
        "Herausforderung im Kampfsaal\f",
        "nicht unterbrochen werden kann.\r"
      ]
    },
    {
      "id": "msg_0108_00006",
      "de_DE": "Hoffentlich bis bald mal wieder!"
    },
    {
      "id": "msg_0108_00007",
      "de_DE": [
        "Welche Regel möchtest du für diese\n",
        "Herausforderung aktivieren?\r",
        "Level 50 oder Offener Level?"
      ]
    },
    {
      "id": "msg_0108_00008",
      "de_DE": [
        "Bevor ich dich hereinlasse,\n",
        "musst du das Spiel speichern.\f",
        "Einverstanden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_00009",
      "de_DE": "Bitte hier entlang!"
    },
    {
      "id": "msg_0108_00010",
      "de_DE": [
        "Wir freuen uns auf deinen nächsten\n",
        "Besuch!\r"
      ]
    },
    {
      "id": "msg_0108_00011",
      "de_DE": [
        "Lange nicht gesehen!\r",
        "Du musst das Spiel speichern, bevor du\n",
        "die Herausforderung wieder aufnimmst.\r",
        "Bitte habe Geduld."
      ]
    },
    {
      "id": "msg_0108_00012",
      "de_DE": [
        "Entschuldigung!\r",
        "Vorm Verlassen deiner letzten\n",
        "Herausforderung hast du nicht\f",
        "gespeichert.\r",
        "Aus diesem Grunde wurdest du\n",
        "disqualifiziert!\r"
      ]
    },
    {
      "id": "msg_0108_00013",
      "de_DE": [
        "Glückwunsch!\r",
        "Der Preis für deinen Sieg ist dieses\n",
        "schmucke Erinnerungsfoto!\r"
      ]
    },
    {
      "id": "msg_0108_00014",
      "de_DE": [
        "Das Goldfoto wurde an die Kampfkamera\n",
        "von {STRVAR_1 3, 0, 0} gesendet.\r"
      ]
    },
    {
      "id": "msg_0108_00015",
      "de_DE": [
        "Das Silberfoto wurde an die Kampfkamera\n",
        "von {STRVAR_1 3, 0, 0} gesendet.\r"
      ]
    },
    {
      "id": "msg_0108_00016",
      "de_DE": "EINZELKAMPF"
    },
    {
      "id": "msg_0108_00017",
      "de_DE": "DOPPELKAMPF"
    },
    {
      "id": "msg_0108_00018",
      "de_DE": "HERAUSFORDERN"
    },
    {
      "id": "msg_0108_00019",
      "de_DE": "INFO"
    },
    {
      "id": "msg_0108_00020",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0108_00021",
      "de_DE": "LEVEL 50"
    },
    {
      "id": "msg_0108_00022",
      "de_DE": "OFFENER LEVEL"
    },
    {
      "id": "msg_0108_00023",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0108_00024",
      "de_DE": [
        "Du möchtest gerne starke Pokémon\n",
        "trainieren, hast aber keinen blassen\f",
        "Schimmer, welche sich dafür eignen?\r",
        "Trainer, die genau diese Art von\n",
        "Kummer plagt, sind in der Kampffabrik\f",
        "an der richtigen Adresse!"
      ]
    },
    {
      "id": "msg_0108_00025",
      "de_DE": [
        "Ja, das ist natürlich wahr...\r",
        "Man lernt nie aus im Leben! Aber selbst\n",
        "wenn du etwas über Pokémon-Kämpfe\f",
        "und das Trainerdasein lernen möchtest,\f",
        "bist du hier an der richtigen Adresse..."
      ]
    },
    {
      "id": "msg_0108_00026",
      "de_DE": [
        "Hepp und wusch!\n",
        "Hepp und wusch!\r",
        "Ich habe noch kein eigenes Pokémon.\n",
        "Deshalb übe ich lieber noch ein wenig,\f",
        "wie man Pokébälle richtig wirft."
      ]
    },
    {
      "id": "msg_0108_00027",
      "de_DE": [
        "Ooomi! Ooomiii! Ich habe es geschafft,\n",
        "mir ein paar Accessoires zu ertauschen!\f",
        "Die kriegt alle meine Omi!"
      ]
    },
    {
      "id": "msg_0108_00028",
      "de_DE": [
        "Oh, da freue ich mich aber...\r",
        "Sie ist ja so niedlich, so lebendig und\n",
        "so herzensgut... manchmal weiß ich gar\f",
        "nicht, ob ich so eine Enkelin verdiene..."
      ]
    },
    {
      "id": "msg_0108_00029",
      "de_DE": [
        "Siehst du das kleine Mädchen da\n",
        "drüben bei dieser alten Frau?\f",
        "Sie ist unglaublich stark!\f",
        "Aber man sieht es ihr nicht an!"
      ]
    },
    {
      "id": "msg_0108_00030",
      "de_DE": [
        "Bitte legt fest, wer von euch der\n",
        "“LEITER WERDEN” soll.\r",
        "Der andere Spieler wählt\n",
        "“MITSPIELER” aus. {YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_00031",
      "de_DE": [
        "Drahtlose DS-Datenübertragung\n",
        "initialisieren? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_00032",
      "de_DE": [
        "Du musst das Spiel speichern, bevor ich\n",
        "dich hereinlasse. Bitte habe Geduld."
      ]
    },
    {
      "id": "msg_0108_00033",
      "de_DE": "Bitte Pokémon für den Kampf auswählen.\r"
    },
    {
      "id": "msg_0108_00034",
      "de_DE": [
        "Zurzeit ist für {STRVAR_1 0, 0, 0} eine\n",
        "Siegesserie zwischengespeichert.\r",
        "Aufzeichnung löschen und eine\n",
        "neue für {STRVAR_1 0, 1, 0} starten? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0108_00035",
      "de_DE": [
        "Entschuldigung...\r",
        "Du hast gar kein Pokémon über Level\n",
        "30, das an dem Kampf teilnehmen kann!\r"
      ]
    },
    {
      "id": "msg_0108_00036",
      "de_DE": [
        "Entschuldigung...\r",
        "Für Doppelkämpfe benötigst du zwei\n",
        "Pokémon derselben Art, deren Level\f",
        "über 30 ist.\r"
      ]
    },
    {
      "id": "msg_0108_00037",
      "de_DE": [
        "Hmmm... Eier dürfen hier aber auch\n",
        "nicht mitspielen.\r"
      ]
    },
    {
      "id": "msg_0108_00038",
      "de_DE": [
        "Eier und {STRVAR_1 0, 1, 0} dürfen an den\n",
        "Kämpfen nicht teilnehmen.\r"
      ]
    },
    {
