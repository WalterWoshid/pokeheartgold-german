{
  "key": 33867,
  "messages": [
    {
      "id": "msg_0067_00000",
      "de_DE": [
        "Wir haben die Rufe von allen\n",
        "bekannten Pokémon auf Tonband.\f",
        "Es sind circa 200!"
      ]
    },
    {
      "id": "msg_0067_00001",
      "de_DE": [
        "Als Partner sind Pokémon für\n",
        "einen Trainer unabdingbar!\r",
        "Es tut mir in der Seele weh, wenn\n",
        "sie jemand so herumkommandiert."
      ]
    },
    {
      "id": "msg_0067_00002",
      "de_DE": [
        "Wir sind rund um die Uhr auf Sendung!\r",
        "Ich selbst bin auch 24 Stunden am Tag\n",
        "darum bemüht, unserem Publikum ein\f",
        "spannendes Programm darzubieten!"
      ]
    },
    {
      "id": "msg_0067_00003",
      "de_DE": [
        "Der Anführer von Team Rocket hat sich\n",
        "hinter dieser Tür verbarrikadiert.\r",
        "Sie wurde von innen abgeschlossen, aber\n",
        "der Intendant könnte sie öffnen!\r",
        "Du findest ihn im vierten Stock!\n",
        "Oh bitte, du musst ihn retten!"
      ]
    },
    {
      "id": "msg_0067_00004",
      "de_DE": "Geht es dem Intendanten gut?"
    },
    {
      "id": "msg_0067_00005",
      "de_DE": [
        "Vielen Dank, mein kleiner Retter!\n",
        "Hier hast du eine Belohnung!\r"
      ]
    },
    {
      "id": "msg_0067_00006",
      "de_DE": "{STRVAR_1 3, 0, 0} erhält TM11!"
    },
    {
      "id": "msg_0067_00007",
      "de_DE": [
        "Diese TM enthält die Attacke Sonnentag.\n",
        "Mit ihr kannst du temporär Attacken\f",
        "vom Typ Feuer verstärken."
      ]
    },
    {
      "id": "msg_0067_00008",
      "de_DE": "Hoppla? Deine Taschen sind voll!"
    },
    {
      "id": "msg_0067_00009",
      "de_DE": "Saubere Arbeit!"
    },
    {
      "id": "msg_0067_00010",
      "de_DE": [
        "Die Tür ist verschlossen...\n",
        "du brauchst den Türöffner!"
      ]
    },
    {
      "id": "msg_0067_00011",
      "de_DE": "Das ist der Schlitz für den Türöffner!\r"
    },
    {
      "id": "msg_0067_00012",
      "de_DE": "{STRVAR_1 3, 0, 0} verwendet den Türöffner!\r"
    },
    {
      "id": "msg_0067_00013",
      "de_DE": [
        "Mit dem Türöffner sollte sich diese\n",
        "Tür öffnen lassen!"
      ]
    },
    {
      "id": "msg_0067_00014",
      "de_DE": "Das ist der Schlitz für den Türöffner."
    },
    {
      "id": "msg_0067_00015",
      "de_DE": "2S: Allgemeine Angelegenheiten"
    },
    {
      "id": "msg_0067_00016",
      "de_DE": [
        "Pokémon-Musik\n",
        "Moderiert von Ben... jawollja!"
      ]
    }
  ]
}
