    {
      "id": "msg_0344_00003",
      "de_DE": [
        "Direktor: Mein geliebter Generator!\n",
        "Produziere schön fleißig Energie für\f",
        "die guten Leute von Kanto und beschere\f",
        "ihnen einen unkomplizierten Alltag!"
      ]
    },
    {
      "id": "msg_0344_00004",
      "de_DE": [
        "Wir müssen in Zukunft mehr\n",
        "Wachpersonal abstellen, damit\f",
        "so etwas nicht noch einmal\f",
        "geschehen kann!"
      ]
    },
    {
      "id": "msg_0344_00005",
      "de_DE": [
        "Der Generator versorgt uns jetzt\n",
        "wieder mit genügend Saft!"
      ]
    },
    {
      "id": "msg_0344_00006",
      "de_DE": "Der Generator läuft wieder!"
    },
    {
      "id": "msg_0344_00007",
      "de_DE": [
        "Seit der Generator wieder läuft, \n",
        "ist der Direktor quietschfidel!"
      ]
    },
    {
      "id": "msg_0344_00008",
      "de_DE": [
        "Jetzt können wir endlich auch den\n",
        "Magnetzug wieder anwerfen!"
      ]
    },
    {
      "id": "msg_0344_00009",
      "de_DE": [
        "Ich sammele Pokémon!\n",
        "Hast du ein DIGDRI?\r",
        "Möchtest du es gegen mein\n",
        "MAGNETON tauschen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0344_00010",
      "de_DE": [
        "Klasse!\n",
        "Jetzt habe ich ein DIGDRI!\r",
        "Tausend Dank!"
      ]
    },
    {
      "id": "msg_0344_00011",
      "de_DE": [
        "Häh?\n",
        "Das ist kein DIGDRI!\f",
        "Hmpf, wie enttäuschend..."
      ]
    },
    {
      "id": "msg_0344_00012",
      "de_DE": [
        "Du möchtest nicht tauschen?\n",
        "Hmpf, so eine Enttäuschung..."
      ]
    },
    {
      "id": "msg_0344_00013",
      "de_DE": [
        "Hi!\n",
        "Wie geht es dem MAGNETON,\f",
        "das ich mit dir getauscht habe?"
      ]
    },
    {
      "id": "msg_0344_00014",
      "de_DE": [
        "Grundregeln für die Arbeit im Kraftwerk\r",
        "1. Energie ist nicht unerschöpflich!\n",
        "2. Wir müssen sie sparen, wo wir können!\f",
        "3. Einer für alle und alle für einen!\f",
        "4. Schlamperei wird nicht toleriert!\f",
        "5. Allgemeine Gummisohlenpflicht!\f",
        "6. Der Direktor ist groß und mächtig!"
      ]
    },
    {
      "id": "msg_0344_00015",
      "de_DE": [
        "Umweltfreundliche Energie\n",
        "für einen komfortablen Alltag.\r",
        "...Das Kanto-Kraftwerk!"
      ]
    }
  ]
}
