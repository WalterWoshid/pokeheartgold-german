{
  "key": 10217,
  "messages": [
    {
      "id": "msg_0761_00000",
      "de_DE": [
        "Was machst du bei deinem\n",
        "Pokémon-Abenteuer am liebsten?"
      ]
    },
    {
      "id": "msg_0761_00001",
      "de_DE": [
        "Was für eine Art Trainer\n",
        "würdest du gern sein?"
      ]
    },
    {
      "id": "msg_0761_00002",
      "de_DE": [
        "Mit welchem Pokémon-Typ hast\n",
        "du dein Abenteuer begonnen?"
      ]
    },
    {
      "id": "msg_0761_00003",
      "de_DE": [
        "Wenn du mit Freunden Pokémon\n",
        "spielst, was macht ihr dann so?"
      ]
    },
    {
      "id": "msg_0761_00004",
      "de_DE": [
        "Hast du jemals via Nintendo Wi-Fi\n",
        "Connection Pokémon getauscht?"
      ]
    },
    {
      "id": "msg_0761_00005",
      "de_DE": "Wohin gehst du am häufigsten?"
    },
    {
      "id": "msg_0761_00006",
      "de_DE": [
        "Was kümmert dich am meisten\n",
        "in Bezug auf deine Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00007",
      "de_DE": [
        "Wo spielst du normalerweise\n",
        "Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00008",
      "de_DE": [
        "Was hast du während des Spielens\n",
        "schon einmal gemacht?"
      ]
    },
    {
      "id": "msg_0761_00009",
      "de_DE": [
        "Welcher Status bei deinen Pokémon\n",
        "gefällt dir am wenigsten?"
      ]
    },
    {
      "id": "msg_0761_00010",
      "de_DE": [
        "Welchen Status fügst du nach Reduzie-\n",
        "rung der KP zu, um ein PKMN zu fangen?"
      ]
    },
    {
      "id": "msg_0761_00011",
      "de_DE": [
        "Was verwendest du am häufigsten\n",
        "während deines Abenteuers?"
      ]
    },
    {
      "id": "msg_0761_00012",
      "de_DE": [
        "Wo fängst du am häufigsten\n",
        "Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00013",
      "de_DE": "Wann spielst du Pokémon?"
    },
    {
      "id": "msg_0761_00014",
      "de_DE": "Wer sind deine Pokémon-Rivalen?"
    },
    {
      "id": "msg_0761_00015",
      "de_DE": [
        "Welches Item würdest du gerne\n",
        "selbst mal ausprobieren?"
      ]
    },
    {
      "id": "msg_0761_00016",
      "de_DE": [
        "Das Plaza-Spiel von welchem\n",
        "Pokémon magst du?"
      ]
    },
    {
      "id": "msg_0761_00017",
      "de_DE": [
        "Worauf achtest du bei\n",
        "Attacken besonders?"
      ]
    },
    {
      "id": "msg_0761_00018",
      "de_DE": [
        "Erlaubst du, dass sich dein\n",
        "Lieblings-Pokémon entwickelt?"
      ]
    },
    {
      "id": "msg_0761_00019",
      "de_DE": [
        "Welches Getränk schmeckt\n",
        "wohl am besten?"
      ]
    },
    {
      "id": "msg_0761_00020",
      "de_DE": [
        "Welches Item würdest du\n",
        "gern selbst tragen?"
      ]
    },
    {
      "id": "msg_0761_00021",
      "de_DE": [
        "Über was für eine Art Geschenk\n",
        "freust du dich am meisten?"
      ]
    },
    {
      "id": "msg_0761_00022",
      "de_DE": [
        "Über welches Pokémon freust\n",
        "du dich am meisten?"
      ]
    },
    {
      "id": "msg_0761_00023",
      "de_DE": [
        "Welche Art von Arenaleiter\n",
        "magst du am liebsten?"
      ]
    },
    {
      "id": "msg_0761_00024",
      "de_DE": [
        "Was siehst du in deinem\n",
        "Lieblings-Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00025",
      "de_DE": [
        "Was würdest du tun, wenn\n",
        "du ein Pokémon wärst?"
      ]
    },
    {
      "id": "msg_0761_00026",
      "de_DE": "Was macht dich so richtig wütend?"
    },
    {
      "id": "msg_0761_00027",
      "de_DE": [
        "Welche Art von Musik magst du \n",
        "in den Pokémon-Spielen am liebsten?"
      ]
    },
    {
      "id": "msg_0761_00028",
      "de_DE": [
        "Was machst du mit\n",
        "Technischen Maschinen?"
      ]
    },
    {
      "id": "msg_0761_00029",
      "de_DE": "Wie sehen deine Boxen im PC aus?"
    },
    {
      "id": "msg_0761_00030",
      "de_DE": [
        "Welchen Level haben die sechs\n",
        "Pokémon in deinem Team?"
      ]
    },
    {
      "id": "msg_0761_00031",
      "de_DE": "Was halten deine Pokémon?"
    },
    {
      "id": "msg_0761_00032",
      "de_DE": [
        "Wissen andere Leute, dass\n",
        "du Pokémon magst?"
      ]
    },
    {
      "id": "msg_0761_00033",
      "de_DE": [
        "Womit bewegst du dich während\n",
        "deines Abenteuers am liebsten fort?"
      ]
    },
    {
      "id": "msg_0761_00034",
      "de_DE": [
        "Was setzt du am liebsten\n",
        "in Kämpfen ein?"
      ]
    },
    {
      "id": "msg_0761_00035",
      "de_DE": [
        "Was magst du am meisten\n",
        "an deinen Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00036",
      "de_DE": [
        "Was macht dich beim Spielen\n",
        "mit Pokémon nervös?"
      ]
    },
    {
      "id": "msg_0761_00037",
      "de_DE": [
        "Was machst du mit dem Geld, das\n",
        "du in Kämpfen gewinnst?"
      ]
    },
    {
      "id": "msg_0761_00038",
      "de_DE": [
        "Was von den nachfolgenden\n",
        "Dingen wärst du gern?"
      ]
    },
    {
      "id": "msg_0761_00039",
      "de_DE": [
        "Was ist deiner Meinung nach am\n",
        "wichtigsten bei Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00040",
      "de_DE": [
        "Gab es Trainer, die den gleichen\n",
        "Namen trugen wie du?"
      ]
    },
    {
      "id": "msg_0761_00041",
      "de_DE": [
        "Welche Art von Spitznamen\n",
        "gibst du deinen Pokémon?"
      ]
    },
    {
      "id": "msg_0761_00042",
      "de_DE": [
        "Welche Attacke würdest du am\n",
        "liebsten selbst einmal verwenden?"
      ]
    },
    {
      "id": "msg_0761_00043",
      "de_DE": [
        "Was unternimmst du, wenn\n",
        "ein Pokémon vergiftet wurde?"
      ]
    },
    {
      "id": "msg_0761_00044",
      "de_DE": [
        "Kennst du jemanden, der wie\n",
        "ein Arenaleiter aussieht?"
      ]
    },
    {
      "id": "msg_0761_00045",
      "de_DE": [
        "Welche Attacke würdest du am\n",
        "liebsten selbst einmal verwenden?"
      ]
    },
    {
      "id": "msg_0761_00046",
      "de_DE": [
        "Hast du jemals ein Bild von\n",
        "einem Pokémon gemalt?"
      ]
    },
    {
      "id": "msg_0761_00047",
      "de_DE": [
        "Was interessiert dich an den\n",
        "Trainern, die den Plaza besuchen?"
      ]
    },
    {
      "id": "msg_0761_00048",
      "de_DE": [
        "Worauf konzentrierst du\n",
        "dich in Kämpfen?"
      ]
    },
    {
      "id": "msg_0761_00049",
      "de_DE": [
        "Welche Art von Pokémon\n",
        "magst du am liebsten?"
      ]
    }
  ]
}
