{
  "key": 47028,
  "messages": [
    {
      "id": "msg_0650_00000",
      "de_DE": "Misty"
    },
    {
      "id": "msg_0650_00001",
      "de_DE": [
        "Hallo? Ich verstehe dich kaum!\n",
        "Die Verbindung ist so schlecht!\r",
        "Bitte ruf einmal von woanders an!"
      ]
    },
    {
      "id": "msg_0650_00002",
      "de_DE": [
        "Hallo!\n",
        "Wie geht es dir?\f",
        "Mir geht es gut.\r"
      ]
    },
    {
      "id": "msg_0650_00003",
      "de_DE": [
        "Außer mir gibt es noch viele andere\n",
        "starke Arenaleiter!\f",
        "Du musst dich also anstrengen!"
      ]
    },
    {
      "id": "msg_0650_00004",
      "de_DE": [
        "Wenn man so beliebt ist wie ich, dann\n",
        "ist man immer im Stress...\r",
        "Ah! Am Mittwochmorgen hätte ich\n",
        "eventuell Zeit...\f",
        "Ruf mich doch dann einfach einmal an!"
      ]
    },
    {
      "id": "msg_0650_00005",
      "de_DE": [
        "Also heute hätte ich etwas Zeit...\n",
        "Trittst du noch mal gegen mich an? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0650_00006",
      "de_DE": [
        "Das freut mich!\n",
        "Also, ich warte auf dich im Dojo von\f",
        "Saffronia City!"
      ]
    },
    {
      "id": "msg_0650_00007",
      "de_DE": [
        "Waaas?\n",
        "Spielverderber!"
      ]
    },
    {
      "id": "msg_0650_00008",
      "de_DE": [
        "Wie? Du hast dich außer mir noch mit\n",
        "niemandem zum Rematch verabredet?\r",
        "Da bist du aber nicht ganz ehrlich, gib\n",
        "es zu!"
      ]
    },
    {
      "id": "msg_0650_00009",
      "de_DE": [
        "Also, ich warte auf dich im Dojo von\n",
        "Saffronia City!\f",
        "Ich nehme dich beim Wort!"
      ]
    },
    {
      "id": "msg_0650_00010",
      "de_DE": [
        "Hallo, hier ist Misty!\n",
        "Na, geht es dir gut?\r"
      ]
    },
    {
      "id": "msg_0650_00011",
      "de_DE": [
        "Ich erwarte dich wie abgemacht im Dojo\n",
        "von Saffronia City zum Rematch!\f",
        "Vergiss es ja nicht!"
      ]
    },
    {
      "id": "msg_0650_00012",
      "de_DE": [
        "Hast du schon ganz Kanto bereist?\n",
        "Und? Wie gefällt es dir so, verglichen\f",
        "mit Johto?\r",
        "Es hat landschaftlich viel zu bieten,\n",
        "nicht wahr?\r",
        "Ich liebe ja das Kap bei Route 25!\n",
        "Da kommen so viele Erinnerungen in mir\f",
        "hoch! Du willst wissen, welche?\r",
        "Das werde ich dir bestimmt nicht auf die\n",
        "Nase binden!"
      ]
    },
    {
      "id": "msg_0650_00013",
      "de_DE": [
        "Also, da kam so ein seltsamer Typ in\n",
        "meine Arena...\r",
        "Warst du es, der ihm neulich eine\n",
        "Lektion erteilt hat?\r",
        "Vielen Dank! Nicht nur von mir, sondern\n",
        "von allen aus meiner Arena!"
      ]
    },
    {
      "id": "msg_0650_00014",
      "de_DE": [
        "Hast du das schon gewusst?\n",
        "Wenn man auf der Route 25 die sechs\f",
        "Trainer besiegt, ohne auch nur ein\f",
        "einziges Mal zu verlieren, dann sollen\f",
        "sich alle Liebeswünsche erfüllen!\r",
        "Wie bitte? Noch nie davon gehört?\n",
        "Wie auch! Schließlich hab ich mir das ja\f",
        "auch ausgedacht!"
      ]
    }
  ]
}
