    {
      "id": "msg_0188_00000",
      "de_DE": "Wii-Code überprüfen"
    },
    {
      "id": "msg_0188_00001",
      "de_DE": "Wii-Code registrieren"
    },
    {
      "id": "msg_0188_00002",
      "de_DE": "Wii-Nachr.-Empfang konf."
    },
    {
      "id": "msg_0188_00003",
      "de_DE": "Wii-Nachr.-Einst. entf."
    },
    {
      "id": "msg_0188_00004",
      "de_DE": "Zurück"
    },
    {
      "id": "msg_0188_00005",
      "garbage": 15
    },
    {
