    {
      "id": "msg_0188_00054",
      "de_DE": [
        "Die Nintendo Wi-Fi Connection wird\n",
        "gerade gewartet.\r",
        "Bitte versuche es später noch einmal.\r"
      ]
    },
    {
      "id": "msg_0188_00055",
      "de_DE": [
        "Die Nintendo WFC ist mit starkem\n",
        "Datenverkehr ausgelastet oder steht\f",
        "vorübergehend nicht zur Verfügung.\r",
        "Bitte versuche es später noch einmal.\r"
      ]
    },
    {
      "id": "msg_0188_00056",
      "de_DE": [
        "Keine Verbindung zur Nintendo Wi-Fi\n",
        "Connection möglich.\r"
      ]
    },
    {
