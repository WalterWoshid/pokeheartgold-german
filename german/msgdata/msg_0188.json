    },
    {
      "id": "msg_0188_00009",
      "de_DE": [
        "Ist von deinem derzeitigen Ort eine\n",
        "Verbindung zur Nintendo WFC möglich?"
      ]
    },
    {
      "id": "msg_0188_00010",
      "de_DE": [
        "Bitte registriere dich, sobald eine Ver-\n",
        "bindung zur Nintendo WFC möglich ist.\r"
      ]
    },
    {
      "id": "msg_0188_00011",
      "de_DE": [
        "Wii-Code und Nintendo Wi-Fi Connection-\n",
        "User-Daten dieses Nintendo DS-Systems\f",
        "werden gespeichert.\r",
        "Danach beginnt die Datenübertragung\n",
        "via Nintendo Wi-Fi Connection. Bereit?"
      ]
    },
    {
      "id": "msg_0188_00012",
      "de_DE": [
        "Keine Verbindung zur Nintendo Wi-Fi\n",
        "Connection möglich.\r",
        "Überprüfe bitte deine\n",
        "Verbindungseinstellungen."
      ]
    },
    {
      "id": "msg_0188_00013",
      "de_DE": [
        "Der Registrierungs-Code wurde an deine\n",
        "Wii-Konsole geschickt.\r",
        "Bitte gib den Registrierungs-Code ein."
      ]
    },
    {
      "id": "msg_0188_00014",
      "de_DE": [
        "Verbindung zur Nintendo WFC trennen u.\n",
        "Registrierung des Wii-Codes abbrechen?"
      ]
    },
    {
      "id": "msg_0188_00015",
      "de_DE": [
        "Verbindung zur Nintendo Wi-Fi\n",
        "Connection wird abgebrochen."
      ]
    },
    {
      "id": "msg_0188_00016",
      "de_DE": [
        "Die Verbindung zur Nintendo Wi-Fi\n",
        "Connection wurde unterbrochen."
      ]
    },
    {
      "id": "msg_0188_00017",
      "de_DE": [
        "Bitte gib die letzten vier Ziffern des\n",
        "Registrierungs-Codes aus der\f",
        "Wii-Nachricht ein.\r"
      ]
    },
    {
      "id": "msg_0188_00018",
      "de_DE": [
        "Registrierungs-Code wird bestätigt.\n",
        "Bitte warten..."
      ]
    },
    {
      "id": "msg_0188_00019",
      "de_DE": "Falscher Registrierungs-Code.\r"
    },
    {
      "id": "msg_0188_00020",
      "de_DE": "Dein Wii-Code wurde registriert.\r"
    },
    {
      "id": "msg_0188_00021",
      "de_DE": [
        "Es wird ein Passwort zur Bestätigung\n",
        "deines Wii-Codes benötigt.\r",
        "Gib bitte eine vierstellige Zahl\n",
        "ein und merke sie dir als dein\f",
        "Wii-Code-Passwort.\r"
      ]
    },
    {
      "id": "msg_0188_00022",
      "garbage": 21
    },
    {
      "id": "msg_0188_00023",
      "garbage": 34
    },
    {
      "id": "msg_0188_00024",
      "de_DE": [
        "Dein Wii-Code-Passwort\n",
        "wurde festgelegt.\r"
      ]
    },
    {
      "id": "msg_0188_00025",
      "de_DE": [
        "Auf Wunsch kannst du eine Wii-Nachricht\n",
        "erhalten, wenn ein Tausch\f",
        "über die GTS vonstatten geht.\r",
        "Möchtest du per Wii-Nachricht\n",
        "informiert werden?"
      ]
    },
    {
      "id": "msg_0188_00026",
      "de_DE": [
        "Du hast dich für den Empfang von\n",
        "Wii-Nachrichten entschieden.\r",
        "Bei der nächsten Verwendung der GTS\n",
        "wirst du über Tauschvorgänge per\f",
        "Wii-Nachrichten informiert.\r"
      ]
    },
    {
      "id": "msg_0188_00027",
      "de_DE": [
        "Du wünschst keinen Empfang von\n",
        "Wii-Nachrichten.\r",
        "Bei der nächsten Verwendung der GTS\n",
        "wirst du nicht über Tauschvorgänge per\f",
        "Wii-Nachrichten informiert.\r"
      ]
    },
    {
      "id": "msg_0188_00028",
      "de_DE": [
        "Deine Wii-Nachrichten-Einstellungen und\n",
        "das Passwort werden gelöscht. Okay?"
      ]
    },
    {
      "id": "msg_0188_00029",
      "de_DE": [
        "Alle Wii-Nachrichten-Einstellungen\n",
        "wurden gelöscht.\r"
      ]
    },
    {
      "id": "msg_0188_00030",
      "garbage": 19
    },
    {
      "id": "msg_0188_00031",
      "garbage": 15
    },
    {
      "id": "msg_0188_00032",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0188_00033",
      "de_DE": "{STRVAR_1 3, 0, 0} hat das Spiel gespeichert."
    },
    {
      "id": "msg_0188_00034",
      "de_DE": "Fehler beim Speichervorgang."
    },
    {
      "id": "msg_0188_00035",
      "garbage": 22
    },
    {
      "id": "msg_0188_00036",
      "garbage": 43
    },
    {
      "id": "msg_0188_00037",
      "garbage": 23
    },
    {
      "id": "msg_0188_00038",
      "de_DE": [
        "Bitte gib zur Bestätigung noch einmal\n",
        "deinen Wii-Code ein.\r"
      ]
    },
    {
      "id": "msg_0188_00039",
      "de_DE": [
        "Der Wii-Code stimmt nicht überein.\n",
        "Bitte gib ihn erneut ein.\r"
      ]
    },
    {
      "id": "msg_0188_00040",
      "de_DE": [
        "Falsches Passwort.\n",
        "Bitte gib es erneut ein.\r"
      ]
    },
    {
      "id": "msg_0188_00041",
      "de_DE": [
        "Dein Wii-Code lautet:\n",
        "{STRVAR_1 53, 0, 0} {STRVAR_1 53, 1, 0} {STRVAR_1 53, 2, 0} {STRVAR_1 53, 3, 0}\r"
      ]
    },
    {
      "id": "msg_0188_00042",
      "de_DE": "Nicht registrieren"
    },
    {
      "id": "msg_0188_00043",
      "de_DE": "Registrieren"
    },
    {
      "id": "msg_0188_00044",
      "de_DE": [
        "{COLOR 1}Einen Wii-Code registrieren{COLOR 0}\n",
        "\n",
        "Falls dein Wii-Code registriert ist,\n",
        "wirst du per Wii-Nachricht informiert,\n",
        "wenn über die GTS ein Tauschvorgang\n",
        "vonstatten geht.\n",
        "\n",
        "Für genauere Informationen lies bitte in der\n",
        "Bedienungsanleitung nach.\n",
        "\n",
        "Möchtest du deinen Wii-Code registrieren?"
      ]
    },
