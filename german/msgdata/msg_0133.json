{
  "key": 55218,
  "messages": [
    {
      "id": "msg_0133_00000",
      "de_DE": [
        "Baoba: Oh, du bist es! Danke, dass du\n",
        "den weiten Weg auf dich genommen hast!\f",
        "Willkommen in der Safari-Zone!\r",
        "Wir haben gerade erst unsere Pforten\n",
        "geöffnet, aber auf Safari gehen kannst\f",
        "du trotzdem schon! Tobe dich ruhig aus!\r"
      ]
    },
    {
      "id": "msg_0133_00001",
      "de_DE": [
        "Baoba: Ach ja! Wir werden die Safari-\n",
        "Zone auch in Zukunft weiter verbessern.\f",
        "Wenn es irgendwas Neues zu berichten\f",
        "gibt, melde ich mich per Pokécom bei dir!\r"
      ]
    },
    {
      "id": "msg_0133_00002",
      "de_DE": [
        "Das ist also die Safari-Zone...\r",
        "Es ist echt seltsam... seit ich hier\n",
        "bin, komme ich mir wie auf einem\f",
        "Jahrmarkt in einem fremden Land\f",
        "vor - weit, weit weg..."
      ]
    },
    {
      "id": "msg_0133_00003",
      "de_DE": [
        "... ... ...\n",
        "(Ich bin nicht sehr gesprächig.)"
      ]
    },
    {
      "id": "msg_0133_00004",
      "de_DE": "KANGAMA: ... ... ..."
    },
    {
      "id": "msg_0133_00005",
      "de_DE": [
        "Junge, Junge, hier in der Safari-Zone\n",
        "wird’s einem echt nicht langweilig!\r",
        "Ich laufe hier wie besessen nur noch\n",
        "irgendwelchen Pokémon hinterher!\r",
        "Ich befürchte, dieses PUMMELUFF hier,\n",
        "mein ständiger Begleiter, ist deswegen\f",
        "etwas angefressen..."
      ]
    },
    {
      "id": "msg_0133_00006",
      "de_DE": "PUMMELUFF: Uff..."
    },
    {
      "id": "msg_0133_00007",
      "de_DE": [
        "Safari, Safari!\n",
        "So ein Spaß!\r",
        "Safari, Safari!\n",
        "Hier geb ich Gas!\r",
        "Wo in Schilf und Schlamm in Massen die\n",
        "Pokémon lauern im hohen Gras!\r",
        "Dieses Lied habe ich selbst geschrieben!\r",
        "Singe es doch auf deinen Streifzügen\n",
        "durch die Safari-Zone vor dich hin!"
      ]
    },
    {
      "id": "msg_0133_00008",
      "de_DE": [
        "Mein Safariball rast unterm Firmament\n",
        "vorbei an der Sonne,\f",
        "die mein Haupt in Schweiß tränkt,\r",
        "wie ein Blitz in meinem Verstand\n",
        "beim Gedenken an jenen Tag in der Zone,\r",
        "an dem ich dich fand...\n",
        "Bei der Safari, wie ich betone!\r",
        "Jetzt hat das Lied so richtig Schmiss!\r",
        "Was meinst du, das gäbe doch\n",
        "ein prima Werbelied ab, oder?"
      ]
    },
    {
      "id": "msg_0133_00009",
      "de_DE": [
        "Ich habe mein eigenes Geschäft eröffnet\n",
        "und verkaufe hier Pokémon-Drinks.\r",
        "Ganz eingearbeitet habe ich mich zwar\n",
        "noch nicht, aber ich gebe mein Bestes!\r"
      ]
    },
    {
      "id": "msg_0133_00010",
      "de_DE": [
        "Wie, was? Du möchtest etwas kaufen?\n",
        "Warte bitte einen Moment!\f",
        "Ich muss erst den Laden aufmachen...\f",
        "... ... ...\r"
      ]
    },
    {
      "id": "msg_0133_00011",
      "de_DE": "SMETTBO: Smett..."
    },
    {
      "id": "msg_0133_00012",
      "de_DE": [
        "Unter all den vielen Pokémon sind mir\n",
        "die FLEGMON immer noch am liebsten!\f",
        "Diese kleinen Dinger sind einfach zu süß!\r",
        "Ich höre auch oft von Leuten, dass ich\n",
        "selbst wie ein FLEGMON aussehe!"
      ]
    },
    {
      "id": "msg_0133_00013",
      "de_DE": "FLEGMON: ...Flegmon?"
    },
    {
      "id": "msg_0133_00014",
      "de_DE": [
        "Die Entscheidung ist gefallen!\n",
        "Mein allererstes Pokémon fange\f",
        "ich mir in der Safari-Zone!"
      ]
    },
    {
      "id": "msg_0133_00015",
      "de_DE": [
        "Du hältst es bestimmt für extrem\n",
        "futuristisch, deine Safari-Erfahrung\f",
        "genau an deinen Geschmack anpassen\f",
        "zu können, oder?\r",
        "Tja, aber in Wahrheit..."
      ]
    },
    {
      "id": "msg_0133_00016",
      "de_DE": [
        "Pfuuuh...\n",
        "Ich bin am Ende meiner Kräfte...\r",
        "Für diese Arbeit braucht man\n",
        "echt einiges an Kondition..."
      ]
    },
    {
      "id": "msg_0133_00017",
      "de_DE": [
        "Willkommen in der Safari-Zone!\r",
        "Folge dem ungebändigten Ruf der Wildnis\n",
        "mit maximalem Komfort!"
      ]
    }
  ]
}
