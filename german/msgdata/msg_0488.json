{
  "key": 54295,
  "messages": [
    {
      "id": "msg_0488_00000",
      "de_DE": [
        "Ich bin der Vorsitzende des\n",
        "Pokémon Fan Clubs!\r",
        "Ich habe schon mehr als 150\n",
        "Pokémon trainiert!\r",
        "Ach, ich könnte einfach stundenlang\n",
        "über Pokémon reden...\r",
        "Möchtest du eine meiner\n",
        "tollen Pokémon-Geschichten hören? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0488_00001",
      "de_DE": [
        "Sehr schön! Dann will ich doch gleich\n",
        "mal deinem Wunsch nachkommen!\r",
        "Mein geliebtes GALLOPA ist... blabla...\r",
        "Aber es hat auch... blabla... wobei...\n",
        "...blablabla... es ist eben so niedlich...\f",
        "Ach ja! Da wird mir ganz warm ums Herz!\f",
        "...blablabla... und überhaupt... bla...\f",
        "... mein ganzes Leben habe ich... bla...\f",
        "...würde man zumindest denken! Bla...\f",
        "Und ich dann so: “Urgs!”...bla...\r",
        "...aber es kuschelt eben gerne...\n",
        "...blabla, ja, wild und schön, blabla...\f",
        "Oha! So spät ist es schon? Mit dir\f",
        "vergisst man echt die Zeit!\r",
        "Danke, dass du dir so geduldig meine\n",
        "Schwärmerei angehört hast! Dafür\f",
        "bekommst du jetzt auch was von mir!\r"
      ]
    },
    {
      "id": "msg_0488_00002",
      "garbage": 20
    },
    {
      "id": "msg_0488_00003",
      "de_DE": [
        "Dieses Sonderbonbon macht\n",
        "schlaffe Pokémon fit!\r",
        "Aber meine Pokémon sollen lieber\n",
        "durch Kämpfe stark werden.\r",
        "Du kannst es also haben!"
      ]
    },
    {
      "id": "msg_0488_00004",
      "de_DE": [
        "Oh, hallo {STRVAR_1 3, 0, 0}!\r",
        "Bist du hier, um ein paar neue\n",
        "wunderbare Geschichten über mich\f",
        "und meine Pokémon zu hören?\r",
        "Nein? Echt nicht? Hm, zu schade...\n",
        "Du bist so ein Langweiler...\n"
      ]
    },
    {
      "id": "msg_0488_00005",
      "de_DE": [
        "Oh, hallo {STRVAR_1 3, 0, 0}!\r",
        "Bist du hier, um ein paar neue\n",
        "wunderbare Geschichten über mich\f",
        "und meine Pokémon zu hören?\r",
        "Nein? Echt nicht? Hm, zu schade...\n",
        "Du bist so ein Langweiler...\n"
      ]
    },
    {
      "id": "msg_0488_00006",
      "de_DE": [
        "Du bist echt ein Langweiler...\r",
        "Komm wieder, wenn du das Bedürfnis\n",
        "verspürst, doch eine meiner\f",
        "wunderbaren Geschichten zu hören!"
      ]
    },
    {
      "id": "msg_0488_00007",
      "de_DE": "Du kannst nicht mehr tragen!"
    },
    {
      "id": "msg_0488_00008",
      "de_DE": [
        "Unser Vorsitzender ist wirklich sehr\n",
        "redselig, wenn es um Pokémon geht."
      ]
    },
    {
      "id": "msg_0488_00009",
      "de_DE": [
        "Es ist einfach zu niedlich, wenn PIEPI\n",
        "seine Arme nach mir ausstreckt...\r",
        "Hach ja...\n",
        "PIEPI ist einfach zu süß!"
      ]
    },
    {
      "id": "msg_0488_00010",
      "de_DE": [
        "Ich mag PIEPI, aber ich werde es nie\n",
        "schaffen, eins zu fangen. Tja, ich\f",
        "werde mich wohl mit dieser Poképuppe\f",
        "begnügen müssen, die ich gefunden habe."
      ]
    },
    {
      "id": "msg_0488_00011",
      "de_DE": [
        "Ich mag PIEPI, aber ich werde es nie\n",
        "schaffen, eins zu fangen. Tja, ich\f",
        "werde mich wohl mit dieser Poképuppe\f",
        "begnügen müssen, die ich gefunden habe.\r",
        "Moment, ist das wirklich wahr?!\n",
        "Das Mädchen, das diese Puppe verloren\f",
        "hat, ist ganz traurig deswegen?\r",
        "...Klar! Das verstehe ich natürlich!\n",
        "Hier, bringe sie der Kleinen zurück!\r",
        "Ich werde versuchen, mich aus eigener\n",
        "Kraft mit einem PIEPI anzufreunden!\r"
      ]
    },
    {
      "id": "msg_0488_00012",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält die verlorene\n",
        "Poképuppe!"
      ]
    },
    {
      "id": "msg_0488_00013",
      "de_DE": [
        "Irgendwann finde ich ein echtes PIEPI\n",
        "als Freund! Du wirst schon sehen!"
      ]
    },
    {
      "id": "msg_0488_00014",
      "de_DE": [
        "Sieh nur, sieh nur! Mein LORBLATT!\r",
        "Das Blatt auf seinem Köpfchen ist\n",
        "ja so süß und schick!"
      ]
    },
    {
      "id": "msg_0488_00015",
      "de_DE": [
        "Aber das ist doch ein PIEPI!\n",
        "...Hm?\r",
        "Ach, es ist ja doch nur eine Poképuppe!"
      ]
    },
    {
      "id": "msg_0488_00016",
      "de_DE": "LORBLATT: Looorblatt!"
    },
    {
      "id": "msg_0488_00017",
      "de_DE": [
        "Wenn dir jemand eine “wunderbare”\n",
        "Geschichte erzählen will, dann höre\f",
        "ihm einfach geduldig zu."
      ]
    },
    {
      "id": "msg_0488_00018",
      "de_DE": [
        "Wenn jemand so schwärmt, wird einfach\n",
        "doppelt so viel zurückgeschwärmt!"
      ]
    }
  ]
}
