{
  "key": 20259,
  "messages": [
    {
      "id": "msg_0564_00000",
      "de_DE": [
        "Direkt hinter dem Tor liegt\n",
        "der Steineichenwald."
      ]
    },
    {
      "id": "msg_0564_00001",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: Sag mal...\r",
        "Stimmt es eigentlich, dass Team\n",
        "Rocket jetzt wieder da ist?\r",
        "Was? Du hast diese Bande eigenhändig\n",
        "aufgehalten, sagst du?\r",
        "Erzähl mir keine Märchen! Wenn das\n",
        "wirklich stimmt, dann kannst du mir ja\f",
        "bestimmt auch eine Kostprobe deiner\f",
        "Fähigkeiten geben!\r"
      ]
    },
    {
      "id": "msg_0564_00002",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: Ich kann Schwächlinge\n",
        "einfach nicht ausstehen.\r",
        "Das gilt nicht nur für Pokémon,\n",
        "sondern auch für ihre Trainer...\r",
        "Hier verunstalten mir eindeutig zu\n",
        "viele Schwächlinge die Gegend!\r",
        "Team Rocket ist genauso schlimm.\r",
        "Nicht einer von dieser Bande hat\n",
        "was auf dem Kasten.\r",
        "Die Leute von Team Rocket halten sich\n",
        "bloß für die Größten, weil die Zahl ihrer\f",
        "Mitglieder so hoch ist!\r",
        "Aber mir machen sie nichts vor!\r",
        "Ich werde jedem, der sich mir in\n",
        "den Weg stellt, eine Lektion erteilen,\f",
        "genau wie dir...\r"
      ]
    },
    {
      "id": "msg_0564_00003",
      "de_DE": [
        "Hier gibt es nichts zu sehen!\r",
        "Ich stehe hier Wache, weil der Brunnen\n",
        "eine öffentliche Gefahr darstellt und\f",
        "jemand aus dem Dorf versehentlich\f",
        "hineinfallen könnte.\r",
        "Ach ja, bin ich nicht zu gutmütig?"
      ]
    },
    {
      "id": "msg_0564_00004",
      "de_DE": [
        "Hast du schon mal eine FLEGMON-Rute\n",
        "gegessen? Die sollen echt lecker sein!\r",
        "Wenn das mal kein heißer Tipp ist!\n",
        "Ach ja, bin ich nicht zu gutmütig?"
      ]
    },
    {
      "id": "msg_0564_00005",
      "de_DE": [
        "Alle FLEGMON sind aus der\n",
        "Stadt verschwunden...\r",
        "Dabei dachte ich, dass man hier\n",
        "FLEGMON-Ruten kaufen kann..."
      ]
    },
    {
      "id": "msg_0564_00006",
      "de_DE": [
        "Die FLEGMON sind wieder da!\n",
        "Vermutlich haben sie wieder irgendwo\f",
        "gefaulenzt."
      ]
    },
    {
      "id": "msg_0564_00007",
      "de_DE": [
        "Bist du auch hier, um Kurt zu bitten,\n",
        "Pokébälle für dich anzufertigen?\f",
        "Eine Menge Leute wollen das!"
      ]
    },
    {
      "id": "msg_0564_00008",
      "de_DE": [
        "Hinter Azalea City gelangst du in\n",
        "den sogenannten Steineichenwald.\r",
        "Allerdings machen es diese dürren Bäume\n",
        "unmöglich, dort durchzukommen.\r",
        "Nur die Pokémon des Köhlers könnten\n",
        "sie vielleicht aus dem Weg räumen!"
      ]
    },
    {
      "id": "msg_0564_00009",
      "de_DE": [
        "FLEGMON: ... ... ...\r",
        "... ... ...\r"
      ]
    },
    {
      "id": "msg_0564_00010",
      "de_DE": "...Flegmon?"
    },
    {
      "id": "msg_0564_00011",
      "de_DE": [
        "Azalea City\n",
        "Hier hat jeder Pokémon gern."
      ]
    },
    {
      "id": "msg_0564_00012",
      "de_DE": [
        "Kurts Haus\r",
        "Pokéball-Schmied Kurt macht kurzen\n",
        "Prozess mit Aprikokos."
      ]
    },
    {
      "id": "msg_0564_00013",
      "de_DE": [
        "Pokémon-Arena von Azalea City\n",
        "Leiter: Kai\f",
        "Die wandelnde Enzyklopädie für\f",
        "Käfer-Pokémon"
      ]
    },
    {
      "id": "msg_0564_00014",
      "de_DE": [
        "Der FLEGMON-Brunnen\n",
        "Auch bekannt als Regenmacherquelle.\r",
        "Die Leute in dieser Gegend glauben,\n",
        "dass, wann immer ein FLEGMON gähnt,\f",
        "bald Regen fallen wird.\r",
        "Alte Aufzeichnungen besagen, dass vor\n",
        "400 Jahren einmal ein FLEGMON eine\f",
        "Dürre beendet haben soll, indem es\f",
        "gegähnt hat."
      ]
    },
    {
      "id": "msg_0564_00015",
      "de_DE": [
        "Holzkohle-Ofen\r",
        "Die Rohstoffe für die Kohleherstellung\n",
        "werden von PORENTA beschafft."
      ]
    },
    {
      "id": "msg_0564_00016",
      "de_DE": [
        "Was soll das werden? Weißt du denn\n",
        "nicht, mit wem du es hier zu tun hast?\r",
        "Na, mit Team Rocket natürlich!\r",
        "...Team Rocket dürfte es eigentlich\n",
        "gar nicht mehr geben, sagst du?\r",
        "Ha! Dass ich nicht lache!\r",
        "Team Rocket ist aktiver denn je!\r",
        "Wir haben uns zwar vor drei Jahren\n",
        "vorübergehend aufgelöst, aber jetzt\f",
        "stecken wir mitten in unserem Comeback!\r",
        "Der Traum unseres Oberhaupts Giovanni\n",
        "wird schon bald wahr werden!\r",
        "Aber das geht dich überhaupt nichts an!\n",
        "Lass mich einfach in Frieden!\r"
      ]
    },
    {
      "id": "msg_0564_00017",
      "de_DE": "RUMMS!\r"
    },
    {
      "id": "msg_0564_00018",
      "de_DE": [
        "In dieser Stadt lebt ein Mann namens\n",
        "Kurt. Auf ihn ist immer Verlass!\f",
        "Er wird bestimmt etwas unternehmen..."
      ]
    },
    {
      "id": "msg_0564_00019",
      "de_DE": "Auf Kurt ist einfach immer Verlass!"
    }
  ]
}
