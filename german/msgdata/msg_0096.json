{
  "key": 9338,
  "messages": [
    {
      "id": "msg_0096_00000",
      "de_DE": [
        "Willkommen im Duellturm!\r",
        "Ich bin die Anweiserin für die\n",
        "Einzel- und Doppelkampfräume.\r"
      ]
    },
    {
      "id": "msg_0096_00001",
      "de_DE": [
        "Möchtest du die Herausforderung\n",
        "des Kampfraumes beginnen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0096_00002",
      "de_DE": "Hoffentlich kommst du bald wieder!"
    },
    {
      "id": "msg_0096_00003",
      "de_DE": [
        "Der Duellturm bietet die Möglichkeit,\n",
        "Einzel- und Doppelkämpfe auszutragen.\r",
        "Nimmst du eine Herausforderung an,\n",
        "hört diese erst auf, wenn du verloren\f",
        "oder alle Kämpfe bestritten hast.\r",
        "In den Einzelkämpfen trittst du mit\n",
        "drei Pokémon an.\r",
        "In die Doppelkämpfe hingegen ziehst du\n",
        "mit vier Pokémon ein.\r",
        "Die Kämpfe finden in den sogenannten\n",
        "Kampfräumen statt, von denen es im\f",
        "Duellturm eine ganze Menge gibt!\r",
        "In jedem dieser Räume warten sieben\n",
        "Trainer auf deine Herausforderung.\r",
        "Schaffst du es, alle sieben zu\n",
        "besiegen, erhältst du\f",
        "Gewinnpunkte (GP).\r",
        "Willst du den Kampf unterbrechen,\n",
        "speichere bitte dein Spiel.\r",
        "Speicherst du es nicht, wirst du\n",
        "disqualifiziert.\r",
        "Bitte vergiss das nicht!\r"
      ]
    },
    {
      "id": "msg_0096_00004",
      "de_DE": [
        "Welchen Kampfraum möchtest du?\n",
        "Einzel- oder Doppelkampfraum? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0096_00005",
      "garbage": 192
    },
    {
      "id": "msg_0096_00006",
      "garbage": 258
    },
    {
      "id": "msg_0096_00007",
      "garbage": 36
    },
    {
      "id": "msg_0096_00008",
      "de_DE": [
        "Wähle die Pokémon,\n",
        "die teilnehmen sollen.\r"
      ]
    },
    {
      "id": "msg_0096_00009",
      "de_DE": [
        "Du kannst nur mit unterschiedlichen\n",
        "Pokémon antreten!\r"
      ]
    },
    {
      "id": "msg_0096_00010",
      "de_DE": [
        "Nur unterschiedliche Items\n",
        "dürfen getragen werden.\r"
      ]
    },
    {
      "id": "msg_0096_00011",
      "de_DE": [
        "Ich werde dir jetzt den\n",
        "Kampfraum zeigen."
      ]
    },
    {
      "id": "msg_0096_00012",
      "de_DE": [
        "Herzlichen Glückwunsch!\n",
        "Alle 7 Kämpfe wurden gewonnen!\r"
      ]
    },
    {
      "id": "msg_0096_00013",
      "de_DE": [
        "Herzlichen Glückwunsch!\n",
        "Du hast den Kampfkoloss besiegt!\r",
        "In Anerkennung deines herausragenden\n",
        "Talents geben wir dir Gewinnpunkte.\r",
        "{STRVAR_1 3, 0, 0} erhält {STRVAR_1 50, 1, 0} GP.\r"
      ]
    },
    {
      "id": "msg_0096_00014",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0096_00015",
      "de_DE": "Komm bald wieder!"
    },
    {
      "id": "msg_0096_00016",
      "de_DE": [
        "Wir haben schon auf dich gewartet!\r",
        "Bevor du einen Kampfraum betrittst,\n",
        "wird dein Spiel gespeichert.\r",
        "Bitte warte einen Moment."
      ]
    },
    {
      "id": "msg_0096_00017",
      "garbage": 22
    },
    {
      "id": "msg_0096_00018",
      "garbage": 9
    },
    {
      "id": "msg_0096_00019",
      "de_DE": [
        "Entschuldigung!\r",
        "Die letzte Herausforderung wurde\n",
        "abgebrochen.\r",
        "Wir müssen dich daher für diese\n",
        "Herausforderung disqualifizieren!\r"
      ]
    },
    {
      "id": "msg_0096_00020",
      "de_DE": [
        "Willkommen im Duellturm!\r",
        "Ich begleite dich durch die\n",
        "Räume des Multikampfs.\r"
      ]
    },
    {
      "id": "msg_0096_00021",
      "de_DE": [
        "Möchtest du dich der Heraus-\n",
        "forderung im Multikampf stellen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0096_00022",
      "garbage": 26
    },
    {
      "id": "msg_0096_00023",
      "de_DE": [
        "In den Multikampf-Räumen des\n",
        "Duellturms kannst du mit einem Partner\f",
        "an einem Multikampf teilnehmen.\r",
        "Möchtest du dies tun, bilde ein Team mit\n",
        "einem anderen Trainer und nimm zwei\f",
        "deiner Pokémon mit in den Kampf.\r",
        "Im Turm gibt es eine Teamlounge.\n",
        "Dort triffst du andere Trainer.\r",
        "Finde einen Partner, der mit dir\n",
        "an einem Multikampf teilnimmt.\r",
        "Du kannst auch über die Drahtlose\n",
        "DS-Datenübertragung mit einem Freund\f",
        "ein Team bilden.\r",
        "Hast du einen Partner gefunden, kannst\n",
        "du in den Multikampf-Raum gehen.\r",
        "Hier warten 7 Teams auf euch.\r",
        "Schafft ihr es, alle sieben zu besiegen,\n",
        "erhältst du Gewinnpunkte.\r",
        "Willst du den Kampf unterbrechen,\n",
        "speichere bitte dein Spiel.\r",
        "Speicherst du es nicht, wirst du\n",
        "disqualifiziert.\r",
        "Befindest du dich in einem\n",
        "Teamkampf mit einem Freund, kannst\f",
        "du den Kampf nicht unterbrechen.\r"
      ]
    },
    {
      "id": "msg_0096_00024",
      "garbage": 259
    },
