{
  "key": 62531,
  "messages": [
    {
      "id": "msg_0072_00000",
      "de_DE": [
        "Hm?\n",
        "Oh, ist das etwa ein Pokédex?\f",
        "Dürfte ich da mal einen Blick reinwerfen?\r",
        "Ist ja ein Ding. \n",
        "So viele unterschiedliche Pokémon...\r",
        "Unglaublich!\r",
        "Was ist das denn für ein Pokémon?\r",
        "Es sieht aus wie die merkwürdigen\n",
        "Zeichen an den Wänden der Ruinen.\r",
        "Falls diese Zeichen tatsächlich Pokémon\n",
        "sind, dann gibt es noch viel mehr davon.\r",
        "Ich weiß!\n",
        "Lass mich deinen Pokédex erweitern.\f",
        "Mir nach!\r"
      ]
    },
    {
      "id": "msg_0072_00001",
      "de_DE": "!!!\r"
    },
    {
      "id": "msg_0072_00002",
      "de_DE": [
        "Oh, entschuldige vielmals!\n",
        "Ich war einfach so aufgeregt...\f",
        "Du liebe Zeit, ist mir das peinlich.\f",
        "Ist dir auch nichts passiert?\r"
      ]
    },
    {
      "id": "msg_0072_00003",
      "de_DE": [
        "I-i-ich werd verrückt!\n",
        "Das Pokémon dort!\r",
        "Das ist ein ARCEUS! Sage bloß, es ist\n",
        "aus Sinnoh bis hierher gekommen?\r"
      ]
    },
    {
      "id": "msg_0072_00004",
      "de_DE": [
        "Hmmm... ja... faszinierend...\n",
        "Was, wenn ARCEUS der Auslöser ist?\r",
        "Ich habe keine Ahnung, wie das möglich\n",
        "ist, aber es muss einfach so sein...\r"
      ]
    },
    {
      "id": "msg_0072_00005",
      "de_DE": [
        "Könnte ARCEUS der Schlüssel sein,\n",
        "um das Rätsel der Alph-Ruinen\f",
        "und der ICOGNITO zu lösen?\r"
      ]
    },
    {
      "id": "msg_0072_00006",
      "de_DE": [
        "M-möchtest du mich nicht \n",
        "zu den Alph-Ruinen begleiten?\f",
        "Ich bestehe sogar darauf!\r",
        "Meine Forschernase sagt mir, wir stehen\n",
        "kurz vor einer großen Entdeckung!\r"
      ]
    },
    {
      "id": "msg_0072_00007",
      "de_DE": [
        "Alph-Ruinen\r",
        "Besucher jederzeit\n",
        "willkommen"
      ]
    },
    {
      "id": "msg_0072_00008",
      "de_DE": [
        "Alph-Ruinen\r",
        "Fossilienfunde\n",
        "bitte abgeben"
      ]
    },
    {
      "id": "msg_0072_00009",
      "de_DE": [
        "Alph-Ruinen\n",
        "Forschungszentrum\r",
        "Die Autorität in\n",
        "Sachen Alph-Ruinen"
      ]
    },
    {
      "id": "msg_0072_00010",
      "de_DE": [
        "Mysteriöse Halle\n",
        "Pass auf, wo du hintrittst!"
      ]
    }
  ]
}
