{
  "key": 50215,
  "messages": [
    {
      "id": "msg_0509_00000",
      "de_DE": [
        "Ich war auf ein PORYGON aus,\n",
        "aber ich war genau 100 Münzen\f",
        "zu knapp bei Kasse..."
      ]
    },
    {
      "id": "msg_0509_00001",
      "de_DE": [
        "Uff...\r",
        "Ich muss mich echt am\n",
        "Riemen reißen und langsam machen!\r",
        "Wenn ich mich hier immer nur amüsiere,\n",
        "dann wirft mich meine Frau am Ende\f",
        "noch hochkant aus dem Haus!"
      ]
    },
    {
      "id": "msg_0509_00002",
      "de_DE": [
        "Ich bin aufgewacht und habe\n",
        "endlich ihr Talent erkannt!\r",
        "Was für ein Talent, fragst du?\r",
        "Na, die Kraftreserve, die in meinen\n",
        "Pokémon verborgen lag!\r",
        "Ich weiß jetzt, welchem Typ ihre\n",
        "Kraftreserve entspricht, wenn sie\f",
        "die gleichnamige Attacke lernen! Toll!\r",
        "Was sagst du? Soll ich dir verraten,\n",
        "welchem Typ die Kraftreserve deiner\f",
        "Pokémon entspricht? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00003",
      "de_DE": [
        "Soll ich dir verraten, welchem\n",
        "Typ die Kraftreserve deiner\f",
        "Pokémon entspricht? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00004",
      "de_DE": [
        "Würde dieses Pokémon Kraftreserve\n",
        "erlernen, dann wäre der Typ der\f",
        "Attacke “{STRVAR_1 15, 0, 0}”!"
      ]
    },
    {
      "id": "msg_0509_00005",
      "de_DE": [
        "Die Kraftreserve dieses Pokémon\n",
        "entspricht dem Typ “{STRVAR_1 15, 0, 0}”!"
      ]
    },
    {
      "id": "msg_0509_00006",
      "de_DE": [
        "Wenn du mehr wissen möchtest, dann\n",
        "frage mich einfach! Ich habe immer noch\f",
        "ein bisschen Kraft für dich in Reserve!"
      ]
    },
    {
      "id": "msg_0509_00007",
      "de_DE": [
        "Du willst wissen, welchem Typ die\n",
        "Attacke bei diesem Ei entspricht?\f",
        "Daraus wird nichts!"
      ]
    },
    {
      "id": "msg_0509_00008",
      "de_DE": [
        "Nein! Dieses Pokémon kann\n",
        "Kraftreserve nicht erlernen!"
      ]
    },
    {
      "id": "msg_0509_00009",
      "de_DE": [
        "Willkommen!\r",
        "Hier kannst du deine Spielmünzen\n",
        "gegen einen Preis deiner Wahl\f",
        "tauschen! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00010",
      "de_DE": [
        "Oh, in Ordnung! Dann spare dir ein paar\n",
        "Münzen zusammen, bis du wiederkommst!"
      ]
    },
    {
      "id": "msg_0509_00011",
      "de_DE": [
        "Oh, tut mir leid, aber dafür hast du\n",
        "nicht genug Münzen! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00012",
      "de_DE": [
        "{STRVAR_1 8, 0, 0} also! Bist du damit\n",
        "auch wirklich zufrieden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00013",
      "de_DE": "Hier, bitte!\r"
    },
    {
      "id": "msg_0509_00014",
      "de_DE": "Du kannst nichts mehr tragen.\r"
    },
    {
      "id": "msg_0509_00015",
      "de_DE": [
        "Du hast zu viele Pokémon dabei.\r",
        "Komm zurück, wenn du etwas Platz\n",
        "in deinem Team geschaffen hast!"
      ]
    },
    {
      "id": "msg_0509_00016",
      "de_DE": "Ist {STRVAR_1 0, 1, 0} O.K.? {YESNO 0}"
    },
    {
      "id": "msg_0509_00017",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält\n",
        "{STRVAR_1 0, 1, 0}! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00018",
      "de_DE": [
        "Willkommen!\r",
        "Hier kannst du deine Spielmünzen\n",
        "gegen ein Pokémon deiner Wahl\f",
        "tauschen! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0509_00019",
      "de_DE": [
        "Du verstaust {STRVAR_1 8, 0, 0} in\n",
        "deiner {STRVAR_1 18, 1, 0}-Tasche. {YESNO 0}"
