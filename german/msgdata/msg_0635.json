    {
      "id": "msg_0635_00042",
      "de_DE": [
        "Die Attacke Draco Meteor verfügt\n",
        "über ein wahrlich erdrückendes\f",
        "Maß an Macht!\r",
        "Wenn dein Pokémon sie einsetzt, sinkt\n",
        "dabei aber leider auch die Kraft seiner\f",
        "Spezialangriffe."
      ]
    },
    {
      "id": "msg_0635_00043",
      "de_DE": [
        "Führt dich dein Verlangen, stärker\n",
        "zu werden, her zu mir?\r",
        "...Nun gut.\r",
        "Dein Enthusiasmus soll belohnt werden.\r",
        "Ich werde einem deiner Pokémon eine\n",
        "ultimativ mächtige Attacke beibringen!\r",
        "Bist du damit einverstanden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00044",
      "de_DE": [
        "Die ultimative Attacke wartet auf dich!\n",
        "Soll ich sie einem deiner Pokémon\f",
        "beibringen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00045",
      "de_DE": [
        "Welchem deiner Pokémon soll ich\n",
        "die Attacke beibringen?\r"
      ]
    },
    {
      "id": "msg_0635_00046",
      "de_DE": [
        "Hmpf, na gut, wie du willst...\n",
        "Aber komm ruhig zurück, wenn du es\f",
        "dir anders überlegen solltest!"
      ]
    },
    {
      "id": "msg_0635_00047",
      "garbage": 26
    },
    {
      "id": "msg_0635_00048",
      "de_DE": [
        "Diesem Pokémon kann ich die Attacke\n",
        "nicht beibringen, in Ordnung?\f",
        "Lies gefälligst die Aufzeichnungen dort!\f",
        "Hrmpf!!"
      ]
    },
    {
      "id": "msg_0635_00049",
      "de_DE": [
        "Nicht einmal ich kann einem Ei eine\n",
        "Attacke beibringen, okay? Hrmpf!!"
      ]
    },
    {
      "id": "msg_0635_00050",
      "de_DE": [
        "Du bist mit diesem Pokémon noch nicht\n",
        "gut genug befreundet! Hrmpf!!"
      ]
    },
    {
      "id": "msg_0635_00051",
      "de_DE": [
        "Dieses Pokémon hat die Attacke\n",
        "schon gelernt, okay? Hrmpf!!"
      ]
    },
    {
      "id": "msg_0635_00052",
      "de_DE": [
        "Dann bringe ich {STRVAR_1 0, 0, 0} jetzt\n",
        "Lohekanonade bei, okay? Hrmpf! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00053",
      "de_DE": [
        "Dann bringe ich {STRVAR_1 0, 0, 0} jetzt\n",
        "Aquahaubitze bei, okay? Hrmpf!! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00054",
      "de_DE": [
        "Dann bringe ich {STRVAR_1 0, 0, 0} jetzt\n",
