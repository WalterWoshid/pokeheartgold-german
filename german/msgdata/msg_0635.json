    {
      "id": "msg_0635_00025",
      "de_DE": [
        "{STRVAR_1 3, 3, 0} gibt im Austausch dafür\n",
        "eine Herzschuppe ab."
      ]
    },
    {
      "id": "msg_0635_00026",
      "de_DE": [
        "Hihihi... ich bin Oma Ma!\r",
        "Kind, ich kann spüren, dass du\n",
        "das Zeug zum Drachen-Profi hättest!\r",
        "Ich sag dir was...\n",
        "Soll ich einem deiner Pokémon eine\f",
        "Attacke aus meinem Repertoire\f",
        "beibringen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00027",
      "de_DE": [
        "Oh, du bist es...\r",
        "Soll ich einem deiner Pokémon die\n",
        "mächtige Attacke vom Typ Drachen\f",
        "aus meinem Repertoire beibringen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00028",
      "de_DE": [
        "Na gut, in Ordnung. Komm wieder, wenn\n",
        "du es dir anders überlegt hast!"
      ]
    },
    {
      "id": "msg_0635_00029",
      "de_DE": [
        "Schön... ich mag deine Einstellung!\r",
        "Aber in deinem aktuellen Team gibt\n",
        "es leider kein Pokémon, das diese\f",
        "Attacke erlernen könnte!"
      ]
    },
    {
      "id": "msg_0635_00030",
      "de_DE": [
        "Welchem Pokémon soll ich die\n",
        "Attacke beibringen?\r"
      ]
    },
    {
      "id": "msg_0635_00031",
      "de_DE": [
        "Oh, Verzeihung...\r",
        "Du hast zwar ein Pokémon, das diese\n",
        "Attacke erlernen könnte, aber ich\f",
        "befürchte, es hat sich noch nicht so\f",
        "richtig mit dir anfreunden können...\r",
        "Deshalb kann ich ihm meine Attacke\n",
        "auch noch nicht beibringen."
      ]
    },
    {
      "id": "msg_0635_00032",
      "de_DE": [
        "Oh, Verzeihung...\r",
        "Dieses Pokémon kann meine Attacke\n",
        "leider nicht erlernen."
      ]
    },
    {
      "id": "msg_0635_00033",
      "de_DE": [
        "Hm, sei mir nicht böse, aber...\r",
        "Es wäre vergebene Mühe zu versuchen,\n",
        "einem Ei diese Attacke beizubringen."
      ]
    },
    {
      "id": "msg_0635_00034",
      "de_DE": [
        "Oh, warte mal eben! Dieses Pokémon\n",
        "hat {STRVAR_1 6, 0, 0} schon gelernt!"
      ]
    },
