{
  "key": 46175,
  "messages": [
    {
      "id": "msg_0635_00000",
      "de_DE": [
        "Äh...\n",
        "Wer warst du gleich noch mal?\r",
        "... ... ...\n",
        "... ... ...\r",
        "Und wer bin überhaupt ich? Ach ja!\n",
        "Ich bin der Attacken-Verlerner!\r"
      ]
    },
    {
      "id": "msg_0635_00001",
      "de_DE": [
        "Soll ich eins deiner Pokémon eine\n",
        "Attacke vergessen lassen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00002",
      "de_DE": [
        "Welches Pokémon soll eine Attacke\n",
        "vergessen?\r"
      ]
    },
    {
      "id": "msg_0635_00003",
      "de_DE": [
        "Komm wieder, wenn es Attacken\n",
        "gibt, die vergessen werden sollen."
      ]
    },
    {
      "id": "msg_0635_00004",
      "de_DE": [
        "Dieses Pokémon kennt nur eine Attacke,\n",
        "daher kann es keine vergessen...\r"
      ]
    },
    {
      "id": "msg_0635_00005",
      "de_DE": [
        "Was?\n",
        "Ein Ei kennt doch keine Attacken!\r"
      ]
    },
    {
      "id": "msg_0635_00006",
      "de_DE": "Welche Attacke soll vergessen werden?\r"
    },
    {
      "id": "msg_0635_00007",
      "de_DE": [
        "Hm! {STRVAR_1 6, 0, 0}?\n",
        "Diese Attacke vergessen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0635_00008",
      "de_DE": [
        "Das klappte doch perfekt!\r",
        "Dein Pokémon hat {STRVAR_1 6, 0, 0}\n",
        "komplett vergessen."
      ]
    },
    {
      "id": "msg_0635_00009",
      "de_DE": [
        "Mein Name? Du kannst mich den\n",
        "Attackenmaniac nennen!\r",
        "Ich kenne alle Attacken, die ein\n",
        "Pokémon lernen kann.\r",
        "Deshalb kann ich deinen Pokémon\n",
        "selbst Attacken beibringen, die sie\f",
        "schon einmal vergessen haben, hehe!\r",
        "Aber alles hat seinen Preis!\r",
        "Für jede Attacke, die ich einem deiner\n",
        "Pokémon beibringe, verlange ich als\f",
        "Gegenleistung, dass du mir eine\f",
        "Herzschuppe mitbringst!"
      ]
    },
    {
      "id": "msg_0635_00010",
      "de_DE": [
        "Oh! Das ist es! Das ist ehrlich und\n",
        "wahrhaftig eine Herzschuppe!\f",
        "Lass mich raten...\r",
        "Ich soll einem Pokémon eine\n",
        "alte Attacke beibringen?!?\r"
      ]
    },
    {
      "id": "msg_0635_00011",
      "de_DE": [
        "Komm mit einer Herzschuppe wieder, wenn\n",
        "ich einem deiner Pokémon mit einer alten\f",
        "Attacke auf die Sprünge helfen soll!"
      ]
    },
    {
      "id": "msg_0635_00012",
      "de_DE": [
        "Welches Pokémon soll sich an\n",
        "eine alte Attacke erinnern?\r"
      ]
    },
    {
      "id": "msg_0635_00013",
      "de_DE": [
        "An welche Attacke soll es sich\n",
        "wieder erinnern?\r"
      ]
    },
    {
      "id": "msg_0635_00014",
      "de_DE": [
        "Tut mir leid...\r",
        "Anscheinend gibt es keine Attacke, an\n",
        "die ich das Pokémon wieder erinnern\f",
        "könnte."
      ]
    },
    {
      "id": "msg_0635_00015",
      "de_DE": [
        "Hm?\r",
        "Ein Ei hat normalerweise noch keine\n",
        "Attacken vergessen.\r",
        "Es ist schließlich noch ein Ei."
      ]
    },
