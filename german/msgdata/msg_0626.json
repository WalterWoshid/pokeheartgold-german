        "Aktueller Rekord:\n",
        "{STRVAR_1 52, 0, 0},{STRVAR_1 50, 1, 0} cm ({STRVAR_1 3, 2, 0})"
      ]
    },
    {
      "id": "msg_0626_00033",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} hat\n",
        "{STRVAR_1 8, 1, 0} gefunden!"
      ]
    },
    {
      "id": "msg_0626_00034",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} verstaut {STRVAR_1 8, 1, 0}\n",
        "in der {COLOR 2}{STRVAR_1 31, 2, 0}{COLOR 0}-Tasche."
      ]
    },
    {
      "id": "msg_0626_00035",
      "de_DE": [
        "{STRVAR_1 8, 0, 0} erhalten!\r",
        "Jammerschade!\n",
        "Der Beutel ist voll..."
      ]
    }
  ]
}
