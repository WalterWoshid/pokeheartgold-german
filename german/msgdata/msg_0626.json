      "de_DE": [
        "See des Zorns\r",
        "(Auch bekannt als der\n",
        "GARADOS-See)"
      ]
    },
    {
      "id": "msg_0626_00031",
      "de_DE": "Haus des Profi-Anglers"
    },
    {
      "id": "msg_0626_00032",
      "de_DE": [
