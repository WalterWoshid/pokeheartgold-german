{
  "key": 57386,
  "messages": [
    {
      "id": "msg_0752_00000",
      "de_DE": [
        "Monja: Ich bin\n",
        "Monja von Montag.\r",
        "Als Zeichen unserer Freund-\n",
        "schaft schenke ich dir dies!\r"
      ]
    },
    {
      "id": "msg_0752_00001",
      "de_DE": [
        "Monja: Dieses Item verstärkt\n",
        "Flug-Attacken.\r",
        "Damit solltest du ein\n",
        "Vogel-Pokémon ausstatten."
      ]
    },
    {
      "id": "msg_0752_00002",
      "de_DE": [
        "Monja: Meine Geschwister\n",
        "findest du überall.\r",
        "Versuche mal, ob du sie\n",
        "alle aufspüren kannst!"
      ]
    },
    {
      "id": "msg_0752_00003",
      "de_DE": [
        "Monja: Nein, so geht das aber nicht!\n",
        "Heute ist doch gar nicht Montag!\r",
        "Besuche mich später noch einmal."
      ]
    },
    {
      "id": "msg_0752_00004",
      "de_DE": [
        "Dietlinde: Darf ich mich vorstellen? Ich\n",
        "bin Dietlinde von Dienstag.\r",
        "Da wir uns zum ersten Mal sehen,\n",
        "schenke ich dir diesen Krummlöffel.\r"
      ]
    },
    {
      "id": "msg_0752_00005",
      "de_DE": [
        "Dietlinde: Findest du nicht auch, dass\n",
        "er eine äußerst sonderbare Form hat?\r",
        "Er verstärkt Attacken der\n",
        "Elementklasse Psycho.\r",
        "Ich bin sicher, er wird\n",
        "dir sehr nützlich sein."
      ]
    },
    {
      "id": "msg_0752_00006",
      "de_DE": [
        "Dietlinde: Bist du Monja, meiner\n",
        "älteren Schwester, schon begegnet?\r",
        "Oder meinem kleinen Bruder Mitko?\r",
        "Ich bin das zweite von sieben Kindern."
      ]
    },
    {
      "id": "msg_0752_00007",
      "de_DE": [
        "Dietlinde: Der Dienstag vergeht\n",
        "wirklich wie im Flug, nicht wahr?\r",
        "Schau doch an einem anderen\n",
        "Dienstag noch einmal vorbei."
      ]
    },
    {
      "id": "msg_0752_00008",
      "de_DE": [
        "Mitko: Ich bin Mitko von Mittwoch.\n",
        "Soll heißen, heute ist Mittwoch.\r",
        "Freut mich, dich kennenzulernen.\n",
        "Nimm dir bitte ein Souvenir.\r"
      ]
    },
    {
      "id": "msg_0752_00009",
      "de_DE": [
        "Mitko: Dieser Schwarzgurt verstärkt\n",
        "die Kraft von Kampf-Attacken."
      ]
    },
    {
      "id": "msg_0752_00010",
      "de_DE": [
        "Mitko: Da du mich gefunden hast,\n",
        "musst du meine Brüder und\f",
        "Schwestern getroffen haben.\r",
        "Oder hattest du einfach nur Glück?"
      ]
    },
    {
      "id": "msg_0752_00011",
      "de_DE": [
        "Mitko: Ist nicht wahr!\n",
        "Der Mittwoch ist schon wieder vorbei?\f",
        "Na, dann mal bis nächste Woche!"
      ]
    },
    {
      "id": "msg_0752_00012",
      "de_DE": [
        "Donatus: Wer bist du denn?\r",
        "Ich bin Donatus von Donnerstag.\r",
        "Hier. Das kannst du haben.\r"
      ]
    },
    {
      "id": "msg_0752_00013",
      "de_DE": [
        "Donatus: Gib das einem Pokémon zum\n",
        "Halten, das Gestein-Attacken benutzt.\r",
        "Es verleiht ihnen noch einmal\n",
        "extra Durchschlagskraft."
      ]
    },
    {
      "id": "msg_0752_00014",
      "de_DE": [
        "Donatus: Ich bin Donatus von\n",
        "Donnerstag, der zweite Sohn\f",
        "unter uns sieben Geschwistern!"
      ]
    },
    {
      "id": "msg_0752_00015",
      "de_DE": [
        "Donatus: Was ist für dich die\n",
        "Mitte der Woche? Mittwoch?\f",
        "Oder doch der Donnerstag?\r",
        "Wie auch immer deine Antwort lautet -\n",
        "wir sehen uns nächsten Donnerstag!"
      ]
    },
    {
      "id": "msg_0752_00016",
      "de_DE": [
        "Frieda: Juhu! Es ist Freitag!\r",
        "Ich bin Frieda von Freitag!\n",
        "Schön, dich kennenzulernen!\r",
        "Hier, einmal Giftstich für dich!\r"
      ]
    },
    {
      "id": "msg_0752_00017",
      "de_DE": [
        "Frieda: Gib es einem Pokémon, das\n",
        "über Gift-Attacken verfügt.\r",
        "Oh ja!\r",
        "Das Ding haut richtig rein!\r",
        "Du wirst dich wundern, wie effektiv\n",
        "deine Gift-Attacken werden!"
      ]
    },
    {
      "id": "msg_0752_00018",
      "de_DE": [
        "Frieda: Hossa! Welchen Wochentag\n",
        "hast du am liebsten?\r",
        "Ich liebe Freitag.\n",
        "Daran gibt es keinen Zweifel!\r",
        "Denkst du nicht auch, dass Freitag\n",
        "großartig ist?"
      ]
    },
    {
      "id": "msg_0752_00019",
      "de_DE": [
        "Frieda: Was? Du sagst,\n",
        "heute sei gar nicht Freitag?\r",
        "Also, wenn’s nach mir ginge,\n",
        "könnte jeden Tag Freitag sein!"
      ]
    },
    {
      "id": "msg_0752_00020",
      "de_DE": [
        "Samson: ... ... ... ...\r",
        "Ich bin Samson von Samstag...\r",
        "Hier, für dich... ...\r"
      ]
    },
    {
      "id": "msg_0752_00021",
      "de_DE": [
        "Samson: ... ... ... ...\r",
        "Pudersand... ...\r",
        "Er verstärkt Boden-Attacken.\n",
        "Du wirst staunen..."
      ]
    },
    {
      "id": "msg_0752_00022",
      "de_DE": [
        "Samson: ... ... ... ...\r",
        "Wir sehen uns an einem anderen\n",
        "Samstag wieder..."
      ]
    },
    {
      "id": "msg_0752_00023",
      "de_DE": [
        "Samson: Heute... ist\n",
        "nicht Samstag?\r",
        "Dann eben bis Samstag..."
      ]
    },
    {
      "id": "msg_0752_00024",
      "de_DE": [
        "Sonnfried: Hi! Ich bin Sonnfried\n",
        "von Sonntag. Soll heißen, heute ist\f",
        "Sonntag!\r",
        "Man hat mir aufgetragen, dir das\n",
        "zu geben, wenn ich dich treffe!\r"
      ]
    },
    {
      "id": "msg_0752_00025",
      "de_DE": [
        "Sonnfried: Dieses Ding...\r",
        "Äh...\r",
        "...Was war das noch mal...\r",
        "...\r",
        "Ah! Jetzt erinnere ich mich!\r",
        "Gib das einem Pokémon, das Elektro-\n",
        "Attacken verwendet, zum Tragen.\r",
        "Meine Schwester Monja behauptet,\n",
        "das mache sie noch effektiver!"
      ]
    },
    {
      "id": "msg_0752_00026",
      "de_DE": [
        "Sonnfried: Meine Geschwister heißen\n",
        "Monja, Dietlinde,\f",
        "Mitko, Donatus,\f",
        "Frieda und Samson.\r",
        "Sie sind alle älter als ich!"
      ]
    },
    {
      "id": "msg_0752_00027",
      "de_DE": [
        "Sonnfried: Ist heute nicht Sonntag?\n",
        "Äh...\f",
        "Das hatte ich vergessen!"
      ]
    },
    {
      "id": "msg_0752_00028",
      "de_DE": [
        "Monja: He da!\n",
        "Wenn das nicht der Trainer ist, der mich\f",
        "und all meine Geschwister besucht hat!\r",
        "Du bist also quasi ein Familienfreund!\r",
        "Nimm dieses Band der Wachsamkeit als\n",
        "Zeichen unserer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0752_00029",
      "de_DE": [
        "Monja: Mit dem Band der Wachsamkeit\n",
        "sieht dein Pokémon sehr schick aus!"
      ]
    },
    {
      "id": "msg_0752_00030",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band der Wachsamkeit angelegt!"
      ]
    },
    {
      "id": "msg_0752_00031",
      "de_DE": [
        "Ich verschenke nur einmal pro Woche\n",
        "Bänder...\r",
        "Wenn du noch eines möchtest,\n",
        "musst du nächste Woche wiederkommen."
      ]
    },
    {
      "id": "msg_0752_00032",
      "de_DE": [
        "Dietlinde: Sowas!\n",
        "Wenn das nicht der Trainer ist, der mich\f",
        "und all meine Geschwister besucht hat!\r",
        "Du bist also quasi ein Familienfreund!\r",
        "Nimm dieses Band des Schocks als\n",
        "Zeichen unserer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0752_00033",
      "de_DE": [
        "Dietlinde: Das Band des Schocks steht\n",
        "deinem Pokémon wirklich ausgezeichnet!"
      ]
    },
    {
      "id": "msg_0752_00034",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band des Schocks angelegt!"
      ]
    },
    {
      "id": "msg_0752_00035",
      "de_DE": [
        "Ich verteile nur einmal pro Woche\n",
        "Geschenke...\r",
        "Komm doch nächste Woche noch einmal\n",
        "vorbei, wenn du noch ein Band möchtest."
      ]
    },
    {
      "id": "msg_0752_00036",
      "de_DE": [
        "Mitko: Holla, du da!\n",
        "Wenn das nicht der Trainer ist, der mich\f",
        "und all meine Geschwister besucht hat!\r",
        "Du bist also quasi ein Familienfreund!\r",
        "Nimm dieses Band des Niederschlags als\n",
        "Zeichen unserer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0752_00037",
      "de_DE": [
        "Mitko: Dein Pokémon macht sich wirklich\n",
        "gut mit dem Band des Niederschlags!"
      ]
    },
    {
      "id": "msg_0752_00038",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band des Niederschlags angelegt!"
      ]
    },
    {
      "id": "msg_0752_00039",
      "de_DE": [
        "Mitko: Bei mir gibt es pro\n",
        "Woche nur ein Band!\r",
        "Mehr erhältst du höchstens,\n",
        "wenn du mich nächste Woche besuchst!"
      ]
    },
    {
      "id": "msg_0752_00040",
      "de_DE": [
        "Donatus: Da trete mich doch ein PONYTA!\n",
        "Wenn das nicht der Trainer ist, der mich\f",
        "und all meine Geschwister besucht hat!\r",
        "Du bist also quasi ein Familienfreund!\r",
        "Nimm dieses Band der Sorglosigkeit als\n",
        "Zeichen unserer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0752_00041",
      "de_DE": [
        "Donatus: Mit dem Band der Sorglosigkeit\n",
        "kann dein Pokémon sich sehen lassen!"
      ]
    },
    {
      "id": "msg_0752_00042",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band der Sorglosigkeit angelegt!"
      ]
    },
    {
      "id": "msg_0752_00043",
      "de_DE": [
        "Donatus: Nix da. Bänder gibt es\n",
        "hier nur einmal pro Woche.\r",
        "Komm nächste Woche wieder,\n",
        "dann habe ich wieder welche."
      ]
    },
    {
      "id": "msg_0752_00044",
      "de_DE": [
        "Frieda: Juhu!\n",
        "Wenn das nicht der Trainer ist, der mich\f",
        "und all meine Geschwister besucht hat!\r",
        "Du bist also quasi ein Familienfreund!\r",
        "Nimm dieses Band der Entspannung als\n",
        "Zeichen unserer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0752_00045",
      "de_DE": [
        "Frieda: Das Band der Entspannung\n",
        "passt haargenau zu deinem Pokémon!"
      ]
    },
    {
      "id": "msg_0752_00046",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band der Entspannung angelegt!"
      ]
    },
    {
      "id": "msg_0752_00047",
      "de_DE": [
        "Frieda: Bänder gibt es bei mir\n",
        "nur einmal wöchentlich.\r",
        "Wenn du noch mehr möchtest,\n",
        "komm einfach nächste Woche vorbei."
      ]
    },
    {
      "id": "msg_0752_00048",
      "de_DE": [
        "Samson: ... ... ... ...\n",
        "Du bist doch der Trainer, der mich und\f",
        "all meine Geschwister besucht hat...\r",
        "Also quasi... ein Familienfreund.\r",
        "Hier... ein Band des Schlafens... als\n",
        "Zeichen unserer Freundschaft.\r"
      ]
    },
    {
      "id": "msg_0752_00049",
      "de_DE": [
        "Samson: Das Band des Schlafens\n",
        "steht deinem Pokémon..."
      ]
    },
    {
      "id": "msg_0752_00050",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band des Schlafens angelegt!"
      ]
    },
    {
      "id": "msg_0752_00051",
      "de_DE": [
        "Samson: Ich kann dir nur ein\n",
        "Band pro Woche geben...\r",
        "Wenn du mehr willst, komm\n",
        "nächste Woche wieder..."
      ]
    },
    {
      "id": "msg_0752_00052",
      "de_DE": [
        "Sonnfried: Aaah.\n",
        "Wenn das nicht der Trainer ist, der mich\f",
        "und all meine Geschwister besucht hat!\r",
        "Du bist ein Familienfreund!\r",
        "Dafür gibt es ein Band des Lächelns, als\n",
        "Zeichen unserer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0752_00053",
      "de_DE": [
        "Sonnfried: Mit dem Band des Lächelns\n",
        "sieht dein Pokémon prima aus!"
      ]
    },
    {
      "id": "msg_0752_00054",
      "de_DE": [
        "{STRVAR_1 0, 0, 0} wurde das\n",
        "Band des Lächelns angelegt!"
      ]
    },
    {
      "id": "msg_0752_00055",
      "de_DE": [
        "Sonnfried: Sorry. Ich kann dir nur ein\n",
        "Band pro Woche geben.\r",
        "Wenn du mehr willst, komm\n",
        "doch nächste Woche wieder."
      ]
    }
  ]
}
