{
  "key": 25718,
  "messages": [
    {
      "id": "msg_0114_00000",
      "de_DE": [
        "Siegfried: {STRVAR_1 3, 0, 0}!\r",
        "Um den Schließmechanismus an der Tür\n",
        "zum Transmitterraum zu entriegeln,\f",
        "braucht es das Stimmprofil\f",
        "einer ganz bestimmten Person...\r",
        "Und zwar... die von \n",
        "Team Rocket-Vorstandsmitglied Lambda!\r",
        "Ich konnte herausfinden, dass er sich\n",
        "im Bosszimmer versteckt hält!\r",
        "Allerdings...\n",
        "lässt das Bosszimmer sich ebenfalls\f",
        "nur mit einem Passwort betreten...\r",
        "Dann mal los, {STRVAR_1 3, 0, 0}!\n",
        "Zuallererst müssen wir uns das\f",
        "Passwort zum Bosszimmer beschaffen!\r"
      ]
    },
    {
      "id": "msg_0114_00001",
      "de_DE": [
        "Siegfried: {STRVAR_1 3, 0, 0}!\r",
        "Um den Schließmechanismus an der Tür\n",
        "zum Transmitterraum zu entriegeln,\f",
        "braucht es das Stimmprofil\f",
        "einer ganz bestimmten Person...\r",
        "Und zwar... die von \n",
        "Team Rocket-Vorstandsmitglied Lambda!\r",
        "Ich konnte herausfinden, dass er sich\n",
        "im Bosszimmer versteckt hält!\r",
        "Allerdings...\n",
        "lässt das Bosszimmer sich ebenfalls\f",
        "nur mit einem Passwort betreten...\r",
        "Dann mal los, {STRVAR_1 3, 0, 0}!\n",
        "Zuallererst müssen wir uns das\f",
        "Passwort zum Bosszimmer beschaffen!\r"
      ]
    },
    {
      "id": "msg_0114_00002",
      "de_DE": [
        "Urrrgh... dieser Typ mit dem Umhang\n",
        "war einfach viel zu stark...\f",
        "So stark, dass ich alle Geheimnisse\f",
        "der Basis ausgeplaudert habe...\r",
        "Nur, dass zwei Passwörter nötig sind,\n",
        "um das Bosszimmer zu betreten,\f",
        "DAS habe ich ihm nicht verraten!"
      ]
    },
    {
      "id": "msg_0114_00003",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: ... ... ...\r",
        "Was hast du denn nun schon\n",
        "wieder hier verloren?\r",
        "Hmpf! Du musst ja wirklich mächtig auf\n",
        "diese Team Rocket-Nulpen abfahren!\r",
        "...Aber egal. Viel mehr interessiert\n",
        "mich dieser Drachenprofi!\r",
        "Meine Pokémon waren\n",
        "keine Gegner für ihn.\r",
        "Die Niederlage an sich ist mir schnuppe.\n",
        "Wenn ich erst mal ein paar stärkere\f",
        "Pokémon habe, verliere ich bestimmt\f",
        "nicht gegen ihn!\r",
        "Was mich wurmt, ist, was er zu\n",
        "mir gesagt hat...\r",
        "Er sagte, dass ich meine Pokémon\n",
        "nicht ausreichend liebe und ihnen\f",
        "nicht vertraue.\r",
        "Was ein lauwarmes Gewäsch! Ich könnte\n",
        "mich in den Hintern beißen, dass ich\f",
        "gegen eine solche Memme verloren habe!\r",
        "...Hmpf! Und für einen Kampf gegen\n",
        "dich habe ich sowieso keine Zeit!\r"
      ]
    },
    {
      "id": "msg_0114_00004",
      "de_DE": [
        "Hnhnhnhn... willkommen\n",
        "in meinem Versteck, {STRVAR_1 3, 0, 0}...\r",
        "Was?\n",
        "Du willst wissen, wer ich bin?\r",
        "Ich bin Giovanni! Der große Giovanni!\n",
        "Mwaaahahaharrr!\r"
      ]
    },
    {
      "id": "msg_0114_00005",
      "de_DE": [
        "... ...Wie jetzt?\r",
        "Ich sehe nicht aus wie Giovanni?\n",
        "Wir sehen uns gar nicht ähnlich?\r",
        "Verflixt!!! Dabei habe ich mir doch\n",
        "solche Mühe gegeben und geübt!\r"
      ]
    },
    {
      "id": "msg_0114_00006",
      "de_DE": [
        "Lambda: Ich bin Team Rocket-\n",
        "Vorstandsmitglied Lambda!\r",
        "Du dachtest wohl,\n",
        "du könntest dich in den\f",
        "Transmitterraum einschleichen?\r",
        "Aber da hast du dich verzettelt!\r",
        "Das Zimmer wird nämlich durch\n",
        "ein besonderes Passwort geschützt!\r",
        "Und dieses Passwort lautet:\n",
        "“Lang lebe Giovanni”!\r",
        "Hehehe. Jetzt bist du bestimmt baff,\n",
        "dass ich es so einfach verraten habe?\r",
        "Aber das macht überhaupt nichts!\n",
        "Denn du kannst damit nichts anfangen!\r",
        "Bevor du das Passwort nämlich\n",
        "nicht mit MEINER STIMME aufsagst,\f",
        "rührt die Tür sich keinen Zentimeter!\r"
      ]
    },
    {
      "id": "msg_0114_00007",
      "de_DE": [
        "Lambda: Vor drei Jahren löste unser\n",
        "Anführer, der große Giovanni,\f",
        "Team Rocket auf und verschwand...\r",
        "Doch ich bin sicher, er harrt irgendwo\n",
        "nur auf seine Chance für ein Comeback!\r",
        "Muuu Ha Ha Harr!\r",
        "Die Niederlage gegen dich jedenfalls\n",
        "juckt mich überhaupt nicht!\r",
        "Denn ohne meine Stimme... kannst\n",
        "du die Tür zum Transmitterraum zu\f",
        "öffnen versuchen, bis du schwarz wirst!\r"
      ]
    },
    {
      "id": "msg_0114_00008",
      "de_DE": "KRAMURX: Lang lebe Giovanni!\r"
    },
    {
      "id": "msg_0114_00009",
      "de_DE": [
        "Das KRAMURX hat Lambdas\n",
        "Stimme perfekt imitiert!\r",
        "Könnte das etwa...\r"
      ]
    },
    {
      "id": "msg_0114_00010",
      "de_DE": "KRAMURX: Lang lebe Giovanni!\r"
    },
    {
      "id": "msg_0114_00011",
      "de_DE": [
        "Die Tür ist verschlossen...\r",
        "Zum Öffnen werden zwei Passwörter\n",
        "benötigt."
      ]
    },
    {
      "id": "msg_0114_00012",
      "de_DE": [
        "Die Tür ist verschlossen...\r",
        "{STRVAR_1 3, 0, 0} gibt beide Passwörter ein.\r",
        "Die Tür wird entriegelt!\r"
      ]
    }
  ]
}
