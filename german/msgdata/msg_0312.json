{
  "key": 22722,
  "messages": [
    {
      "id": "msg_0312_00000",
      "de_DE": [
        "Hallo und willkommen bei der\n",
        "Pokéathlon-Teilnehmerregistrierung!\r",
        "Möchtest du deine Pokémon\n",
        "für einen Wettkampf anmelden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0312_00001",
      "de_DE": [
        "Willkommen. Bei uns kannst du deine\n",
        "Pokémon für den Profi-Cup anmelden.\r",
        "Dabei treten nur Elite-Poké-Athleten\n",
        "gegeneinander an!\f",
        "Nimmst du die Herausforderung an? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0312_00002",
      "de_DE": [
        "Kann ich sonst noch etwas\n",
        "für dich tun? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0312_00003",
      "de_DE": [
        "Für welches unserer Turniere\n",
        "darf ich dich eintragen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0312_00004",
      "de_DE": [
        "Das {STRVAR_4 1, 3, 0} also?\n",
        "Ist das so richtig? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0312_00005",
      "de_DE": "Dann bitte hier entlang.\r"
    },
    {
      "id": "msg_0312_00006",
      "de_DE": [
        "In ein paar Minuten geht es los.\n",
        "Deine Mannschaftsfarbe ist Rot.\r",
        "Also dann, Hals- und Beinbruch!\r"
      ]
    },
    {
      "id": "msg_0312_00007",
      "garbage": 32
    },
    {
      "id": "msg_0312_00008",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} schlüpft in einen\n",
        "Trainingsanzug!"
      ]
    },
    {
      "id": "msg_0312_00009",
      "garbage": 27
    },
    {
      "id": "msg_0312_00010",
      "de_DE": "Schau mal wieder vorbei."
    },
    {
      "id": "msg_0312_00011",
      "de_DE": [
        "Was darf ich dir näher erklären?\n",
        "{YESNO 0}"
      ]
    },
    {
      "id": "msg_0312_00012",
      "de_DE": [
        "Der Pokéathlon ist eine feierliche\n",
        "Veranstaltung, bei der Trainer\f",
        "sich gemeinsam mit drei ihrer Pokémon\f",
        "im sportlichen Wettkampf messen.\r",
        "Ein Pokéathlon-Turnier besteht aus\n",
        "unterschiedlichen Wettkämpfen, die\f",
        "auf die individuellen Eigenschaften\f",
        "der Pokémon abgestimmt sind.\r",
        "Es wäre uns eine Freude, auch dich und\n",
        "dein Team dabei begrüßen zu dürfen!\r"
      ]
    },
    {
      "id": "msg_0312_00013",
      "de_DE": [
        "Der Profi-Cup ist ein besonderes\n",
        "Turnier, bei dem ausgewählte\r",
        "Poké-Athleten aus allen Regionen\n",
        "aufeinander treffen.\r",
        "Außerdem bringt ein Gewinn beim\n",
        "Profi-Cup dir extra viele Punkte ein.\r",
        "Versuche mal dein Glück und messe dich\n",
        "mit den besten Pokémon des Kontinents!\r"
      ]
    },
    {
      "id": "msg_0312_00014",
      "de_DE": [
        "Das Tempo-Turnier besteht aus drei\n",
        "ausgewählten Disziplinen, bei denen\f",
        "vor allem die Geschwindigkeit\f",
        "deiner Pokémon zählt!\r",
        "Beim Hürdenlauf geht es darum,\n",
        "geschwind ins Ziel zu hüpfen!\r",
        "Beim Flaggenschnappen gilt es, fix Wimpel\n",
        "einzusammeln und Punkte zu kassieren.\r",
        "Und beim Staffellauf kommt alles\n",
        "auf reibungsloses Teamwork an!\r",
        "Der Gewinner des Turniers erhält\n",
        "die Tempo-Medaille.\r",
        "Wähle einfach drei Pokémon aus,\n",
        "die besonders flott unterwegs sind\f",
        "und versuche es einmal!\r"
      ]
    },
    {
      "id": "msg_0312_00015",
      "de_DE": [
        "Das Kraft-Turnier besteht aus drei\n",
        "ausgewählten Disziplinen, bei denen es\f",
        "vor allem auf die Körperkraft\f",
        "deiner Pokémon ankommt!\r",
        "Beim Ziegelbrechen musst du\n",
        "möglichst viele Ziegel zertrümmern.\r",
        "Beim Drängelkreis bleibt nur der stehen,\n",
        "der sich im Pulk behaupten kann!\r",
        "Und beim Torschießen beförderst du\n",
        "mit Karacho den Ball ins Tor!\r",
        "Der Gewinner des Turniers erhält\n",
        "die Kraft-Medaille.\r",
        "Wähle einfach drei Pokémon aus,\n",
        "die vor Kraft strotzen\f",
        "und versuche es einmal!\r"
      ]
    },
    {
      "id": "msg_0312_00016",
      "de_DE": [
        "Das Ausdauer-Turnier besteht aus drei\n",
        "ausgewählten Disziplinen, bei denen es\f",
        "vor allem auf das Durchhaltevermögen\f",
        "deiner Pokémon ankommt!\r",
        "Beim Ringrangeln bleibt nur der\n",
        "mit dem größten Stehvermögen im Ring!\r",
        "Im Staffellauf entscheidet die Kondition\n",
        "der Läufer über Sieg und Niederlage!\r",
        "Und beim Ziegelbrechen heißt es,\n",
        "draufhauen bis die Luft heraus ist!\r",
        "Der Gewinner des Turniers erhält\n",
        "die Ausdauer-Medaille.\r",
        "Wähle einfach drei Pokémon aus,\n",
        "die nicht schnell schlapp machen\f",
        "und versuche es einmal!\r"
      ]
    },
    {
      "id": "msg_0312_00017",
      "de_DE": [
        "Das Sprung-Turnier besteht aus drei\n",
        "ausgewählten Disziplinen, bei denen es\f",
        "vor allem auf die Sprungkraft\f",
        "deiner Pokémon ankommt!\r",
        "Beim Lampionspringen gewinnt, wer am\n",
        "höchsten in die Luft geschleudert wird!\r",
        "Beim Diskusfangen springst du und\n",
        "schnappst dir die fliegenden Scheiben!\r",
        "Und beim Hürdenlauf kommen nur\n",
        "Hüpfgewandte schnell ins Ziel!\r",
        "Der Gewinner des Turniers erhält\n",
        "die Sprung-Medaille.\r",
        "Wähle einfach drei Pokémon aus, deren\n",
        "Sprungkraft besonders ausgeprägt ist\f",
        "und versuche es einmal!\r"
      ]
    },
    {
      "id": "msg_0312_00018",
      "de_DE": [
        "Das Technik-Turnier besteht aus drei\n",
        "ausgewählten Disziplinen, bei denen es\f",
        "vor allem auf die Geschicklichkeit\f",
        "deiner Pokémon ankommt!\r",
        "Bei der Schneeschlacht gewinnt der,\n",
        "der am treffsichersten werfen kann!\r",
        "Beim Torschießen ist Geschmeidigkeit\n",
        "unabdingbar für einen sauberen Schuss!\r",
        "Und beim Flaggenschnappen musst du\n",
        "fix sein, um den Gegner zu überrumpeln!\r",
        "Der Gewinner des Turniers erhält\n",
        "die Technik-Medaille.\r",
        "Wähle einfach drei Pokémon aus, die\n",
        "technisch besonders versiert sind\f",
        "und versuche es einmal!\r"
      ]
    },
    {
      "id": "msg_0312_00019",
      "de_DE": [
        "Danke für deine Teilnahme!\r",
        "Ich verwandele deine Punktzahl\n",
        "nun in Athletenpunkte.\r"
      ]
