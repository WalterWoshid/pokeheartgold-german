    {
      "id": "msg_0109_00028",
      "de_DE": "Komm wieder, wenn du bereit bist.\r"
    },
    {
      "id": "msg_0109_00029",
      "de_DE": [
        "Huch? Beide Trainer haben sich für das\n",
        "Pokémon {STRVAR_1 0, 0, 0} entschieden!\r",
        "Bitte berate dich mit dem anderen\n",
        "Trainer, damit jeder ein anderes\f",
        "Pokémon hat.\r"
      ]
    },
    {
      "id": "msg_0109_00030",
      "de_DE": [
        "Huch? Beide Trainer haben sich für die\n",
        "Pokémon {STRVAR_1 0, 0, 0} und {STRVAR_1 0, 1, 0}\f",
        "entschieden!\r",
        "Bitte berate dich mit dem anderen\n",
        "Trainer, damit jeder ein anderes\f",
        "Pokémon hat.\r"
      ]
    },
    {
      "id": "msg_0109_00031",
      "de_DE": [
        "Bevor ich dich hereinlasse,\n",
        "musst du das Spiel speichern.\f",
        "Einverstanden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0109_00032",
      "de_DE": "Hier entlang bitte!"
    },
    {
      "id": "msg_0109_00033",
      "de_DE": [
        "Lange nicht gesehen!\r",
        "Du musst das Spiel speichern, bevor du\n",
        "die Herausforderung wieder aufnimmst.\r",
        "Bitte habe Geduld."
      ]
    },
    {
      "id": "msg_0109_00034",
      "de_DE": [
        "Entschuldigung!\r",
        "Vorm Verlassen deiner letzten\n",
        "Herausforderung hast du nicht\f",
        "gespeichert.\r",
        "Aus diesem Grunde wurdest du\n",
        "disqualifiziert!\r"
      ]
    },
    {
      "id": "msg_0109_00035",
      "de_DE": [
        "Glückwunsch!\r",
        "Der Preis für deinen Sieg ist dieses\n",
        "schmucke Erinnerungsfoto!\r"
      ]
    },
    {
      "id": "msg_0109_00036",
      "de_DE": [
        "Das Goldfoto wurde an die Kampfkamera\n",
        "von {STRVAR_1 3, 0, 0} gesendet.\r"
      ]
    },
    {
      "id": "msg_0109_00037",
      "de_DE": [
        "Das Silberfoto wurde an die Kampfkamera\n",
        "von {STRVAR_1 3, 0, 0} gesendet.\r"
      ]
    },
    {
      "id": "msg_0109_00038",
      "de_DE": "EINZELKAMPF"
    },
    {
      "id": "msg_0109_00039",
      "de_DE": "DOPPELKAMPF"
    },
    {
      "id": "msg_0109_00040",
      "de_DE": "HERAUSFORDERN"
    },
    {
      "id": "msg_0109_00041",
      "de_DE": "INFO"
    },
    {
      "id": "msg_0109_00042",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0109_00043",
      "de_DE": [
        "Bitte legt fest, wer von euch\n",
        "“LEITER WERDEN” soll.\r",
        "Der andere Spieler wählt\n",
        "“MITSPIELER” aus. {YESNO 0}"
      ]
    },
    {
      "id": "msg_0109_00044",
      "de_DE": [
        "Drahtlose DS-Datenübertragung\n",
        "initialisieren? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0109_00045",
      "de_DE": [
        "Du musst das Spiel speichern, bevor ich\n",
        "dich hereinlasse. Bitte habe Geduld."
      ]
    },
    {
      "id": "msg_0109_00046",
      "de_DE": [
        "Gewinnen deine Pokémon, ohne Schaden\n",
        "zu nehmen, erhältst du mehr PP.\r",
        "Es ist gut, viele PP zu haben!\n",
        "Ich hingegen habe nur ganz wenige..."
      ]
    },
    {
      "id": "msg_0109_00047",
      "de_DE": [
        "Stellst du dich Gegnern mit höheren\n",
        "Leveln, verdienst du mehr PP.\r",
        "Wie heißt es doch so schön:\n",
        "Wer nicht wagt, der nicht gewinnt!"
      ]
    },
    {
      "id": "msg_0109_00048",
      "de_DE": [
        "Vor jedem Kampf solltest du dir die\n",
        "gegnerische Aufstellung ansehen.\r",
        "Geize nur nicht mit deinen PP! \n",
        "Wenn du verloren hast, ist es\f",
        "dafür zu spät...\f",
        "Wie heißt es doch so schön:\r",
        "Wer zu spät kommt, den bestraft\n",
        "das Leben!"
      ]
    },
    {
      "id": "msg_0109_00049",
      "de_DE": [
        "Oh, Herr Perenus...\r",
        "Wie edel, sich selbst völlig\n",
        "zurückzunehmen, um gänzlich\f",
        "Lady Kattlea dienen zu können!\r",
        "Wahrlich, wie edel!"
      ]
    },
    {
      "id": "msg_0109_00050",
      "de_DE": [
        "Zunächst darfst du die PP nur zum\n",
        "Wiederherstellen deiner KP einsetzen.\r",
        "Du kannst PP aber auch einsetzen,\n",
        "um den nächsten Rang zu erreichen.\f",
        "So kannst du auch AP wiederherstellen."
      ]
    },
    {
      "id": "msg_0109_00051",
      "de_DE": [
        "Ich muss dir etwas Wichtiges mitteilen:\n",
        "Wenn du verlierst, dann stehst du mit\f",
        "deinen PP wieder bei null! Das ist das\f",
        "eherne Gesetz des Kampfpalais!"
      ]
    },
    {
      "id": "msg_0109_00052",
      "de_DE": [
        "Es ist mein großer Traum, in der Zukunft\n",
        "mit einem schönen Kleid auf einem\f",
        "Schloss zu leben!\r",
        "...Ähm, ich wollte natürlich sagen:\r",
        "Mit einer Frau in einem schönen\n",
        "Kleid auf einem Schloss zu leben!"
      ]
    }
  ]
}
