{
  "key": 25935,
  "messages": [
    {
      "id": "msg_0765_00000",
      "de_DE": [
        "Hast du dir jemals einen\n",
        "Pokémon-Film angesehen?"
      ]
    },
    {
      "id": "msg_0765_00001",
      "de_DE": "Besitzt du Pokémon-Plüschtiere?"
    },
    {
      "id": "msg_0765_00002",
      "de_DE": [
        "Was gefällt dir an deinem\n",
        "Lieblings-Pokémon am meisten?"
      ]
    },
    {
      "id": "msg_0765_00003",
      "de_DE": [
        "Hast du je ein Pokémon als Geschenk\n",
        "bei einer Veranstaltung bekommen?"
      ]
    },
    {
      "id": "msg_0765_00004",
      "de_DE": [
        "Wie viele Pokémon-Spiele hast\n",
        "du vor diesem bereits gespielt?"
      ]
    },
    {
      "id": "msg_0765_00005",
      "de_DE": [
        "Wann hast du begonnen,\n",
        "Pokémon zu spielen?"
      ]
    },
    {
      "id": "msg_0765_00006",
      "de_DE": [
        "Wenn du ein Pokémon wärst, welcher von\n",
        "den nachfolgenden Typen wärst du?"
      ]
    },
    {
      "id": "msg_0765_00007",
      "de_DE": "Was ist deine Strategie in Kämpfen?"
    },
    {
      "id": "msg_0765_00008",
      "de_DE": [
        "Wen würdest du als Einsteiger\n",
        "für Pokémon gewinnen wollen?"
      ]
    },
    {
      "id": "msg_0765_00009",
      "de_DE": [
        "Hast du jemals an einer\n",
        "Pokémon-Veranstaltung teilgenommen?"
      ]
    }
  ]
}
