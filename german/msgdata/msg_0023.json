{
  "key": 61156,
  "messages": [
    {
      "id": "msg_0023_00000",
      "de_DE": "Hier steht ein Aprikokobaum!\r"
    },
    {
      "id": "msg_0023_00001",
      "de_DE": "...eine {STRVAR_1 8, 1, 0}!\r"
    },
    {
      "id": "msg_0023_00002",
      "de_DE": "Der Baum trägt keine Früchte..."
    },
    {
      "id": "msg_0023_00003",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält\n",
        "eine {STRVAR_1 8, 1, 0}!"
      ]
    },
    {
      "id": "msg_0023_00004",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} verstaut die\n",
        "{STRVAR_1 8, 1, 0} in der Aprikokobox!"
      ]
    },
    {
      "id": "msg_0023_00005",
      "de_DE": [
        "...doch halt! \n",
        "Du hast nichts dabei, in dem du\f",
        "die Aprikoko aufbewahren kannst!\r",
        "{STRVAR_1 3, 0, 0} kann die {STRVAR_1 8, 1, 0}\n",
        "nicht pflücken..."
      ]
    },
    {
      "id": "msg_0023_00006",
      "de_DE": [
        "...doch halt. Hoppla!\n",
        "Die Aprikokobox ist randvoll!\r",
        "{STRVAR_1 3, 0, 0} kann die {STRVAR_1 8, 1, 0}\n",
        "nicht pflücken..."
      ]
    },
    {
      "id": "msg_0023_00007",
      "de_DE": [
        "Ohne einen Behälter kannst du\n",
        "die Aprikoko nicht pflücken..."
      ]
    }
  ]
}
