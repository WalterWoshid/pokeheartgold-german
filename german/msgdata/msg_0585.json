{
  "key": 25686,
  "messages": [
    {
      "id": "msg_0585_00000",
      "de_DE": [
        "Behandelst du deine Pokémon gut,\n",
        "werden sie dich regelrecht lieben!\r",
        "Huch? Lass mich mal einen Blick auf\n",
        "dieses Pokémon werfen...\r"
      ]
    },
    {
      "id": "msg_0585_00001",
      "de_DE": [
        "Es sieht sehr glücklich aus!\n",
        "Es muss dich sehr gernhaben!"
      ]
    },
    {
      "id": "msg_0585_00002",
      "de_DE": [
        "Ich habe den Eindruck, dass es dir\n",
        "wirklich vertraut."
      ]
    },
    {
      "id": "msg_0585_00003",
      "de_DE": [
        "Es hat dich wirklich sehr gern.\n",
        "Es wirkt auf jeden Fall sehr glücklich."
      ]
    },
    {
      "id": "msg_0585_00004",
      "de_DE": "Es ist ziemlich niedlich!"
    },
    {
      "id": "msg_0585_00005",
      "de_DE": [
        "Du solltest es besser behandeln!\n",
        "Es scheint sich noch nicht an dich\f",
        "gewöhnt zu haben."
      ]
    },
    {
      "id": "msg_0585_00006",
      "de_DE": [
        "Es scheint dich gar nicht zu mögen.\n",
        "Es schaut dich auch ganz böse an..."
      ]
    },
    {
      "id": "msg_0585_00007",
      "de_DE": [
        "Ständig werden meine Pokémon bei\n",
        "Kämpfen besiegt und bewusstlos...\r",
        "Vielleicht ist das ja der Grund, weshalb\n",
        "sie mich nicht ausstehen können."
      ]
    },
    {
      "id": "msg_0585_00008",
      "de_DE": [
        "Wenn ich Items auf meine Pokémon\n",
        "anwende, freuen sie sich immer sehr!"
      ]
    }
  ]
}
