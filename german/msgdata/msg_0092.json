    {
      "id": "msg_0092_00000",
      "de_DE": [
        "Ich warte hier darauf, dass\n",
        "sich FLEGMON entwickelt!\r",
        "Meine Beobachtungen haben mich zu\n",
        "einer neuen Entdeckung geführt.\f",
        "Aus irgendeinem Grund werden FLEGMON\f",
        "oft von MUSCHAS gebissen, wenn sie\f",
        "einen King-Stein bei sich tragen.\r",
        "Weißt du was? Hier, du kannst einen\n",
        "von meinen haben! Los, greif zu!"
      ]
    },
    {
      "id": "msg_0092_00001",
      "garbage": 22
    },
    {
      "id": "msg_0092_00002",
      "de_DE": [
        "Ich werde mir ein Beispiel an FLEGMON\n",
        "nehmen und hier ganz entspannt darauf\f",
        "warten, dass es sich entwickelt."
      ]
    }
  ]
}
