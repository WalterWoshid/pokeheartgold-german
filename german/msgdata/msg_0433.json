    },
    {
      "id": "msg_0433_00013",
      "de_DE": "{STRVAR_1 50, 1, 0} {STRVAR_1 8, 0, 0} erhalten!"
    },
    {
      "id": "msg_0433_00014",
      "de_DE": [
        "Es tut mir leid, aber du hast nicht\n",
        "genügend GP. Komm bitte wieder."
      ]
    },
    {
      "id": "msg_0433_00015",
      "de_DE": [
        "Willkommen!\n",
        "Möchtest du ein paar Rubbelkarten?\r",
        "Du kannst drei Rubbelkarten für\n",
        "{STRVAR_1 50, 0, 0} GP kaufen.\r",
        "Auf jeder Rubbelkarte sind Felder,\n",
        "unter denen sich Pokémon-Symbole\f",
        "verstecken.\r",
        "Pro Karte kannst du drei Felder\n",
        "aufdecken, indem du die Schicht\f",
        "abkratzt.\r",
        "Hast du dreimal das gleiche\n",
        "Symbol, gewinnst du einen Preis,\f",
        "zum Beispiel eine Beere!\r",
        "Außerdem lässt sich das Symbol für\n",
        "DITTO in ein anderes Pokémon\f",
        "umwandeln.\r",
        "Viel Glück dabei!\r"
      ]
    }
