{
  "key": 62583,
  "messages": [
    {
      "id": "msg_0579_00000",
      "de_DE": [
        "Bist du von Oliviana City hergekommen?\n",
        "Dann hast du bestimmt diese vier Inseln\f",
        "auf dem Weg gesehen, oder?\f",
        "Man erzählt sich, dass dort ein\f",
        "mythisches Wesen hausen soll!"
      ]
    },
    {
      "id": "msg_0579_00001",
      "de_DE": [
        "Ich habe gehört, dass man es nur sehen\n",
        "kann, wenn man einen Silberflügel hat.\r",
        "Er muss bestimmt denselben Geruch wie\n",
        "diese Kreatur ausströmen."
      ]
    },
    {
      "id": "msg_0579_00002",
      "de_DE": [
        "Es heißt schon lange, dass diese\n",
        "mythische Kreatur auch die Strudel\f",
        "um die Inseln macht.\r",
        "Man braucht wahrscheinlich eine\n",
        "Spezialattacke, um an denen\f",
        "vorbeizukommen."
      ]
    }
  ]
}
