{
  "key": 18239,
  "messages": [
    {
      "id": "msg_0467_00000",
      "de_DE": [
        "Das Kanto-Kraftwerk? Es befindet sich\n",
        "am Ende von Route 9, der Straße\f",
        "östlich von hier. Angeblich haben die\f",
        "da mit irgendeinem Defekt zu kämpfen..."
      ]
    },
    {
      "id": "msg_0467_00001",
      "de_DE": [
        "Na sieh mal einer an! Willst du etwa\n",
        "alle existierenden Pokémon sammeln?\r",
        "Das ist ja richtige Schwerstarbeit!\n",
        "Aber es zahlt sich sicher auch aus!"
      ]
    },
    {
      "id": "msg_0467_00002",
      "de_DE": [
        "Das Kap im Norden gilt bei Mädchen als\n",
        "ein beliebter Ort für Rendezvous!\r",
        "Soll ich dir ein Geheimnis erzählen?\r",
        "Es gehen immer wieder Gerüchte um,\n",
        "nach denen irgendwelche Leute auch\f",
        "Misty, die Arenaleiterin, dort erspäht\f",
        "haben wollen...\r",
        "Das muss man erst mal verdauen!"
      ]
    },
    {
      "id": "msg_0467_00003",
      "de_DE": "LAHMUS: Laaahm?"
    },
    {
      "id": "msg_0467_00004",
      "de_DE": "LAHMUS glüht vor Unternehmungslust!"
    },
    {
      "id": "msg_0467_00005",
      "de_DE": [
        "LAHMUS und ich, wir geben ein\n",
        "prächtiges Team ab!\r",
        "Los, LAHMUS! Zeige uns allen\n",
        "deine Psychokinese!!\r",
        "... ... !\r",
        "Seine Psychokinese ist echt eine Wucht!"
      ]
    },
    {
      "id": "msg_0467_00006",
      "de_DE": [
        "Vorhin hat mich so ein komischer Kerl\n",
        "mit schwarzen Klamotten nach dem\f",
        "Weg zum Kraftwerk gefragt.\r",
        "Er sagte ständig “Geheimnis, secret!”,\n",
        "und dass niemand davon erfahren dürfe.\r",
        "Aber wenn ich mal fragen dürfte...\n",
        "was heißt “secret” überhaupt?"
      ]
    },
    {
      "id": "msg_0467_00007",
      "de_DE": [
        "Der verdächtige Typ mit den schwarzen\n",
        "Klamotten hat sich vorhin ganz heimlich\f",
        "in die Arena geschlichen!\r",
        "Ich möchte ja echt gerne mal wissen,\n",
        "was dieser Kerl von Misty will!"
      ]
    },
    {
      "id": "msg_0467_00008",
      "de_DE": [
        "Der verdächtige Typ mit den schwarzen\n",
        "Klamotten ist in Richtung Kap geflohen!"
      ]
    },
    {
      "id": "msg_0467_00009",
      "de_DE": [
        "Ich bin ein riesiger Fan von Misty,\n",
        "der Arenaleiterin von Azuria City!"
      ]
    },
    {
      "id": "msg_0467_00010",
      "de_DE": [
        "Ich bin in diese Stadt gekommen, weil\n",
        "man mir sagte, dass es hier eine Höhle\f",
        "mit extrem starken Pokémon geben soll.\r"
      ]
    },
    {
      "id": "msg_0467_00011",
      "de_DE": [
        "Nanu?\r",
        "Mein Itemradar schlägt aus..."
      ]
    },
    {
      "id": "msg_0467_00012",
      "de_DE": [
        "Wie du bestimmt selbst schon weißt,\n",
        "ist das hier die Azuria-Höhle!\r",
        "Sie wird von gar fürchterlichen\n",
        "Pokémon bewohnt...\r",
        "Nur Trainer, die sich alle acht\n",
        "Orden der Arenaleiter von Kanto\f",
        "erkämpft haben, dürfen hier rein!"
      ]
    },
    {
      "id": "msg_0467_00013",
      "de_DE": [
        "Azuria City\n",
        "Stadt der blühenden Blumen"
      ]
    },
    {
      "id": "msg_0467_00014",
      "de_DE": [
        "Pokémon-Arena von Azuria City\n",
        "Leiterin: Misty\f",
        "Die jungenhafte Meerjungfrau"
      ]
    },
    {
      "id": "msg_0467_00015",
      "de_DE": [
        "Der Fahrradladen von Azuria City\r",
        "Auslöser des Drahteselbooms"
      ]
    },
    {
      "id": "msg_0467_00016",
      "de_DE": [
        "Da ist ein Flugblatt...\r",
        "Jeder Diebstahl wird geahndet!\n",
        "Um eine sichere und friedliche Stadt\f",
        "zu gewährleisten, müssen wir alle\f",
        "zusammenarbeiten!\f",
        "Das Ordnungsamt von Azuria City"
      ]
    },
    {
      "id": "msg_0467_00017",
      "de_DE": [
        "Zur Route 24\n",
        "Östlich zum Kap (Azuria City)"
      ]
    },
    {
      "id": "msg_0467_00018",
      "de_DE": "Abgeschlossen..."
    }
  ]
}
