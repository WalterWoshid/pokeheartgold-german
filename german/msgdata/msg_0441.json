    },
    {
      "id": "msg_0441_00031",
      "de_DE": "Gegen die Saaldiva antreten?"
    },
    {
      "id": "msg_0441_00032",
      "de_DE": [
        "Entschuldige bitte!\n",
        "Warte bitte einen Moment.\r",
        "In Anerkennung deiner bemerkenswerten\n",
        "Siegesserie fordert dich unsere\f",
        "Kampfkoryphäe zu einem Kampf heraus.\r",
        "Im Grunde genommen hast du keine Wahl.\r",
        "Du musst gegen unsere Saaldiva\n",
        "antreten!\r"
      ]
    },
    {
      "id": "msg_0441_00033",
      "de_DE": [
        "Argenta: In meinem Kampfsaal können\n",
        "Trainer Herausforderungen mit ihrem\f",
        "Lieblings-Pokémon bestreiten.\r",
        "Es war sicher nicht leicht, mit deinem\n",
        "Lieblings-Pokémon hierher zu kommen.\r",
        "Aber eine echte Herausforderung macht\n",
        "einen Sieg umso bedeutender.\r",
        "Ich heiße Argenta. Dies ist deine letzte\n",
        "und anspruchvollste Herausforderung.\r",
        "Stelle dich ihr, wenn du dich traust!\r"
      ]
    },
    {
      "id": "msg_0441_00034",
      "de_DE": [
        "Argenta: Unglaublich!\n",
        "Du meine Güte, dein Pokémon...\f",
        "Es ist so unglaublich stark.\r",
        "Selbst aus dem Inneren seines Pokéballs\n",
        "dringt seine Ausstrahlung zu mir durch.\r",
        "Aber ich bin die Saaldiva.\n",
        "Ich werde das selbst beurteilen.\r",
        "Ein Kampf wird beweisen, ob ich mit\n",
        "meinem Gefühl richtig liege.\r",
        "Daher müssen wir jetzt gegeneinander\n",
        "antreten.\r"
      ]
    },
    {
      "id": "msg_0441_00035",
      "de_DE": [
        "Argenta: Ein guter Trainer zwingt\n",
        "niemandem sein Lieblings-Pokémon auf.\r",
        "Ein guter Trainer hält ohne großes\n",
        "Aufsehen daran fest.\r",
        "So sehe ich das zumindest.\r",
        "Und meiner Ansicht nach bist du ein\n",
        "hervorragender Trainer!\r",
        "Besuche den Kampfsaal erneut mit\n",
        "einem deiner liebsten Pokémon.\r",
        "Bis dann also, auf Wiedersehen!\r"
      ]
    },
    {
      "id": "msg_0441_00036",
      "de_DE": [
        "Argenta: Du darfst nicht vergessen,\n",
        "dass an diesem Ort jeder glänzen kann!\r",
        "Das gilt auch für alle Arten von\n",
        "Pokémon.\r",
        "Sage das allen in deinen eigenen Worten\n",
        "weiter. Jeder sollte das wissen.\r",
        "Und nun, nach meiner Niederlage, habe\n",
        "ich nichts weiter zu sagen bis auf...\r",
        "Auf Wiedersehen!\r"
      ]
    },
    {
      "id": "msg_0441_00037",
      "de_DE": [
        "Bitte wähle den Pokémon-Typ, gegen\n",
        "den du antreten möchtest."
      ]
    }
  ]
}
