    },
    {
      "id": "msg_0441_00023",
      "de_DE": [
        "Bitte wähle den Pokémon-Typ, gegen\n",
        "den du antreten möchtest.\r"
      ]
    },
    {
      "id": "msg_0441_00024",
      "de_DE": [
        "Möchtest du gegen {STRVAR_1 15, 0, 0}-Pokémon,\n",
        "Rang {STRVAR_1 51, 1, 0}, antreten?"
      ]
    },
    {
      "id": "msg_0441_00025",
      "garbage": 16
    },
    {
