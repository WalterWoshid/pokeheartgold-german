      "id": "msg_0441_00002",
      "de_DE": "{STRVAR_1 0, 0, 0} komplett geheilt."
    },
    {
      "id": "msg_0441_00003",
      "de_DE": [
        "Als Nächstes kommt Kampf Nr. {STRVAR_1 53, 0, 0}!\n",
        "Bist du bereit?"
      ]
    },
    {
      "id": "msg_0441_00004",
      "de_DE": [
        "Möchtest du den letzten Kampf als dein\n",
        "Kampfvideo speichern?"
      ]
    },
    {
      "id": "msg_0441_00005",
      "de_DE": [
        "Kampf von {STRVAR_1 3, 0, 0} wurde als\n",
        "Kampfvideo gespeichert.\r"
      ]
    },
    {
      "id": "msg_0441_00006",
      "de_DE": [
        "Ein Fehler ist aufgetreten. Das Kampf-\n",
        "video konnte nicht gespeichert werden."
      ]
    },
    {
      "id": "msg_0441_00007",
      "de_DE": [
        "Dein existierendes Kampfvideo löschen\n",
        "und den letzten Kampf speichern?"
      ]
    },
    {
      "id": "msg_0441_00008",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0441_00009",
      "de_DE": [
        "Möchtest du speichern und\n",
        "eine Pause einlegen?"
      ]
    },
    {
      "id": "msg_0441_00010",
      "de_DE": [
        "Möchtest du dich aus dieser Kampfsaal-\n",
        "Herausforderung zurückziehen?"
      ]
    },
    {
      "id": "msg_0441_00011",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} wählt gerade.\n",
        "Bitte warten."
      ]
    },
    {
      "id": "msg_0441_00012",
      "garbage": 20
    },
    {
      "id": "msg_0441_00013",
      "de_DE": "{STRVAR_1 3, 0, 0} hat sich zurückgezogen."
    },
    {
      "id": "msg_0441_00014",
      "de_DE": [
        "Du hast dein zehntes Spiel im Kampfsaal\n",
        "geschafft! Glückwunsch!\r",
        "Für deine enorme Siegesserie gebühren\n",
        "dir und {STRVAR_1 0, 0, 0} GP als Belohnung!\r"
      ]
    },
    {
      "id": "msg_0441_00015",
      "de_DE": "{STRVAR_1 3, 0, 0} erhielt {STRVAR_1 51, 1, 0} GP!\r"
    },
