{
  "key": 4051,
  "messages": [
    {
      "id": "msg_0342_00000",
      "de_DE": [
        "Ich bin heilfroh, dass es dieses\n",
        "Pokémon-Center in der Nähe\f",
        "des Tunnels gibt."
      ]
    },
    {
      "id": "msg_0342_00001",
      "de_DE": [
        "Als ich neulich am Kraftwerk\n",
        "vorbeigekommen bin, konnte ich\f",
        "drinnen jemanden schreien hören:\f",
        "“Dieser verflixte Langfinger!”\r",
        "Das... war wohl der Direktor, was?"
      ]
    },
    {
      "id": "msg_0342_00002",
      "de_DE": [
        "Soll Team Rocket nicht auch versucht\n",
        "haben, ein Comeback zu starten?\f",
        "Aber scheinbar wurde da nichts draus.\r",
        "Ich hatte ja keine Ahnung!"
      ]
    },
    {
      "id": "msg_0342_00003",
      "de_DE": [
        "Südlich von diesem Pokémon-Center\n",
        "gibt es ein großes Kraftwerk, aber\f",
        "von hier aus kann man es nicht sehen,\f",
        "weil es von einem Berg verdeckt wird."
      ]
    }
  ]
}
