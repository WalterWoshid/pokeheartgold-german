  "messages": [
    {
      "id": "msg_0101_00000",
      "de_DE": [
        "Es gibt zwar auch Trainer, die sich\n",
        "alleine auf die angeborenen Fähigkeiten\f",
        "ihrer Pokémon verlassen, aber je\f",
        "nach Anwendungsweise kann man\f",
        "ihre Fähigkeiten auch mithilfe von Items\f",
        "und Tränken weiter ausbauen!"
      ]
    },
    {
      "id": "msg_0101_00001",
      "de_DE": [
        "Beim Bergsteigen und bei Pokémon-\n",
        "Kämpfen sind allein deine angeborenen\f",
        "Fähigkeiten ausschlaggebend!\r",
        "Im Kampf verlasse ich mich nur auf\n",
        "Talent und Training und nicht auf\f",
        "Tränke oder Items!"
      ]
    }
  ]
}
