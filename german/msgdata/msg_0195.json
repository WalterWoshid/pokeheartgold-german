    {
      "id": "msg_0195_00000",
      "de_DE": [
        "Zunächst behalten wir deine Pokémon\n",
        "als Pfand für die ausgeliehenen ein.\r",
        "Darf ich also vorschlagen, Pokémon\n",
        "mit Bedacht zu wählen?\r"
      ]
    },
    {
      "id": "msg_0195_00001",
      "de_DE": "Bitte warte einen Moment."
    },
    {
      "id": "msg_0195_00002",
      "de_DE": "Bitte geh hinein."
    },
    {
      "id": "msg_0195_00003",
      "de_DE": [
        "Gut gemacht!\n",
        "Dein Team wird nun geheilt."
      ]
    },
    {
      "id": "msg_0195_00004",
      "de_DE": [
        "Als Nächstes kommt Kampf Nr. {STRVAR_1 53, 0, 0}!\n",
        "Bist du bereit?"
      ]
    },
    {
      "id": "msg_0195_00005",
      "de_DE": [
        "Möchtest du vor dem Kampf\n",
        "noch Pokémon tauschen?"
      ]
    },
    {
      "id": "msg_0195_00006",
      "de_DE": [
        "Möchtest du den letzten Kampf\n",
        "als dein Kampfvideo speichern?"
      ]
    },
    {
      "id": "msg_0195_00007",
      "de_DE": [
        "Kampf von {STRVAR_1 3, 0, 0} wurde\n",
        "als Kampfvideo gespeichert.\r"
      ]
    },
    {
      "id": "msg_0195_00008",
      "de_DE": [
        "Es ist ein Fehler aufgetreten. Kampf-\n",
        "video konnte nicht gespeichert werden.\r"
      ]
    },
    {
      "id": "msg_0195_00009",
      "de_DE": [
        "Dein existierendes Kampfvideo löschen\n",
        "und den letzten Kampf speichern?"
      ]
    },
    {
      "id": "msg_0195_00010",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0195_00011",
      "de_DE": [
        "Möchtest du speichern und\n",
        "eine Pause einlegen?"
      ]
    },
    {
      "id": "msg_0195_00012",
      "de_DE": [
        "Möchtest du dich aus dieser Kampf-\n",
        "fabrik-Herausforderung zurückziehen?"
      ]
    },
    {
      "id": "msg_0195_00013",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} wählt gerade.\n",
        "Bitte warten."
      ]
    },
    {
      "id": "msg_0195_00014",
      "garbage": 21
    },
    {
      "id": "msg_0195_00015",
      "de_DE": "{STRVAR_1 3, 0, 0} hat sich zurückgezogen."
    },
    {
      "id": "msg_0195_00016",
      "de_DE": [
        "Du hast dein siebtes Spiel in der\n",
        "Kampffabrik geschafft! Glückwunsch!\r",
        "In Anerkennung deines umfassenden\n",
        "Wissens über Pokémon belohnen\f",
        "wir dich mit GP!\r"
      ]
    },
    {
      "id": "msg_0195_00017",
      "de_DE": "{STRVAR_1 3, 0, 0} erhielt {STRVAR_1 51, 1, 0} GP!\r"
    },
    {
      "id": "msg_0195_00018",
      "de_DE": [
        "Die als Pfand einbehaltenen Pokémon\n",
        "werden nun zurückgegeben.\r"
      ]
