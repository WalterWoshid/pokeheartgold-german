      "de_DE": [
        "Ach du bist es, {STRVAR_1 3, 0, 0}!\r",
        "Mein Mann ist immer so beschäftigt.\n",
        "Ich hoffe, er überarbeitet sich nicht!\r",
        "Wenn er in seiner Pokémon-Forschung\n",
        "versinkt, vergisst er sogar zu essen."
      ]
    },
    {
      "id": "msg_0544_00001",
      "de_DE": [
        "Ach du bist es, {STRVAR_1 3, 0, 0}!\r",
        "Mein Mann ist immer so beschäftigt.\n",
        "Ich hoffe, er überarbeitet sich nicht!\r",
        "Wenn er in seiner Pokémon-Forschung\n",
        "versinkt, vergisst er sogar zu essen."
      ]
    },
    {
      "id": "msg_0544_00002",
      "de_DE": [
        "Wenn ich groß bin, will ich meinem\n",
        "Papa bei der Arbeit helfen!\r",
        "Und dann werde ich zu einem\n",
        "ganz tollen Pokémon-Professor!"
      ]
    },
    {
      "id": "msg_0544_00003",
      "de_DE": [
        "Die Pokémon... Woher kommen sie?\r",
        "Wohin gehen sie?\r",
        "Warum war noch nie jemand Zeuge\n",
        "der Geburt eines Pokémon?\r",
        "Und welche Auswirkungen hat der\n",
        "Umgang mit uns Menschen auf sie?\r",
        "Ich muss es unbedingt herausfinden!\r",
        "Zu diesem Zweck habe ich mein gesamtes\n",
        "Leben der Forschung verschrieben!\r",
        "... ... ...\r",
        "Das ist ein Teil von Professor Linds\n",
        "Aufzeichnungen."
      ]
    }
  ]
