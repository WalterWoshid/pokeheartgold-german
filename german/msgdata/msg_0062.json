  "messages": [
    {
      "id": "msg_0062_00000",
      "de_DE": [
        "Ich kann eins meiner Pokémon\n",
        "in den Pokéwalker übertragen...\r",
        "Hm, sich auf ein einziges festzulegen,\n",
        "ist gar nicht mal so leicht."
      ]
    },
    {
      "id": "msg_0062_00001",
      "de_DE": [
        "Oh, ich? Man merkt es vielleicht nicht\n",
        "sofort, aber mein Körper ist überall\f",
        "mit Pokéwalkern beladen!\r",
        "Wenn ich mit diesen Dingern durch die\n",
        "Gegend spaziere, klappert und rasselt\f",
        "es immer ganz fürchterlich."
      ]
    },
    {
      "id": "msg_0062_00002",
      "de_DE": [
        "So, jetzt mal hergehört, Herrschaften!\r",
        "...Oh, Entschuldigung. Ich muss echt\n",
        "mal dieses Lehrergehabe loswerden.\r",
        "Du bist ein Pokémon-Trainer, stimmt’s?\r",
        "Du scheinst sehr hart zu arbeiten.\n",
        "Hier, nimm das als Belohnung!\r"
      ]
    },
    {
      "id": "msg_0062_00003",
      "garbage": 21
    },
    {
      "id": "msg_0062_00004",
      "de_DE": [
        "Gib diese Flinkklaue einem deiner\n",
        "Pokémon, und es wird mit ihrer Hilfe\f",
        "im Kampf ab und zu die Initiative\f",
        "erhalten!"
      ]
    },
    {
      "id": "msg_0062_00005",
      "de_DE": [
        "Es ist natürlich schön, wenn man sein\n",
        "Pokémon aus dem Pokéball lassen und\f",
        "mit ihm spazieren gehen kann.\f",
        "Aber wenn du es in den Pokéwalker\f",
        "überträgst, eröffnen sich dir noch mal\f",
        "ganz andere Spielmöglichkeiten!"
      ]
    },
    {
      "id": "msg_0062_00006",
      "de_DE": [
        "Meine Mutter hat ein bisschen Angst\n",
        "vor Pokémon und lässt sie mich nicht\f",
        "mit ins Haus bringen.\f",
        "Sie ist da sehr streng...\r",
        "Aber wenn ich ein Pokémon in den\n",
        "Pokéwalker übertrage, ist es immer\f",
        "in meiner Nähe!"
      ]
    },
    {
      "id": "msg_0062_00007",
      "de_DE": [
        "Ich gehe oft im Park spazieren,\n",
        "aber ich meide das hohe Gras,\f",
        "weil ich sonst kämpfen müsste."
      ]
    },
    {
      "id": "msg_0062_00008",
      "de_DE": "SNOBILIKAT: Snooobi, snobi!"
    },
    {
      "id": "msg_0062_00009",
      "de_DE": [
        "Hechel, hechel, keuch...\r",
        "Ich habe meine Faust entschlossen um\n",
        "den Pokéwalker geballt und bin damit\f",
        "durch den ganzen Park gehetzt, um\f",
        "Watt zu sammeln...\f",
        "Und jetzt bin ich fix und fertig."
      ]
    },
