  "key": 21543,
  "messages": [
    {
      "id": "msg_0349_00000",
      "de_DE": [
        "Ich bin der jüngere Bruder\n",
        "des Profi-Anglers.\r",
        "Hm...\n",
        "Du siehst wie jemand aus, der\f",
        "Spaß am Angeln hat!\r",
        "Na? War die Einschätzung richtig?\n",
        "Ich bin berühmt für meinen scharfen\f",
        "Blick, was Menschen angeht! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0349_00001",
      "de_DE": [
        "Ja, ganz eindeutig! Du angelst gerne!\n",
        "Genau wie ich mir dachte!\r",
        "Hier, ein kleines Geschenk unter\n",
        "Anglern! Diese Angel ist der Wahnsinn!\r"
      ]
    },
    {
      "id": "msg_0349_00002",
      "de_DE": [
        "Damit kannst du an den verschiedensten\n",
        "Orten dem Angeln frönen!\r",
        "Wenn du verschiedene Ruten benutzt,\n",
        "beißen auch immer andere Pokémon an!"
      ]
    },
    {
      "id": "msg_0349_00003",
      "de_DE": [
        "Echt jetzt? Sollte ich mich in meiner\n",
        "Einschätzung etwa getäuscht haben?"
      ]
    }
  ]
}
