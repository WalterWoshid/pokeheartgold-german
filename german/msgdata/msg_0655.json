{
  "key": 38189,
  "messages": [
    {
      "id": "msg_0655_00000",
      "de_DE": "Sabrina"
    },
    {
      "id": "msg_0655_00001",
      "de_DE": [
        "Bitte? Ich verstehe dich kaum!\n",
        "Die Verbindung ist so schlecht!\r",
        "Ruf bitte noch einmal von woanders an!"
      ]
    },
    {
      "id": "msg_0655_00002",
      "de_DE": [
        "Hallo?\n",
        "Gibt es bei dir irgendwas Neues?\f",
        "Bei mir ist alles beim Alten!\r"
      ]
    },
    {
      "id": "msg_0655_00003",
      "de_DE": [
        "Es gibt noch viele andere starke\n",
        "Arenaleiter außer mir!\f",
        "Streng dich an!"
      ]
    },
    {
      "id": "msg_0655_00004",
      "de_DE": [
        "Am Sonntagmittag könnte ich mir Zeit\n",
        "nehmen...\r",
        "Ruf mich dann doch einfach an!"
      ]
    },
    {
      "id": "msg_0655_00005",
      "de_DE": [
        "Dein Anruf kommt wie gerufen!\n",
        "Ich hätte jetzt Zeit für dich...\r",
        "Na, hast du Lust auf ein Rematch? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0655_00006",
      "de_DE": [
        "Um ehrlich zu sein, alles andere hätte\n",
        "mich auch sehr enttäuscht!\r",
        "Ich warte auf dich im Dojo von\n",
        "Saffronia City!"
      ]
    },
    {
      "id": "msg_0655_00007",
      "de_DE": [
        "Hm...\n",
        "Irgendwie hatte ich zwar damit\f",
        "gerechnet, dass du ablehnst, aber\f",
        "enttäuscht bin ich schon ein wenig..."
      ]
    },
    {
      "id": "msg_0655_00008",
      "de_DE": [
        "Hast du denn überhaupt Zeit, um mit mir\n",
        "zu kämpfen?\r",
        "Solltest du noch eine Verabredung zum\n",
        "Rematch ausstehen haben, dann geht\f",
        "das natürlich vor!"
      ]
    },
    {
      "id": "msg_0655_00009",
      "de_DE": [
        "Ich erwarte dich dann im Dojo von\n",
        "Saffronia City!\f",
        "Vergiss es bitte nicht!"
      ]
    },
    {
      "id": "msg_0655_00010",
      "de_DE": [
        "Ich bin’s, Sabrina!\n",
        "Wie geht’s dir?\r"
      ]
    },
    {
      "id": "msg_0655_00011",
      "de_DE": [
        "Du hast nicht vergessen, dass wir uns\n",
        "im Dojo von Saffronia City zum Rematch\f",
        "verabredet haben, nicht wahr?"
      ]
    },
    {
      "id": "msg_0655_00012",
      "de_DE": [
        "Ich werde dir einmal etwas über das\n",
        "Psycho-Training sagen.\r",
        "Unter übersinnlichen Kräften versteht\n",
        "man die Fähigkeit, seine Gefühle zu\f",
        "kontrollieren. \r",
        "Schließe die Augen und versuche, dich\n",
        "von allem Überflüssigen zu befreien...\f",
        "Ziel ist es, sein Selbst wiederzufinden!\r",
        "Es geht nicht darum, durch die Kraft\n",
        "der Gedanken Dinge zu bewegen...\r",
        "Es kommt einzig darauf an, die eigenen\n",
        "Gefühle richtig zu beherrschen!"
      ]
    },
    {
      "id": "msg_0655_00013",
      "de_DE": [
        "Du... wirst noch viel stärker werden,\n",
        "als du es ohnehin schon bist!\f",
        "Ich weiß das...\r",
        "Ich sehe dich schon als strahlenden\n",
        "Sieger vor mir, der Trainer um Trainer\f",
        "bezwungen hat...\r",
        "Das wollte ich dir einfach einmal\n",
        "gesagt haben...\r",
        "In diesem Sinne!"
      ]
    },
    {
      "id": "msg_0655_00014",
      "de_DE": [
        "Bei dir sind Verstand, Kraft und Herz\n",
        "in perfekter Harmonie vereint!\f",
        "Du bist der geborene Trainer!\r",
        "Vor allem dein Herz verfügt über eine\n",
        "besondere Kraft! Das spüre ich...\r",
        "Hast du nie darüber nachgedacht, dich\n",
        "ernsthaft dem Psycho-Training zu\f",
        "unterziehen?\r",
        "Wer weiß, womöglich übertriffst du mich\n",
        "ja!"
      ]
    }
  ]
}
