{
  "key": 57706,
  "messages": [
    {
      "id": "msg_0708_00000",
      "de_DE": "Günter"
    },
    {
      "id": "msg_0708_00001",
      "de_DE": [
        "Yeah! Wie du mich angegriffen hast,\n",
        "das war gut!\f",
        "Wir müssen uns wiedersehen!\r",
        "Gib mir doch bitte deine Nummer! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0708_00002",
      "de_DE": [
        "Ich rufe an, wenn mir\n",
        "der Sinn nach Kämpfen steht!"
      ]
    },
    {
      "id": "msg_0708_00003",
      "de_DE": [
        "Nein? In Ordnung. Ein klares Nein\n",
        "ist leicht zu verkraften!\r",
        "Ich bin hier, wenn du erneut\n",
        "kämpfen möchtest."
      ]
    },
    {
      "id": "msg_0708_00004",
      "de_DE": [
        "Du willst meine Nummer speichern, um\n",
        "erneut gegen mich zu kämpfen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0708_00005",
      "de_DE": [
        "Du bist wirklich was Besonderes.\r",
        "Hätte ich mich doch auch mit\n",
        "Pokémon befasst, als ich noch jung war.\r",
        "Ich möchte, dass du in unser beider\n",
        "Namen arbeitest und erfolgreich bist.\f",
        "Also nimm dies!\r"
      ]
    },
    {
      "id": "msg_0708_00006",
      "de_DE": [
        "He?\n",
        "Höre ich da einen Fluss im Hintergrund?\f",
        "Sag bloß, du bist in der Nähe?"
      ]
    },
    {
      "id": "msg_0708_00007",
      "de_DE": [
        "Nichts kann es mit meinem {STRVAR_1 0, 10, 0}\n",
        "aufnehmen.\r",
        "Gemeinsam haben wir sogar\n",
        "ein wildes {STRVAR_1 0, 11, 0} besiegt.\r",
        "Eigentlich wollte ich es ja fangen...\n",
        "Aber egal.\r",
        "O.K., ruf mich an!"
      ]
    },
    {
      "id": "msg_0708_00008",
      "de_DE": [
        "Nichts kann es mit meinem {STRVAR_1 0, 10, 0}\n",
        "aufnehmen.\r",
        "Gestern haben wir sogar ein wildes\n",
        "{STRVAR_1 0, 11, 0} gesehen. Wir diskutierten,\f",
        "ob wir es fangen sollten.\r",
        "Dann tauchte ein anderer Typ auf\n",
        "und fing es! Potztausend!\r",
        "Okay, ruf mich an!"
      ]
    },
    {
      "id": "msg_0708_00009",
      "de_DE": [
        "So langsam brennst du sicher darauf,\n",
        "gegen mich zu kämpfen, richtig?\f",
        "Das tust du doch? Aber klar!\r",
        "Gut! Ich warte hier: {STRVAR_1 4, 3, 0}!"
      ]
    },
    {
      "id": "msg_0708_00010",
      "de_DE": [
        "Ich hocke immer noch hier.\n",
        "{STRVAR_1 4, 3, 0}! Ausgerechnet!\r",
        "O.K., hier zu warten ist nicht übel,\n",
        "aber ich möchte kämpfen!"
      ]
    },
    {
      "id": "msg_0708_00011",
      "de_DE": [
        "Du kämpfst doch wieder\n",
        "gegen mich, oder?"
      ]
    }
  ]
}
