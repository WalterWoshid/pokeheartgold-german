  "messages": [
    {
      "id": "msg_0616_00000",
      "de_DE": [
        "Der Glockenturm wurde als Zuflucht und\n",
        "Ruhestätte für HO-OH, das fliegende\f",
        "Pokémon aus der Legende, errichtet.\r",
        "Schon viele Menschen haben versucht,\n",
        "diesen Turm zu erklimmen und HO-OH\f",
        "wieder herbeizurufen, aber keiner von\f",
        "ihnen war je erfolgreich.\r",
        "Jens, der Arenaleiter dieser Stadt,\n",
        "ist eine dieser unglücklichen Seelen.\r",
        "Offenbar bist du noch nicht im Besitz\n",
        "des Ordens von Teak City.\r",
        "Wenn du es schon nicht schaffst, gegen\n",
        "Jens zu gewinnen, macht es auch keinen\f",
        "Sinn, dass du dich am Turm versuchst.\r",
        "Es tut mir wirklich leid, aber ich muss\n",
        "dich bitten, wieder umzukehren..."
      ]
    },
    {
      "id": "msg_0616_00001",
      "de_DE": [
        "Jens, der Arenaleiter dieser Stadt,\n",
        "bestieg den Turm in der Hoffnung,\f",
        "das Pokémon aus der Legende wieder\f",
        "herbeirufen zu können.\r",
        "Aber auch er scheiterte an seinem\n",
        "Unterfangen.\r",
        "Offenbar bist du noch nicht im Besitz\n",
        "des Ordens von Teak City.\r",
        "Wenn du es schon nicht schaffst, gegen\n",
        "Jens zu gewinnen, macht es auch keinen\f",
        "Sinn, dass du dich am Turm versuchst.\r",
        "Es tut mir wirklich leid, aber ich muss\n",
        "dich bitten, wieder umzukehren..."
      ]
    },
    {
      "id": "msg_0616_00002",
      "de_DE": [
        "Der Glockenturm wurde als Zuflucht und\n",
        "Ruhestätte für HO-OH, das fliegende\f",
        "Pokémon aus der Legende, errichtet.\r",
        "Schon viele Menschen haben versucht,\n",
        "diesen Turm zu erklimmen und HO-OH\f",
        "wieder herbeizurufen, aber keiner von\f",
        "ihnen war je erfolgreich.\r",
        "Jens, der Arenaleiter dieser Stadt,\n",
        "ist eine dieser unglücklichen Seelen.\r",
        "Oh! Aber das ist ja der Orden aus der\n",
        "Arena von Teak City!\r",
        "... ... ...\n",
        "Nur weil du dir den Orden erkämpft hast,\f",
        "heißt das noch nicht gleich, dass es dir\f",
        "auch gelingen wird, HO-OH zu rufen.\r",
        "Aber es ist zumindest Grund genug,\n",
        "um dich hier durchzulassen!\r",
        "Bitte, du darfst gehen!\r"
      ]
    },
    {
      "id": "msg_0616_00003",
      "de_DE": [
        "Nur weil du dir den Orden erkämpft hast,\n",
        "heißt das noch nicht gleich, dass es dir\f",
        "auch gelingen wird, HO-OH zu rufen.\r",
        "Aber es ist zumindest Grund genug,\n",
        "um dich hier durchzulassen!\r",
        "Bitte, du darfst gehen!\r"
      ]
    },
    {
      "id": "msg_0616_00004",
      "de_DE": "Schreite voran..."
    },
    {
      "id": "msg_0616_00005",
      "de_DE": [
        "Alleine dafür, dass ich miterleben\n",
        "durfte, wie HO-OH wieder zu uns\f",
        "herabgestiegen ist, hat es sich\f",
        "gelohnt, all diese Jahre harten\f",
        "Trainings zu erdulden..."
      ]
    },
    {
      "id": "msg_0616_00006",
      "de_DE": [
        "Nur jemandem, der im Besitz der\n",
        "Buntschwinge ist, wird erlaubt, den\f",
        "Glockenturm zu besteigen...\r",
        "Aber wenn du das regenbogenfarbene\n",
        "Pokémon herbeirufen möchtest, reicht\f",
        "es natürlich nicht, einfach nur an die\f",
        "Spitze des Turms zu steigen.\r",
        "Um HO-OH zu erreichen, benötigst du\n",
        "noch etwas anderes.\r",
        "Angeblich wissen die Kimono-Girls aus\n",
        "dieser Stadt, was das genau ist..."
      ]
    },
    {
      "id": "msg_0616_00007",
      "de_DE": [
        "Es gibt zwei Sagen, die sich um die\n",
        "Johto-Region ranken.\r",
        "Eine von ihnen befasst sich mit den\n",
        "Strudelinseln, während die andere\f",
        "vom Glockenturm erzählt...\r",
        "Wir Leute von Teak City sind sehr darum\n",
        "bemührt, die Sage vom Glockenturm\f",
        "für kommende Generationen am Leben\f",
        "zu erhalten."
      ]
    },
    {
      "id": "msg_0616_00008",
      "de_DE": [
        "Der Glockenturm bebt!\r",
        "Bestimmt... bestimmt ist HO-OH\n",
        "wieder zu uns zurückgekehrt!"
      ]
    },
    {
      "id": "msg_0616_00009",
      "de_DE": [
        "Ausgerechnet ein junger Trainer wie du\n",
        "soll HO-OH..."
      ]
    },
    {
      "id": "msg_0616_00010",
      "de_DE": [
        "Das regenbogenfarbene Pokémon\n",
        "soll anmutig auf die Spitze des Turms\f",
        "herabsteigen, während das silbern\f",
        "strahlende Pokémon tief am Meeresboden\f",
        "unter den Strudelinseln schlummert.\r",
        "Schwer vorzustellen, was?"
      ]
    }
  ]
