{
  "key": 50307,
  "messages": [
    {
      "id": "msg_0135_00000",
      "de_DE": [
        "Willkommen in der Safari-Zone!\r",
        "Für nur {STRVAR_1 52, 1, 0} $ kannst du hier so viele\n",
        "Pokémon fangen, wie du willst.\f",
        "Na, wie wär’s? Hast du Lust? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00001",
      "de_DE": [
        "Boss!\n",
        "Willkommen in der Safari-Zone!\r",
        "Für nur {STRVAR_1 52, 1, 0} $ kannst du hier so viele\n",
        "Pokémon fangen, wie du willst.\f",
        "Na, wie wär’s? Hast du Lust? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00002",
      "de_DE": "Gut, dann bekomme ich {STRVAR_1 52, 1, 0} $ von dir!\r"
    },
    {
      "id": "msg_0135_00003",
      "de_DE": [
        "Oh, in Ordnung.\n",
        "Aber ich hoffe, du kommst mal wieder!"
      ]
    },
    {
      "id": "msg_0135_00004",
      "de_DE": "Hier sind deine Safaribälle.\r"
    },
    {
      "id": "msg_0135_00005",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält\n",
        "{STRVAR_1 51, 1, 0} Safaribälle!"
      ]
    },
    {
      "id": "msg_0135_00006",
      "de_DE": [
        "Wir melden uns bei dir, sobald\n",
        "dir die Safaribälle ausgehen.\f",
        "Und jetzt tobe dich mal so\f",
        "richtig aus!\r"
      ]
    },
    {
      "id": "msg_0135_00007",
      "de_DE": [
        "Du hast noch Safaribälle übrig.\n",
        "Willst du trotzdem aufhören? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00008",
      "de_DE": [
        "In Ordnung, wie du wünschst!\r",
        "Dann geht der Rest deiner Safaribälle\n",
        "wieder zurück an uns.\r"
      ]
    },
    {
      "id": "msg_0135_00009",
      "de_DE": [
        "Bist du auf deine Kosten gekommen?\n",
        "Beehre uns doch mal wieder!"
      ]
    },
    {
      "id": "msg_0135_00010",
      "de_DE": [
        "Oh, das tut mir aber leid!\n",
        "Dein Geld scheint nicht zu reichen.\r",
        "Aber ich hoffe, du kommst mal wieder!"
      ]
    },
    {
      "id": "msg_0135_00011",
      "de_DE": [
        "Oh, das tut mir aber leid, Boss!\n",
        "Dein Geld scheint nicht zu reichen.\r",
        "Aber ich hoffe, du kommst mal wieder!"
      ]
    },
    {
      "id": "msg_0135_00012",
      "de_DE": [
        "Oh, das tut mir aber leid!\n",
        "Du hast keinen Platz mehr in den Boxen.\r",
        "Sei doch so gut und komm wieder,\n",
        "wenn du etwas Platz geschaffen hast."
      ]
    },
    {
      "id": "msg_0135_00013",
      "de_DE": [
        "Oh, das tut mir aber leid, Boss!\n",
        "Du hast keinen Platz mehr in den Boxen.\r",
        "Sei doch so gut und komm wieder,\n",
        "wenn du etwas Platz geschaffen hast."
      ]
    },
    {
      "id": "msg_0135_00014",
      "de_DE": [
        "Willkommen in der Safari-Zone!\r",
        "Bist du zum ersten Mal hier? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00015",
      "de_DE": [
        "Willkommen in der Safari-Zone, Boss!\r",
        "Kurze Erklärung, was es mit der\n",
        "Safari auf sich hat, gefällig? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00016",
      "de_DE": [
        "In der Safari-Zone erhältst du von uns\n",
        "{STRVAR_1 51, 1, 0} Safaribälle, mit denen du dort\f",
        "Pokémon fangen und das Safari-Spiel\f",
        "in vollen Zügen genießen kannst.\r",
        "Gehen dir die Bälle aus,\n",
        "ist das Spiel vorbei.\r",
        "Die Pokémon, denen du während deines\n",
        "Safari-Trips begegnest, kannst du\f",
        "entweder mit einem Köder locken\f",
        "oder mit Matsch bombardieren.\r",
        "Pokémon, denen du einen Köder zuwirfst,\n",
        "lassen sich schwerer fangen, aber sie\f",
        "laufen dir dafür nicht so leicht davon.\r",
        "Pokémon, die du mit Matsch zuwirfst,\n",
        "lassen sich leichter fangen, aber\f",
        "nehmen dafür auch eher Reißaus.\r",
        "Und jetzt wünsche ich dir viel Spaß bei\n",
        "deinen Abenteuern in der Safari-Zone!"
      ]
    },
    {
      "id": "msg_0135_00017",
      "de_DE": [
        "Viel Spaß bei deinen\n",
        "Abenteuern in der Safari-Zone!"
      ]
    },
    {
      "id": "msg_0135_00018",
      "de_DE": [
        "Baoba, der Wärter, scheint dir\n",
        "etwas Wichtiges mitteilen zu wollen!"
      ]
    },
    {
      "id": "msg_0135_00019",
      "de_DE": [
        "Dies ist der Terrain-Editor.\r",
        "Was soll ich dir erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00020",
      "de_DE": [
        "Die Safari-Zone besteht aus sechs\n",
        "Arealen, die mit verschiedenen Terrains\f",
        "ausgestattet werden können.\r",
        "Es gibt unter anderem Grasland,\n",
        "Felsplateau und noch viele mehr.\r",
        "Mit dem Terrain-Editor kannst\n",
        "du dir frei nach Laune deine eigene\f",
        "Safari-Zone zusammenschustern!\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00021",
      "de_DE": [
        "Der Terrain-Editor wird gestartet,\n",
        "sobald du diese Maschine untersuchst.\r",
        "Auf dem unteren Bildschirm wird dir die\n",
        "gegenwärtige Anordnung der Safari-Zone\f",
        "angezeigt. Wählst du ein Areal mit dem\f",
        "A-Knopf aus, kannst du dieses mit einem\f",
        "anderen Terrain ausstatten.\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00022",
      "de_DE": [
        "Hast du dir ein Areal ausgesucht und\n",
        "wählst die Option “TAUSCH”,\f",
        "werden dir zwölf Arten von Terrains auf\f",
        "dem Bildschirm angezeigt.\r",
        "Wähle nun das Terrain, gegen das du das\n",
        "alte gerne austauschen möchtest, und\f",
        "bestätige mit dem A-Knopf.\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00023",
      "de_DE": [
        "Hast du dich für ein Areal entschieden\n",
        "und wählst die Option “BEWEGEN”,\r",
        "kannst du das Terrain und ein anderes,\n",
        "das sich bereits in deiner Safari-Zone\f",
        "befindet, die Plätze tauschen lassen.\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00024",
      "de_DE": [
        "Jedes Terrain der Safari wird von\n",
        "unterschiedlichen Pokémon bewohnt.\r",
        "Tauschst du irgendwo das Terrain aus,\n",
        "triffst du dort auch andere Pokémon.\r",
        "Experimentiere also unbedingt mit\n",
        "verschiedenen Terrains herum!\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00025",
      "de_DE": [
        "Tut mir leid, aber diese Maschine\n",
        "kann noch nicht benutzt werden.\r",
        "Aber es heißt, der Wärter Baoba\n",
        "habe unglaubliche Dinge mit dieser\f",
        "Maschine vor...\f",
        "Die Details hält er allerdings selbst\f",
        "vor uns fürs Erste noch geheim."
      ]
    },
    {
      "id": "msg_0135_00026",
      "de_DE": [
        "Viel Spaß noch mit dem\n",
        "Terrain-Editor!"
      ]
    },
    {
      "id": "msg_0135_00027",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} schaltet den\n",
        "Terrain-Editor ein!\r"
      ]
    },
    {
      "id": "msg_0135_00028",
      "de_DE": "Außer Betrieb!"
    },
    {
      "id": "msg_0135_00029",
      "de_DE": [
        "Oh! Da bist du ja endlich!\n",
        "Na, was sagst du? Wahnsinn, oder?\r",
        "Wie du siehst, haben wir eine neue\n",
        "Safari eröffnet!\r",
        "Tja, und jetzt...\r",
        "Jetzt hab ich ein Attentat auf dich vor!\n",
        "Willst du bei meinem Eignungstest\f",
        "für Safari-Besitzer mitmachen, hm? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00030",
      "de_DE": [
        "Sehr schön, so gefällst du mir!\r",
        "Dann erkläre ich dir gleich mal,\n",
        "wie der Test genau abläuft.\r",
        "Keine Sorge, es ist kinderleicht!\r",
        "Alles, was du tun musst, ist bei der\n",
        "Safari ein KLEINSTEIN zu fangen!\f",
        "Wenn du eins zu mir bringst, hast\f",
        "du auch schon bestanden!\r",
        "Sie halten sich im hohen Gras gleich am\n",
        "Eingang zur Safari auf. Wenn du ein\f",
        "klein wenig suchst, solltest du also\f",
        "mit Leichtigkeit eins finden!\r",
        "So, dann wünsche ich dir mal\n",
        "Weidmannsheil!"
      ]
    },
    {
      "id": "msg_0135_00031",
      "de_DE": [
        "Oha! Dass du ablehnst, hätte ich\n",
        "jetzt ehrlich gesagt nicht erwartet!\r",
        "Willst du denn wirklich nicht\n",
        "deine eigene Safari besitzen?\r",
        "Du wärst dort dein eigener Boss!\n",
        "Hört sich das nicht verlockend an?\r",
        "Komm schon, versuch’s doch mal! {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00032",
      "de_DE": [
        "Oh, fantastisch!\n",
        "Du hast ein KLEINSTEIN gefangen!\r",
        "Damit hast du den ersten Teil\n",
        "des Tests bestanden!\r",
        "... ... ...\n",
        "Ach, hatte ich dir das nicht gesagt?\r",
        "Dieser Test setzt sich aus insgesamt\n",
        "zwei Teilen zusammen!\r",
        "Logisch, oder? Ganz so leicht wird\n",
        "man auch nicht zum Safari-Besitzer!\r",
        "Gut, der zweite Teil also...\r",
        "Leider stecke ich selbst noch mitten\n",
        "in den Planungsarbeiten dafür.\f",
        "Ich werde dir per Pokécom Bescheid\f",
        "geben, wenn ich damit fertig bin.\f",
        "Gedulde dich also noch ein klein wenig!"
      ]
    },
    {
      "id": "msg_0135_00033",
      "de_DE": [
        "Lege dich tüchtig ins Zeug und fange\n",
        "mir ein schönes KLEINSTEIN!\r",
        "Sie halten sich im hohen Gras gleich am\n",
        "Eingang zur Safari auf. Wenn du ein\f",
        "klein wenig suchst, solltest du also\f",
        "mit Leichtigkeit eins finden!\r",
        "So, dann wünsche ich dir mal\n",
        "Weidmannsheil!"
      ]
    },
    {
      "id": "msg_0135_00034",
      "de_DE": [
        "Oh, da bist du ja endlich! Ich bin\n",
        "mit den Planungsarbeiten fertig!\r",
        "Hör gut zu: Für den zweiten Test\n",
        "musst du ein SANDAN fangen\f",
        "und es zu mir bringen!\r",
        "Was, das erinnert dich jetzt doch\n",
        "ziemlich an den ersten Test, sagst du?\r",
        "Lass mich doch erst einmal ausreden!\r",
        "Es ist nämlich gar nicht mal so leicht,\n",
        "hier ein SANDAN zu Gesicht zu bekommen!\r",
        "Und genau da kommt das hier ins Spiel!\r"
      ]
    },
    {
      "id": "msg_0135_00035",
      "de_DE": [
        "Mit dieser technisch hoch entwickelten\n",
        "Maschine kannst du die Safari-Bereiche\f",
        "nach Lust und Laune neu gestalten!\r",
        "Ich nenne sie den “Terrain-Editor”!\r",
        "Nach welchem Konzept sie funktioniert\n",
        "und was genau in ihr steckt...\f",
        "Tja, das bleibt mein Geheimnis!\r",
        "Aber keine Angst! Es wird dir sehr\n",
        "leicht fallen, sie zu bedienen!\r",
        "Die Einzelheiten kann dir mein\n",
        "Mitarbeiter da drüben erklären!\r"
      ]
    },
    {
      "id": "msg_0135_00036",
      "de_DE": [
        "Oh, Moment mal! Tut mir leid!\r",
        "Ich hatte dir den zweiten Teil des Tests\n",
        "ja noch gar nicht vollständig erklärt!\r",
        "Auf dem bisherigen Terrain der Safari\n",
        "wirst du keine SANDAN finden.\r",
        "Aber genau das ist der Knackpunkt!\r",
        "Du wirst dir den Terrain-Editor zunutze\n",
        "machen müssen, um das Terrain\f",
        "der Safari zu verändern!\r",
        "SANDAN findest du...\n",
        "natürlich in der Wüste!\r",
        "Also dann!\n",
        "Weidmannsheil!"
      ]
    },
    {
      "id": "msg_0135_00037",
      "de_DE": [
        "Oh, fantastisch!\n",
        "Du hast ein SANDAN gefangen!\r",
        "Ich wusste von Anfang an,\n",
        "dass du es schaffen würdest!\r",
        "Du hast bestanden!\r",
        "Jetzt kann ich dich ohne Bedenken\n",
        "zum Besitzer der Safari machen!\r"
      ]
    },
    {
      "id": "msg_0135_00038",
      "de_DE": [
        "Weißt du...\n",
        "Mein Traum war es, junge Leute mit\f",
        "einer Leidenschaft für Pokémon bei\f",
        "Safari-Abenteuern zu begleiten.\r",
        "Irgendwie hatte ich das Gefühl, mit\n",
        "diesem Traum etwas völlig Neuartigem\f",
        "auf der Spur zu sein.\r",
        "Mit der Safari helfe ich unter anderem\n",
        "Leuten wie dir dabei, ihren Pokédex\f",
        "zu vervollständigen. Aber ich selbst\f",
        "kann dabei auch noch eine Menge lernen.\r",
        "Das war der Gedanke hinter allem.\r"
      ]
    },
    {
      "id": "msg_0135_00039",
      "de_DE": [
        "Noch eine Sache...\r",
        "Ich weiß, du bist jetzt eigentlich\n",
        "der Besitzer der Safari...\f",
        "aber würdest du vielleicht trotzdem\f",
        "immer die Eintrittsgebühr bezahlen?\r",
        "Ich muss leider auch von etwas leben...\r",
        "Ich werde mir im Gegenzug auch\n",
        "weitere Attraktionen einfallen lassen,\f",
        "die dir dabei behilflich sind, deinen\f",
        "Pokédex zu vervollständigen!\r",
        "Schön! Dann wünsche ich dir noch\n",
        "viel Spaß in der Safari-Zone!"
      ]
    },
    {
      "id": "msg_0135_00040",
      "de_DE": [
        "Wenn mir eine neue Attraktion einfällt,\n",
        "bist du der Erste, den ich in die Idee\f",
        "einweihe! Natürlich per Pokécom!"
      ]
    },
    {
      "id": "msg_0135_00041",
      "de_DE": [
        "Lege dich ins Zeug und fange\n",
        "mir ein schönes SANDAN!\r",
        "Finden kannst du diese Pokémon...\n",
        "natürlich in der Wüste!\r",
        "Also dann!\n",
        "Weidmannsheil!"
      ]
    },
    {
      "id": "msg_0135_00042",
      "de_DE": [
        "Nur mal keine Panik!\r",
        "Wenn ich den zweiten Test vollständig\n",
        "durchgeplant habe, bist du der Erste,\f",
        "den ich per Pokécom darüber in\f",
        "Kenntnis setzen werde.\f",
        "Habe noch ein wenig Geduld!"
      ]
    },
    {
      "id": "msg_0135_00043",
      "de_DE": [
        "Oh, da bist du ja endlich!\r",
        "Mir ist endlich die Inspiration für\n",
        "ein neues Spiel gekommen!\r",
        "Ich nenne es...\n",
        "den Sofortofix Block-Verteiler!\r",
        "Das wird dich aus den Socken hauen!\n",
        "Damit kannst du, während du auf Safari\f",
        "bist, nach Herzenslust Gegenstände\f",
        "in der Gegend verteilen!\r"
      ]
    },
    {
      "id": "msg_0135_00044",
      "de_DE": [
        "Aber das ist noch nicht alles!\r",
        "Je nachdem, was für eine Sorte\n",
        "von Block du legst, wirst du dort\r",
        "auch auf verschiedene Pokémon\n",
        "treffen!\f",
        "Ist das nicht einfach unglaublich?\r",
        "Also dann! Wenn es wieder etwas\n",
        "gibt, melde ich mich per Pokécom!\r"
      ]
    },
    {
      "id": "msg_0135_00045",
      "de_DE": [
        "Ich kann dir erklären, wie das mit dem\n",
        "Verteilen von Blöcken funktioniert.\r",
        "Soll ich es dir erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00046",
      "de_DE": [
        "Ich kann dir erklären, wie das mit dem\n",
        "Verteilen von Blöcken funktioniert.\r",
        "Frage mich einfach, wonach du willst!\r"
      ]
    },
    {
      "id": "msg_0135_00047",
      "de_DE": [
        "“Blöcke” sind Objekte,\n",
        "die du während einer Safari frei in der\f",
        "Gegend verteilen kannst!\r",
        "Aber sei vorsichtig, denn über einer\n",
        "Treppe oder hohem Gras, wo du auf\f",
        "Pokémon treffen könntest, ist es nicht\f",
        "möglich, Blöcke abzulegen!\r",
        "Erschwerend kommt noch hinzu, dass\n",
        "du auf einem Terrain nicht mehr als\f",
        "maximal 30 Blöcke verteilen kannst.\r",
        "Das solltest du also auch immer\n",
        "im Hinterkopf behalten!\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00048",
      "de_DE": [
        "Blöcke zu legen, ist ganz einfach!\n",
        "Zuerst solltest du genau überprüfen,\r",
        "ob das Feld vor dir auch frei ist. \n",
        "Wenn dem so ist, kannst du dort einen\f",
        "beliebigen Block ablegen.\r",
        "Blöcke können ganz unterschiedliche\n",
        "Größen haben. Es kann also vorkommen,\f",
        "dass du an bestimmten Stellen etwas aus\f",
        "Platzmangel nicht ablegen kannst.\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00049",
      "de_DE": [
        "Willst du einen Block, den du bereits\n",
        "platziert hast, wieder entfernen,\f",
        "musst du ihn nur untersuchen.\f",
        "Blöcke, die du zuvor auf dem Terrain\f",
        "platziert hast, leuchten ein wenig.\f",
        "Dieses Licht wird dir vor allem bei\f",
        "Nacht zur Orientierung dienen.\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00050",
      "de_DE": [
        "Es gibt ganz unterschiedliche\n",
        "Sorten von Blöcken!\r",
        "Wiesenblöcke...\n",
        "Baumblöcke...\f",
        "Felsenblöcke...\f",
        "Wasserblöcke...\f",
        "Undnocheinpaarandereblöcke...\f",
        "Sieh dir einfach alle mal an!\r",
        "Die Anzahl der Blöcke, die du bei\n",
        "der Safari ausgelegt hast, kannst du\f",
        "auf dem oberen Bildschirm des\f",
        "Terrain-Editors ablesen!\r",
        "Von Zeit zu Zeit werden auch immer\n",
        "mal wieder neue Blöcke dazukommen!\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00051",
      "de_DE": [
        "Je nachdem, was für Blöcke du ausgelegt\n",
        "hast, wirst du auf dem Terrain einer\f",
        "neuen Mischung von Pokémon begegnen.\r",
        "Wenn du irgendwo also einen Block\n",
        "platzierst, verändert sich damit auch\f",
        "umgehend dein Safari-Erlebnis!\r",
        "Lege also möglichst viele Blöcke aus und\n",
        "sei ein bisschen experimentierfreudig!\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00052",
      "de_DE": [
        "Aber Vorsicht!\r",
        "Wenn du an einer bestimmten Stelle das\n",
        "Terrain veränderst, verschwinden dabei\f",
        "alle Blöcke, die du dort abgelegt hast!\f",
        "Pass also gut auf, was du tust!\r",
        "Was soll ich sonst noch erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00053",
      "de_DE": [
        "Dann wünsche ich dir noch jede\n",
        "Menge Spaß in der Safari-Zone!"
      ]
    },
    {
      "id": "msg_0135_00054",
      "de_DE": [
        "Willkommen in der Safari-Zone\n",
        "von {STRVAR_1 3, 0, 0}!\r",
        "Zahle 500 $ und behalte alles,\n",
        "was du fängst! Bist du dabei? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0135_00055",
      "de_DE": "Gut, dann bekomme ich {STRVAR_1 52, 1, 0} $ von dir!\r"
    },
    {
      "id": "msg_0135_00056",
      "de_DE": [
        "Wirklich nicht?\n",
        "Aber dann das nächste Mal, ja?"
      ]
    },
    {
      "id": "msg_0135_00057",
      "de_DE": "Hier sind deine Safaribälle.\r"
    },
    {
      "id": "msg_0135_00058",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} erhält\n",
        "{STRVAR_1 51, 1, 0} Safaribälle!"
      ]
    },
    {
      "id": "msg_0135_00059",
      "de_DE": [
        "Wir melden uns bei dir, sobald\n",
        "dir die Safaribälle ausgehen.\f",
