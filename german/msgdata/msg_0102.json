  "key": 18963,
  "messages": [
    {
      "id": "msg_0102_00000",
      "de_DE": [
        "Kämpfernaturen wie ich tragen ihr\n",
        "Karate-Outfit wie eine Uniform!\r",
        "Für jemanden, der auf dem Weg zur\n",
        "Kampfzone ist, könnte ich mir\f",
        "keine bessere Kluft vorstellen!"
      ]
    },
    {
      "id": "msg_0102_00001",
      "de_DE": [
        "Alle Welt ist überrascht,\n",
        "dass sich ein kleines\f",
        "Mädchen wie ich ganz alleine\f",
        "in der Kampfzone aufhält.\r",
        "Aber ich nehme ja auch gar\n",
        "nicht an den Kämpfen teil..."
      ]
    },
    {
      "id": "msg_0102_00002",
      "de_DE": [
        "Ich habe mich schon als kleines Mädel\n",
        "für Pokémon-Kämpfe interessiert.\f",
        "Aber ja doch! Jetzt auch!\r",
        "Ein Kämpflein nach dem Frühstück,\n",
        "ein Kämpflein nach dem Mittagessen,\f",
        "und nach dem Abendessen...\f",
        "gehe ich dann langsam mal ins Bett."
      ]
    }
  ]
}
