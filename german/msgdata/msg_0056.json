{
  "key": 58411,
  "messages": [
    {
      "id": "msg_0056_00000",
      "de_DE": [
        "Weisester: Deine Macht sucht\n",
        "wahrlich ihresgleichen...\r",
        "Wie vereinbart will ich dir nun\n",
        "diese TM überreichen.\r",
        "Aber... du solltest deine Pokémon\n",
        "ein klein wenig besser behandeln!\r",
        "Die Art, wie du kämpfst,\n",
        "ist viel zu verbissen.\r",
        "Pokémon sind schließlich\n",
        "nicht nur zum Kämpfen da.\r"
      ]
    },
    {
      "id": "msg_0056_00001",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: ...\r",
        "...Pah!\n",
        "Erst erzählt er mir groß,\f",
        "er sei der Weiseste von allen,\f",
        "und dann macht er sofort schlapp!\r",
        "Aber das war mir von vorneherein klar.\n",
        "Ich verliere doch nicht gegen jemanden,\f",
        "der so kindisches Zeug erzählt! Man\f",
        "soll seine Pokémon gut behandeln? Pah!\r",
        "Für mich zählen nur Pokémon, die starke\n",
        "Siegertypen sind.\r",
        "Alle anderen Pokémon interessieren\n",
        "mich einen feuchten Kehricht.\r"
      ]
    },
    {
      "id": "msg_0056_00002",
      "de_DE": [
        "{STRVAR_1 3, 0, 0} verwendet\n",
        "Fluchtseil!"
      ]
    },
    {
      "id": "msg_0056_00003",
      "de_DE": [
        "Du hast dich wacker geschlagen!\r",
        "Hier im KNOFENSA-Turm erarbeiten sich\n",
        "Pokémon und Menschen eine strahlende\f",
        "gemeinsame Zukunft oder suchen im\f",
        "Training Bestätigung.\r",
        "Ich werde deine letzte Prüfung sein.\r",
        "Erlaube mir, die Freundschaft zwischen\n",
        "dir und deinem Team zu erproben!\r"
      ]
    },
    {
      "id": "msg_0056_00004",
      "de_DE": [
        "Hm...\n",
        "dein Kampfstil lässt wahrlich\f",
        "nichts zu wünschen übrig.\r",
        "Damit brauchst du dich nicht einmal\n",
        "vor Meister Falk zu verstecken.\r",
        "Und... jemand wie du weiß sicher\n",
        "auch hiermit richtig umzugehen.\r",
        "Das ist eine TM namens Blitz!\n",
        "Sie gehört dir.\r"
      ]
    },
    {
      "id": "msg_0056_00005",
      "de_DE": [
        "Wenn du einem deiner Pokémon Blitz\n",
        "beibringst, kannst du damit jeden noch\f",
        "so dunklen Ort erhellen.\r",
        "Du könntest die TM zum Beispiel\n",
        "einem KNOFENSA beibringen!"
      ]
    },
    {
      "id": "msg_0056_00006",
      "de_DE": [
        "Möge deine Reise einmal\n",
        "Früchte tragen!"
      ]
    },
    {
      "id": "msg_0056_00007",
      "de_DE": [
        "Hier hat jemand mit kräftigem Strich\n",
        "ein KNOFENSA gezeichnet..."
      ]
    },
    {
      "id": "msg_0056_00008",
      "de_DE": [
        "Die Statue eines Pokémon...\n",
        "sie erfüllt dich irgendwie mit Ehrfurcht."
      ]
    }
  ]
}
