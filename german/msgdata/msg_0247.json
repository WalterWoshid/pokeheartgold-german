    },
    {
      "id": "msg_0247_00022",
      "de_DE": [
        "Unser Lieferant hat eine ganze Menge\n",
        "Geschenke für dich!\r",
        "Bitte suche ihn in einem PKMN-Markt\n",
        "auf und hole deine Geschenke ab."
      ]
    },
    {
      "id": "msg_0247_00023",
      "de_DE": [
        "Du hast dieses Geschenk bereits\n",
        "erhalten."
      ]
    },
    {
      "id": "msg_0247_00024",
      "de_DE": "Es wurden keine Geschenke gefunden."
    },
    {
      "id": "msg_0247_00025",
      "de_DE": "Deine Anfrage wurde abgelehnt."
    },
    {
      "id": "msg_0247_00026",
      "de_DE": [
        "Du hast keinen Platz mehr für\n",
        "weitere Wunderkarten.\r",
        "Du kannst kein weiteres Geschenk\n",
        "annehmen."
      ]
    },
    {
      "id": "msg_0247_00027",
      "de_DE": [
        "Beim Empfang des Geschenks trat ein\n",
        "Problem auf.\r",
        "Drücke den A-Knopf, um zum\n",
        "Titelbildschirm zurückzukehren."
      ]
    },
    {
      "id": "msg_0247_00028",
      "de_DE": [
        "Geschenk wurde gefunden, kann aber mit\n",
        "dieser Version nicht empfangen werden.\r",
        "Drücke den A-Knopf, um zum Menü\n",
        "zurückzukehren."
      ]
    },
    {
      "id": "msg_0247_00029",
