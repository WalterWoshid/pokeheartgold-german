  "messages": [
    {
      "id": "msg_0247_00000",
      "de_DE": "Willkommen beim Geheimgeschehen!"
    },
    {
      "id": "msg_0247_00001",
      "de_DE": [
        "Wähle bitte aus, auf welche Weise du\n",
        "dein Geschenk erhalten möchtest."
      ]
    },
    {
      "id": "msg_0247_00002",
      "de_DE": [
        "Drahtlose DS-Datenübertragung wird\n",
        "gestartet."
      ]
    },
    {
      "id": "msg_0247_00003",
      "de_DE": [
        "Suche nach Geschenk.\n",
        "Einen Moment bitte..."
      ]
    },
    {
      "id": "msg_0247_00004",
      "de_DE": "Geschenk empfangen?"
    },
    {
      "id": "msg_0247_00005",
      "de_DE": "Nach einem anderen Geschenk suchen?"
    },
    {
      "id": "msg_0247_00006",
      "de_DE": [
        "Deine Anfrage wurde gesendet.\n",
        "Einen Moment bitte..."
      ]
    },
    {
      "id": "msg_0247_00007",
      "de_DE": [
        "Geschenk wird empfangen.\n",
        "Bitte schalte das DS-System nicht aus."
      ]
    },
    {
      "id": "msg_0247_00008",
      "de_DE": [
        "Das Geschenk wurde empfangen!\r",
        "Bitte hole das Geschenk in einem\n",
        "Pokémon-Supermarkt ab."
      ]
    },
    {
      "id": "msg_0247_00009",
      "de_DE": [
        "Dieses Geschenk wird von einer anderen\n",
        "Person mit dir geteilt.\r",
        "Du kannst das Geschenk annehmen, aber\n",
        "du kannst es nicht an deine Freunde\f",
        "weitergeben.\r",
        "Möchtest du das Geschenk annehmen?"
      ]
    },
    {
      "id": "msg_0247_00010",
      "garbage": 19
    },
    {
