{
  "key": 22311,
  "messages": [
    {
      "id": "msg_0644_00000",
      "de_DE": "Bianka"
    },
    {
      "id": "msg_0644_00001",
      "de_DE": [
        "Häh? Ich verstehe dich ganz schlecht!\n",
        "Das muss an der Verbindung liegen!\r",
        "Versuche es noch einmal von woanders!"
      ]
    },
    {
      "id": "msg_0644_00002",
      "de_DE": [
        "Hallo?\n",
        "Ja?\f",
        "Mir geht’s super!\r"
      ]
    },
    {
      "id": "msg_0644_00003",
      "de_DE": [
        "Es gibt außer mir noch viele unglaublich\n",
        "starke Arenaleiter!\f",
        "Also gib dein Bestes!"
      ]
    },
    {
      "id": "msg_0644_00004",
      "de_DE": [
        "Also mir passt es samstagmittags\n",
        "am besten!\f",
        "Ruf mich dann einfach an!"
      ]
    },
    {
      "id": "msg_0644_00005",
      "de_DE": [
        "Hm, was soll ich mit meiner ganzen\n",
        "Freizeit bloß anstellen? Ich hab’s!\r",
        "Hättest du Lust auf ein Rematch? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0644_00006",
      "de_DE": [
        "Super, ich freue mich schon!\n",
        "Ich warte auf dich im Dojo von Saffronia\f",
        "City!"
      ]
    },
    {
      "id": "msg_0644_00007",
      "de_DE": [
        "Häh?\n",
        "Spielverderber!"
      ]
    },
    {
      "id": "msg_0644_00008",
      "de_DE": [
        "Du hast Zeit für ein kleines Match?\r",
        "Oh! Du hast ja schon mehrere\n",
        "Einladungen zum Rematch! Melde dich\f",
        "wieder, wenn du tatsächlich Zeit hast!"
      ]
    },
    {
      "id": "msg_0644_00009",
      "de_DE": [
        "Ich warte auf dich im Dojo von Saffronia\n",
        "City! Wehe, du kommst nicht!\f",
        "Du hast es versprochen!"
      ]
    },
    {
      "id": "msg_0644_00010",
      "de_DE": [
        "Hi, Bianka hier!\n",
        "Bei dir alles im Lot?\r"
      ]
    },
    {
      "id": "msg_0644_00011",
      "de_DE": [
        "Ich erwarte dich im Dojo von Saffronia\n",
        "City zum Rematch. Und vergiss nicht:\f",
        "Versprochen ist versprochen!\f",
        "Du hast mir dein Ehrenwort gegeben!"
      ]
    },
    {
      "id": "msg_0644_00012",
      "de_DE": [
        "Warst du schon einmal auf der\n",
        "Kuhmuh-Farm an der Route 39?\r",
        "Meine liebe Milla, also mein MILTANK,\n",
        "ist dort aufgewachsen!"
      ]
    },
    {
      "id": "msg_0644_00013",
      "de_DE": [
        "Ich habe ziemlichen Hunger!\n",
        "Du nicht?\r",
        "Nein! Ich esse überhaupt nicht zu viel!\n",
        "Warte nur ab! Wenn du erst in meinem\f",
        "Alter bist..."
      ]
    },
    {
      "id": "msg_0644_00014",
      "de_DE": [
        "Welcher von den Top Vier sieht am\n",
        "besten aus? Bruno, oder?\r",
        "Ich stehe da mit meiner Meinung nicht\n",
        "allein! Alle denken so!\f",
        "Bei einem Mann kommt es eben in erster\f",
        "Linie auf die Stärke an!"
      ]
    }
  ]
}
