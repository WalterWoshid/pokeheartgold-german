  "messages": [
    {
      "id": "msg_0602_00000",
      "de_DE": [
        "Du kannst hier sehen, wie sehr Leute\n",
        "auf der gesamten Welt Pokémon lieben.\r",
        "Beim Ansehen der Kampfvideos hast du so\n",
        "viel Spaß wie die Leute beim Aufnehmen!"
      ]
    },
    {
      "id": "msg_0602_00001",
      "de_DE": [
        "Eine wundervolle Idee!\n",
        "Alle können dabei mitmachen!\r",
        "Und wenn du verlierst, bist du vielleicht\n",
        "trotzdem in dem Kampfvideo von jemand\f",
        "anderem zu sehen!\n"
      ]
    },
    {
      "id": "msg_0602_00002",
      "de_DE": [
        "Bei diesem Kampfvideo kann man nicht\n",
        "anders, als einfach mitzufiebern!\r",
        "Da bekomme ich direkt Lust, nach Hause\n",
        "zu gehen und meine Pokémon noch etwas\f",
        "zu trainieren!"
      ]
    },
    {
      "id": "msg_0602_00003",
      "de_DE": [
        "Meine liebsten Kampfvideos enthalten\n",
        "nur süße kleine MARILL... ganz viele."
      ]
    },
    {
      "id": "msg_0602_00004",
      "de_DE": [
        "Eine sagenhafte Kollektion! Jetzt\n",
        "verstehe ich, wieso sie so beliebt ist!\r",
        "Schon beim Ansehen dieser Kampfvideos\n",
        "fühle ich mich ganz aufgepumpt!"
      ]
    },
    {
      "id": "msg_0602_00005",
      "de_DE": [
        "Jeder sollte sich jeden Tag ein paar\n",
        "Kampfvideos anschauen...\r",
        "Das ist ein ehrenvolles Hobby\n",
        "für wahre Genießer."
      ]
    },
    {
      "id": "msg_0602_00006",
      "de_DE": [
        "Mein geheimnisvolles Kampfvideo!\n",
        "Mein geheimnisvolles Kampfvideo!\r",
        "Was wohl auf dir drauf ist?\n",
        "Was wohl auf dir drauf ist?\r",
        "Verrat’s mir!\n",
        "Nun verrat’s mir schon endlich!"
      ]
    },
    {
      "id": "msg_0602_00007",
      "de_DE": [
        "Ich werde Dukatia City ein Lied widmen,\n",
        "jeder Buchstabe bekommt eine Zeile!\r",
        "D... du liegst direkt nördlich\n",
        "vom Steineichenwald\r",
        "U... und in der Passage\n",
        "da raucht der Asphalt\r",
        "K... kein Wunder,\n",
        "denn kaum liegt man\f",
        "müde im Bett,\f",
        "klaut Team Rocket munter\f",
        "dein Taschengeld weg!\r",
        "Ah, ich bin nicht so gut, wie ich dachte.\n",
        "Versuch du dich doch einmal daran!"
      ]
    },
    {
      "id": "msg_0602_00008",
      "de_DE": [
        "Der Wanderer, der sich im ersten Stock\n",
        "die Box-Daten ansieht, ist mein Bruder!"
      ]
    },
    {
