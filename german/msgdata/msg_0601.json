{
  "key": 27730,
  "messages": [
    {
      "id": "msg_0601_00000",
      "de_DE": [
        "W-w-w-was soll das denn? Das sind ja\n",
        "ausschließlich Fotos von Pokémon!\r",
        "Wieso gibt es hier kein einziges Foto\n",
        "mit hübschen Mädchen!?!"
      ]
    },
    {
      "id": "msg_0601_00001",
      "de_DE": [
        "Ich habe nichts gegen Bergsteigen und\n",
        "genieße selbst gerne die schöne\f",
        "Aussicht am Gipfel, aber...\r",
        "Hier heimlich einen Blick in die Boxen\n",
        "fremder Leute zu werfen, bereitet mir\f",
        "eindeutig viel mehr Freude!"
      ]
    },
    {
      "id": "msg_0601_00002",
      "de_DE": [
        "Kennst du meine Box?\n",
        "Kann nicht sein!\r",
        "Dann wärst du nämlich\n",
        "schon vor Neid geplatzt!\r",
        "Darin befinden sich Pokémon, die jeder\n",
        "gern haben möchte... zum Beispiel...\r",
        "...Ach, ich kann hier nicht einfach jeden\n",
        "neidisch machen. Bin ja kein Angeber.\r",
        "Wenn du’s wirklich wissen willst, dann\n",
        "finde es doch heraus."
      ]
    },
    {
      "id": "msg_0601_00003",
      "de_DE": [
        "Ich komme jeden Tag vorbei, um mir die\n",
        "Model-Daten der anderen anzusehen.\r",
        "Das ist für mich der erste Schritt, um\n",
        "immer topmodern zu sein!"
      ]
    },
    {
      "id": "msg_0601_00004",
      "de_DE": [
        "Hachje! Wie kann das sein?\n",
        "Das ist ja skandalös!"
      ]
    },
    {
      "id": "msg_0601_00005",
      "de_DE": [
        "Wenn man sich ansieht, wie andere\n",
        "Leute ihre Pokémon mit Accessoires\f",
        "schmücken, kann man dabei immer\f",
        "etwas Neues entdecken."
      ]
    },
    {
      "id": "msg_0601_00006",
      "de_DE": [
        "Ein und dasselbe Accessoire kann\n",
        "ganz unterschiedlich wirken.\r",
        "Es hängt allein davon ab, wo und wie\n",
        "du es zum Einsatz bringst!"
      ]
    },
    {
      "id": "msg_0601_00007",
      "de_DE": [
        "Ich habe bei der Accessoire-Lotterie\n",
        "in der Passage der Stadt eine Kulisse\f",
        "gewonnen!"
      ]
    },
    {
      "id": "msg_0601_00008",
      "de_DE": [
        "Was ich gern mag?\r",
        "Ich mag es, Leuten zuzuschauen,\n",
        "die die Model-Daten inspizieren."
      ]
    },
    {
      "id": "msg_0601_00009",
      "de_DE": [
        "Teleporter zur GTS und den\n",
        "Trainer-Ranglisten im Erdgeschoss."
      ]
    },
    {
      "id": "msg_0601_00010",
      "de_DE": [
        "Teleporter zur Kampfvideo-Station\n",
        "im zweiten Stock."
      ]
    },
    {
      "id": "msg_0601_00011",
      "de_DE": [
        "Mit Nintendo Wi-Fi Connection\n",
        "verbinden und Model-Daten\f",
        "ansehen oder senden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0601_00012",
      "de_DE": [
        "Hier kannst du die Model-Daten\n",
        "deines Pokémon ausstellen.\r",
        "In der Passage von Dukatia City\n",
        "kannst du sie anpassen und speichern.\r",
        "Die Model-Daten von anderen Trainern\n",
        "kannst du hier auch ansehen.\r",
        "Du kannst die Daten nach Pokémon\n",
        "ordnen, das macht es übersichtlicher!\r"
      ]
    },
    {
      "id": "msg_0601_00013",
      "de_DE": [
        "Mit Nintendo Wi-Fi Connection\n",
        "verbinden und Box-Daten\f",
        "ansehen oder senden? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0601_00014",
      "de_DE": [
        "Hier kannst du Box-Daten ausstellen,\n",
        "die deine Pokémon zeigen.\r",
        "Wähle einen Hintergrund und\n",
        "postiere davor deine Pokémon.\r",
        "Diese Szene kannst du nun anderen\n",
        "Trainern zeigen.\r",
        "Umgekehrt kannst du auch die Box-Daten\n",
        "von anderen Trainern ansehen.\r"
      ]
    },
    {
      "id": "msg_0601_00015",
      "de_DE": "VERWENDEN"
    },
    {
      "id": "msg_0601_00016",
      "de_DE": "INFO"
    },
    {
      "id": "msg_0601_00017",
      "de_DE": "ZURÜCK"
    }
  ]
}
