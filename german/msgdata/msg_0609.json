{
  "key": 21606,
  "messages": [
    {
      "id": "msg_0609_00000",
      "de_DE": [
        "Auf dem Weg nach Anemonia City\n",
        "gibt es vier unbewohnte Inseln.\r",
        "Ungezogene Kinder werden zur\n",
        "Bestrafung dorthin geschickt!"
      ]
    },
    {
      "id": "msg_0609_00001",
      "de_DE": [
        "Wenn ich ungezogen bin, macht\n",
        "mir mein Papa immer sofort mit\f",
        "gruseligen Geschichten Angst..."
      ]
    },
    {
      "id": "msg_0609_00002",
      "de_DE": [
        "Ich habe gaaanz viele Sticker von\n",
        "meiner Schwester bekommen!\f",
        "Hier, ich gebe dir ein paar davon ab!\r"
      ]
    },
    {
      "id": "msg_0609_00003",
      "de_DE": [
        "Wow, das ist ja der Wahnsinn!\n",
        "Du hast echt viele Sticker!\r",
        "Damit kannst du eine ganze Menge\n",
        "Bälle bekleben!"
      ]
    },
    {
      "id": "msg_0609_00004",
      "de_DE": [
        "Wenn du morgen wiederkommst,\n",
        "gebe ich dir noch etwas viel Besseres!"
      ]
    },
    {
      "id": "msg_0609_00005",
      "de_DE": [
        "Huch? Hast du etwa keinen\n",
        "Stickerkoffer?\f",
        "Schade, ich hätte dir gerne\f",
        "ein paar Sticker abgetreten."
      ]
    },
    {
      "id": "msg_0609_00006",
      "de_DE": "In Ordnung, dann nimm!\r"
    },
    {
      "id": "msg_0609_00007",
      "de_DE": "Ich habe noch mehr für dich!\r"
    },
    {
      "id": "msg_0609_00008",
      "de_DE": "Und das war noch nicht alles!\r"
    },
    {
      "id": "msg_0609_00009",
      "de_DE": "Klebe deine Sticker auf einen Ball!"
    },
    {
      "id": "msg_0609_00010",
      "de_DE": "Oh, du hast schon zu viele Sticker!"
    },
    {
      "id": "msg_0609_00011",
      "de_DE": [
        "{STRVAR_1 10, 0, 0} wurde\n",
        "im Stickerkoffer verstaut.\r"
      ]
    }
  ]
}
