{
  "key": 20283,
  "messages": [
    {
      "id": "msg_0581_00000",
      "de_DE": [
        "Dieser hochmoderne Radiosender wurde\n",
        "aus einem alten einsturzgefährdeten\f",
        "Turm gebaut, der hier einmal stand."
      ]
    },
    {
      "id": "msg_0581_00001",
      "de_DE": [
        "Warst du schon mal beim Pokéathlon?\n",
        "Das ist eine kolossale Sportanlage, wo\f",
        "Pokémon bis ans Äußerste gehen können!\r",
        "Das Gebäude ist eine wahre Pracht."
      ]
    },
    {
      "id": "msg_0581_00002",
      "de_DE": [
        "Hier soll es irgendwo einen neuen\n",
        "Fahrradladen geben. Aber wo bloß?\r",
        "Ich finde ihn einfach nicht..."
      ]
    },
    {
      "id": "msg_0581_00003",
      "de_DE": [
        "Moment mal, das ist doch ein Fahrrad,\n",
        "auf dem du da fährst!\r",
        "Das hast du doch bestimmt in diesem\n",
        "Fahrradladen gekauft, nicht wahr?\r",
        "Ausgezeichnet!\n",
        "Dann weiß ich jetzt auf jeden Fall schon\f",
        "mal, dass es diesen Laden wirklich gibt!"
      ]
    },
    {
      "id": "msg_0581_00004",
      "de_DE": [
        "Hat sich dieser Mann in Schwarz etwa\n",
        "als Mitglied von Team Rocket verkleidet?\f",
        "Was ist das denn für ein Widerling?"
      ]
    },
    {
      "id": "msg_0581_00005",
      "de_DE": [
        "Dann gehörte dieser Mann in Schwarz\n",
        "also wirklich zu Team Rocket?\f",
        "Ich kann es immer noch nicht glauben!"
      ]
    },
    {
      "id": "msg_0581_00006",
      "de_DE": [
        "Der Radioturm ist das Wahrzeichen\n",
        "von Dukatia City.\r",
        "Es soll möglich sein, sich dort seinen\n",
        "Pokécom zum Radio aufrüsten zu lassen!"
      ]
    },
    {
      "id": "msg_0581_00007",
      "de_DE": [
        "Der Radioturm ist das Wahrzeichen\n",
        "von Dukatia City.\r",
        "Es soll möglich sein, sich dort seinen\n",
        "Pokécom zum Radio aufrüsten zu lassen!\r",
        "Oh, offenbar kannst du mit deinem\n",
        "Pokécom bereits Radio hören!"
      ]
    },
    {
      "id": "msg_0581_00008",
      "de_DE": [
        "Hehehe... ich habe Ärger gekriegt,\n",
        "weil ich im Untergrund-Lagerhaus\f",
        "Verstecken gespielt habe."
      ]
    },
    {
      "id": "msg_0581_00009",
      "de_DE": [
        "Der Mann in diesem Haus bewertet\n",
        "die Spitznamen deiner Pokémon.\r",
        "Du kannst ihnen dort auch bessere\n",
        "Namen geben lassen!"
      ]
    },
    {
      "id": "msg_0581_00010",
      "de_DE": [
        "Wenn meine Pokémon beim Pokéathlon\n",
        "gut abschneiden, könnte ich mich dazu\f",
        "erweichen lassen, ihnen als Belohnung\f",
        "etwas coolere Spitznamen zu geben."
      ]
    },
    {
      "id": "msg_0581_00011",
      "de_DE": [
        "Diese Stadt ist wirklich enorm groß!\n",
        "Es gibt hier so viele Häuser, dass ich\f",
        "schon gar nicht mehr sagen kann,\f",
        "was wo liegt."
      ]
    },
    {
      "id": "msg_0581_00012",
      "de_DE": [
        "Wenn du Route 35 nach Norden folgst\n",
        "und dich am Tor links hältst, erreichst\f",
        "du die Pokéathlonhallen. So viel konnte\f",
        "ich zumindest schon mal herausfinden.\r",
        "Aber in dieser Stadt finde ich mich immer\n",
        "noch nicht richtig zurecht..."
      ]
    },
    {
      "id": "msg_0581_00013",
      "de_DE": "Das ist also der Radioturm...\r"
    },
    {
      "id": "msg_0581_00014",
      "de_DE": "Was willst du, Nervensäge? Hau ab!\r"
    },
    {
      "id": "msg_0581_00015",
      "de_DE": [
        "Was soll das hier werden? Kehre\n",
        "gefälligst auf deinen Posten zurück!\r"
      ]
    },
    {
      "id": "msg_0581_00016",
      "de_DE": [
        "Pokémon? Die sind nicht viel mehr\n",
        "als Werkzeuge zum Geldscheffeln!"
      ]
    },
    {
      "id": "msg_0581_00017",
      "de_DE": [
        "Keine Sorge! Wir stehen hier Wache und\n",
        "passen auf, dass uns niemand stört!"
      ]
    },
    {
      "id": "msg_0581_00018",
      "de_DE": [
        "Wir haben den Radioturm besetzt, um...\r",
        "Moment mal! Das geht ein Kind wie dich\n",
        "doch gar nichts an!"
      ]
    },
    {
      "id": "msg_0581_00019",
      "de_DE": [
        "Du bist noch ziemlich jung...\n",
        "Bist du neu dabei, oder was?"
      ]
    },
    {
      "id": "msg_0581_00020",
      "de_DE": [
        "Ich glaube, ich sehe nicht recht!\n",
        "Was hat denn ein Kind hier verloren?\f",
        "Los, verzieh dich gefälligst!"
      ]
    },
    {
      "id": "msg_0581_00021",
      "de_DE": [
        "Was hast du hier verloren? Für diesen\n",
        "Bereich bin ich zuständig!\r",
        "Warum hilfst du nicht den anderen im\n",
        "Radioturm?"
      ]
    },
    {
      "id": "msg_0581_00022",
      "de_DE": [
        "Du und deine Pokémon seid Freunde?\r",
        "Dass ich nicht lache!"
      ]
    },
    {
      "id": "msg_0581_00023",
      "de_DE": [
        "Bald geht unser Traum in Erfüllung...\n",
        "Es war ein steiniger Weg bis hierher..."
      ]
    },
    {
      "id": "msg_0581_00024",
      "de_DE": [
        "Oh, bist du etwa neu?\r",
        "Ich habe meinen Kumpel darum gebeten,\n",
        "mir eine neue Uniform zu holen, weil wir\f",
        "hier keine mehr vorrätig hatten.\r",
        "Aber er lässt sich ganz schön Zeit...\r",
        "Dabei ist es bis zum Fotoladen in\n",
        "der Dukatia-Passage gar nicht weit!"
      ]
    },
    {
      "id": "msg_0581_00025",
      "de_DE": [
        "Du wurdest bei Team Rocket zugelassen,\n",
        "obwohl du noch so jung bist?\f",
        "Erstaunlich!"
      ]
    },
    {
      "id": "msg_0581_00026",
      "de_DE": [
        "Lass mich gefälligst durch!\r",
        "Wir, die Trainer aus der Arena, werden\n",
        "nicht zulassen, dass Team Rocket in\f",
        "dieser Stadt Unruhe stiftet!"
      ]
    },
    {
      "id": "msg_0581_00027",
      "de_DE": [
        "Hehehe!\r",
        "Wir haben keine Lust darauf, uns mit\n",
        "euch Nichtsnutzen aus der Arena\f",
        "herumschlagen zu müssen, also lassen\f",
        "wir es gar nicht erst so weit kommen.\r",
        "Ihr bleibt schön brav in eurer Arena!"
      ]
    },
    {
      "id": "msg_0581_00028",
      "de_DE": [
        "Die Arenaleiterin hier heißt Bianka.\n",
        "Aber sie ist vorhin plötzlich von hier\f",
        "weggegangen und meinte, sie wolle\f",
        "sich ein Radio-Modul holen oder so."
      ]
    },
    {
      "id": "msg_0581_00029",
      "de_DE": [
        "W-w-was bildest du dir eigentlich ein?\n",
        "Siehst du etwa nicht diese coole\f",
        "schwarze Uniform, die ich trage?\r",
        "Willst du mir etwa erzählen, du hättest\n",
        "keine Angst vor Team Rocket?"
      ]
    },
    {
      "id": "msg_0581_00030",
      "de_DE": [
        "Deine Uniform reicht irgendwie noch\n",
        "nicht aus, um dir den unberechenbaren\f",
        "Team Rocket-Look zu verleihen...\r",
        "Versuche wenigstens, eine etwas\n",
        "düsterere Miene aufzusetzen und ein\f",
        "bisschen die Zähne zu fletschen!"
      ]
    },
    {
      "id": "msg_0581_00031",
      "de_DE": [
        "Augenblick mal! Wir stecken mitten in\n",
        "einer Operation! Wo willst du hin?"
      ]
    },
    {
      "id": "msg_0581_00032",
      "de_DE": [
        "Sag mal, was ist bloß mit dir los?\n",
        "Da geht es nicht zum Radioturm!"
      ]
    },
    {
      "id": "msg_0581_00033",
      "de_DE": [
        "Die GTS ermöglicht es dir, mit\n",
        "Leuten aus der ganzen Welt\f",
        "Pokémon zu tauschen!\r",
        "...Aber dafür ist jetzt eindeutig\n",
        "nicht der richtige Zeitpunkt!"
      ]
    },
    {
      "id": "msg_0581_00034",
      "de_DE": [
        "Willst du so dringend Pokémon tauschen?\r",
        "Wenn wir hier am Radioturm fertig sind,\n",
        "kannst du immer noch so viel tauschen,\f",
        "wie du Lust hast!"
      ]
    },
    {
      "id": "msg_0581_00035",
      "de_DE": [
        "M-moment mal!\r",
        "Hier ganz alleine als Wache abgestellt\n",
        "zu sein, ist echt kein leichter Job!\r",
        "Also versuche bitte nicht, mich hier\n",
        "auch noch zu mobben!\r"
      ]
    },
    {
      "id": "msg_0581_00036",
      "de_DE": [
        "Dukatia City, Bahnhof für die Magnet-\n",
        "zugstrecke zwischen Johto und Kanto"
      ]
    },
    {
      "id": "msg_0581_00037",
      "de_DE": [
        "Dukatia City Radioturm\r",
        "Das Informationsnetzwerk für alle\n",
        "möglichen Nachrichten aus Johto"
      ]
    },
    {
      "id": "msg_0581_00038",
      "de_DE": [
        "Pokémon-Arena von Dukatia City\n",
        "Leiterin: Bianka\f",
        "Ein Mädchen so scharf wie Sprengstoff!"
      ]
    },
    {
      "id": "msg_0581_00039",
      "de_DE": [
        "Dukatia City\n",
        "Feststadt mit Charme"
      ]
    },
    {
      "id": "msg_0581_00040",
      "de_DE": [
        "Fahrradladen\r",
        "Die Welt ist ein Radweg!\n",
        "Der Fahrradladen von Dukatia City\f",
        "schickt auch dich auf die Reise!"
      ]
    },
    {
      "id": "msg_0581_00041",
      "de_DE": [
        "Spielhalle von Dukatia City\r",
        "Für sorgenfreien Spaß.\n",
        "Hier spielt die ganze Stadt!"
      ]
    },
    {
      "id": "msg_0581_00042",
      "de_DE": [
        "Namenbewerter\r",
        "Hier erhältst du eine ehrliche\n",
        "Einschätzung deiner Spitznamen."
      ]
    },
    {
      "id": "msg_0581_00043",
      "de_DE": [
        "VORSICHT!\r",
        "In der Passage bitte stets\n",
        "vom Fahrrad absteigen!"
      ]
    },
    {
      "id": "msg_0581_00044",
      "de_DE": [
        "ACHTUNG!\r",
        "In der Passage bitte stets\n",
        "vom Fahrrad absteigen!"
      ]
    },
    {
      "id": "msg_0581_00045",
      "de_DE": [
        "Globales Terminal\n",
        "Global bis zum Gehtnichtmehr!"
      ]
    },
    {
      "id": "msg_0581_00046",
      "de_DE": [
        "Blumenladen\n",
        "Ein kleiner Laden fürs große Glück"
      ]
    }
  ]
}
