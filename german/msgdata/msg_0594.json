  "messages": [
    {
      "id": "msg_0594_00000",
      "de_DE": [
        "I-ich bin so ungeduldig, dass\n",
        "i-ich in einem Pokémon-Kampf\f",
        "i-immer gleich X-Tempo einsetze.\f",
        "I-ich erhöhe damit die Initiative\f",
        "meines Pokémon!"
      ]
    },
    {
      "id": "msg_0594_00001",
      "de_DE": [
        "Bis hierher sind die Schergen von Team\n",
        "Rocket also schon vorgedrungen!?!"
      ]
    },
    {
      "id": "msg_0594_00002",
      "de_DE": [
        "Hey! Setzt du im Kampf öfter\n",
        "auch mal X-Spezial ein?\r",
        "Das ist einfach toll! Es verstärkt\n",
        "den Spezial-Angriff deines Pokémon!"
      ]
    },
    {
      "id": "msg_0594_00003",
      "de_DE": [
        "Ach was! Sag bloß, Leute von Team\n",
        "Rocket gehen auch Einkaufen und so!"
      ]
    },
    {
      "id": "msg_0594_00004",
      "de_DE": [
        "Für Siegeshungrige\n",
        "2S: Kampfkollektion"
      ]
    }
  ]
}
