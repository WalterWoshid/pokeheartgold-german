{
  "key": 62539,
  "messages": [
    {
      "id": "msg_0076_00000",
      "de_DE": [
        "Wenn du hier von oben heruntergefallen\n",
        "bist, bedeutet das ja...\r",
        "Nie im Leben! Du hast tatsächlich das\n",
        "Puzzle der Steintafeln gelöst?!?\r",
        "Das ist ja wunderbar!\r",
        "Du scheinst ein Händchen für\n",
        "die Archäologie zu haben!\f",
        "Hier, nimm dieses Icognitoheft!\r",
        "Es legt automatisch Einträge für\n",
        "ICOGNITO an, die du neu gefangen hast.\f",
        "Das wird dir von großem Nutzen sein!\r"
      ]
    },
    {
      "id": "msg_0076_00001",
      "de_DE": "Du kannst irgendeine Präsenz spüren..."
    },
    {
      "id": "msg_0076_00002",
      "de_DE": [
        "Dafür, dass er so leer ist, wurde dieser\n",
        "Raum aber ziemlich groß angelegt..."
      ]
    },
    {
      "id": "msg_0076_00003",
      "de_DE": [
        "Dieser Raum strahlt irgendwie etwas\n",
        "Mystisches... etwas...\f",
        "Geschichtsträchtiges... etwas...\f",
        "Unheilvolles... etwas...\f",
        "Altertümliches... etwas...\f",
        "Bedrückendes... etwas...\f",
        "Muffiges... etwas, na ja... einigen wir\r",
        "uns mal auf Ehrfurcht einflößendes aus!"
      ]
    },
    {
      "id": "msg_0076_00004",
      "de_DE": [
        "Diese Ruinen wurden weder\n",
        "geplündert noch geschändet,\f",
        "und mit Graffiti hat sie auch\f",
        "niemand verunstaltet.\r",
        "Sie sind uns beinahe in ihrem\n",
        "urtümlichen Zustand erhalten!\r",
        "Irgendetwas an den Ruinen hält die\n",
        "Leute davon ab, solche Dinge zu tun."
      ]
    },
    {
      "id": "msg_0076_00005",
      "de_DE": [
        "Dies ist eine Nachbildung eines\n",
        "antiken Pokémon."
      ]
    },
    {
      "id": "msg_0076_00006",
      "de_DE": [
        "Hmm...\r",
        "Ich habe während meiner Forschungen\n",
        "viele Jahre in diesen Ruinen zugebracht.\f",
        "Aber irgendetwas...\f",
        "ist hier anders als sonst...\r"
      ]
    },
    {
      "id": "msg_0076_00007",
      "de_DE": [
        "Du liebe Güte!\r",
        "Die ICOGNITO aus den\n",
        "Zeichnungen an der Wand...\r",
        "Es ist, als würden sie mich\n",
        "mit ihren Augen verfolgen!\r"
      ]
    },
    {
      "id": "msg_0076_00008",
      "de_DE": [
        "W-w-was geht hier vor sich?!?\n",
        "Durch diesen ganzen Spuk\f",
        "wollen meine Beine nicht mehr\f",
        "a-a...\f",
        "a-aufhören zu zittern!\r"
      ]
    },
    {
      "id": "msg_0076_00009",
      "de_DE": [
        "Uah! Geht es dir gut?!?\n",
        "Du warst plötzlich wie von der\f",
        "Erdoberfläche verschwunden!\f",
        "Das war echt ein Schock!\r"
      ]
    },
    {
      "id": "msg_0076_00010",
      "de_DE": [
        "Das ist also passiert, verstehe!\r",
        "Die vereinten Mächte von ARCEUS\n",
        "und den ICOGNITO müssen\f",
        "unglaubliche Energien freigesetzt\f",
        "haben, durch die du dann zu den\f",
        "Sinjoh-Ruinen katapultiert wurdest.\r",
        "ICOGNITO, die Alph-Ruinen und jetzt\n",
        "auch noch ARCEUS...\f",
        "Hier jagt ein Rätsel das andere!\r",
        "Aber jetzt brenne ich richtiggehend\n",
        "vor Wissbegierde!\r",
        "Irgendwann wird der Tag kommen, an\n",
        "dem ich all diese Geheimnisse lüfte!\r"
      ]
    }
  ]
}
