{
  "key": 58431,
  "messages": [
    {
      "id": "msg_0481_00000",
      "de_DE": [
        "Mr. Fuji: Sei willkommen!\r",
        "Hm, du scheinst dir sehr viel Mühe beim\n",
        "Trainieren des Pokémon-Teams zu geben.\r",
        "Dieser Ort ist ein Treffpunkt für Leute,\n",
        "deren Herz für Pokémon schlägt.\r",
        "Möchtest du dem Pokémon-Team hier\n",
        "auch deinen Respekt zollen?\f",
        "Sie werden es dir sicher danken."
      ]
    },
    {
      "id": "msg_0481_00001",
      "de_DE": [
        "Ich glaube, hier liegen noch andere\n",
        "Pokémon begraben.\r",
        "Es gibt viele Kammern, die nur\n",
        "Mr. Fuji betreten darf."
      ]
    },
    {
      "id": "msg_0481_00002",
      "de_DE": [
        "Ich besuche mit meiner Mutter die\n",
        "Grabmale der Pokémon..."
      ]
    },
    {
      "id": "msg_0481_00003",
      "de_DE": [
        "Ich habe so lange mit diesen Pokémon\n",
        "zusammengelebt, dass sie für mich\f",
        "denselben Stellenwert einnehmen\f",
        "wie meine Enkelkinder..."
      ]
    }
  ]
}
