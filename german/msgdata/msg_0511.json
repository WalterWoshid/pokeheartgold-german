{
  "key": 8067,
  "messages": [
    {
      "id": "msg_0511_00000",
      "de_DE": [
        "Mein Name ist Herr von Zock!\r",
        "Juckt es dich nicht auch in den\n",
        "Fingern, wenn du jemandem\f",
        "beim Münzspiel zusiehst?\r",
        "Ich glaube, darin steckt der\n",
        "eigentliche Sinn des Lebens!\r",
        "Aber du scheinst einem Spielchen auch\n",
        "nicht abgeneigt zu sein, nicht wahr?\r",
        "Beim Münzspiel musst du einfach nur\n",
        "Münzen sammeln, wofür du im\f",
        "Gegenzug wunderbare Preise erhältst.\r",
        "Möchtest du dich am Münzspiel\n",
        "versuchen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0511_00001",
      "garbage": 2
    },
    {
      "id": "msg_0511_00002",
      "garbage": 3
    },
    {
      "id": "msg_0511_00003",
      "de_DE": [
        "Prima! Dann gebe ich dir\n",
        "jetzt diesen Münzkorb!\r"
      ]
    },
    {
      "id": "msg_0511_00004",
      "de_DE": "Dann zeige mir mal, was du so kannst!\r"
    },
    {
      "id": "msg_0511_00005",
      "de_DE": [
        "Beim Münzspiel können wir beide uns\n",
        "ausgiebig vergnügen!"
      ]
    },
    {
      "id": "msg_0511_00006",
      "de_DE": [
        "Mein Name ist\n",
        "Herr von Zock!\r",
        "Juckt es dich nicht auch in den\n",
        "Fingern, wenn du jemandem beim\f",
        "Münzspiel zusiehst?\r",
        "Ich glaube, darin steckt der\n",
        "eigentliche Sinn des Lebens!\r",
        "He du! Worauf wartest du noch?\n",
        "Wage ein Spielchen und zeige mir,\f",
        "was du so kannst!"
      ]
    },
    {
      "id": "msg_0511_00007",
      "de_DE": [
        "Worauf wartest du noch?\n",
        "Zeige mir, was du im Münzspiel\f",
        "so draufhast!"
      ]
    },
    {
      "id": "msg_0511_00008",
      "de_DE": [
        "Dich juckt’s bestimmt in den Fingern,\n",
        "wenn du anderen beim Münzspiel\f",
        "zusiehst, nicht wahr? Ach übrigens!\r",
        "Gehe in das Gebäude nebenan, wenn du\n",
        "genug Münzen hast, und lass dir tolle\f",
        "Preise geben!"
      ]
    },
    {
      "id": "msg_0511_00009",
      "de_DE": [
        "Jetzt hat dich das Münzspielfieber\n",
        "also doch gepackt, nicht wahr?"
      ]
    },
    {
      "id": "msg_0511_00010",
      "de_DE": [
        "Ohne Münzkorb wirst du wohl\n",
        "nicht spielen können...\r"
      ]
    },
    {
      "id": "msg_0511_00011",
      "de_DE": [
        "Herr von Zock: He du! Du willst dich\n",
        "doch sicherlich am Münzspiel versuchen!\r",
        "Komm bitte hierher! Ich gebe dir einen\n",
        "Münzkorb!"
      ]
    },
    {
      "id": "msg_0511_00012",
      "de_DE": [
        "Herr von Zock: Dann zeige mir mal,\n",
        "was du im Münzspiel so draufhast!\r"
      ]
    },
    {
      "id": "msg_0511_00013",
      "de_DE": [
        "Herr von Zock: He du!\n",
        "Schlag keine Wurzeln an der Tischkante,\f",
        "sondern setz dich mir gegenüber\f",
        "und lass uns anfangen zu spielen!"
      ]
    },
    {
      "id": "msg_0511_00014",
      "de_DE": [
        "Wenn das mal nicht unsere zukünftige\n",
        "Legende ist! Möchtest du dich am\f",
        "Münzspiel versuchen?\r",
        "Ich habe es auch auf ein Pokémon als\n",
        "Preis abgesehen, aber ich bekomme\f",
        "einfach nicht genug Münzen zusammen!"
      ]
    }
  ]
}
