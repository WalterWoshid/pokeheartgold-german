  "messages": [
    {
      "id": "msg_0046_00000",
      "de_DE": [
        "Willkommen im Kolosseum.\r",
        "Hier kannst du gegen deine Freunde\n",
        "antreten.\r"
      ]
    },
    {
      "id": "msg_0046_00001",
      "de_DE": [
        "Welche Art Kampf würdest du gerne\n",
        "spielen? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0046_00002",
      "de_DE": [
        "Mit wie vielen Spielern\n",
        "möchtest du antreten?{YESNO 0}"
      ]
    },
    {
      "id": "msg_0046_00003",
      "de_DE": "Einmal Multikampf für Vier?{YESNO 0}"
    },
    {
      "id": "msg_0046_00004",
      "de_DE": "MULTIKAMPF"
    },
    {
      "id": "msg_0046_00005",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0046_00006",
      "de_DE": [
        "Es gibt fünf verschiedene Kampfarten.\r",
        "Der Einzelkampf ist für zwei Trainer mit\n",
        "je einem oder mehr Pokémon.\r",
        "Jeder Trainer kann nur ein Pokémon\n",
        "auf einmal in den Kampf schicken.\r",
        "Der Doppelkampf ist für zwei Trainer mit\n",
        "je zwei oder mehr Pokémon.\r",
        "Jeder Trainer schickt zwei Pokémon\n",
        "auf einmal in den Kampf.\r",
        "Der Mischkampf ist für zwei Trainer mit\n",
        "je drei Pokémon.\r",
        "Jeder Trainer wählt ein Pokémon des\n",
        "Gegners, fügt es seinem eigenen Team\f",
        "hinzu und kämpft so gegen den anderen\f",
        "Trainer.\r",
        "Beim Handicapkampf werden Pokémon, die\n",
        "über Level 50 sind, für die Dauer des\f",
        "Kampfes auf Level 50 reduziert.\r",
        "Der Multikampf ist für vier Trainer\n",
        "mit je drei Pokémon.\r",
        "Jeder Trainer kann nur ein Pokémon\n",
        "auf einmal in den Kampf schicken.\r"
      ]
    },
