      "id": "msg_0738_00131",
      "de_DE": [
        "Melde dich bei mir, wenn du\n",
        "etwas von mir willst!"
      ]
    },
    {
      "id": "msg_0738_00132",
      "de_DE": [
        "Du willst Statistiken tauschen?\n",
        "Gerne. Ich brauche nur etwas Zeit."
      ]
    },
    {
      "id": "msg_0738_00133",
      "de_DE": [
        "Tut mir leid, dass du warten musstest.\n",
        "Legen wir los!"
      ]
    },
    {
      "id": "msg_0738_00134",
      "de_DE": [
        "Tut mir leid!\n",
        "Vielleicht beim nächsten Mal!"
      ]
    },
    {
      "id": "msg_0738_00135",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: Wir tauschen gerade\n",
        "unsere Statistiken.\r",
        "Natürlich! {STRVAR_1 3, 1, 0}, möchtest du\n",
        "mittauschen?"
      ]
    },
    {
      "id": "msg_0738_00136",
      "de_DE": [
        "Oh...\n",
        "Bitte komme jederzeit vorbei."
      ]
    },
    {
      "id": "msg_0738_00137",
      "de_DE": [
        "Danke, dass du gewartet hast.\n",
        "Lass uns Statistiken tauschen!"
      ]
    },
    {
      "id": "msg_0738_00138",
      "de_DE": "Tut mir leid. Ein andermal, okay?"
    },
    {
      "id": "msg_0738_00139",
      "de_DE": [
        "Es macht total viel Spaß, Statistiken zu\n",
        "tauschen."
      ]
    },
    {
      "id": "msg_0738_00140",
      "de_DE": [
        "Ich werde auch weiterhin ganz viele\n",
        "Statistiken tauschen."
      ]
    },
    {
      "id": "msg_0738_00141",
      "de_DE": "Tauschen wir. Juchhu!"
    },
    {
      "id": "msg_0738_00142",
      "de_DE": "Was jetzt wohl passieren wird?"
    },
    {
      "id": "msg_0738_00143",
      "de_DE": [
        "Reihumtausch? Natürlich!\n",
        "Gut, kannst du einen Moment warten?"
      ]
    },
    {
      "id": "msg_0738_00144",
      "de_DE": [
        "In Ordnung, alles bereit!\n",
        "Der Reihumtausch kann losgehen!"
      ]
    },
    {
      "id": "msg_0738_00145",
      "garbage": 21
    },
    {
      "id": "msg_0738_00146",
      "de_DE": [
        "Wenn du an einem Reihumtausch\n",
        "teilnehmen möchtest, brauchst du\f",
        "auch ein Ei.\r"
      ]
    },
    {
      "id": "msg_0738_00147",
      "de_DE": [
        "{STRVAR_1 3, 0, 0}: Wir machen gerade\n",
        "einen Reihumtausch.\r",
        "{STRVAR_1 3, 1, 0}, möchtest du auch bei\n",
        "einem Reihumtausch mitmachen?"
      ]
    },
    {
      "id": "msg_0738_00148",
      "de_DE": [
        "Oh, in Ordnung.\n",
        "Stoß zu uns, wann immer du magst!"
      ]
    },
    {
      "id": "msg_0738_00149",
      "de_DE": [
        "In Ordnung! Machen wir zusammen\n",
        "einen Reihumtausch!"
      ]
    },
    {
      "id": "msg_0738_00150",
      "garbage": 45
    },
    {
      "id": "msg_0738_00151",
      "garbage": 21
    },
    {
      "id": "msg_0738_00152",
      "de_DE": [
        "Es gibt ein Ei in deinem Team, das nicht\n",
        "getauscht werden kann."
      ]
    },
    {
      "id": "msg_0738_00153",
      "de_DE": "Wir machen Reihumtausche!"
    },
    {
      "id": "msg_0738_00154",
      "de_DE": [
        "Wah!\n",
        "Es hat sich schon wieder bewegt!"
      ]
    },
    {
      "id": "msg_0738_00155",
      "de_DE": [
        "Da wechselt das Ei, das ich haben\n",
        "wollte, den Besitzer..."
      ]
    },
    {
      "id": "msg_0738_00156",
      "de_DE": [
        "Hätte es dort angehalten, hätte ich\n",
        "eine Beere bekommen."
      ]
    },
    {
      "id": "msg_0738_00157",
      "de_DE": [
        "Willkommen im Konnex-Klub.\r",
        "Sag Bescheid, wenn ich dir\n",
        "helfen kann. {YESNO 0}"
      ]
    },
    {
      "id": "msg_0738_00158",
      "de_DE": "Wie kann ich dir helfen? {YESNO 0}"
    },
    {
      "id": "msg_0738_00159",
      "de_DE": [
        "Welchen Themenbereich soll\n",
        "ich dir näher erklären? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0738_00160",
      "de_DE": [
        "Im Konnex-Klub kannst du mit zwei\n",
        "Pokémon deiner Wahl kämpfen, wenn\f",
        "ihr Level 30 oder niedriger ist.\r",
        "Wenn du also hierher kommst, solltest\n",
        "du entsprechende Pokémon mitbringen.\r"
      ]
    },
    {
      "id": "msg_0738_00161",
      "de_DE": [
        "Du kannst Pokémon mit anderen Spielern\n",
        "tauschen.\r",
        "Je mehr Spieler du kennst, desto eher\n",
        "könnte ein seltenes Pokémon dabei sein!\r"
      ]
    },
    {
      "id": "msg_0738_00162",
      "de_DE": [
        "Du kannst mit anderen Spielern\n",
        "kommunizieren und Statistiken\f",
        "austauschen.\r",
        "Was dieser Statistiktausch bringen soll,\n",
        "fragst du?\r",
        "Tja, versuch es doch einfach mal!\r",
        "Bis zu fünf Spieler können daran\n",
        "teilnehmen, also versuch es mal mit\f",
        "deinen Freunden!\r"
      ]
    },
    {
      "id": "msg_0738_00163",
      "de_DE": [
        "Zu einem Reihumtausch bringt jeder ein\n",
        "Ei zum Tauschen mit anderen mit.\r",
        "Welches Ei wirst du bekommen?\n",
        "Welches Pokémon wird in diesem Ei sein?\f",
        "Das ist so aufregend und macht Spaß!\r",
        "Bis zu fünf Spieler können teilnehmen,\n",
        "versuche es also mit deinen Freunden!\r"
      ]
    },
    {
      "id": "msg_0738_00164",
      "de_DE": [
        "Du kannst dich mit anderen Spielern\n",
        "treffen, um zu zeichnen.\r",
        "Ihr könnt alle an demselben Blatt\n",
        "arbeiten - und zwar gleichzeitig.\r",
        "Eine Zeichnung von Freunden ist ein\n",
        "wunderschönes Erinnerungsstück!\r",
        "Bis zu fünf Spieler können daran\n",
        "teilnehmen, also versuch es mal mit\f",
        "deinen Freunden!\r"
      ]
    },
    {
      "id": "msg_0738_00165",
      "de_DE": [
        "Beginne einen Chat mit anderen Spielern,\n",
        "indem du im Menü “CHAT” wählst.\r",
        "Im Konnex-Klub kannst du die\n",
        "unterschiedlichsten Leute treffen!\r",
        "Unterhalte dich mit ihnen. Plant, was ihr\n",
        "gemeinsam machen wollt.\r",
        "Erweitere deinen Freundeskreis -\n",
        "und deinen Horizont!\r"
      ]
    },
    {
      "id": "msg_0738_00166",
      "de_DE": [
        "Oh!\n",
        "Da kommt jemand!\r",
        "Sprich doch lieber mit dem Neuankömmling\n",
        "als mit mir.\r"
      ]
    },
    {
      "id": "msg_0738_00167",
      "garbage": 34
    },
    {
      "id": "msg_0738_00168",
      "de_DE": [
        "{STRVAR_1 14, 0, 0}! Damit wirst du\n",
        "manchmal verwechselt?\r",
        "So kommst du mir zumindest vor.\r"
      ]
    },
    {
      "id": "msg_0738_00169",
      "de_DE": [
        "Hallo!\r",
        "So ist es!\n",
        "Der Gruß ist wichtig!\r",
        "Wenn jemand neu ist und hereinkommt,\n",
        "sollte man immer freundlich sein!\r"
      ]
    },
    {
      "id": "msg_0738_00170",
      "de_DE": [
        "Grüß dich!\r",
        "{STRVAR_1 28, 0, 0}?\n",
        "Wunderschön!\f",
        "Mir gefällt es auch!\r",
        "Wenn du jemanden zum ersten Mal\n",
        "triffst, solltest du so höflich sein und\f",
        "dich vorstellen.\r",
        "Dadurch erfährst du dann auch etwas\n",
        "über die andere Person!\r"
      ]
    },
    {
      "id": "msg_0738_00171",
      "de_DE": [
        "{STRVAR_1 28, 0, 0}-Trainer?\n",
        "Das also bist du?\f",
        "Was du nicht sagst!\r",
        "Aber ich habe gar keine Pokémon...\r",
        "Ich schaue lieber zu, als selbst zu\n",
        "kämpfen, weißt du?\r"
      ]
    },
    {
      "id": "msg_0738_00172",
      "de_DE": [
        "Oh! Dein {STRVAR_1 28, 0, 0}!\n",
        "Ich würde es so gerne haben!\f",
        "Lass uns tauschen!\r",
        "...\r",
        "Nur ein Scherz.\r",
        "Ich habe gar keine Pokémon, also kann\n",
        "ich auch nicht tauschen...\r"
      ]
    },
    {
      "id": "msg_0738_00173",
      "de_DE": [
        "{STRVAR_1 28, 0, 0}? Ich kann verstehen,\n",
        "dass du so etwas möchtest...\r",
        "Aber sei nicht egoistisch.\r",
        "Wenn du tauschst, musst du auch\n",
        "berücksichtigen, welches Pokémon\f",
        "die andere Person gerne hätte.\r"
      ]
    },
    {
      "id": "msg_0738_00174",
      "de_DE": [
        "Willkommen im Konnex-Klub!\r",
        "Ich bin zurzeit allein hier, also bring\n",
        "bitte alle deine Freunde mit.\r",
        "Dann haben wir hier unseren Spaß!\r",
        "Wenn du Zeit hast, bin ich auch hier, um\n",
        "ein wenig zu plaudern.\r",
        "Ich habe nämlich sehr viel Zeit...\r"
      ]
    },
    {
      "id": "msg_0738_00175",
      "de_DE": [
        "Ich kann besonders gut zeichnen!\r",
        "Wenn es um {STRVAR_1 28, 0, 0} geht,\n",
        "überlass das nur mir!\f",
        "Das kann niemand besser als ich!\r"
      ]
    },
    {
      "id": "msg_0738_00176",
      "de_DE": [
        "Oh, du gehst schon...\r",
        "...\r",
        "Ich bin doch so einsam...\r",
        "Bitte komme wieder!\r"
      ]
    },
    {
      "id": "msg_0738_00177",
      "de_DE": [
        "Was ist denn los?\n",
        "Bist du traurig?\r",
        "Wenn du niedergeschlagen bist, solltest\n",
        "du Zeit mit deinen Freunden verbringen!\f",
        "Das ist schöner, als allein zu leiden.\r"
      ]
    },
    {
      "id": "msg_0738_00178",
      "de_DE": [
        "{STRVAR_1 28, 0, 0}?\n",
        "Ja bitte!\r",
        "...Ich würde so gerne mitmachen, aber\n",
        "ich bin im Dienst...\r",
        "Seufz... {STRVAR_1 28, 0, 0}...\n",
        "Ich wünschte, ich könnte...\r"
      ]
    },
    {
      "id": "msg_0738_00179",
      "de_DE": [
        "{STRVAR_1 28, 0, 0}?\n",
        "Ich auch, bitte!\r",
        "Aber ich muss leider hierbleiben und\n",
        "mich um die Besucher kümmern...\r",
        "Hab du zumindest viel Spaß!\r"
      ]
    },
    {
      "id": "msg_0738_00180",
      "de_DE": [
        "{STRVAR_1 28, 0, 0}?\n",
        "Du lädst mich ein?\r",
        "Oh, aber ich muss doch hierbleiben\n",
        "und mich um die Besucher kümmern.\r",
        "Tut mir leid. Ich würde gerne mitmachen,\n",
        "aber ich kann einfach nicht.\r"
      ]
    },
    {
      "id": "msg_0738_00181",
      "de_DE": [
        "So ist es!\r",
        "Manchmal muss man einfach andere\n",
        "Leute einladen.\r",
        "Aber sei nicht zu eifersüchtig,\n",
        "wenn du {STRVAR_1 28, 0, 0} wählst.\r"
      ]
    },
    {
      "id": "msg_0738_00182",
      "de_DE": [
        "Ja!\n",
        "Schon in Ordnung!\r",
        "Unmöglich ist gar nichts.\r",
        "Positiv denken und den Kopf nicht\n",
        "hängen lassen!\r"
      ]
    },
    {
      "id": "msg_0738_00183",
      "de_DE": [
        "Jeder hat mindestens ein Gebiet, auf\n",
        "dem er oder sie nicht gut ist.\r",
        "Zwinge niemanden, etwas zu tun, das der\n",
        "andere nicht möchte.\r",
        "Ich zum Beispiel würde gerne\n",
        "{STRVAR_1 28, 0, 0} wählen.\r"
      ]
    },
    {
      "id": "msg_0738_00184",
      "de_DE": [
        "Viel Glück! Ich hoffe, du magst\n",
        "ernsthafte, harte Kämpfe.\r",
        "Solche kannst du nämlich nicht im\n",
        "Konnex-Klub finden!\r"
      ]
    },
    {
      "id": "msg_0738_00185",
      "de_DE": [
        "Du möchtest dich unterhalten?\r",
        "Nun, du solltest deine Zeit nicht damit\n",
        "verbringen, dich mit mir zu unterhalten.\r",
        "Du musst aktiver sein und mit anderen\n",
        "Spielern sprechen.\r",
        "Du kannst doch keine Freunde finden,\n",
        "wenn du nicht mit Leuten sprichst.\r"
      ]
    },
    {
      "id": "msg_0738_00186",
      "de_DE": [
        "Wo du bist?\n",
        "Ähm... direkt vor meiner Nase.\r",
        "Oh!\n",
        "Bist du ein Hochstapler?\r",
        "Ist der echte Spieler woanders?\r",
        "...Das ist ja lächerlich!\n",
        "Erzähl doch keinen Unsinn!\f",
        "Meine Güte!\r"
      ]
    },
    {
      "id": "msg_0738_00187",
      "de_DE": [
        "{STRVAR_1 28, 0, 0}-Tausch?\n",
        "Das klingt lustig!\f",
        "Das würde ich auch gern machen.\r",
        "Aber mir das zu sagen, hilft eigentlich\n",
        "nicht. Ich kann mit niemandem tauschen.\r"
      ]
    },
    {
      "id": "msg_0738_00188",
      "de_DE": [
        "Wenn du einen {STRVAR_1 28, 0, 0}-Kampf\n",
        "möchtest, musst du andere Spieler\f",
        "direkt darauf ansprechen.\r",
        "Solange du keine Entschlossenheit\n",
        "zeigst, hast du gar keine Chance auf\f",
        "einen {STRVAR_1 28, 0, 0}-Kampf!\r"
      ]
    },
