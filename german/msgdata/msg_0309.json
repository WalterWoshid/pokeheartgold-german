    {
      "id": "msg_0309_00197",
      "de_DE": "{ALN_CENTER}Wettkampfregeln"
    },
    {
      "id": "msg_0309_00198",
      "de_DE": "Nimm alle Hürden und lauf ins Ziel!"
    },
    {
      "id": "msg_0309_00199",
      "de_DE": "Schnappe dir fix die Flaggen!"
    },
    {
      "id": "msg_0309_00200",
      "de_DE": "Bleibe innerhalb der Kreise!"
    },
    {
      "id": "msg_0309_00201",
      "de_DE": "Zerbrich so viele Ziegel wie möglich!"
    },
    {
      "id": "msg_0309_00202",
      "de_DE": "Springe und fange die Scheiben!"
    },
    {
      "id": "msg_0309_00203",
      "de_DE": "Springe und schalte die Lampen an!"
    },
    {
      "id": "msg_0309_00204",
      "de_DE": "Wechsele aus, wenn du müde wirst!"
    },
    {
      "id": "msg_0309_00205",
      "de_DE": "Stoße deine Gegner aus dem Ring!"
    },
    {
      "id": "msg_0309_00206",
      "de_DE": "Lass die Schneebälle sausen!"
    },
    {
      "id": "msg_0309_00207",
      "de_DE": "Schieße ins Tor deiner Gegner!"
    },
    {
      "id": "msg_0309_00208",
      "de_DE": "{ALN_CENTER}Steuerung"
    },
    {
      "id": "msg_0309_00209",
      "de_DE": [
        "Bringe deine drei Pokémon\n",
        "durch den Hürdenparcours.\n",
        "Berühre eines, um zu springen."
      ]
    },
    {
      "id": "msg_0309_00210",
      "de_DE": [
        "Der Hürdenlauf ist ein Wettlauf mit der\n",
        "Zeit. Es gewinnt, wer die Hürden mit\n",
        "gezielten Sprüngen überwindet und als\n",
        "Schnellster das Ziel erreicht. Die Punkte\n",
        "richten sich nach der Gesamtzeit aller\n",
        "drei Athleten.\n",
        "\n",
        "Tempo: bestimmt die Laufgeschwindigkeit\n",
        "Sprung: bestimmt, wie weit man springt"
      ]
    },
    {
      "id": "msg_0309_00211",
      "de_DE": [
        "Berühre ein Pokémon, um zu springen.\n",
        "Überwinde alle Hürden!\n",
        "Du steuerst drei Pokémon gleichzeitig.\n",
        "Erreiche als Erster das Ziel!"
      ]
    },
    {
      "id": "msg_0309_00212",
      "de_DE": [
        "Treibe deine Pokémon mit dem\n",
        "Touchpen an. Ramme Gegner,\n",
        "um ihre Flaggen zu stehlen!"
      ]
    },
    {
      "id": "msg_0309_00213",
      "de_DE": [
        "Beim Flaggenschnappen dreht sich alles\n",
        "darum, möglichst viele Wimpel zu sammeln.\n",
        "Deine Pokémon können jeweils bis zu\n",
        "9 Flaggen tragen. Rempeln sie einen\n",
        "Gegner von hinten an, klauen sie\n",
        "dessen Flaggen.\n",
        "\n",
        "Tempo: bestimmt die Laufgeschwindigkeit\n",
        "Technik: fördert die Beweglichkeit"
      ]
    },
    {
      "id": "msg_0309_00214",
      "de_DE": [
        "Treibe deine Pokémon mit schnellen\n",
        "Bewegungen des Touchpens an!\n",
        "Je öfter du sie anschiebst, desto\n",
        "schneller laufen sie!\n",
        "\n",
        "Sei schneller als die anderen und\n",
        "hole jede Menge Flaggen ins Ziel!"
      ]
    },
    {
      "id": "msg_0309_00215",
      "de_DE": [
        "Steuere 3 Pokémon auf einmal,\n",
        "indem du sie mit dem Touchpen\n",
        "über das Spielfeld führst!"
      ]
    },
    {
      "id": "msg_0309_00216",
      "de_DE": [
        "Beim Drängelkreis behauptet sich,\n",
        "wer die anderen aus dem Kreis befördert.\n",
        "Ist der Countdown bei eins angekommen,\n",
        "erhalten alle Pokémon, die innerhalb\n",
        "eines Kreises stehen, Punkte.\n",
        "\n",
        "Kraft: verstärkt die Wucht der Schübe\n",
        "Ausdauer: fördert die Kondition"
      ]
    },
    {
      "id": "msg_0309_00217",
      "de_DE": [
        "Steuere deine Pokémon, indem du ihre\n",
        "Bewegungen mit dem Touchpen nach-\n",
        "zeichnest.\n",
        "Versuche, alle drei Pokémon\n",
        "innerhalb der Kreise zu halten -\n",
        "das ergibt die meisten Punkte!"
      ]
    },
    {
      "id": "msg_0309_00218",
      "de_DE": [
        "Tippe die Ziegel an, um sie\n",
        "entzweizuschlagen. Wechsele,\n",
        "wenn Athleten müde werden."
      ]
    },
    {
      "id": "msg_0309_00219",
      "de_DE": [
        "Beim Ziegelbrechen zerschmettern deine\n",
        "Athleten mit aller Kraft die vor ihnen\n",
        "gestapelten Steinplatten. Vergiss nicht,\n",
        "Pokémon auszuwechseln, wenn sie müde\n",
        "werden. Jeder zerbrochene Ziegel gibt\n",
        "Punkte.\n",
        "\n",
        "Kraft: beeinflusst die Zerstörungskraft\n",
        "Ausdauer: fördert die Kondition"
      ]
    },
    {
      "id": "msg_0309_00220",
      "de_DE": [
        "Tippe die Ziegel an, um sie zu zerbrechen.\n",
        "Bearbeite die Blöcke mit schnellen\n",
        "Handkantenschlägen, um möglichst viele\n",
        "hintereinander zu schaffen.\n",
        "\n",
        "Wird dein Pokémon müde, berühre\n",
        "den Wechsel-Knopf & hole ein\n",
        "neues Teammitglied ins Spiel!"
      ]
    },
    {
      "id": "msg_0309_00221",
      "de_DE": [
        "1) Führe deine Pokémon mit dem\n",
        "Touchpen über das Feld.\n",
        "2) Antippen: Springen"
      ]
    },
    {
      "id": "msg_0309_00222",
      "de_DE": [
        "Beim Diskusfangen steuerst du 3 Pokémon\n",
        "gleichzeitig. Es gilt, im richtigen Moment\n",
        "zu springen und die aus dem Meer\n",
        "hervorspringenden Scheiben abzufangen.\n",
        "Je weiter hinten du stehst, desto mehr\n",
        "Punkte erhältst du.\n",
        "\n",
        "Sprung: bestimmt, wie hoch du springst\n",
        "Kraft: verstärkt die Wucht deiner Hiebe"
      ]
    },
    {
      "id": "msg_0309_00223",
      "de_DE": [
        "1) Weise deine Pokémon durch Führen des\n",
        "Touchpen an, wohin sie laufen sollen.\n",
        "Schiebe deine Gegner aus dem Weg, um die\n",
        "Scheiben zu erreichen.\n",
        "2) Tippe deine Pokémon leicht\n",
        "an, um zu springen! Fange\n",
        "so viele Scheiben wie möglich."
      ]
    },
    {
      "id": "msg_0309_00224",
      "de_DE": [
        "Katapultiere deine 3 Pokémon\n",
        "nach oben, indem du sie nach\n",
        "unten ziehst und loslässt!"
      ]
    },
    {
      "id": "msg_0309_00225",
      "de_DE": [
        "Beim Lampionspringen steuerst du 3\n",
        "Pokémon gleichzeitig. Deine Aufgabe ist\n",
        "es, durch hohe Sprünge die Lampions zu\n",
        "berühren. Je mehr Lampions du mit einem\n",
        "Mal berührst, desto mehr Punkte gibt es.\n",
        "\n",
        "Sprung: bestimmt, wie hoch du springst\n",
        "Technik: macht es einfacher, seitwärts\n",
        "zu springen"
      ]
    },
    {
      "id": "msg_0309_00226",
      "de_DE": [
        "Katapultiere deine Pokémon nach oben,\n",
        "indem du sie schnell nach unten ziehst\n",
        "und loslässt!\n",
        "Ziehe das Sprungfeld zur Seite und\n",
        "gib ihnen einen Seitwärtsdrall!"
      ]
    },
    {
      "id": "msg_0309_00227",
      "de_DE": [
        "Lasse deine Pokémon mit dem\n",
        "Touchpen sprinten. Ist eines\n",
        "müde, so wechsele es aus!"
      ]
    },
    {
      "id": "msg_0309_00228",
      "de_DE": [
        "Beim Staffellauf versuchen die Läufer\n",
        "abwechselnd, eine möglichst lange\n",
        "Strecke zurückzulegen. Denke daran,\n",
        "deine Pokémon auszuwechseln, bevor sie\n",
        "erschöpft sind. Je mehr Runden du\n",
        "zurücklegst, desto mehr Punkte gibt es.\n",
        "\n",
        "Ausdauer: fördert die Kondition\n",
        "Tempo: bestimmt die Laufgeschwindigkeit"
      ]
    },
    {
      "id": "msg_0309_00229",
      "de_DE": [
        "Sprinte los, indem du deinen Touchpen\n",
        "schnell nach rechts ziehst!\n",
        "\n",
        "Je schneller deine Züge, desto\n",
        "schneller sprinten die Pokémon!\n",
        "\n",
        "Wird dein PKMN müde, berühre\n",
        "den Wechsel-Knopf & hole ein\n",
        "neues Teammitglied ins Spiel!"
      ]
    },
    {
      "id": "msg_0309_00230",
      "de_DE": [
        "1) Führe die ₧₦ übers Feld\n",
        "2) Schnelles Ziehen: Angriff!\n",
        "3) Antippen: Springen"
      ]
    },
    {
      "id": "msg_0309_00231",
      "de_DE": [
        "Beim Ringrangeln schieben und drücken\n",
        "deine Pokémon um die Wette - wer einen\n",
        "Gegner aus dem Ring stößt, erhält\n",
        "Punkte. Berühre den Wechsel-Knopf in\n",
        "deiner Team-Ecke, um dein Pokémon\n",
        "auszuwechseln\n",
        "\n",
        "Ausdauer: beeinflusst die Standfestigkeit\n",
        "Kraft: bestimmt die Wucht der Stöße"
      ]
    },
    {
      "id": "msg_0309_00232",
      "de_DE": [
        "1)Ziehe deine Pokémon mit dem Touchpen\n",
        "über das Feld.\n",
        "2)Gib deinen Gegnern einen Schubs\n",
        "und stoße sie aus dem Ring!\n",
        "3)Durch Antippen springst du.\n",
        "Begrabe Gegner unter dir!"
      ]
    },
    {
      "id": "msg_0309_00233",
      "de_DE": [
        "1) Wirf Schneebälle, indem du\n",
        "den Touchpen nach oben ziehst\n",
        "2) Tippen vergrößert die Bälle"
      ]
    },
    {
      "id": "msg_0309_00234",
      "de_DE": [
        "Bei der Schneeschlacht steuerst du\n",
        "3 Pokémon auf einmal. Es geht darum,\n",
        "den Gegner mit möglichst vielen\n",
        "Schneebällen zu bewerfen. Es ist egal,\n",
        "welches Pokémon du anvisierst.\n",
        "Jeder Treffer bringt Punkte!\n",
        "\n",
        "Technik: verbessert die Zielgenauigkeit\n",
        "Kraft: verleiht den Bällen Wucht"
      ]
    },
    {
      "id": "msg_0309_00235",
      "de_DE": [
        "1)Ziehe dein Pokémon in Richtung Gegner,\n",
        "um einen Schneeball zu werfen.\n",
        "2)Hält ein PKMN einen Schneeball,\n",
        "vergrößere ihn durch Antippen.\n",
        "3)Sehr große Bälle lassen den\n",
        "Gegner ohnmächtig werden!"
      ]
    },
    {
      "id": "msg_0309_00236",
      "de_DE": [
        "1) Ziehe deine Pokémon in die\n",
        "gewünschte Richtung.\n",
        "2) Sprinte mit schnellen Zügen"
      ]
    },
    {
      "id": "msg_0309_00237",
      "de_DE": [
        "Beim Torschießen geht es darum, den Ball\n",
        "in eines der gegnerischen Tore zu\n",
        "befördern. Jedes bringt gleich viele\n",
        "Punkte ein. Aber Vorsicht: Geht der\n",
        "Ball in dein Tor, gibt es Minuspunkte!\n",
        "\n",
        "Technik: beeinflusst die Schussweite\n",
        "Kraft: bestimmt die Wucht des Balls"
      ]
    },
    {
      "id": "msg_0309_00238",
      "de_DE": [
        "1) Steuere alle 3 Pokémon gleichzeitig,\n",
        "indem du sie mit dem Touchpen in die\n",
        "gewünschte Richtung ziehst.\n",
        "\n",
        "2) Nimm Anlauf durch schnelles\n",
        "Ziehen mit dem Touchpen und\n",
        "schieß den Ball ins Tor!"
      ]
    },
