{
  "key": 10949,
  "messages": [
    {
      "id": "msg_0309_00000",
      "de_DE": [
        "Willkommen beim Pokéathlon!\n",
        "Und Hallo zum {STRVAR_4 1, 0, 0}!\r",
        "Wer wird der strahlende Sieger sein?\n",
        "Die heutigen Poké-Athleten sind:\r"
      ]
    },
    {
      "id": "msg_0309_00001",
      "de_DE": [
        "In Team {STRVAR_1 3, 0, 0}: {STRVAR_1 1, 1, 0},\n",
        "{STRVAR_1 1, 2, 0}, {STRVAR_1 1, 3, 0}!\r"
      ]
    },
    {
      "id": "msg_0309_00002",
      "de_DE": [
        "Dann mal nichts wie los!\n",
        "Gebt Gummi! Auf die Plätze, fertiiig...\r",
        "{ALN_CENTER}{SIZE 200}Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00003",
      "de_DE": [
        "Ein großes Lob an all unsere Athleten!\r",
        "Welches Team ist der Sieger?\n",
        "Ich verlese nun die Ergebnisse!\r",
        "Doch als Erstes...\n",
        "eine Belohnung für Mut zum Risiko!\r"
      ]
    },
    {
      "id": "msg_0309_00004",
      "de_DE": "Der Draufgängerbonus!\r"
    },
    {
      "id": "msg_0309_00005",
      "de_DE": [
        "Es gehen {STRVAR_1 52, 1, 0} Punkte an\n",
        "Team {STRVAR_1 3, 0, 0}!\r"
      ]
    },
    {
      "id": "msg_0309_00006",
      "de_DE": "Als Nächstes der Einzelpreis...\r"
    },
    {
      "id": "msg_0309_00007",
      "de_DE": [
        "Extrapunkte für einen fehlerfreien\n",
        "Durchlauf gehen aaan...\r"
      ]
    },
    {
      "id": "msg_0309_00008",
      "de_DE": "{STRVAR_1 0, 1, 0} aus Team {STRVAR_1 3, 0, 0}!"
    },
    {
      "id": "msg_0309_00009",
      "de_DE": "...niemand!\r"
    },
    {
      "id": "msg_0309_00010",
      "de_DE": "Das war’s auch schon!\r"
    },
    {
      "id": "msg_0309_00011",
      "de_DE": [
        "Was fehlt noch? Ach ja!\n",
        "Unser heutiger Punktekönig!\r"
      ]
    },
    {
      "id": "msg_0309_00012",
      "de_DE": "{STRVAR_1 0, 1, 0} aus Team {STRVAR_1 3, 0, 0}!"
    },
    {
      "id": "msg_0309_00013",
      "de_DE": "Das war’s!\r"
    },
    {
      "id": "msg_0309_00014",
      "de_DE": [
        "Nun die Punkte\n",
        "für besondere Leistungen!\r"
      ]
    },
    {
      "id": "msg_0309_00015",
      "de_DE": [
        "Die meisten Sprünge gehen\n",
        "auf das Konto von... ...\r"
      ]
    },
    {
      "id": "msg_0309_00016",
      "de_DE": [
        "Die meisten Angriffe gehen\n",
        "auf das Konto von... ...\r"
      ]
    },
    {
      "id": "msg_0309_00017",
      "de_DE": [
        "Die meisten Schnitzer gehen\n",
        "auf das Konto von... ...\r"
      ]
    },
    {
      "id": "msg_0309_00018",
      "de_DE": [
        "Die meisten Sprints gehen\n",
        "auf das Konto von... ...\r"
      ]
    },
    {
      "id": "msg_0309_00019",
      "de_DE": [
        "Und das Schlusslicht bildete\n",
        "diesmal... ...\r"
      ]
    },
    {
      "id": "msg_0309_00020",
      "de_DE": "{STRVAR_1 0, 1, 0} aus Team {STRVAR_1 3, 0, 0}!"
    },
    {
      "id": "msg_0309_00021",
      "de_DE": "So viel dazu!\r"
    },
    {
      "id": "msg_0309_00022",
      "de_DE": [
        "Und zu guter Letzt... addieren wir die\n",
        "Punkte aus den einzelnen Wettkämpfen!\r"
      ]
    },
    {
      "id": "msg_0309_00023",
      "de_DE": "{STRVAR_1 50, 0, 0}. Wettkampf!"
    },
    {
      "id": "msg_0309_00024",
      "de_DE": [
        "Na gibt’s denn so was? Ein Gleichstand?\n",
        "In dem Fall entscheidet das Los!\r",
        "Hm... mja... hmmm...\n",
        "... ... ... ... ... ...\r",
        "... ... ... ... ... ...\n",
        "Wir haben einen Gewinner!\r"
      ]
    },
    {
      "id": "msg_0309_00025",
      "de_DE": [
        "Der Sieger mit unglaublichen\n",
        "{STRVAR_1 52, 0, 0} Punkten iiist...\r"
      ]
    },
    {
      "id": "msg_0309_00026",
      "de_DE": "{ALN_CENTER}{SIZE 200}Team {STRVAR_1 3, 0, 0}!\r"
    },
    {
      "id": "msg_0309_00027",
      "de_DE": [
        "Team {STRVAR_1 3, 0, 0} darf sich auf\n",
        "eine {STRVAR_4 3, 1, 0} freuen!\r"
      ]
    },
    {
      "id": "msg_0309_00028",
      "de_DE": [
        "Team {STRVAR_1 3, 0, 0} erhält\n",
        "eine {STRVAR_4 3, 1, 0}\f",
        "und eine {STRVAR_4 3, 2, 0}!\r"
      ]
    },
    {
      "id": "msg_0309_00029",
      "de_DE": [
        "Team {STRVAR_1 3, 0, 0} hat\n",
        "beim {STRVAR_4 1, 1, 0}\f",
        "seinen persönlichen Rekord gebrochen!\r"
      ]
    },
    {
      "id": "msg_0309_00030",
      "de_DE": [
        "Da hat sich aber jemand mächtig ins Zeug\n",
        "gelegt beim {STRVAR_4 1, 0, 0}!\r"
      ]
    },
    {
      "id": "msg_0309_00031",
      "de_DE": [
        "Herzlichen Glückwunsch!\n",
        "Das war ganz großartiger Sport!\r",
        "Macht weiter so, und vielleicht gehört\n",
        "ihr bald zu den Top-Poké-Athleten!\r",
        "Wie heißt es so schön?\n",
        "Pokéathlooon...\r",
        "{ALN_CENTER}{SIZE 200}Forever!\r"
      ]
    },
    {
      "id": "msg_0309_00032",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} Wettkämpfen ein\n",
        "aufgehender Stern am Pokéathlonhimmel!\r"
      ]
    },
    {
      "id": "msg_0309_00033",
      "de_DE": [
        "Mit schon {STRVAR_1 55, 1, 0} Wettkämpfen ein\n",
        "heller Komet am Pokéathlonhimmel!\r"
      ]
    },
    {
      "id": "msg_0309_00034",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} Wettkämpfen eine\n",
        "Supernova im Pokéathlonkosmos!\r"
      ]
    },
    {
      "id": "msg_0309_00035",
      "de_DE": [
        "Mit sagenhaften {STRVAR_1 55, 1, 0} Wettkämpfen\n",
        "der Große Knall des Pokéversums!\r"
      ]
    },
    {
      "id": "msg_0309_00036",
      "de_DE": [
        "Mit noch ungestilltem Hunger auf den\n",
        "Sieg! Die neue Hoffnung des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00037",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} Siegen auf dem\n",
        "besten Weg zum Ruhm!\r"
      ]
    },
    {
      "id": "msg_0309_00038",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} Siegen auf der Autobahn\n",
        "Richtung goldene Pokéathlon-Zukunft!\r"
      ]
    },
    {
      "id": "msg_0309_00039",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} Siegen eine\n",
        "lebende Pokéathlon-Legende!\r"
      ]
    },
    {
      "id": "msg_0309_00040",
      "de_DE": [
        "Wer sich wie sie keine Fehler leistet,\n",
        "ist immer ganz vorne dabei!\r"
      ]
    },
    {
      "id": "msg_0309_00041",
      "de_DE": [
        "Mit nur {STRVAR_1 55, 1, 0} letzten Plätzen\n",
        "weiterhin wacker am Ball!\r"
      ]
    },
    {
      "id": "msg_0309_00042",
      "de_DE": [
        "Schon {STRVAR_1 55, 1, 0} letzte Plätze!\n",
        "Doch sie lassen sich nicht unterkriegen!\r"
      ]
    },
    {
      "id": "msg_0309_00043",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} letzten Plätzen immer\n",
        "die Ersten von hinten!\r"
      ]
    },
    {
      "id": "msg_0309_00044",
      "de_DE": [
        "Der erste “erste Platz”\n",
        "ist erst aller guten Dinge Anfang!\r"
      ]
    },
    {
      "id": "msg_0309_00045",
      "de_DE": [
        "Schon {STRVAR_1 55, 1, 0}-mal ganz oben auf dem\n",
        "Treppchen! Weiter so!\r"
      ]
    },
    {
      "id": "msg_0309_00046",
      "de_DE": [
        "Schon {STRVAR_1 55, 1, 0}-mal Erster in einer\n",
        "Disziplin! Können sie das heute toppen?\r"
      ]
    },
    {
      "id": "msg_0309_00047",
      "de_DE": [
        "Sage und schreibe {STRVAR_1 55, 1, 0}-mal Erster!\n",
        "Holen sie sich auch heute Gold?\r"
      ]
    },
    {
      "id": "msg_0309_00048",
      "de_DE": [
        "Niederlagen können sie nicht schrecken!\n",
        "Denn sie erlauben sich keine Schlappe!\r"
      ]
    },
    {
      "id": "msg_0309_00049",
      "de_DE": [
        "{STRVAR_1 55, 1, 0}-mal Letzter im Turnier! Aber\n",
        "Hauptsache ist, man rappelt sich auf!\r"
      ]
    },
    {
      "id": "msg_0309_00050",
      "de_DE": [
        "Für andere sind es {STRVAR_1 55, 1, 0} Niederlagen,\n",
        "doch dieses Team trägt sie wie Orden!\r"
      ]
    },
    {
      "id": "msg_0309_00051",
      "de_DE": [
        "Ihr Motto nach {STRVAR_1 55, 1, 0} Niederlagen:\n",
        "Die Letzten werden die Ersten sein!\r"
      ]
    },
    {
      "id": "msg_0309_00052",
      "de_DE": [
        "Ist es Kompetenz, die sie gewinnen\n",
        "lässt? Oder pures Glück?\r"
      ]
    },
    {
      "id": "msg_0309_00053",
      "de_DE": [
        "Schon ganze {STRVAR_1 55, 1, 0} Bonuspunkte!\n",
        "Denn auch Glück ist eine Tugend!\r"
      ]
    },
    {
      "id": "msg_0309_00054",
      "de_DE": [
        "Schon insgesamt {STRVAR_1 55, 1, 0} Bonuspunkte...\n",
        "Auch das ist eine Leistung!\r"
      ]
    },
    {
      "id": "msg_0309_00055",
      "de_DE": [
        "Mit erstaunlichen {STRVAR_1 55, 1, 0} Bonuspunkten\n",
        "die größten Glückspilze des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00056",
      "de_DE": [
        "Gib alles für dein Team und\n",
        "gemeinsam bewegt ihr Berge!\r"
      ]
    },
    {
      "id": "msg_0309_00057",
      "de_DE": [
        "Ihr Teamgeist schreibt noch\n",
        "einmal Sportgeschichte!\r"
      ]
    },
    {
      "id": "msg_0309_00058",
      "de_DE": [
        "Was für ein Team! Was für ein\n",
        "Teamgeist! Was für ein Siegeswille!\r"
      ]
    },
    {
      "id": "msg_0309_00059",
      "de_DE": "Im Sport ein Team und ein Geist!\r"
    },
    {
      "id": "msg_0309_00060",
      "de_DE": [
        "Mit so wenig Schnitzern, dass man meint,\n",
        "es ginge nicht mit rechten Dingen zu!\r"
      ]
    },
    {
      "id": "msg_0309_00061",
      "de_DE": [
        "Hält sich mit nur {STRVAR_1 55, 1, 0} Schnitzern\n",
        "wacker im Rennen!\r"
      ]
    },
    {
      "id": "msg_0309_00062",
      "de_DE": [
        "Mit schon {STRVAR_1 55, 1, 0} Schnitzern das\n",
        "hellste Schlusslicht des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00063",
      "de_DE": [
        "Mit {STRVAR_1 55, 1, 0} Schnitzern Profis darin,\n",
        "aus den eigenen Fehlern zu lernen!\r"
      ]
    },
    {
      "id": "msg_0309_00064",
      "de_DE": [
        "Wer hoch hinaus will, dem ist selbst\n",
        "der Himmel nicht zu weit!\r"
      ]
    },
    {
      "id": "msg_0309_00065",
      "de_DE": [
        "Gerade erst vom Boden abgehoben und\n",
        "unterwegs zu ihrem ersten Höhenflug!\r"
      ]
    },
    {
      "id": "msg_0309_00066",
      "de_DE": [
        "Ein Team, das schon große Sprünge\n",
        "getan hat!\r"
      ]
    },
    {
      "id": "msg_0309_00067",
      "de_DE": [
        "Wer so hoch springt, greift als\n",
        "Nächstes nach den Sternen!\r"
      ]
    },
    {
      "id": "msg_0309_00068",
      "de_DE": [
        "Ein Team, das auszog, um seinen\n",
        "ersten Punkt zu gewinnen!\r"
      ]
    },
    {
      "id": "msg_0309_00069",
      "de_DE": [
        "Wer die Punkte nicht ehrt, ist\n",
        "des Sieges nicht wert!\r"
      ]
    },
    {
      "id": "msg_0309_00070",
      "de_DE": [
        "Sie arbeiten sich Punkt für Punkt\n",
        "nach vorne!\r"
      ]
    },
    {
      "id": "msg_0309_00071",
      "de_DE": [
        "Ein Applaus für die Punktekönige!\n",
        "Vor ihnen ist kein Punkt sicher!\r"
      ]
    },
    {
      "id": "msg_0309_00072",
      "de_DE": [
        "Kommt ihnen nicht zu nah, oder ihr\n",
        "bekommt ihren ersten Angriff zu spüren!\r"
      ]
    },
    {
      "id": "msg_0309_00073",
      "de_DE": [
        "Sie sind klein, gemein und bissig! \n",
        "Mit {STRVAR_1 55, 1, 0} Attacken...\r"
      ]
    },
    {
      "id": "msg_0309_00074",
      "de_DE": [
        "Mit roher Kraft zum Sieg!\n",
        "Schon {STRVAR_1 55, 1, 0} Attacken für...\r"
      ]
    },
    {
      "id": "msg_0309_00075",
      "de_DE": [
        "Niemand kann sie stoppen, niemand kann\n",
        "sie toppen! Mit {STRVAR_1 55, 1, 0} Attacken...\r"
      ]
    },
    {
      "id": "msg_0309_00076",
      "de_DE": [
        "Es ist noch kein Meister vom Himmel\n",
        "gefallen, doch umso mehr auf die Nase!\r"
      ]
    },
    {
      "id": "msg_0309_00077",
      "de_DE": [
        "Es geht doch nichts über einen Fall aus\n",
        "großer Höhe! Sie wissen, was ich meine!\r"
      ]
    },
    {
      "id": "msg_0309_00078",
      "de_DE": [
        "Mit der Nase immer dicht am Boden!\n",
        "Wahrlich, ein Team für alle Fälle!\r"
      ]
    },
    {
      "id": "msg_0309_00079",
      "de_DE": [
        "Dieses Team macht keine halben Sachen!\n",
        "Stets am Rande des Abgrunds stehend...\r"
      ]
    },
    {
      "id": "msg_0309_00080",
      "de_DE": [
        "Achtet auf ihren Sprint! Denn bald\n",
        "ziehen sie an euch vorbei!\r"
      ]
    },
    {
      "id": "msg_0309_00081",
      "de_DE": [
        "Ein Team, das den Pokéathlon\n",
        "in Windeseile erobert hat!\r"
      ]
    },
    {
      "id": "msg_0309_00082",
      "de_DE": [
        "Wenn sie laufen, sprühen Funken!\n",
        "Schnell, schneller, am schnellsten!\r"
      ]
    },
    {
      "id": "msg_0309_00083",
      "de_DE": [
        "So schnell wie ein geölter Blitz\n",
        "und sicherlich unerreicht!\r"
      ]
    },
    {
      "id": "msg_0309_00084",
      "de_DE": [
        "Rohe Kraft ist nicht alles! Die\n",
        "Strategie ist der Schlüssel zum Sieg!\r"
      ]
    },
    {
      "id": "msg_0309_00085",
      "de_DE": [
        "Setze deine Kräfte weise ein und\n",
        "du kontrollierst das Schlachtfeld!\r"
      ]
    },
    {
      "id": "msg_0309_00086",
      "de_DE": [
        "Nimm dich vor ihnen in Acht! Oder sie\n",
        "drehen blitzschnell den Spieß herum!\r"
      ]
    },
    {
      "id": "msg_0309_00087",
      "de_DE": [
        "Keiner wechselt so fix und effektiv!\n",
        "Die großen Pokéathlon-Strategen!\r"
      ]
    },
    {
      "id": "msg_0309_00088",
      "de_DE": [
        "Denk daran, du bist nicht allein,\n",
        "und die Konkurrenz schläft nicht!\r"
      ]
    },
    {
      "id": "msg_0309_00089",
      "de_DE": [
        "Vom Ehrgeiz gepackt - darin\n",
        "zeigt sich das wahre Sportlerherz!\r"
      ]
    },
    {
      "id": "msg_0309_00090",
      "de_DE": [
        "Im Wettstreit gestählt - ihre Kraft\n",
        "kommt aus der Kraft ihrer Rivalen!\r"
      ]
    },
    {
      "id": "msg_0309_00091",
      "de_DE": [
        "Zahlreiche Rivalen in zahllosen Kämpfen!\n",
        "Nur ihre Freundschaft ist unbezahlbar!\r"
      ]
    },
    {
      "id": "msg_0309_00092",
      "de_DE": [
        "Ihre Gegner waren hart,\n",
        "aber sie sind härter!\r"
      ]
    },
    {
      "id": "msg_0309_00093",
      "de_DE": [
        "Es gibt immer jemanden, der besser ist.\n",
        "Doch sie haben’s ihnen gezeigt!\r"
      ]
    },
    {
      "id": "msg_0309_00094",
      "de_DE": [
        "Verlieren? Das wäre ja noch schöner!\n",
        "Sie haben es allen gezeigt!\r"
      ]
    },
    {
      "id": "msg_0309_00095",
      "de_DE": [
        "Sie sind ständig auf der Suche nach\n",
        "dem Stärksten - um ihn zu besiegen!\r"
      ]
    },
    {
      "id": "msg_0309_00096",
      "de_DE": [
        "Die Zahl ihrer Niederlagen beweist ihre\n",
        "Stärke! Sie unterliegen nur den Besten!\r"
      ]
    },
    {
      "id": "msg_0309_00097",
      "de_DE": [
        "Es gibt immer jemanden, der besser ist.\n",
        "Und niemand weiß das besser als sie!\r"
      ]
    },
    {
      "id": "msg_0309_00098",
      "de_DE": [
        "Sie liegen ständig im Wettstreit...\n",
        "Häufig sogar mit sich selbst!\r"
      ]
    },
    {
      "id": "msg_0309_00099",
      "de_DE": [
        "Gewinnen? Verlieren? Das ist ihnen egal!\n",
        "Sie kämpfen nur gegen die Besten!\r"
      ]
    },
    {
      "id": "msg_0309_00100",
      "de_DE": [
        "Noch neu beim Hürdenlauf, aber mit\n",
        "viel Kraft und Elan dabei!\r"
      ]
    },
    {
      "id": "msg_0309_00101",
      "de_DE": [
        "“Zeige mir eine Hürde, und ich zeige\n",
        "dir, wie man springt!” Das Motto von...\r"
      ]
    },
    {
      "id": "msg_0309_00102",
      "de_DE": [
        "Für sie ist kein Hindernis zu schwer!\n",
        "Keine Hürde zu hoch!\r"
      ]
    },
    {
      "id": "msg_0309_00103",
      "de_DE": [
        "Sie nehmen jede Hürde,\n",
        "als wäre sie gar nicht da!\r"
      ]
    },
    {
      "id": "msg_0309_00104",
      "de_DE": [
        "Die geborenen Flaggenträger!\n",
        "Die neuen Herrscher des Strands!\r"
      ]
    },
    {
      "id": "msg_0309_00105",
      "de_DE": [
        "Kein Wimpel ist vor ihnen sicher!\n",
        "Die Helden des Flaggenschnappens!\r"
      ]
    },
    {
      "id": "msg_0309_00106",
      "de_DE": [
        "Der Strand ist ihr Revier! Sie ziehen\n",
        "frei und ungehindert ihre Bahnen!\r"
      ]
    },
    {
      "id": "msg_0309_00107",
      "de_DE": [
        "Keine Flagge, die sie nicht schnappen!\n",
        "Kein Sieg, den sie nicht erringen!\r"
      ]
    },
    {
      "id": "msg_0309_00108",
      "de_DE": [
        "Drücken! Drücken! DRÜCKEN!\n",
        "Macht Platz für die Neuen im Kreis!\r"
      ]
    },
    {
      "id": "msg_0309_00109",
      "de_DE": [
        "Sie haben noch jeden weggeschoben!\n",
        "Sie behaupten sich in jedem Kreis!\r"
      ]
    },
    {
      "id": "msg_0309_00110",
      "de_DE": [
        "Sie drängeln nicht wie alle anderen!\n",
        "Sie drängeln für ihr Leben gerne!\r"
      ]
    },
    {
      "id": "msg_0309_00111",
      "de_DE": [
        "Fühlt ihr, wie die Luft schwerer wird?\n",
        "Schon ihr Blick plättet ganze Reihen!\r"
      ]
    },
    {
      "id": "msg_0309_00112",
      "de_DE": [
        "Zack, zack, zack! Ihre Handkanten\n",
        "warten nur auf einen Ziegel!\r"
      ]
    },
    {
      "id": "msg_0309_00113",
      "de_DE": [
        "Sie kriegen alles klein!\n",
        "Die großen Brecher des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00114",
      "de_DE": [
        "Sie brechen auch durch\n",
        "die dickste Wand!\r"
      ]
    },
    {
      "id": "msg_0309_00115",
      "de_DE": [
        "Aus ihren zerbröselten Ziegeln\n",
        "entstanden schon ganze Gebirge!\r"
      ]
    },
    {
      "id": "msg_0309_00116",
      "de_DE": [
        "Der Diskus kam geflogen, sie griffen\n",
        "danach... der Rest ist Geschichte!\r"
      ]
    },
    {
      "id": "msg_0309_00117",
      "de_DE": [
        "Jeder Griff nach dem Diskus\n",
        "ist ein Griff nach den Sternen!\r"
      ]
    },
    {
      "id": "msg_0309_00118",
      "de_DE": [
        "Jeder Diskus, den sie fangen, bringt\n",
        "sie näher an ihren großen Traum!\r"
      ]
    },
    {
      "id": "msg_0309_00119",
      "de_DE": [
        "Sie schnappen sich jeden Diskus!\n",
        "Sie schnappen sie sich alle!\r"
      ]
    },
    {
      "id": "msg_0309_00120",
      "de_DE": [
        "Geschwind wie der Wind!\n",
        "Leicht wie eine Wolke!\r"
      ]
    },
    {
      "id": "msg_0309_00121",
      "de_DE": [
        "Sie springen hoch, hoch in den Himmel!\n",
        "Sie kennen keine Schwerkraft!\r"
      ]
    },
    {
      "id": "msg_0309_00122",
      "de_DE": [
        "Sie lesen den Wind wie ein Buch! Die\n",
        "großen Himmelsstürmer des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00123",
      "de_DE": [
        "Himmel und Erde - für\n",
        "sie sind beide eins!!!\r"
      ]
    },
    {
      "id": "msg_0309_00124",
      "de_DE": [
        "Sie kann niemand mehr aufhalten!\n",
        "Denn sie wurden geboren, um zu laufen!\r"
      ]
    },
    {
      "id": "msg_0309_00125",
      "de_DE": [
        "Sie kennen keine Müdigkeit -\n",
        "dieses Team steht niemals still!\r"
      ]
    },
    {
      "id": "msg_0309_00126",
      "de_DE": [
        "Sie laufen, laufen und laufen! Sie sind\n",
        "das Perpetuum mobile des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00127",
      "de_DE": [
        "Ihr Motor ist ihre Freundschaft!\n",
        "Ihr Kraftstoff ist der Sieg!\r"
      ]
    },
    {
      "id": "msg_0309_00128",
      "de_DE": [
        "Sie sind nicht nur eine, sie haben Wucht!\n",
        "Dieses Team bringt Bewegung in den Ring!\r"
      ]
    },
    {
      "id": "msg_0309_00129",
      "de_DE": [
        "Sie ruhen nicht, bis auch der letzte\n",
        "Gegner aus dem Ring verschwunden ist!\r"
      ]
    },
    {
      "id": "msg_0309_00130",
      "de_DE": [
        "Dieser Ring ist ihr Revier!\n",
        "Betreten nur auf eigene Gefahr!\r"
      ]
    },
    {
      "id": "msg_0309_00131",
      "de_DE": [
        "Dieses Team kennt sich selbst! Denn nur\n",
        "der Ring zeigt dir, wer du wirklich bist!\r"
      ]
    },
    {
      "id": "msg_0309_00132",
      "de_DE": [
        "Niemandes Bälle fliegen so schön!\n",
        "Sie müssen nur noch treffen lernen!\r"
      ]
    },
    {
      "id": "msg_0309_00133",
      "de_DE": [
        "Jeder Wurf ein Treffer!\n",
        "... In die Visagen ihrer Gegner!\r"
      ]
    },
    {
      "id": "msg_0309_00134",
      "de_DE": [
        "Ihre Bälle mähen alles nieder! Man\n",
        "nennt sie auch “Den weißen Tornado”!\r"
      ]
    },
    {
      "id": "msg_0309_00135",
      "de_DE": [
        "Ihre Bälle kommen von überall her!\n",
        "Die lebende Lawine des Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00136",
      "de_DE": [
        "Ihre Bälle sind unaufhaltbar!\n",
        "Ein Tor ist nur eine Frage der Zeit!\r"
      ]
    },
    {
      "id": "msg_0309_00137",
      "de_DE": [
        "Mit ihrer grandiosen Teamarbeit\n",
        "erstürmen sie jedes Tor!\r"
      ]
    },
    {
      "id": "msg_0309_00138",
      "de_DE": [
        "Ihre Beinarbeit ist legendär!\n",
        "Gemeinsam schießen sie sich zum Sieg!\r"
      ]
    },
    {
      "id": "msg_0309_00139",
      "de_DE": [
        "Ihr Leben dreht sich nicht nur\n",
        "um den Ball! Sie SIND der Ball!\r"
      ]
    },
    {
      "id": "msg_0309_00140",
      "de_DE": [
        "Das freigiebigste Team von allen, denn\n",
        "es verschenkt sogar Punkte!\r"
      ]
    },
    {
      "id": "msg_0309_00141",
      "de_DE": [
        "Geht etwas schief, dann lächele wie sie!\n",
        "Sieg ist nicht alles beim Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00142",
      "de_DE": [
        "Sie treffen jedes Tor -\n",
        "auch wenn’s das eigene ist!\r"
      ]
    },
    {
      "id": "msg_0309_00143",
      "de_DE": [
        "Ihr Team ist unzertrennlich - und jedes\n",
        "Eigentor ein Beweis ihrer Freundschaft!\r"
      ]
    },
    {
      "id": "msg_0309_00144",
      "de_DE": [
        "Sie tun alles, um aufzufallen! Sieg ist\n",
        "eben nicht alles beim Pokéathlon!\r"
      ]
    },
    {
      "id": "msg_0309_00145",
      "de_DE": [
        "Da sind sie wieder! Unser Lieblingsteam!\n",
        "Autogramme gibt’s erst hinterher!\r"
      ]
    },
    {
      "id": "msg_0309_00146",
      "de_DE": [
        "Ihr wollt sie siegen sehen?\n",
        "Das sollt ihr haben!\r"
      ]
    },
    {
      "id": "msg_0309_00147",
      "de_DE": [
        "Die Quelle ihres Siegeswillens\n",
        "ist die Freude ihrer Fans!\r"
      ]
    },
