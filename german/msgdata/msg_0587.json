{
  "key": 25702,
  "messages": [
    {
      "id": "msg_0587_00000",
      "de_DE": [
        "Es fahren keine Züge mehr!\r",
        "Ich könnte alle Fahrgäste Huckepack\n",
        "nehmen und sie auf meinem Rücken...\r",
        "Aber wenn ich’s mir genau überlege...\n",
        "Nein, besser doch nicht."
      ]
    },
    {
      "id": "msg_0587_00001",
      "de_DE": [
        "Der Magnetzug hat endlich wieder\n",
        "seinen Dienst aufgenommen!\r",
        "Alle Reisenden werden gebeten, ihren\n",
        "Fahrschein hier am Eingang\f",
        "elektronisch überprüfen zu lassen...\r"
      ]
    },
    {
      "id": "msg_0587_00002",
      "de_DE": [
        "...Fiiiep!\r",
        "Es tut mir sehr leid, aber ohne ein\n",
        "Magnetticket kannst du nicht\f",
        "mit dem Magnetzug fahren...\r"
      ]
    },
    {
      "id": "msg_0587_00003",
      "de_DE": [
        "Alle Reisenden werden gebeten, ihr\n",
        "Magnetticket hier am Eingang\f",
        "elektronisch überprüfen zu lassen...\r"
      ]
    },
    {
      "id": "msg_0587_00004",
      "de_DE": [
        "...Ratter, ratter, tsching! Danke, hier\n",
        "hast du deinen Fahrschein wieder!\r",
        "Der Magnetzug nach Saffronia City wird\n",
        "in wenigen Augenblicken abfahren!"
      ]
    },
    {
      "id": "msg_0587_00005",
      "de_DE": [
        "Viel Spaß auf deiner magnetisch\n",
        "magischen Zugreise!"
      ]
    },
    {
      "id": "msg_0587_00006",
      "de_DE": [
        "Dukatia City! Dukatia City!\n",
        "Mit langgezogenem “A”!"
      ]
    },
    {
      "id": "msg_0587_00007",
      "de_DE": [
        "Viel Spaß auf deiner magnetisch-\n",
        "magischen Zugreise!\r"
      ]
    },
    {
      "id": "msg_0587_00008",
      "de_DE": [
        "Ich bin der Präsident.\r",
        "Mein Traum war es, einen Zug zu bauen,\n",
        "der schneller ist als jedes Pokémon.\r",
        "Ich wollte, dass Johto und Kanto enger\n",
        "zusammenwachsen!"
      ]
    },
    {
      "id": "msg_0587_00009",
      "de_DE": [
        "Eine Bitte an unsere Fahrgäste:\n",
        "Im Inneren des Bahnhofs sollten\f",
        "Pokémon, wenn möglich, nicht frei\f",
        "laufengelassen werden, um zu\f",
        "gewährleisten, dass alle unsere\f",
        "Gäste eine ungestörte Reise\f",
        "genießen können."
      ]
    }
  ]
}
