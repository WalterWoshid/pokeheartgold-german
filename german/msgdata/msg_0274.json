    {
      "id": "msg_0274_00046",
      "de_DE": [
        "Gehe bald mal wieder auf Erkundungs-\n",
        "tour. Es gibt noch viel zu entdecken!\r"
      ]
    },
    {
      "id": "msg_0274_00047",
      "de_DE": [
        "Lege Pokémon in deinem Pokéwalker ab\n",
        "und wandere mit ihnen durch die Welt!\r"
      ]
    },
    {
      "id": "msg_0274_00048",
      "de_DE": [
        "... ... ... ... ... ...\n",
