  "messages": [
    {
      "id": "msg_0274_00000",
      "de_DE": [
        "Willkommen!\r",
        "Hier kannst du Pokémon\n",
        "aus deiner PC-Box auswählen,\f",
        "sie in den Pokéwalker übertragen\r",
        "und dann gemeinsam mit ihnen\n",
        "einen Ausflug machen!\r"
      ]
    },
    {
      "id": "msg_0274_00001",
      "de_DE": [
        "Wähle ein Pokémon, das mit\n",
        "dir wandern gehen soll."
      ]
    },
    {
      "id": "msg_0274_00002",
      "de_DE": [
        "Empfange ausgeführtes \n",
        "Pokémon oder Geschenke."
      ]
    },
    {
      "id": "msg_0274_00003",
      "de_DE": [
        "Achtung!\r",
        "Diese Funktion löscht alle auf dem\n",
        "Pokéwalker gespeicherten Daten.\f",
        "Bitte überprüfe die auf dem Pokéwalker\f",
        "vorhandenen Informationen,\f",
        "bevor du sie löschst!\r",
        "Mit dem Pokéwalker ausgeführte Pokémon\n",
        "kehren zwar zu dir zurück,\r",
        "andere Daten werden\n",
        "jedoch unwiderruflich gelöscht.\r",
        "Möchtest du dennoch mit\n",
        "dem Löschen fortfahren?"
      ]
    },
    {
      "id": "msg_0274_00004",
      "de_DE": [
        "Daten auf dem Pokéwalker\n",
        "werden gelöscht."
      ]
    },
    {
      "id": "msg_0274_00005",
      "de_DE": [
        "Auf die DS-Karte richten\n",
        "und “VERBINDEN” wählen."
      ]
    },
    {
      "id": "msg_0274_00006",
      "de_DE": [
        "Verbinde mit Pokéwalker...\n",
        "Bitte einen Moment Geduld."
      ]
    },
    {
      "id": "msg_0274_00007",
      "de_DE": [
        "Bitte richte den Pokéwalker\n",
        "auf die DS-Karte,\r",
        "drücke den Knopf und\n",
        "warte 5 Sekunden lang."
      ]
    },
    {
      "id": "msg_0274_00008",
      "de_DE": [
        "Nimm deine Pokémon mit auf\n",
        "einen Pokéwalker-Ausflug."
      ]
    },
    {
      "id": "msg_0274_00009",
      "de_DE": [
        "Soll die Schrittzahl aus dem\n",
        "Pokéwalker ausgelesen werden?"
      ]
    },
    {
      "id": "msg_0274_00010",
      "garbage": 21
    },
    {
      "id": "msg_0274_00011",
      "de_DE": [
        "Wähle ein Pokémon aus\n",
        "einer deiner PC-Boxen.\r"
      ]
    },
    {
      "id": "msg_0274_00012",
      "de_DE": "Bitte wähle eine Route.\r"
    },
    {
      "id": "msg_0274_00013",
      "de_DE": [
        "Spielstand wird gespeichert...\n",
        "Bitte schalte das System nicht aus."
      ]
    },
