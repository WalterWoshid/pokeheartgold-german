    {
      "id": "msg_0274_00119",
      "de_DE": [
        "Eine sattgrüne Wiese, wie\n",
        "gemacht für einen Ausflug. Hier\n",
        "findest du allerlei Pokémon."
      ]
    },
    {
      "id": "msg_0274_00120",
      "de_DE": [
        "Ein großer, naturbelassener\n",
        "Wald. Unter den hohen Wipfeln\n",
        "hausen viele Pokémon."
      ]
    },
    {
      "id": "msg_0274_00121",
      "de_DE": [
        "Ein holpriger Bergpfad mit vielen\n",
        "steilen Strecken. Von hoch oben\n",
        "hat man eine tolle Aussicht."
      ]
    },
    {
      "id": "msg_0274_00122",
      "de_DE": [
        "Ihre Schönheit macht sie als\n",
        "Ausflugsziel sehr beliebt. Hier\n",
        "triffst du viele Wasser-Pokémon."
      ]
    },
    {
      "id": "msg_0274_00123",
      "de_DE": [
        "Du wirst erstaunt sein, wie viele\n",
        "Pokémon sich in einem typischen\n",
        "Wohngebiet aufstöbern lassen!"
      ]
    },
    {
      "id": "msg_0274_00124",
      "de_DE": [
        "Ein aufmerksamer Wanderer\n",
        "entdeckt auch in dunklen Höhlen\n",
        "Pokémon! Bist du mutig genug?"
      ]
    },
    {
      "id": "msg_0274_00125",
      "de_DE": [
        "Ein See mit tiefblauem Wasser.\n",
        "Es heißt, auf seinem Grund leben\n",
        "viele seltene Pokémon."
      ]
    },
    {
      "id": "msg_0274_00126",
      "de_DE": [
        "Wo die Menschen der Vorstadt\n",
        "den Rücken kehrten, bietet sie\n",
        "Pokémon ein neues Zuhause."
      ]
    },
    {
      "id": "msg_0274_00127",
      "de_DE": [
        "Diese Route führt dich bis in die\n",
        "weit entfernte Hoenn-Region\n",
        "voller exotischer Pokémon!"
      ]
    },
    {
      "id": "msg_0274_00128",
      "de_DE": [
        "Irgendwo in Hoenn liegt dieser\n",
        "sonnige Strand. Auf ihm tummeln\n",
        "sich viele unbekannte Pokémon."
      ]
    },
    {
      "id": "msg_0274_00129",
      "de_DE": [
        "Dieser Pfad führt an einem\n",
        "aktiven Vulkan vorbei. Seine\n",
        "Hitze zieht seltene Pokémon an."
      ]
    },
    {
      "id": "msg_0274_00130",
      "de_DE": [
        "Ein Teil des Waldes wurde im Ein-\n",
        "klang mit der Natur gestaltet.\n",
        "Hier leben besondere Pokémon."
      ]
    },
    {
      "id": "msg_0274_00131",
      "de_DE": [
        "Aus der Finsternis dieser Höhle\n",
        "ertönt ein fernes Geräusch. Man\n",
        "sagt, hier lebten viele Pokémon."
      ]
    },
    {
      "id": "msg_0274_00132",
      "de_DE": [
        "Hier kannst du die ferne Sinnoh-\n",
        "Region erkunden und dort viele\n",
        "seltene Pokémon fangen."
      ]
    },
    {
      "id": "msg_0274_00133",
      "de_DE": [
        "Eine Tour auf diesem steilen,\n",
        "schneeverwehten Pfad testet\n",
        "das Vertrauen deiner Pokémon!"
      ]
    },
    {
      "id": "msg_0274_00134",
      "de_DE": [
        "Ein Wald voller riesiger,\n",
        "uralter Bäume. Er beherbergt\n",
        "zahlreiche Pokémon."
      ]
    },
    {
      "id": "msg_0274_00135",
      "de_DE": [
        "Dieser See ist stets von dichtem\n",
        "weißen Nebel umgeben, was ihm\n",
        "eine mystische Aura verleiht."
      ]
    },
    {
      "id": "msg_0274_00136",
      "de_DE": [
        "Seltene Pokémon lieben diesen\n",
        "von Wellenbrechern gebeutelten,\n",
        "abgeschiedenen Küstenstreifen."
      ]
    },
    {
      "id": "msg_0274_00137",
      "de_DE": [
        "Ein Ferienziel nur für die oberen\n",
        "Zehntausend, berühmt wegen der\n",
        "vielen zuckersüßen Pokémon."
      ]
    },
    {
      "id": "msg_0274_00138",
      "de_DE": [
        "In dieser menschenleeren\n",
        "Höhle entdeckt das geschulte\n",
        "Auge viele seltene Pokémon."
      ]
    },
    {
      "id": "msg_0274_00139",
      "de_DE": [
        "Weit über dem Meer liegt diese\n",
        "winzige Insel, auf deren schönen\n",
        "Stränden sich Pokémon tummeln."
      ]
    },
    {
      "id": "msg_0274_00140",
      "de_DE": [
        "Eine Wanderung auf dem nacht-\n",
