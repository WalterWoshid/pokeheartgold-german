      "garbage": 65
    },
    {
      "id": "msg_0777_00015",
      "de_DE": [
        "Willkommen auf dem Wi-Fi Plaza!\r",
        "Dies ist der allgemeine Infoschalter.\r"
      ]
    },
    {
      "id": "msg_0777_00016",
      "de_DE": "Worüber möchtest du mehr erfahren?\r"
    },
    {
      "id": "msg_0777_00017",
      "garbage": 86
    },
    {
      "id": "msg_0777_00018",
      "de_DE": [
        "Es gibt einen riesigen Globus in der\n",
        "Nähe des Eingangs zum Wi-Fi Plaza.\r",
        "Der Globus enthält die Gast-Profile und\n",
        "zeigt die Aufenthaltsorte und die Orts-\f",
        "zeiten der Besucher des Wi-Fi Plazas an.\r",
        "Um die Besucher zu sehen, drücke den\n",
        "X-Knopf und betrachte die Konsole.\f",
        "Manchmal schweben auch Ballons vorbei.\r"
      ]
    },
    {
      "id": "msg_0777_00019",
      "de_DE": [
        "Bei den Plaza-Nachrichten handelt es\n",
        "sich um eine elektronische Anzeige,\r",
        "die die Geschehnisse auf dem\n",
        "Wi-Fi Plaza zeigt.\r",
        "Bist du dir nicht sicher, was zu tun ist,\n",
        "überprüfe die Plaza-Nachrichten.\r"
      ]
    },
    {
      "id": "msg_0777_00020",
      "de_DE": [
        "Der Fußabdruck-Stempel ist ein Bedien-\n",
        "feld, an dem du mit den Fußabdrücken\f",
        "deiner Team-Pokémon spielen kannst.\r",
        "Es gibt ein schwarzes und ein weißes\n",
        "Bedienfeld. Such dir ein beliebiges aus.\r"
      ]
    },
    {
      "id": "msg_0777_00021",
      "garbage": 74
    },
    {
      "id": "msg_0777_00022",
      "de_DE": [
        "Wir hoffen, du genießt deine Zeit im Wi-Fi\n",
        "Plaza, bevor dein Zeitlimit abläuft.\r"
      ]
    },
    {
      "id": "msg_0777_00023",
      "de_DE": [
        "Mit Spielzeug kannst du nur\n",
        "auf dem Wi-Fi Plaza spielen.\r",
        "Abgesehen davon kannst du Spielzeug\n",
        "auch mit deinen Freunden teilen.\r",
        "Spielzeug kann durch das Spielen von\n",
        "Plaza-Spielen aufgerüstet werden.\r",
        "Wir hoffen, dass du dich auf deine eigene\n",
        "Art damit vergnügen wirst!\r"
      ]
    },
    {
      "id": "msg_0777_00024",
      "de_DE": [
        "{STRVAR_3 0, 0, 0} ist eines der\n",
        "Plaza-Spiele.\r",
        "Bis zu vier Spieler können teilnehmen.\r",
        "Die Regeln sind einfach: Schnipse Beeren\n",
        "ins Maul eines rotierenden SCHLUKWECH.\r",
        "Der Spieler mit der höchsten Punktzahl\n",
        "erhält eine Spielzeug-Verbesserung.\r"
      ]
    },
    {
      "id": "msg_0777_00025",
      "de_DE": [
        "{STRVAR_3 0, 0, 0} ist eines der\n",
        "Plaza-Spiele.\r",
        "Bis zu vier Spieler können teilnehmen.\r",
        "Die Regeln sind einfach: Rolle einen\n",
        "Ball, damit PANTIMIMI nicht abstürzt.\r",
        "Der Spieler, der PANTIMIMI am längsten\n",
        "auf dem Ball hält, erhält eine\f",
        "Spielzeug-Verbesserung.\r"
      ]
    },
    {
      "id": "msg_0777_00026",
      "de_DE": [
        "{STRVAR_3 0, 0, 0} ist eines der\n",
        "Plaza-Spiele.\r",
        "Bis zu vier Spieler können teilnehmen.\r",
        "Die Regeln sind einfach: Blast Ballons\n",
        "auf, bis sie platzen.\r",
        "Bringt mindestens zehn zum Platzen, und\n",
        "alle Teilnehmer erhalten eine\f",
        "Spielzeug-Verbesserung.\r"
      ]
    },
    {
      "id": "msg_0777_00027",
      "de_DE": [
        "Fällt deine Restzeit auf weniger als die\n",
        "Hälfte, gehen die Scheinwerfer auf dem\f",
        "Wi-Fi Plaza an.\r",
        "Wir hoffen, dir gefällt die andersartige\n",
        "Atmosphäre, die dadurch entsteht.\r"
      ]
    },
    {
      "id": "msg_0777_00028",
      "de_DE": [
        "Wenn dein Zeitlimit fast aufgebraucht\n",
        "ist, erlischt die Beleuchtung.\r",
        "Danach ist überall auf dem Wi-Fi Plaza\n",
        "Feuerwerk zu sehen.\r",
        "Wir hoffen, du genießt das Feuerwerk,\n",
        "wenn sich dein Besuch dem Ende zuneigt.\r"
      ]
    },
    {
      "id": "msg_0777_00029",
      "de_DE": [
        "Ist dein Zeitlimit abgelaufen, tauchen\n",
        "Parade-Flöße aus dem rechten hinteren\f",
        "Teil des Wi-Fi Plazas auf.\r",
        "Diese sehen wie Pokémon aus.\r",
        "Du kannst ein Floß besteigen und zum\n",
        "Pokémon-Center zurückkehren oder\f",
        "Freunde losschicken.\r",
        "Bedenke bitte, dass du nach Betreten\n",
        "eines Floßes nur von Bord kannst,\f",
        "wenn es den Wi-Fi Plaza verlässt.\r",
        "Die Verbindung zur Nintendo WFC wird\n",
        "dann getrennt.\r"
      ]
    },
    {
      "id": "msg_0777_00030",
      "de_DE": [
        "Du kannst an einer Plaza-Umfrage teil-\n",
        "nehmen, indem du die Maschine neben dem\f",
        "allgemeinen Infoschalter verwendest.\r",
        "Um genauere Informationen zu erhalten,\n",
        "wende dich bitte an den Bediensteten\f",
        "neben dem Monitor.\r"
      ]
    },
