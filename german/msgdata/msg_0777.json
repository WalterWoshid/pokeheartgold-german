  "messages": [
    {
      "id": "msg_0777_00000",
      "de_DE": [
        "Willkommen auf dem Wi-Fi Plaza!\r",
        "Jedem Gast wird ein Spielzeug geliehen.\n",
        "Hier ist deins!\r"
      ]
    },
    {
      "id": "msg_0777_00001",
      "de_DE": "{STRVAR_1 3, 0, 0} erhielt {STRVAR_3 2, 1, 0}!"
    },
    {
      "id": "msg_0777_00002",
      "de_DE": [
        "Ich hoffe, du genießt deinen\n",
        "Aufenthalt bis zum Ende.\r"
      ]
    },
    {
      "id": "msg_0777_00003",
      "de_DE": [
        "Dein Aufenthalt auf dem Wi-Fi Plaza\n",
        "ist fast vorbei.\r",
        "Danke für deinen Besuch.\n",
        "Besuche uns bitte bald wieder!\r"
      ]
    },
    {
      "id": "msg_0777_00004",
      "de_DE": [
        "Übrigens, für welchen Typ hast\n",
        "du dich heute entschieden?\r",
        "Wenn du möchtest, kannst du\n",
        "dich auf zwei Typen festlegen.\r"
      ]
    },
    {
      "id": "msg_0777_00005",
      "de_DE": "Wie lautet dein erster Typ für heute?"
    },
    {
      "id": "msg_0777_00006",
      "de_DE": "{STRVAR_1 15, 0, 0}"
    },
    {
      "id": "msg_0777_00007",
      "de_DE": "Keine Auswahl"
    },
    {
      "id": "msg_0777_00008",
      "de_DE": "Deine Wahl lautet also {STRVAR_1 15, 0, 0}-Typ?"
    },
    {
      "id": "msg_0777_00009",
      "garbage": 16
    },
    {
      "id": "msg_0777_00010",
      "de_DE": "Wie lautet dein zweiter Typ für heute?"
    },
    {
      "id": "msg_0777_00011",
      "de_DE": [
        "Verstehe! Du hast dich also für die\n",
        "Typen {STRVAR_1 15, 0, 0} und {STRVAR_1 15, 1, 0} entschieden.\r"
      ]
    },
    {
      "id": "msg_0777_00012",
      "de_DE": [
        "Verstehe! Du hast dich also für\n",
        "den Typ {STRVAR_1 15, 0, 0} entschieden.\r"
      ]
    },
    {
      "id": "msg_0777_00013",
      "garbage": 21
    },
    {
