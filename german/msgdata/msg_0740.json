{
  "key": 17171,
  "messages": [
    {
      "id": "msg_0740_00000",
      "de_DE": [
        "Der störende Felsbrocken wurde\n",
        "beseitigt, aber bis der Erdboden\f",
        "geebnet und begehbar gemacht\f",
        "werden kann, dauert es noch..."
      ]
    },
    {
      "id": "msg_0740_00001",
      "de_DE": [
        "Die Planierarbeiten sind endlich fertig!\r",
        "Jetzt kann ich wieder angeln gehen!"
      ]
    },
    {
      "id": "msg_0740_00002",
      "de_DE": [
        "Hier kommst du nicht weiter, weil hier\n",
        "gerade Planierarbeiten im Gange sind.\f",
        "Um zur Zinnoberinsel zu gelangen, musst\f",
        "du den Umweg über Alabastia machen."
      ]
    },
    {
      "id": "msg_0740_00003",
      "de_DE": [
        "Ich habe so viel geschwitzt,\n",
        "dass jetzt ein paar Runden im\f",
        "Wasser sicher nicht verkehrt wären."
      ]
    },
    {
      "id": "msg_0740_00004",
      "de_DE": [
        "Route 19\n",
        "Süden: Die Seeschauminseln"
      ]
    },
    {
      "id": "msg_0740_00005",
      "de_DE": [
        "Da ist ein Flugblatt...\r",
        "Wer vorhat, zu den Seeschauminseln\n",
        "hinauszuschwimmen, wird gebeten,\f",
        "äußerst vorsichtig zu sein!\f",
        "- Das Ordnungsamt von Fuchsania City"
      ]
    }
  ]
}
