    },
    {
      "id": "msg_0100_00034",
      "de_DE": [
        "Duellturm\n",
        "Nur nicht verlieren!"
      ]
    },
    {
      "id": "msg_0100_00035",
      "de_DE": [
        "Kampfsaal\n",
        "Jedem Pokémon eine Chance"
      ]
    },
    {
      "id": "msg_0100_00036",
      "de_DE": [
        "Kampfpalais\n",
        "Kämpfe mit Palaispunkten bestreiten"
      ]
    },
    {
      "id": "msg_0100_00037",
      "de_DE": [
        "Kampfarkaden\n",
        "Das Ergebnis bleibt ungewiss!"
      ]
    },
    {
      "id": "msg_0100_00038",
      "de_DE": [
        "Kampffabrik\n",
        "Führe Leih-Pokémon in den Kampf"
      ]
    },
    {
      "id": "msg_0100_00039",
      "de_DE": [
        "Die Statue symbolisiert einen Trainer,\n",
        "der soeben ein Pokémon gefangen hat."
      ]
    },
    {
      "id": "msg_0100_00040",
      "de_DE": [
        "“Ruhmvoller Fang”...\n",
        "Das ist wohl der Titel des Werks."
      ]
    },
    {
      "id": "msg_0100_00041",
      "de_DE": [
        "Toll! Eine maßstabsgetreue\n",
        "Miniatur der Kampfzone."
      ]
    }
  ]
}
