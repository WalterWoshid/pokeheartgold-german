{
  "key": 53165,
  "messages": [
    {
      "id": "msg_0656_00000",
      "de_DE": "Hartwig"
    },
    {
      "id": "msg_0656_00001",
      "de_DE": [
        "Was? Ich versteh dich kaum!\n",
        "Das wird wohl an der Verbindung liegen!\r",
        "Ruf mal von woanders an!"
      ]
    },
    {
      "id": "msg_0656_00002",
      "de_DE": [
        "HALLO?\n",
        "SORRY, DASS ICH SO LAUT SPRECHE!\r",
        "BEI MIR IST ALLES IM LOT!\r"
      ]
    },
    {
      "id": "msg_0656_00003",
      "de_DE": [
        "Es gibt außer mir noch viele andere\n",
        "starke Arenaleiter!\f",
        "Kopf hoch! Du schaffst das!"
      ]
    },
    {
      "id": "msg_0656_00004",
      "de_DE": [
        "Für mich wäre Mittwochabend ideal.\n",
        "Ich warte dann auf deinen Anruf!"
      ]
    },
    {
      "id": "msg_0656_00005",
      "de_DE": [
        "Wenn das kein Zufall ist!\n",
        "Mein Training ist gerade vorbei!\f",
        "Na? Hast du Lust auf ein Rematch? {YESNO 0}"
      ]
    },
    {
      "id": "msg_0656_00006",
      "de_DE": [
        "Klasse!!!\r",
        "Ich warte dann auf dich im Dojo von\n",
        "Saffronia City!"
      ]
    },
    {
      "id": "msg_0656_00007",
      "de_DE": [
        "Waaas?\n",
        "Mensch, das ist echt schade!"
      ]
    },
    {
      "id": "msg_0656_00008",
      "de_DE": [
        "Hast du denn überhaupt Zeit, um gegen\n",
        "mich zu kämpfen?\r",
        "Oder hast du vielleicht schon anderen\n",
        "vor mir ein Rematch versprochen?"
      ]
    },
    {
      "id": "msg_0656_00009",
      "de_DE": [
        "Dann treffen wir uns also im Dojo von\n",
        "Saffronia City!\f",
        "Ich verlass mich auf dich!"
      ]
    },
    {
      "id": "msg_0656_00010",
      "de_DE": [
        "Hi, ich bin’s, Hartwig!\n",
        "Na, alles fit bei dir?\r"
      ]
    },
    {
      "id": "msg_0656_00011",
      "de_DE": [
        "Es bleibt dabei, wir treffen uns im Dojo\n",
        "von Saffronia City zum Rematch!\f",
        "Wehe, du versetzt mich!"
      ]
    },
    {
      "id": "msg_0656_00012",
      "de_DE": [
        "Wie du weißt, trainiere ich ja tagein,\n",
        "tagaus unter dem Wasserfall.\r",
        "Meine Frau ist darauf natürlich gar\n",
        "nicht gut zu sprechen!\r",
        "Als kleine Entschädigung möchte ich mit\n",
        "ihr irgendwohin verreisen...\f",
        "Aber wohin nur?\r",
        "Aber natürlich! Zu den Tohjo-Fällen!"
      ]
    },
    {
      "id": "msg_0656_00013",
      "de_DE": [
        "Versprich mir, dass du das für dich\n",
        "behältst, ja?\r",
        "Ich habe eine Schwäche für Süßes...\n",
        "Nach dem Training esse ich immer heimlich\f",
        "Süßigkeiten, aber meine Frau darf das\f",
        "auf keinen Fall erfahren!\r",
        "Ich habe auch schon etwas Hüftgold\n",
        "angesetzt...\r",
        "Aber das bleibt unter uns, ja? Sag es\n",
        "bloß nicht meiner Frau!"
      ]
    },
    {
      "id": "msg_0656_00014",
      "de_DE": [
        "In letzter Zeit gibt es einige Probleme\n",
        "mit der Technik des Wasserfalls in\f",
        "meiner Are... blubber! Platsch! \r",
        "Pschhhhhhhhhhhhhhhhhhhhhhhhhhhh\n",
        "hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh\f",
        "hhhhhhhhhh!!!\r",
        "Entschuldige bitte! Die Technik ist\n",
        "jetzt völlig im Eimer und ich bin\f",
        "klitschnass!\r",
        "Ich rufe dich später wieder an, wenn\n",
        "sich alles beruhigt hat!"
      ]
    }
  ]
}
