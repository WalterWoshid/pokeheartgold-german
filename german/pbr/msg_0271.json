      "id": "msg_0271_00004",
      "de_DE": [
        "Eibe: Ah, {STRVAR_1 3, 0}!\n",
        "Welch ausgezeichnetes Timing!\r",
        "Team Galaktik, diese Schurken,\n",
        "suchen das Legendäre Pokémon!\r",
        "Du musst Lucia helfen!"
      ]
    },
    {
      "id": "msg_0271_00005",
      "de_DE": [
        "Eibe: Ah, {STRVAR_1 3, 0}!\n",
        "Welch ausgezeichnetes Timing!\r",
        "Team Galaktik, diese Schurken,\n",
        "suchen das Legendäre Pokémon!\r",
        "{STRVAR_1 3, 0}, hilf uns bitte.\n",
        "Du musst Lucius helfen!"
      ]
    },
    {
      "id": "msg_0271_00006",
      "de_DE": [
        "Eibe: Wie könnt ihr es wagen!\n",
        "Ihr elenden Schurken!\r"
      ]
    },
    {
      "id": "msg_0271_00007",
      "de_DE": [
        "{STRVAR_1 3, 0}!\n",
        "Lucia braucht deine Hilfe!"
      ]
    },
    {
      "id": "msg_0271_00008",
      "de_DE": [
        "Eibe: Wie könnt ihr es wagen!\n",
        "Ihr elenden Schurken!\r"
      ]
    },
    {
      "id": "msg_0271_00009",
      "de_DE": [
        "{STRVAR_1 3, 0}!\n",
        "Lucius braucht deine Hilfe!"
      ]
    },
    {
      "id": "msg_0271_00010",
      "de_DE": [
        "Au! Aua!\n",
        "Was hat der alte Knacker nur?"
      ]
    },
    {
      "id": "msg_0271_00011",
      "de_DE": [
        "Lucia: {STRVAR_1 3, 0}!\n",
        "Das ist ja das T-team G-galaktik!\f",
        "Sie haben das Pokémon aus dem See..."
      ]
    },
    {
      "id": "msg_0271_00012",
      "de_DE": [
        "Lucius: Das ist Team Galaktik!\r",
        "Sie haben das Pokémon\n",
        "aus dem See entführt..."
      ]
    },
    {
      "id": "msg_0271_00013",
      "de_DE": [
        "Mars: Dieses Gesicht...!\n",
        "Es weckt schlimme Erinnerungen!\r",
        "Ich meine das, was beim\n",
        "Windkraftwerk vorgefallen ist!\r",
        "Wegen dieses kleinen Vorfalls habe ich\n",
        "’ne ganze Menge Ärger gekriegt.\r",
        "Was machst du für ein Gesicht?\n",
        "Du erinnerst dich doch an mich?\r",
        "Schön, was soll’s auch?\n",
        "Ich sage dir, wer ich bin!\r",
        "Ich bin Mars, Commander vom Team\n",
        "Galaktik, zumindest einer von ihnen.\r",
        "Was stellt ihr dar? Irgend so ein\n",
        "Liebespärchen, das zur Hilfe eilt?\r",
        "Keine Chance! Nicht die geringste!\n",
        "Ihr werdet alle zu Grunde gehen!\r"
      ]
    },
    {
      "id": "msg_0271_00014",
      "de_DE": [
        "Ich habe schon wieder verloren...\r",
        "Zuerst beim Windkraftwerk, und jetzt\n",
        "am See der Wahrheit, das büßt du mir!\r",
        "Einem Commander vom Team Galaktik\n",
        "sollte so ein Missgeschick nicht\f",
        "passieren...\r",
        "...Ruhig jetzt, Mars...\n",
        "Meinen Part habe ich immerhin erledigt...\r",
        "Meine Mission war es, das Pokémon aus\n",
        "dem See zum Hauptquartier zu bringen...\r",
        "...Stimmt! Ich habe meine Mission\n",
        "ohne Probleme erfüllt, haha!\r"
      ]
    },
    {
      "id": "msg_0271_00015",
      "de_DE": [
        "Leute! Wir ziehen uns zurück!\n",
        "Der Boss wartet im Hauptquartier!\r"
      ]
    },
    {
      "id": "msg_0271_00016",
      "de_DE": [
        "Irgendwie sind die Pokémon der\n",
        "drei Seen miteinander verbunden.\r",
        "Dank Saturns großartiger Leistung\n",
        "erschien hier eine Höhle.\r",
        "In just dieser Höhle schlief\n",
        "das Pokémon VESPRIT.\r",
        "VESPRIT ist vermutlich aufgetaucht,\n",
        "um den Seinen zu helfen.\r",
        "Das hat perfekt gepasst.\n",
        "Und einfach zu fangen war es auch.\r",
        "Ha, und jetzt haben wir sie alle:\n",
        "VESPRIT, “Das fühlende Wesen”,\f",
        "TOBUTZ, “Das starke Wesen”,\f",
        "SELFE, “Das wissende Wesen”.\r",
        "Jetzt, da wir sie alle in\n",
        "unserer Gewalt haben...\r",
        "Ihr könnt euch gar nicht vorstellen,\n",
        "was Team Galaktik für euch\f",
        "vorbereitet!\r"
      ]
    },
    {
      "id": "msg_0271_00017",
      "de_DE": [
        "Eibe: Jetzt verstehe ich... Das ist\n",
        "auch am See der Kühnheit geschehen...\r",
        "Ein weiteres Legendäres Pokémon wurde\n",
        "vom Team Galaktik entführt...\r",
        "Ihr beide habt es mit einer Gruppe von\n",
        "skrupellosen Kriminellen aufgenommen.\r",
        "Allein, dass ihr unbeschadet\n",
        "davongekommen seid, ist eine Freude.\r",
        "...Was ist aber mit dem See der Stärke?\n",
        "Ist {STRVAR_1 3, 0} in Sicherheit?"
      ]
    },
    {
      "id": "msg_0271_00018",
      "de_DE": [
        "Eibe: {STRVAR_1 3, 0}, du musst dich\n",
        "sofort zum See der Stärke begeben.\r",
        "Ich mache mir Sorgen um {STRVAR_1 3, 1}."
      ]
    },
    {
      "id": "msg_0271_00019",
      "de_DE": [
        "Lucia: {STRVAR_1 3, 0}, was führt\n",
        "Team Galaktik im Schilde?\r",
        "Hoffentlich passiert den Pokémon, die\n",
        "aus den Seen entführt wurden, nichts."
      ]
    },
    {
      "id": "msg_0271_00020",
      "de_DE": [
        "Lucius: {STRVAR_1 3, 0}, was führt\n",
        "Team Galaktik im Schilde?\r",
        "Wehe, sie tun den Pokémon weh,\n",
        "die sie aus den Seen entführt haben..."
      ]
    }
  ]
}
