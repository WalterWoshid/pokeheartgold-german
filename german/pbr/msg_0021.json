{
  "key": 11187,
  "messages": [
    {
      "id": "msg_0021_00000",
      "de_DE": [
        "Wusstest du, dass Pokémon sich nach\n",
        "Typen unterscheiden?\f",
        "Wie Wasser, Feuer oder Pflanze?\r",
        "Man sagt, diese Typen haben Vorteile\n",
        "und Nachteile gegenüber anderen Typen."
      ]
    },
    {
      "id": "msg_0021_00001",
      "de_DE": [
        "Oben befindet sich der Konnex-Klub.\r",
        "Dort kannst du mit anderen Leuten\n",
        "chatten und tauschen.\r",
        "Aber das ist noch längst nicht alles!\n",
        "Sieh dich dort unbedingt mal um!"
      ]
    },
    {
      "id": "msg_0021_00002",
      "de_DE": [
        "Auch wenn dich bereits sechs Pokémon\n",
        "begleiten, kannst du weitere fangen.\r",
        "Sie werden automatisch an deinen PC\n",
        "gesendet, auf den du in jedem\f",
        "Pokémon-Center Zugriff hast.\r",
        "Man kann unglaublich viele\n",
        "Pokémon fangen.\r",
        "Und es macht jedes Mal Spaß,\n",
        "den PC in einem Pokémon-Center\f",
        "zu überprüfen."
      ]
    }
  ]
}
