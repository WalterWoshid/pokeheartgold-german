{
  "key": 1095,
  "messages": [
    {
      "id": "msg_0116_00000",
      "de_DE": [
        "Alle meine Enkel wollen ein\n",
        "eigenes Pokémon.\r",
        "Das wird nicht einfach werden, aber es\n",
        "hebt in jedem Fall die Stimmung."
      ]
    },
    {
      "id": "msg_0116_00001",
      "de_DE": [
        "Nein, nein. In diesem Haus gibt es keine\n",
        "Treppen. So ist es schöner.\r",
        "Ohne Treppen können sich die kleinen\n",
        "Pokémon viel freier bewegen."
      ]
    },
    {
      "id": "msg_0116_00002",
      "de_DE": [
        "Eine Welt, in der alle Menschen in\n",
        "Frieden und Harmonie zusammenleben...\r",
        "Das wünsche ich mir."
      ]
    },
    {
      "id": "msg_0116_00003",
      "de_DE": [
        "Herzhofen sei kinderfreundlich, sagen\n",
        "manche. Aber das stimmt nicht ganz.\r",
        "Herzhofen ist freundlich zu Kindern,\n",
        "zu Erwachsenen und zu Pokémon."
      ]
    }
  ]
}
