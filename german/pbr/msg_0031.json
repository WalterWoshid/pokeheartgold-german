{
  "key": 17411,
  "messages": [
    {
      "id": "msg_0031_00000",
      "de_DE": [
        "Hier findest du eine Rangliste der\n",
        "Mitglieder deiner Gruppe.\r",
        "Wenn ich den Rang meiner Gruppenmit-\n",
        "glieder sehe, spornt mich das noch mehr\r",
        "an, denn ich kann doch nicht schlechter\n",
        "als meine Freunde sein!"
      ]
    },
    {
      "id": "msg_0031_00001",
      "de_DE": [
        "Diese Rangliste ist schon praktisch!\r",
        "Ich werde auch eine Gruppe ins Leben\n",
        "rufen und gegen Freunde antreten!"
      ]
    },
    {
      "id": "msg_0031_00002",
      "de_DE": [
        "Tut mir leid, aber ich muss noch die\n",
        "Feineinstellungen für dieses Ding\f",
        "hier vornehmen."
      ]
    }
  ]
}
