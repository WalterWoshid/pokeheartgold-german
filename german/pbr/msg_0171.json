{
  "key": 50179,
  "messages": [
    {
      "id": "msg_0171_00000",
      "de_DE": [
        "Ich mag die Lebhaftigkeit und\n",
        "den Charme meines Mädchens."
      ]
    },
    {
      "id": "msg_0171_00001",
      "de_DE": [
        "Dank dir ist mein Mädchen\n",
        "sehr glücklich."
      ]
    },
    {
      "id": "msg_0171_00002",
      "de_DE": [
        "Du hast nicht zufällig ein\n",
        "Pokémon namens MEDITALIS?\r",
        "Wenn doch, tauschst du das\n",
        "MEDITALIS gegen mein ALPOLLO?"
      ]
    },
    {
      "id": "msg_0171_00003",
      "de_DE": [
        "Haha! Hat sich mein ALPOLLO in etwas\n",
        "anderes verwandelt? Das war ein Witz!\r",
        "Ich habe ihm ein Item zum Tragen\n",
        "gegeben, das eine Entwicklung\f",
        "verhindert.\r",
        "Bitte behandle mein ALPOLLO gut!\n",
        "Ich kümmere mich auch gut um\f",
        "MEDITALIS!"
      ]
    },
    {
      "id": "msg_0171_00004",
      "de_DE": "Ich habe nach einem MEDITALIS gefragt."
    },
    {
      "id": "msg_0171_00005",
      "de_DE": [
        "Es macht nichts, wenn du nicht\n",
        "tauschen willst.\r",
        "Aber wenn du deine Meinung änderst,\n",
        "dann kommst du einfach wieder her, ja?"
      ]
    },
    {
      "id": "msg_0171_00006",
      "de_DE": [
        "Dank der Pokémon sind wir\n",
        "zu Freunden geworden."
      ]
    }
  ]
}
