      ]
    },
    {
      "id": "msg_0482_00003",
      "de_DE": "Sind das die Mitglieder?"
    },
    {
      "id": "msg_0482_00004",
      "de_DE": "Statistiktausch abbrechen?"
    },
    {
      "id": "msg_0482_00005",
      "de_DE": "Statistiktausch wird abgebrochen."
    },
    {
      "id": "msg_0482_00006",
      "de_DE": [
        "Es gibt ein Mitglied, das nicht\n",
        "länger teilnehmen kann."
      ]
    },
    {
      "id": "msg_0482_00007",
      "de_DE": [
        "Es sind keine Mitglieder anwesend.\n",
        "Statistiktausch wird abgebrochen."
      ]
    },
    {
      "id": "msg_0482_00008",
      "de_DE": [
        "Bitte warten...\n",
        "B-Knopf: Abbrechen"
      ]
    },
    {
      "id": "msg_0482_00009",
      "de_DE": [
        "Ein Mitglied kann nicht mehr teilnehmen.\n",
        "Statistiktausch wird abgebrochen."
      ]
    },
    {
      "id": "msg_0482_00010",
      "de_DE": "Statistiktausch abbrechen?"
