    {
      "id": "msg_0468_00000",
      "de_DE": [
        "Ich hatte einen Traum!\n",
        "Einen wunderschönen Traum!\r",
        "Ich habe geträumt, ein Trainer würde\n",
        "mir ein riesiges REMORAID bringen!"
      ]
    },
    {
      "id": "msg_0468_00001",
      "de_DE": [
        "Ich hatte einen Traum!\n",
        "Einen wunderschönen Traum!\r",
        "Ich habe geträumt, ein Trainer würde\n",
        "mir ein riesiges REMORAID bringen!\r",
        "Oh, du meine Güte!\n",
        "Der Traum wird wahr!\r",
        "W-wie groß ist das REMORAID,\n",
        "das du mir bringst?!?"
      ]
    },
    {
      "id": "msg_0468_00002",
      "de_DE": [
        "{STRVAR_1 52, 0},{STRVAR_1 50, 1} cm...\n",
        "Dieses REMORAID ist {STRVAR_1 52, 0},{STRVAR_1 50, 1} cm groß...\r",
        "...Du hast meinen Traum damit sogar\n",
        "noch überflügelt!\r",
        "Hier, ich möchte dir das geben.\r"
      ]
    },
    {
      "id": "msg_0468_00003",
      "de_DE": [
        "Vielen Dank!\n",
        "Du hast mir eine riesige Freude gemacht!\r",
        "Heute Nacht werde ich bestimmt von\n",
        "einem noch größeren REMORAID träumen."
      ]
    },
    {
      "id": "msg_0468_00004",
      "de_DE": [
        "{STRVAR_1 52, 0},{STRVAR_1 50, 1} cm...\n",
        "Erlebe ich gerade ein Déjà-vu? Ich kann\f",
        "mich noch genau an die Größe erinnern!"
      ]
    },
    {
      "id": "msg_0468_00005",
      "de_DE": [
        "Das REMORAID ist {STRVAR_1 52, 0},{STRVAR_1 50, 1} cm groß.\r",
        "Ich kenne ein Genie, das brachte mir ein\n",
        "REMORAID, das war {STRVAR_1 52, 2},{STRVAR_1 50, 3} cm groß..."
      ]
    },
    {
      "id": "msg_0468_00006",
      "de_DE": [
        "W-wa...\n",
        "Was willst du mir da eigentlich zeigen?!?\r",
        "Hast du überhaupt mitbekommen, was\n",
        "ich dir gesagt habe?!?"
      ]
    },
    {
      "id": "msg_0468_00007",
      "de_DE": [
        "Dein Beutel ist proppenvoll...\n",
        "Ich kann dir das nicht geben..."
      ]
    },
    {
      "id": "msg_0468_00008",
      "de_DE": [
        "Oh? Warum willst du nicht, dass\n",
        "ich dein REMORAID messe?!?"
      ]
    }
  ]
