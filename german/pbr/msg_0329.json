{
  "key": 36501,
  "messages": [
    {
      "id": "msg_0329_00000",
      "de_DE": [
        "Hi!\n",
        "Wie geht’s?\r",
        "Du bist in der {STRVAR_1 61, 1}-Gruppe,\n",
        "mit {STRVAR_1 3, 0} als Leiter, oder?\r",
        "Möchtest du diese Gruppe verlassen\n",
        "und einer anderen beitreten?"
      ]
    },
    {
      "id": "msg_0329_00001",
      "de_DE": [
        "Hi!\n",
        "Wie geht’s?\r",
        "Du bist in der {STRVAR_1 61, 1}-Gruppe,\n",
        "mit {STRVAR_1 3, 0} als Leiter, oder?\r",
        "Möchtest du diese Gruppe verlassen\n",
        "und eine neue gründen?"
      ]
    },
    {
      "id": "msg_0329_00002",
      "de_DE": [
        "Hi. Ich weiß, das kommt jetzt ein\n",
        "bisschen plötzlich, aber hast\f",
        "du nicht Interesse an einer Gruppe?\r",
        "In einer Gruppe kannst du dich mit\n",
        "anderen messen und viel Spaß haben.\f",
        "Nun, was meinst du?\r"
      ]
    },
    {
      "id": "msg_0329_00003",
      "de_DE": "Welcher Gruppe möchtest du beitreten?"
    },
    {
      "id": "msg_0329_00004",
      "de_DE": [
        "Oh.\n",
        "Das ist aber schade!"
      ]
    },
    {
      "id": "msg_0329_00005",
      "de_DE": [
        "Oh, du möchtest eine neue\n",
        "Gruppe gründen? Klar doch!\r",
        "Aber die Gruppe, die du vorher\n",
        "gegründet hast, wird sich dann\f",
        "auflösen. Bist du damit einverstanden?"
      ]
    },
    {
      "id": "msg_0329_00006",
      "de_DE": [
        "Yay, coool! Und wie soll deine\n",
        "Gruppe heißen?!?"
      ]
    },
    {
      "id": "msg_0329_00007",
      "de_DE": [
        "{STRVAR_1 61, 0}-Gruppe, ja?\n",
        "Toller Name!\r",
        "Ihr Leiter ist {STRVAR_1 3, 1}.\n",
        "Ich hoffe, die Gruppe bekommt\f",
        "viele Mitglieder!"
      ]
    },
    {
      "id": "msg_0329_00008",
      "de_DE": [
        "Die {STRVAR_1 61, 0}-Gruppe?\n",
        "Der Leiter ist {STRVAR_1 3, 1}.\f",
        "Möchtest du der Gruppe beitreten?"
      ]
    },
    {
      "id": "msg_0329_00009",
      "de_DE": [
        "Gut! {STRVAR_1 3, 0} gehört nun zur\n",
        "{STRVAR_1 61, 1}-Gruppe."
      ]
    },
    {
      "id": "msg_0329_00010",
      "de_DE": [
        "Bildest du eine neue Gruppe oder\n",
        "trittst einer bei, dann solltest du\f",
        "unbedingt den Konnex-Klub besuchen!\r",
        "Dort kannst du Statistiken mit anderen\n",
        "Gruppenmitgliedern tauschen und\f",
        "so gehörst du schon bald richtig dazu.\r",
        "In einer Gruppe können mehrere\n",
        "Ereignisse gleichzeitig stattfinden.\r",
        "Und genau das macht das Spielen\n",
        "in einer Gruppe so lustig und\f",
        "interessant.\r",
        "Jeder kann eine Gruppe bilden und\n",
        "jeder kann dieser Gruppe beitreten.\r",
        "Ich hoffe, deine Gruppe wird schnell\n",
        "wachsen und du wirst viel Spaß haben!"
      ]
    },
    {
      "id": "msg_0329_00011",
      "de_DE": "GRUPPE BILDEN"
    },
    {
      "id": "msg_0329_00012",
      "de_DE": "GRUPPE BEITRETEN"
    },
    {
      "id": "msg_0329_00013",
      "de_DE": "INFO"
    },
    {
      "id": "msg_0329_00014",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0329_00015",
      "de_DE": "{STRVAR_1 61, 0}-Gruppe"
    },
    {
      "id": "msg_0329_00016",
      "de_DE": "{STRVAR_1 61, 1}-Gruppe"
    },
    {
      "id": "msg_0329_00017",
      "de_DE": "{STRVAR_1 61, 2}-Gruppe"
    },
    {
      "id": "msg_0329_00018",
      "de_DE": "{STRVAR_1 61, 3}-Gruppe"
    },
    {
      "id": "msg_0329_00019",
      "de_DE": "{STRVAR_1 61, 4}-Gruppe"
    },
    {
      "id": "msg_0329_00020",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0329_00021",
      "de_DE": [
        "Diese Gruppe?\n",
        "Gehört die nicht {STRVAR_1 3, 0}?"
      ]
    },
    {
      "id": "msg_0329_00022",
      "de_DE": [
        "Gibt es nicht schon eine Gruppe,\n",
        "die diesen Namen trägt?"
      ]
    }
  ]
