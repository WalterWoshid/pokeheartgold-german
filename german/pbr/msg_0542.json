      "de_DE": [
        "Pokémon tauchen da auf,\n",
        "wo es noch viel Natur gibt.\r",
        "Trainer tummeln sich dort,\n",
        "wo es Pokémon gibt.\r",
        "Und wo es Trainer gibt, werden\n",
        "Pokémon-Center errichtet."
      ]
    },
    {
      "id": "msg_0542_00001",
      "de_DE": [
        "Ein Superstar geht überallhin,\n",
        "um für seine Fans zu singen.\r",
        "Ein Trainer geht überallhin,\n",
        "solange ihn sein Pokémon begleitet."
      ]
    }
  ]
