    },
    {
      "id": "msg_0446_00040",
      "de_DE": [
        "Es denkt: “Hnarrr... Hah?\n",
        "Wie? Wo? Was?\r",
        "Dies ist das Haus von {STRVAR_1 3, 1}?!?\n",
