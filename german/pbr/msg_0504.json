{
  "key": 9262,
  "messages": [
    {
      "id": "msg_0504_00000",
      "de_DE": [
        "Hast du schon gehört?\r",
        "Der Pokémon-Professor ist in den\n",
        "Nachbarort zurückgekehrt.\r",
        "Er soll vier lange Jahre weg\n",
        "gewesen sein.\r",
        "Ob er wohl in der Zeit etwas\n",
        "Faszinierendes über die Pokémon\f",
        "herausgefunden hat?!?"
      ]
    },
    {
      "id": "msg_0504_00001",
      "de_DE": [
        "Nun, Professor Eibe hat dir doch einen\n",
        "Pokédex gegeben, oder?"
      ]
    },
    {
      "id": "msg_0504_00002",
      "de_DE": [
        "Du, hör mal, {STRVAR_1 3, 0}. Ich möchte\n",
        "ein niedliches Pokémon haben!"
      ]
    },
    {
      "id": "msg_0504_00003",
      "de_DE": [
        "Du, sag mal, {STRVAR_1 3, 0}.\r",
        "Meinst du, ich kann mich auch mit\n",
        "Pokémon anfreunden, so wie du\f",
        "das getan hast?"
      ]
    }
  ]
}
