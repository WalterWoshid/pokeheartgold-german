      "garbage": 0
    },
    {
      "id": "msg_0575_00115",
      "de_DE": [
        "{STRVAR_1 3, 0} ist an die Oberfläche\n",
        "zurückgekehrt."
      ]
    },
    {
      "id": "msg_0575_00116",
      "de_DE": [
        "{STRVAR_1 3, 0} hat\n",
        "{STRVAR_1 3, 1} geholfen!"
      ]
    },
    {
      "id": "msg_0575_00117",
      "de_DE": [
        "Eine Nachricht von {STRVAR_1 3, 0}!\n",
        "“Hallo! Schön, dich zu sehen!”"
      ]
    },
    {
      "id": "msg_0575_00118",
      "de_DE": [
