{
  "key": 37978,
  "messages": [
    {
      "id": "msg_0575_00000",
      "de_DE": [
        "Hey!\n",
        "Wie geht’s denn so?"
      ]
    },
    {
      "id": "msg_0575_00001",
      "garbage": 0
    },
    {
      "id": "msg_0575_00002",
      "de_DE": [
        "...\n",
        "Die Person ist beschäftigt."
      ]
    },
    {
      "id": "msg_0575_00003",
      "de_DE": "BEGRÜSSEN"
    },
    {
      "id": "msg_0575_00004",
      "de_DE": "FRAGE"
    },
    {
      "id": "msg_0575_00005",
      "de_DE": "DEKO GEBEN"
    },
    {
      "id": "msg_0575_00006",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0575_00007",
      "de_DE": [
        "Du zeigst mir tatsächlich deinen\n",
        "Trainer-Koffer?\r",
        "Dann zeige ich dir meinen auch!"
      ]
    },
    {
      "id": "msg_0575_00008",
      "de_DE": [
        "Hm? Wo ist mein Trainer-Koffer nur\n",
        "abgeblieben.\r",
        "Tut mir schrecklich leid!\n",
        "Vielleicht beim nächsten Mal."
      ]
    },
    {
      "id": "msg_0575_00009",
      "de_DE": [
        "Vielen Dank!\n",
        "Komm mal wieder vorbei!\r"
      ]
    },
    {
      "id": "msg_0575_00010",
      "de_DE": [
        "Möchtest du vielleicht etwas anderes\n",
        "machen?"
      ]
    },
    {
      "id": "msg_0575_00011",
      "de_DE": [
        "Oh, das geht schon in Ordnung.\n",
        "Dann eben nächstes Mal."
      ]
    },
    {
      "id": "msg_0575_00012",
      "de_DE": [
        "Hm? {STRVAR_1 25, 2}? Bist du sicher,\n",
        "dass du mir das Item geben willst?"
      ]
    },
    {
      "id": "msg_0575_00013",
      "de_DE": [
        "Danke, aber ich muss ablehnen.\n",
        "Das kann ich dir doch nicht wegnehmen.\r",
        "Vielleicht ein anderes Mal!"
      ]
    },
    {
      "id": "msg_0575_00014",
      "de_DE": [
        "Vielen Dank!\r",
        "{STRVAR_1 3, 0} hat {STRVAR_1 25, 2}\n",
        "erhalten."
      ]
    },
    {
      "id": "msg_0575_00015",
      "de_DE": "Dann bis später!"
    },
    {
      "id": "msg_0575_00016",
      "de_DE": [
        "Tut mir leid!\n",
        "Mir ist etwas dazwischengekommen!"
      ]
    },
    {
      "id": "msg_0575_00017",
      "de_DE": [
        "{STRVAR_1 25, 2}\n",
        "erhalten."
      ]
    },
    {
      "id": "msg_0575_00018",
      "de_DE": [
        "{STRVAR_1 25, 3} im Boden gefunden!\r",
        "{STRVAR_1 3, 1} hat\n",
        "{STRVAR_1 25, 3} entschärft!"
      ]
    },
    {
      "id": "msg_0575_00019",
      "de_DE": [
        "Die Wand gibt leicht nach.\n",
        "Willst du versuchen, da zu graben?"
      ]
    },
    {
      "id": "msg_0575_00020",
      "de_DE": [
        "Jammerschade!\n",
        "Dein Beutel ist voll!"
      ]
    },
    {
      "id": "msg_0575_00021",
      "de_DE": [
        "Jammerschade!\n",
        "Dein Beutel ist voll!"
      ]
    },
    {
      "id": "msg_0575_00022",
      "de_DE": "Hallo!"
    },
    {
      "id": "msg_0575_00023",
      "garbage": 0
    },
    {
      "id": "msg_0575_00024",
      "de_DE": [
        "Sieh dir meinen Trainer-Koffer an.\r",
        "Darf ich deinen auch mal sehen?"
      ]
    },
    {
      "id": "msg_0575_00025",
      "de_DE": [
        "Keine Zeit? Oh, ich wollte dich nicht\n",
        "stören! Vielleicht nächstes Mal!"
      ]
    },
    {
      "id": "msg_0575_00026",
      "de_DE": [
        "War schön, dich kennenzulernen,\n",
        "{STRVAR_1 3, 0}!"
      ]
    },
    {
      "id": "msg_0575_00027",
      "de_DE": "Also..."
    },
    {
      "id": "msg_0575_00028",
      "de_DE": [
        "Ach, ja! Ich habe da etwas für dich:\n",
        "{STRVAR_1 25, 2}!\r",
        "Viel Spaß damit."
      ]
    },
    {
      "id": "msg_0575_00029",
      "de_DE": [
        "Oh?\n",
        "So ein Item hast du schon?"
      ]
    },
    {
      "id": "msg_0575_00030",
      "de_DE": [
        "Oh? Du hast ja nicht genug Platz in\n",
        "deinem Beutel.\r",
        "Also gut, dann eben nächstes Mal!"
      ]
    },
    {
      "id": "msg_0575_00031",
      "de_DE": [
        "Hier, das gehört dir!\n",
        "Halte das Item in Ehren!\r",
        "{STRVAR_1 25, 2} von\n",
        "{STRVAR_1 3, 0} erhalten!"
      ]
    },
    {
      "id": "msg_0575_00032",
      "de_DE": "Dann mach’s gut!"
    },
    {
      "id": "msg_0575_00033",
      "de_DE": "{STRVAR_1 25, 3} verwendet!"
    },
    {
      "id": "msg_0575_00034",
      "de_DE": "Du hast eine kleine Höhle entdeckt!\r"
    },
    {
      "id": "msg_0575_00035",
      "de_DE": [
        "Möchtest du hier deine\n",
        "Geheimbasis errichten?"
      ]
    },
    {
      "id": "msg_0575_00036",
      "de_DE": "Möchtest du hierher umziehen?"
    },
    {
      "id": "msg_0575_00037",
      "de_DE": [
        "Willst du den Eingang offen lassen?\n",
        "Oder lieber schließen, um zu dekorieren?"
      ]
    },
    {
      "id": "msg_0575_00038",
      "de_DE": "Tür offen lassen"
    },
    {
      "id": "msg_0575_00039",
      "de_DE": "Zu und dekorieren"
    },
    {
      "id": "msg_0575_00040",
      "garbage": 0
    },
    {
      "id": "msg_0575_00041",
      "de_DE": [
        "Es ist deine eigene Geheimbasis.\n",
        "Möchtest du eintreten?"
      ]
    },
    {
      "id": "msg_0575_00042",
      "garbage": 0
    },
    {
      "id": "msg_0575_00043",
      "garbage": 0
    },
    {
      "id": "msg_0575_00044",
      "de_DE": [
        "Du hast deine eigene Geheimbasis\n",
        "betreten."
      ]
    },
    {
      "id": "msg_0575_00045",
      "de_DE": [
        "Du hast eine kleine Höhle entdeckt!\n",
        "Möchtest du eintreten?"
      ]
    },
    {
      "id": "msg_0575_00046",
      "garbage": 0
    },
    {
      "id": "msg_0575_00047",
      "de_DE": [
        "Möchtest du die Tür öffnen und\n",
        "die Geheimbasis verlassen?"
      ]
    },
    {
      "id": "msg_0575_00048",
      "de_DE": [
        "Drahtlose DS-Datenübertragung\n",
        "wird gestartet."
      ]
    },
    {
      "id": "msg_0575_00049",
      "garbage": 0
    },
    {
      "id": "msg_0575_00050",
      "de_DE": "Geheimbasis verlassen?"
    },
    {
      "id": "msg_0575_00051",
      "de_DE": [
        "Ein Erdbeben!\r",
        "Du bist in den Gang geflüchtet, um\n",
        "der Gefahr zu entgehen!"
      ]
    },
    {
      "id": "msg_0575_00052",
      "de_DE": [
        "Möchtest du wieder an die Stelle\n",
        "zurück, an der du eingestiegen bist?"
      ]
    },
    {
      "id": "msg_0575_00053",
      "garbage": 0
    },
    {
      "id": "msg_0575_00054",
      "de_DE": "Das kann hier nicht verwendet werden!"
    },
    {
      "id": "msg_0575_00055",
      "de_DE": "Das kann hier nicht vergraben werden."
    },
    {
      "id": "msg_0575_00056",
      "de_DE": "Du hast das Loch zugeschüttet."
    },
    {
      "id": "msg_0575_00057",
      "de_DE": [
        "Jemand befindet sich in deiner Geheim-\n",
        "basis. Du kannst jetzt nicht umziehen."
      ]
    },
    {
      "id": "msg_0575_00058",
      "de_DE": [
        "{STRVAR_1 25, 0} {STRVAR_1 51, 1}\n",
        "wurde vergraben."
      ]
    },
    {
      "id": "msg_0575_00059",
      "de_DE": "Da ist bereits etwas vergraben."
    },
    {
      "id": "msg_0575_00060",
      "de_DE": [
        "Du kannst nichts in einer Wand\n",
        "vergraben."
      ]
    },
    {
      "id": "msg_0575_00061",
      "garbage": 0
    },
    {
      "id": "msg_0575_00062",
      "de_DE": [
        "Du bist auf etwas in der Wand gestoßen!\n",
        "{STRVAR_1 50, 0} bestätigt!"
      ]
    },
    {
      "id": "msg_0575_00063",
      "de_DE": "Die Wand ist eingestürzt!"
    },
    {
      "id": "msg_0575_00064",
      "de_DE": "Du hast alle Gegenstände ausgegraben!"
    },
    {
      "id": "msg_0575_00065",
      "de_DE": [
        "Schade aber auch!\n",
        "Dein Beutel ist voll!"
      ]
    },
    {
      "id": "msg_0575_00066",
      "de_DE": [
        "Du kannst von einer Geheimbasis aus\n",
        "nicht direkt an die Oberfläche gelangen."
      ]
    },
    {
      "id": "msg_0575_00067",
      "de_DE": [
        "Das ist wohl die Geheimbasis von\n",
        "{STRVAR_1 3, 0}.\r",
        "Willst du die Trainer-Fahne mitnehmen?"
      ]
    },
    {
      "id": "msg_0575_00068",
      "de_DE": [
        "Du hast den Eingang blockiert, um die\n",
        "Geheimbasis zu dekorieren."
      ]
    },
    {
      "id": "msg_0575_00069",
      "de_DE": "{STRVAR_1 25, 2}, Größe {STRVAR_1 51, 1} erhalten!"
    },
    {
      "id": "msg_0575_00070",
      "de_DE": [
        "Ups!\n",
        "{STRVAR_1 25, 0}!"
      ]
    },
    {
      "id": "msg_0575_00071",
      "de_DE": "Du hast {STRVAR_1 3, 0} geholfen!"
    },
    {
      "id": "msg_0575_00072",
      "de_DE": [
        "Ich grabe gerade nach Schätzen,\n",
        "siehst du das nicht?!?\r",
        "Möchtest du auch? Es gibt bestimmt\n",
        "Stellen, an denen sich das lohnt!"
      ]
    },
    {
      "id": "msg_0575_00073",
      "de_DE": [
        "Du kannst eine Falle nicht in einer\n",
        "Geheimbasis ablegen."
      ]
    },
    {
      "id": "msg_0575_00074",
      "de_DE": [
        "Du kannst in einer Geheimbasis\n",
        "keine Löcher bohren!"
      ]
    },
    {
      "id": "msg_0575_00075",
      "de_DE": [
        "Sie ist um {STRVAR_1 51, 0} Größe(n) gewachsen,\n",
        "seitdem sie vergraben wurde!"
      ]
    },
    {
      "id": "msg_0575_00076",
      "de_DE": "Puste die Falle weg!"
    },
    {
      "id": "msg_0575_00077",
      "de_DE": "Entschärfe die Falle mit dem Touchpen!"
    },
    {
      "id": "msg_0575_00078",
      "de_DE": [
        "Du hast eine Falle gefunden, aber dein\n",
        "Beutel ist voll. Du lässt sie liegen."
      ]
    },
    {
      "id": "msg_0575_00079",
      "de_DE": [
        "{STRVAR_1 25, 0} wurde in der\n",
        "{COLOR 2}♈{COLOR 0}ITEM-Tasche deines Beutels abgelegt."
      ]
    },
    {
      "id": "msg_0575_00080",
      "de_DE": [
        "Dein Beutel ist voll. {STRVAR_1 25, 0}\n",
        "konnte nicht verstaut werden."
      ]
    },
    {
      "id": "msg_0575_00081",
      "de_DE": [
        "{STRVAR_1 25, 0} wurde in der {COLOR 2}♌{COLOR 0}-\n",
        "MEDIZIN-Tasche des Beutels verstaut."
      ]
    },
    {
      "id": "msg_0575_00082",
      "garbage": 0
    },
    {
      "id": "msg_0575_00083",
      "de_DE": [
        "Du hast eine Sphäre gefunden, aber dein\n",
        "Beutel ist voll. Du lässt sie liegen."
      ]
    },
    {
      "id": "msg_0575_00084",
      "de_DE": [
        "Du kannst eine Sphäre nicht innerhalb\n",
        "einer Geheimbasis vergraben."
      ]
    },
    {
      "id": "msg_0575_00085",
      "de_DE": [
        "...\r",
        "Oh? Im Forschersack befindet\n",
        "sich eine Notiz.\r",
        "“Nach Schätzen und Sphären graben!”\r",
        "In deinem Forschersack findest du\n",
        "einen Hammer und eine Spitzhacke!\r",
        "Mit diesen Werkzeugen kannst du in\n",
        "Wänden wahre Schätze ausgraben!\r",
        "Bestimmt holst du sie heraus, bevor\n",
        "die Wand einstürzt!\r",
        "Du schaffst es!\n",
        "Viel Glück, Trainer!"
      ]
    },
    {
      "id": "msg_0575_00086",
      "de_DE": [
        "So etwas Wichtiges kann ich\n",
        "einfach nicht annehmen!"
      ]
    },
    {
      "id": "msg_0575_00087",
      "de_DE": [
        "Danke für das großzügige Angebot, aber\n",
        "nein. Sehe dich dann morgen."
      ]
    },
    {
      "id": "msg_0575_00088",
      "de_DE": [
        "...\r",
        "Die Wand bröckelt schon.\n",
        "Zu gefährlich, um reinzugehen."
      ]
    },
    {
