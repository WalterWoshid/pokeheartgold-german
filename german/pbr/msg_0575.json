    },
    {
      "id": "msg_0575_00104",
      "de_DE": [
        "{STRVAR_1 3, 0} hat die Geheimbasis von\n",
        "{STRVAR_1 3, 1} betreten."
      ]
    },
    {
      "id": "msg_0575_00105",
