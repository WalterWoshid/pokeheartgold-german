      ]
    },
    {
      "id": "msg_0575_00110",
      "de_DE": [
        "{STRVAR_1 3, 0} hat die Fahne von\n",
        "{STRVAR_1 3, 1} an sich gerissen!"
      ]
    },
    {
      "id": "msg_0575_00111",
      "de_DE": [
        "{STRVAR_1 3, 0} hat mit\n",
