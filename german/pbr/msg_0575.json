    },
    {
      "id": "msg_0575_00129",
      "de_DE": [
        "{STRVAR_1 25, 2}... Was willst du\n",
        "damit machen?"
      ]
    },
    {
      "id": "msg_0575_00130",
      "de_DE": "{STRVAR_1 25, 2} weggeworfen."
    },
    {
      "id": "msg_0575_00131",
      "de_DE": "{STRVAR_1 25, 3} im Boden vergraben."
    },
    {
      "id": "msg_0575_00132",
      "de_DE": "MÜLL"
    },
    {
      "id": "msg_0575_00133",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0575_00134",
      "de_DE": "VERGR."
    },
    {
      "id": "msg_0575_00135",
      "de_DE": "EINSTECKEN"
    },
    {
      "id": "msg_0575_00136",
      "de_DE": [
        "Was ist denn?\n",
        "Wolltest du mich etwas fragen?"
      ]
    },
    {
      "id": "msg_0575_00137",
      "de_DE": [
        "{STRVAR_1 29, 5}?\n",
        "Mal sehen..."
      ]
    },
    {
      "id": "msg_0575_00138",
      "de_DE": [
        "Ja, ich glaube, ich weiß die Antwort.\r",
        "Was würdest du antworten?"
      ]
    },
    {
      "id": "msg_0575_00139",
      "de_DE": [
        "Hmmm...\n",
        "Kann mich nicht so recht entscheiden.\r"
      ]
    },
    {
      "id": "msg_0575_00140",
      "de_DE": [
        "Wirklich?\n",
        "{STRVAR_1 30, 5}?\r",
        "Also ich wäre eher für...\n",
        "{STRVAR_1 30, 6}!\r"
      ]
    },
    {
      "id": "msg_0575_00141",
      "de_DE": [
        "Wirklich?\n",
        "{STRVAR_1 30, 5}?\r",
        "Also ich wäre für...\n",
        "{STRVAR_1 30, 6}!\r",
        "...Oh!\n",
        "Das ist ja dieselbe Antwort!\r"
      ]
    },
