{
  "key": 5120,
  "messages": [
    {
      "id": "msg_0355_00000",
      "de_DE": [
        "In unserem Restaurant genießt man\n",
        "mehr als nur vorzügliche Menüs.\r",
        "Der werte Gast kann auch an Kämpfen\n",
        "teilnehmen. Bon appétit!"
      ]
    },
    {
      "id": "msg_0355_00001",
      "de_DE": [
        "Es tut mir leid, aber wir haben\n",
        "geschlossen. Bitte komm wieder,\f",
        "wenn wir geöffnet haben.\r"
      ]
    },
    {
      "id": "msg_0355_00002",
      "de_DE": [
        "Bevor wir unsere Gläser heben und\n",
        "anstoßen, hoffe ich auf einen Kampf...\r",
        "Aber wie ich gerade sehe, hast du gar\n",
        "nicht genug Pokémon dafür."
      ]
    },
    {
      "id": "msg_0355_00003",
      "de_DE": [
        "Wenn du gegen uns antreten möchtest,\n",
        "musst du weitere Pokémon mitbringen."
      ]
    },
    {
      "id": "msg_0355_00004",
      "de_DE": [
        "Mein hübscher Partner im Kampf\n",
        "wird mir Modell stehen.\f",
        "Das kann nur ein Meisterwerk geben.\r"
      ]
    },
    {
      "id": "msg_0355_00005",
      "de_DE": [
        "Bitte?\n",
        "Du möchtest kämpfen?\r"
      ]
    },
    {
      "id": "msg_0355_00006",
      "garbage": 0
    },
    {
      "id": "msg_0355_00007",
      "de_DE": [
        "Auch wenn wir den Kampf verloren\n",
        "haben... Stoßen wir auf deine\f",
        "wunderbaren Pokémon an!"
      ]
    },
    {
      "id": "msg_0355_00008",
      "de_DE": [
        "Er sagte, er würde mich zum Essen\n",
        "einladen, wenn ich für ihn Modell stehe.\r",
        "Also bin ich hier, aber entschieden habe\n",
        "ich mich noch nicht.\r"
      ]
    },
    {
      "id": "msg_0355_00009",
      "de_DE": [
        "Wenn ich mich nicht entscheiden kann,\n",
        "dann kämpfe ich, um mich zu entscheiden.\r"
      ]
    },
    {
      "id": "msg_0355_00010",
      "garbage": 0
    },
    {
      "id": "msg_0355_00011",
      "de_DE": [
        "Ich habe beschlossen, ihm Modell zu\n",
        "stehen. Das macht mich richtig hungrig."
      ]
    },
    {
      "id": "msg_0355_00012",
      "de_DE": [
        "Kein Preis ist zu hoch, wenn es um das\n",
        "Wohl meiner Kunst geht...\r",
        "Aber wenn ich mir die Preise für das\n",
        "Essen hier so ansehe... Teuer, teuer...\r"
      ]
    },
    {
      "id": "msg_0355_00013",
      "de_DE": [
        "Wie?\n",
        "Du hast auch Hunger?\r",
        "Oh, nicht?!?\n",
        "Du möchtest kämpfen!\r"
      ]
    },
    {
      "id": "msg_0355_00014",
      "garbage": 0
    },
    {
      "id": "msg_0355_00015",
      "de_DE": "Meine Vorspeise ist kalt geworden..."
    },
    {
      "id": "msg_0355_00016",
      "de_DE": [
        "Ich muss diese vorzügliche Speise\n",
        "langsam und mit Appetit essen.\r",
        "Und nicht zu viel davon, sonst bin\n",
        "ich vor dem Hauptgang schon satt.\r"
      ]
    },
    {
      "id": "msg_0355_00017",
      "de_DE": [
        "Ich mag einen kleinen Kampf. Der\n",
        "ist immer so appetitanregend.\r",
        "Möchtest du teilnehmen?\r"
      ]
    },
    {
      "id": "msg_0355_00018",
      "garbage": 0
    },
    {
      "id": "msg_0355_00019",
      "de_DE": [
        "Die Vorspeise ist wirklich nicht kalt\n",
        "geworden...\r",
        "Man serviert sie übrigens kalt."
      ]
    },
    {
      "id": "msg_0355_00020",
      "de_DE": [
        "Der Wert einer Speise wird nicht\n",
        "von dem Geschmack allein bestimmt.\r",
        "Die Präsentation, die Farbe und der\n",
        "Geruch sind ebenfalls wichtig.\r",
        "Mit anderen Worten: Ein gutes Essen\n",
        "kann wie ein Kunstwerk sein...\r"
      ]
    },
    {
      "id": "msg_0355_00021",
      "de_DE": [
        "Und in Kämpfen mit Pokémon hoffe ich,\n",
        "ebenfalls ein Kunstwerk zu sehen.\r",
        "Das hoffst du doch auch, oder?!?\r"
      ]
    },
    {
      "id": "msg_0355_00022",
      "garbage": 0
    },
    {
      "id": "msg_0355_00023",
      "de_DE": [
        "Die Speisen hier sind nicht nur köstlich,\n",
        "sondern auch noch gesund.\r",
        "Man muss sich keine Sorgen um seine\n",
        "Figur machen, wenn man hier speist."
      ]
    },
    {
      "id": "msg_0355_00024",
      "de_DE": [
        "Die heutige Hauptspeise ist einfach\n",
        "sagenhaft köstlich.\r",
        "Wenn ich so etwas auch in Zukunft essen\n",
        "darf, werde ich gerne ein Model.\r"
      ]
    },
    {
      "id": "msg_0355_00025",
      "de_DE": [
        "Ich habe ein richtig schlechtes\n",
        "Gewissen, weil ich all diese\f",
        "Köstlichkeiten gegessen habe.\r",
        "Ich werde auch am Kampf teilnehmen.\r"
      ]
    },
    {
      "id": "msg_0355_00026",
      "garbage": 0
    },
    {
      "id": "msg_0355_00027",
      "de_DE": [
        "Die Models, die auf den großen Gemälden\n",
        "zu sehen sind, sind manchmal recht\f",
        "plump.\r",
        "Aber das heißt auch, ich kann futtern\n",
        "ohne Ende - ohne Sorge um meine Figur!"
      ]
    },
    {
      "id": "msg_0355_00028",
      "de_DE": [
        "Wenn du gegen uns antreten\n",
        "willst, bring mehr Pokémon mit."
      ]
    },
    {
      "id": "msg_0355_00029",
      "de_DE": [
        "Willst du gegen uns kämpfen, musst du\n",
        "mindestens zwei Pokémon bei dir haben!"
      ]
    },
    {
      "id": "msg_0355_00030",
      "de_DE": "Mein Vater ist der Chefkoch hier.\r"
    },
    {
      "id": "msg_0355_00031",
      "de_DE": [
        "Was ist? Ein Kampf?!?\n",
        "Muahahaha... Meinst du wirklich,\f",
        "du könntest mich besiegen?\r"
      ]
    },
    {
      "id": "msg_0355_00032",
      "garbage": 0
    },
    {
      "id": "msg_0355_00033",
      "de_DE": [
        "Wir haben verloren.\n",
        "Aber trinken wir trotzdem auf\f",
        "unsere gemeinsame Zukunft."
      ]
    },
    {
      "id": "msg_0355_00034",
      "de_DE": [
        "Echt?\n",
        "Dein Vater ist hier der Küchenchef?\r",
        "Ist das wunderbar!\r"
      ]
    },
    {
      "id": "msg_0355_00035",
      "de_DE": [
        "Ich habe es ihm nicht gesagt, aber\n",
        "meinem Vater gehört das Hotel und\f",
        "Restaurant...\r",
        "Aber davon mal abgesehen...\n",
        "Möchtest du kämpfen?\r"
      ]
    },
    {
      "id": "msg_0355_00036",
      "garbage": 0
    },
    {
      "id": "msg_0355_00037",
      "de_DE": [
        "Lass uns auf den Erfolg dieses\n",
        "Restaurants anstoßen!"
      ]
    },
    {
      "id": "msg_0355_00038",
      "de_DE": [
        "Ich muss es meinem Vater lassen...\n",
        "Die Vorspeise ist einfach köstlich!\r"
      ]
    },
    {
      "id": "msg_0355_00039",
      "de_DE": [
        "...Möchtest du vielleicht kämpfen?\r",
        "Natürlich!\n",
        "Ich schlage keine Herausforderung aus!\r"
      ]
    },
    {
      "id": "msg_0355_00040",
      "garbage": 0
    },
    {
      "id": "msg_0355_00041",
      "de_DE": [
        "So. Nun können wir unser Essen ohne\n",
        "Unterbrechungen genießen."
      ]
    },
    {
      "id": "msg_0355_00042",
      "de_DE": [
        "Ja! Die Speisen sind wirklich vorzüglich\n",
        "und dieses Hotels würdig!\r"
      ]
    },
    {
      "id": "msg_0355_00043",
      "de_DE": [
        "Bitte erzähl meinem Freund nicht, dass\n",
        "meinem Vater das Restaurant gehört!\r",
        "Wenn du den Mund hältst, werde\n",
        "ich auch mit dir kämpfen."
      ]
    },
    {
      "id": "msg_0355_00044",
      "garbage": 0
    },
    {
      "id": "msg_0355_00045",
      "de_DE": [
        "Mein Freund gab sein Bestes, aber\n",
        "du warst stärker als wir beide."
      ]
    },
    {
      "id": "msg_0355_00046",
      "de_DE": [
        "Hahaha, meine Freundin genießt die\n",
        "Kochkünste meines Vaters.\r",
        "Nach jedem Bissen sieht sie richtig\n",
        "verträumt aus.\r"
      ]
    },
    {
      "id": "msg_0355_00047",
      "de_DE": [
        "Ich fühle mich großartig!\n",
        "Sicher werde ich gegen dich antreten!\r",
        "Deshalb bist du doch hier, stimmt’s?\r"
      ]
    },
    {
      "id": "msg_0355_00048",
      "garbage": 0
    },
    {
      "id": "msg_0355_00049",
      "de_DE": [
        "Ich bin als Trainer nicht gerade in\n",
        "Topform...\r",
        "Im Gegensatz zu den fantastischen\n",
        "Kochkünsten meines Vaters..."
      ]
    },
    {
      "id": "msg_0355_00050",
      "de_DE": [
        "Diese Saftigkeit!\n",
        "Das erinnert mich an meine Weltreise.\r",
        "Mein Vater und ich sind durch die ganze\n",
        "Welt gereist und haben ausschließlich\f",
        "in den besten Restaurants gespeist.\r"
      ]
    },
    {
      "id": "msg_0355_00051",
      "de_DE": [
        "Dieses fabelhafte Essen hat meine\n",
        "Laune wirklich merklich verbessert.\r",
        "Wollen wir kämpfen?\r"
      ]
    },
    {
      "id": "msg_0355_00052",
      "garbage": 0
    },
    {
      "id": "msg_0355_00053",
      "de_DE": [
        "Dein Vater hat wirklich magische\n",
        "Fähigkeiten beim Kochen.\r",
        "Seine Speisen scheinen den\n",
        "Menschen Energie zu schenken."
      ]
    },
    {
      "id": "msg_0355_00054",
      "de_DE": [
        "Wenn du unsere Stärke testen willst,\n",
        "brauchst du mindestens zwei Pokémon."
      ]
    },
    {
      "id": "msg_0355_00055",
      "de_DE": [
        "Oh, du bietest uns einen Kampf an?\n",
        "Das ist aber nett von dir.\r",
        "Aber du brauchst mehr als ein\n",
        "Pokémon für einen Kampf gegen uns."
      ]
    },
    {
      "id": "msg_0355_00056",
      "de_DE": [
        "Lass uns auf viele glückliche\n",
        "gemeinsame Jahre anstoßen.\r"
      ]
    },
    {
      "id": "msg_0355_00057",
      "de_DE": [
        "Seit ich im Ruhestand bin, reise ich mit\n",
        "meiner Frau um die Welt.\r",
        "Wir sind immer auf der Suche nach einem\n",
        "außergewöhnlichen Restaurant.\r",
        "Du scheinst den Kampf mit deinen\n",
        "Pokémon zu genießen. Nicht wahr?\r"
      ]
    },
    {
      "id": "msg_0355_00058",
      "garbage": 0
    },
    {
      "id": "msg_0355_00059",
      "de_DE": [
        "Nun, so viel dazu. Genießen\n",
        "wir nun unsere Mahlzeit."
      ]
    },
    {
      "id": "msg_0355_00060",
      "de_DE": [
        "Auf unsere Gesundheit und\n",
        "auf feine Speisen! Prost!\r"
      ]
    },
    {
      "id": "msg_0355_00061",
      "de_DE": [
        "Ein Trinkspruch vor dem Essen\n",
        "regt den Appetit an, finde ich.\r",
        "Aber das wolltest du gar nicht wissen.\n",
        "Du wolltest sicher kämpfen, was?"
      ]
    },
    {
      "id": "msg_0355_00062",
      "garbage": 0
    },
    {
      "id": "msg_0355_00063",
      "de_DE": [
        "Gourmetrestaurants und\n",
        "aufregende Pokémon-Kämpfe...\r",
        "Mein Leben ist einfach klasse!"
      ]
    },
    {
      "id": "msg_0355_00064",
      "de_DE": [
        "Hmm!\n",
        "Nun, das ist mal was Besonderes!\r",
        "Sie scheinen nur kurz im Feuer\n",
        "gewesen zu sein, und sie wurden\f",
        "mit sehr viel Sorgfalt zubereitet!\r"
      ]
    },
    {
      "id": "msg_0355_00065",
      "de_DE": [
        "Ein Gourmet wie ich kann mit einem\n",
        "Blick feststellen, ob die Speise köstlich\f",
        "und wohlschmeckend ist oder nicht.\r",
        "Möchtest du gerne gegen einen\n",
        "Gourmet wie mich antreten?\r"
      ]
    },
    {
      "id": "msg_0355_00066",
      "garbage": 0
    },
    {
      "id": "msg_0355_00067",
      "de_DE": [
        "So viel dazu.\r",
        "Nun freut sich unser Gaumen\n",
        "auf den Hauptgang."
      ]
    },
    {
      "id": "msg_0355_00068",
      "de_DE": [
        "Diese Vorspeise ist einfach himmlisch!\r",
        "Und sie sagt mir, dass der Hauptgang\n",
        "fantastisch sein wird!\r"
      ]
    },
    {
      "id": "msg_0355_00069",
      "de_DE": [
        "Ich dachte, der Hauptgang wäre\n",
        "endlich da...\r",
        "Du bist ein Trainer, der den\n",
        "Kampf sucht?\r"
      ]
    },
    {
      "id": "msg_0355_00070",
      "garbage": 0
    },
    {
      "id": "msg_0355_00071",
      "de_DE": "Die Vorspeise war einfach deliziös!"
    },
    {
      "id": "msg_0355_00072",
      "de_DE": [
        "Hmm!\n",
        "Der Chef hat es perfekt flambiert!\r",
        "Das reiche Aroma und der Geschmack\n",
        "erfüllen meinen Gaumen mit Freude!\r"
      ]
    },
    {
      "id": "msg_0355_00073",
      "de_DE": [
        "Du forderst uns mitten in unserem\n",
        "Hauptgang heraus?!?\r",
        "Nun, du scheinst für dein Alter ein sehr\n",
        "hingebungsvoller Trainer zu sein!\r"
      ]
    },
    {
      "id": "msg_0355_00074",
      "garbage": 0
    },
    {
      "id": "msg_0355_00075",
      "de_DE": [
        "Ah... Das Mahl und der Kampf\n",
        "waren äußerst köstlich."
      ]
    },
    {
      "id": "msg_0355_00076",
      "de_DE": [
        "...!\n",
        "Diese Soße!\r",
        "Dies ist eine würzige Soße nach\n",
        "einem Rezept aus der Hoenn-Region.\r",
        "Sie wird aus geriebenen\n",
        "Amrenabeeren gemacht!\r"
      ]
    },
    {
      "id": "msg_0355_00077",
      "de_DE": [
        "Möchtest du mal probieren?\r",
        "...\n",
        "Oh, in Ordnung. Pokémon?\r"
      ]
    },
    {
      "id": "msg_0355_00078",
      "garbage": 0
    },
    {
      "id": "msg_0355_00079",
      "de_DE": [
        "Kämpfen ist immer eine feine Sache.\r",
        "Aber einem schmackhaften Essen\n",
        "gebe ich dennoch den Vorzug."
      ]
    },
    {
      "id": "msg_0355_00080",
      "de_DE": [
        "Wenn du gegen uns antreten willst,\n",
        "brauchst du mindestens 2 Pokémon."
      ]
    },
    {
      "id": "msg_0355_00081",
      "de_DE": [
        "Hast du keine Pokémon?\n",
        "Dann kämpfen wir ein anderes Mal!"
      ]
    },
    {
      "id": "msg_0355_00082",
      "de_DE": [
        "Amabella, ähm, ich, äh...\n",
        "Ich danke dir, dass du heute\f",
        "gekommen bist...\r",
        "Stoßen wir aufeinander an!\r"
      ]
    },
    {
      "id": "msg_0355_00083",
      "de_DE": [
        "Sie verkauft die Pokémon Dekoartikel\n",
        "in dem Laden, in dem ich ständig bin.\r",
        "Wir sind unglaublich glücklich zusammen.\n",
        "Möchtest du gegen uns antreten?\r"
      ]
    },
    {
      "id": "msg_0355_00084",
      "garbage": 0
    },
    {
      "id": "msg_0355_00085",
      "de_DE": [
        "Oh... Es tut mir leid, dass wir verloren\n",
        "haben. Amabella, bist du sauer?"
      ]
    },
    {
      "id": "msg_0355_00086",
      "de_DE": [
        "Haha... Justus, du bist heute Abend\n",
        "ganz anders als sonst im Laden.\r",
        "Du bist ja richtig schüchtern!\r"
      ]
    },
    {
      "id": "msg_0355_00087",
      "de_DE": [
        "Ich arbeite im Dekoartikel-Laden,\n",
        "weil ich Pokémon liebe.\r",
        "Und dort kann ich den ganzen Tag\n",
        "mit Pokémon zusammen sein.\r",
        "Dadurch werde ich auch immer besser\n",
        "im Kämpfen. Soll ich es beweisen?\r"
      ]
    },
    {
      "id": "msg_0355_00088",
      "garbage": 0
    },
    {
      "id": "msg_0355_00089",
      "de_DE": [
        "Ich mache mir keinen Kopf ums\n",
        "Gewinnen oder Verlieren.\r",
        "Ich bin mit meinen Pokémon\n",
        "zusammen, weil ich sie liebe!"
      ]
    },
    {
      "id": "msg_0355_00090",
      "de_DE": [
        "Wenn ich meinen Pokémon erzähle,\n",
        "dass ich ein Rendezvous mit dir\f",
        "hatte, Amabella...\r",
        "Werden sie wahrscheinlich\n",
        "eifersüchtig auf dich sein...\r"
      ]
    },
    {
      "id": "msg_0355_00091",
      "de_DE": "Bist du auch ein Fan von Amabella?"
    },
    {
      "id": "msg_0355_00092",
      "garbage": 0
    },
    {
      "id": "msg_0355_00093",
      "de_DE": [
        "Amabella, wenn ich dein\n",
        "Lächeln sehe...\r",
        "Dann kann ich gar nicht\n",
        "sagen, ob ich dich oder die\f",
        "Vorspeise appetitlicher finde!"
      ]
    },
    {
      "id": "msg_0355_00094",
      "de_DE": [
        "Wie? Was? Rendezvous?\r",
        "Ähm... Justus...\n",
        "Du bist ein geschätzter Kunde und so...\r"
      ]
    },
    {
      "id": "msg_0355_00095",
      "de_DE": [
        "...Und ich muss zugeben, ich fühlte mich\n",
        "durch die Einladung geschmeichelt.\r",
        "Daher habe ich sie auch angenommen.\r",
        "Ich lasse meine Pokémon anstelle meines\n",
        "Herzens sprechen, welches sich nicht\f",
        "entscheiden kann. Wollen wir kämpfen?\r"
      ]
    },
    {
      "id": "msg_0355_00096",
      "garbage": 0
    },
    {
      "id": "msg_0355_00097",
      "de_DE": [
        "Es stimmt, was man sagt. Unter\n",
        "Pokémon-Fans gibt es nichts Böses!\r",
        "Das gilt auch für Justus!"
      ]
    },
    {
      "id": "msg_0355_00098",
      "de_DE": [
        "Dein Hauptgang scheint gekommen\n",
        "zu sein. Bitte, genieße ihn.\r",
        "Heute geht alles auf meine Rechnung!\r"
      ]
    },
    {
      "id": "msg_0355_00099",
      "de_DE": [
        "Ich werde dich besiegen und\n",
        "das Preisgeld kassieren!\r"
      ]
    },
    {
      "id": "msg_0355_00100",
      "garbage": 0
    },
    {
      "id": "msg_0355_00101",
      "de_DE": [
        "Ich habe das Preisgeld bezahlt und nun\n",
        "ist meine Geldbörse gähnend leer...\r",
        "Aber das macht nichts! Ich habe nämlich\n",
        "noch Geld in meinem Geheimversteck!"
      ]
    },
    {
      "id": "msg_0355_00102",
      "de_DE": [
        "Justus, ich denke, du bist ein bisschen\n",
        "ungelenk, aber du meinst es ernst.\r"
      ]
    },
    {
      "id": "msg_0355_00103",
      "de_DE": [
        "Ich werde auf der Seite\n",
        "meiner Verabredung stehen.\f",
        "Das wird interessant.\r",
        "Wir werden einen hinreißenden\n",
        "Kampf liefern. Bist du dabei?\r"
      ]
    },
    {
      "id": "msg_0355_00104",
      "garbage": 0
    },
    {
      "id": "msg_0355_00105",
      "de_DE": [
        "Das Essen war hervorragend und unser\n",
        "Kampf hat sehr viel Spaß gemacht.\r",
        "Ich bestehe darauf, dass wir uns die\n",
        "Rechnung teilen!"
      ]
    },
    {
      "id": "msg_0355_00106",
      "de_DE": [
        "Sobald du mindestens 2 Pokémon\n",
        "hast, werde ich mit meiner Mama\f",
        "gegen dich antreten."
      ]
    },
    {
      "id": "msg_0355_00107",
      "de_DE": [
        "Ich werde zusammen mit meinem Sohn\n",
        "kämpfen. Er ist mein ganzer Stolz.\r",
        "Aber du musst mehr Pokémon mitbringen."
      ]
    },
    {
      "id": "msg_0355_00108",
      "de_DE": [
        "Was soll ich heute nur nehmen?!?\n",
        "Es sieht alles so lecker aus!\r",
        "Saft, Eis, Kuchen oder... und... \n",
        "SEUFZ...\r"
      ]
    },
    {
      "id": "msg_0355_00109",
      "de_DE": [
        "Oh, hallo Trainer!\r",
        "Möchtest du mit uns kämpfen, bevor\n",
        "wir uns ein köstliches Essen gönnen?\r"
      ]
    },
    {
      "id": "msg_0355_00110",
      "garbage": 0
    },
    {
      "id": "msg_0355_00111",
      "de_DE": [
        "Ich verstehe das nicht. Wieso prosten\n",
        "sich Erwachsene erst mal zu und\f",
        "reden dabei von einem Toast?!?\r",
        "Was das wohl soll?\n",
        "Die haben doch gar kein Brot dabei!!!"
      ]
    },
    {
      "id": "msg_0355_00112",
      "de_DE": [
        "Oh, mein kleiner Schatz. Deine Mami\n",
        "ist so stolz auf dich, dass du den Test\f",
        "so hervorragend bestanden hast.\r",
        "Du darfst dir aussuchen, was du\n",
        "möchtest! Das ist deine Belohnung,\f",
        "mein Spatz!\r"
      ]
    },
    {
      "id": "msg_0355_00113",
      "de_DE": [
        "Stell dir vor! Mein Junge ist nicht nur\n",
        "Klassenbester, sondern auch ein\f",
        "Wunderkind was Pokémon angeht!!!\r",
        "Möchtest du uns nicht herausfordern\n",
        "und dich selbst davon überzeugen?\r"
      ]
    },
    {
      "id": "msg_0355_00114",
      "garbage": 0
    },
    {
      "id": "msg_0355_00115",
      "de_DE": [
        "Und nun spreche ich einen Toast aus!\r",
        "Auf das mein ganzer Stolz, mein Tino,\n",
        "wieder die beste Note in einer\f",
        "Klassenarbeit schreibt!"
      ]
    },
    {
      "id": "msg_0355_00116",
      "de_DE": [
        "Wow, die bringen einem alles\n",
        "nacheinander an den Tisch und\f",
        "nicht das ganze Menü mit einem Mal!\r",
        "Das ist ganz anders als zu Hause!\r"
      ]
    },
    {
      "id": "msg_0355_00117",
      "de_DE": [
        "Ich mache meine Hausaufgaben immer\n",
        "während des Essens. Da habe ich dann\f",
        "hinterher mehr Zeit zum Kämpfen.\r"
      ]
    },
    {
      "id": "msg_0355_00118",
      "garbage": 0
    },
    {
      "id": "msg_0355_00119",
      "de_DE": [
        "Wir werden uns nun diesen\n",
        "Köstlichkeiten widmen. Mach’s gut!"
      ]
    },
    {
      "id": "msg_0355_00120",
      "de_DE": [
        "Über dieses Restaurant spricht\n",
        "man überall. Jeder lobt die\f",
        "ausgezeichnete Küche!\r"
      ]
    },
    {
      "id": "msg_0355_00121",
      "de_DE": [
        "Ich bitte um Verzeihung.\n",
        "Möchtest du vielleicht kämpfen?\r",
        "Das ist in Ordnung. Es ist ja nicht\n",
        "so, dass ich einen Kampf ablehne.\r"
      ]
    },
    {
      "id": "msg_0355_00122",
      "garbage": 0
    },
    {
      "id": "msg_0355_00123",
      "de_DE": [
        "Vielen Dank, dass du meinem Sohn etwas\n",
        "Unbezahlbares beigebracht hast."
      ]
    },
    {
      "id": "msg_0355_00124",
      "de_DE": [
        "Machen Eltern das immer so? Gehen\n",
        "sie immer zusammen essen?\r",
        "Ich meine, ohne ihre Kinder\n",
        "mitzunehmen?\r"
      ]
    },
    {
      "id": "msg_0355_00125",
      "de_DE": [
        "Nun, das ist in Ordnung.\r",
        "Mir macht es eh mehr Spaß zu\n",
        "kämpfen, als vornehm Essen zu gehen!\r"
      ]
    },
    {
      "id": "msg_0355_00126",
      "garbage": 0
    },
    {
      "id": "msg_0355_00127",
      "de_DE": [
        "Mami, du musst mir so etwas zu Hause\n",
        "unbedingt auch mal kochen!"
      ]
    },
    {
      "id": "msg_0355_00128",
      "de_DE": [
        "Dies ist ein besonderer Anlass, Tino.\r",
        "Wir feiern hier doch deine\n",
        "hervorragenden Noten!\r"
      ]
    },
    {
      "id": "msg_0355_00129",
      "de_DE": [
        "Oh? Kampf, sagst du?\n",
        "Nun, sicher. Warum nicht?!?\r"
      ]
    },
    {
      "id": "msg_0355_00130",
      "garbage": 0
    },
    {
      "id": "msg_0355_00131",
      "de_DE": "Ob der Nachtisch bald serviert wird?"
    },
    {
      "id": "msg_0355_00132",
      "de_DE": [
        "Meine Tochter und ich\n",
        "kämpfen immer Seite an Seite."
      ]
    },
    {
      "id": "msg_0355_00133",
      "de_DE": [
        "Ich kann zusammen mit Papa \n",
        "gegen dich antreten. Aber nur,\f",
        "wenn du mehr Pokémon hast."
      ]
    },
    {
      "id": "msg_0355_00134",
      "de_DE": [
        "Einen Toast auf Mama!\n",
        "Möge es ihr immer gut gehen!\r"
      ]
    },
    {
      "id": "msg_0355_00135",
      "de_DE": [
        "Meine Frau ist im Krankenhaus, da sie\n",
        "bald unser Baby zur Welt bringen wird.\r",
        "Ich kann nicht kochen, daher bin ich\n",
        "mit meiner Tochter hierher gekommen.\r",
        "Wie wäre es, wenn wir gegeneinander\n",
        "kämpfen, bis das Essen serviert wird?\r"
      ]
    },
    {
      "id": "msg_0355_00136",
      "garbage": 0
    },
    {
      "id": "msg_0355_00137",
      "de_DE": [
        "Es wird zu Hause bestimmt um einiges\n",
        "lauter, wenn das Baby da ist."
      ]
    },
    {
      "id": "msg_0355_00138",
      "de_DE": [
        "Ich bin mal gespannt, ob es ein\n",
        "Mädchen oder ein Junge wird.\r"
      ]
    },
    {
      "id": "msg_0355_00139",
      "de_DE": [
        "Ein Junge wäre ein Bruder, ein\n",
        "Mädchen wäre eine Schwester.\f",
        "Und ich werde die ältere Schwester sein.\r",
        "Daher muss ich im Umgang mit Pokémon\n",
        "besser werden und ein Vorbild sein!\r"
      ]
    },
    {
      "id": "msg_0355_00140",
      "garbage": 0
    },
    {
      "id": "msg_0355_00141",
      "de_DE": [
        "Kleine Babys klingen wie Pokémon!\n",
        "Piyaaaah!"
      ]
    },
    {
      "id": "msg_0355_00142",
      "de_DE": [
        "Boah... Sieh dir diese Vorspeise an!\n",
        "Die ist ja absolut extravagant!\r"
      ]
    },
    {
      "id": "msg_0355_00143",
      "de_DE": [
        "Ich kann nicht kochen, das gebe\n",
        "ich ohne Zögern zu.\r",
        "Aber mit Pokémon zu kämpfen... Das\n",
        "ist etwas, das ich gut kann.\r"
      ]
    },
    {
      "id": "msg_0355_00144",
      "garbage": 0
    },
    {
      "id": "msg_0355_00145",
      "de_DE": [
        "Vergessen wir die Schmach der\n",
        "Niederlage bei diesem köstlichen Essen!"
      ]
    },
    {
      "id": "msg_0355_00146",
      "de_DE": [
        "Wow!\n",
        "Das Essen sieht wirklich herrlich aus!\r"
      ]
    },
    {
      "id": "msg_0355_00147",
      "de_DE": [
        "Papa ist ein grottenschlechter Koch,\n",
        "daher gehen wir immer essen!\r",
        "Bist du hier, um mit deinen\n",
        "Pokémon zu kämpfen?!?\r"
      ]
    },
    {
      "id": "msg_0355_00148",
      "garbage": 0
    },
    {
      "id": "msg_0355_00149",
      "de_DE": [
        "Ich habe noch niemals etwas\n",
        "wie dieses gegessen."
      ]
    },
    {
      "id": "msg_0355_00150",
      "de_DE": "Hier ist der Hauptgang!\r"
    },
    {
      "id": "msg_0355_00151",
      "de_DE": [
        "Ja, was gibt’s?\n",
        "Du möchtest gegen uns antreten?\r"
      ]
    },
    {
      "id": "msg_0355_00152",
      "garbage": 0
    },
    {
      "id": "msg_0355_00153",
      "de_DE": [
        "Tatjana, ich hoffe dein Geschwisterchen\n",
        "wird einmal genauso ein wunderbarer\f",
        "Mensch, wie du es bist."
      ]
    },
    {
      "id": "msg_0355_00154",
      "de_DE": [
        "Ich wünschte, Mami wäre auch hier und\n",
        "würde mit uns essen...\r"
      ]
    },
    {
      "id": "msg_0355_00155",
      "de_DE": [
        "Mami hat mir meine Pokémon gegeben.\n",
        "Willst du mal sehen, wie stark die sind?\r"
      ]
    },
    {
      "id": "msg_0355_00156",
      "garbage": 0
    },
    {
      "id": "msg_0355_00157",
      "de_DE": [
        "Nächstes Mal kommen wir mit der ganzen\n",
        "Familie und dem Baby hierher."
      ]
    },
    {
      "id": "msg_0355_00158",
      "de_DE": [
        "Ja? Was gibt es?\r",
        "Möchtest du auch mal im\n",
        "Fernsehen zu sehen sein?\r",
        "Oh, tut mir leid! Du möchtest\n",
        "lieber kämpfen, nicht wahr?"
      ]
    },
    {
      "id": "msg_0355_00159",
      "de_DE": [
        "Wenn du ein Autogramm haben möchtest,\n",
        "musst du warten, bis wir mit den\f",
        "Aufnahmen fertig sind.\r",
        "Oh, und wenn du kämpfen möchtest,\n",
        "dann bring bitte mehr Pokémon mit."
      ]
    },
    {
      "id": "msg_0355_00160",
      "de_DE": [
        "Lass uns als Test mal diese\n",
        "Gläser hier aufnehmen.\r"
      ]
    },
    {
      "id": "msg_0355_00161",
      "de_DE": [
        "Wie? Du lädst uns ausgerechnet\n",
        "jetzt zu einem Kampf ein?\r"
      ]
    },
    {
      "id": "msg_0355_00162",
      "garbage": 0
    },
    {
      "id": "msg_0355_00163",
      "de_DE": [
        "Oh, Mann...\n",
        "Nun sind unsere Getränke lauwarm."
      ]
    },
    {
      "id": "msg_0355_00164",
      "de_DE": [
        "Das Getränk des Tages ist heute\n",
        "ein frisch gepresster Saft aus\f",
        "reifen Prisifbeeren,\r",
        "die heute Morgen frisch\n",
        "gepflückt wurden!\r"
      ]
    },
    {
      "id": "msg_0355_00165",
      "de_DE": [
        "Entschuldige?\n",
        "Pokémon?!?\r",
        "Also gut. Aber es muss schnell gehen,\n",
        "da wir gleich weiter aufnehmen.\r"
      ]
    },
    {
      "id": "msg_0355_00166",
      "garbage": 0
    },
    {
      "id": "msg_0355_00167",
      "de_DE": [
        "Meinst du, wir sollten das noch ein\n",
        "weiteres Mal proben?\r",
        "Das Getränk des Tages ist heute\n",
        "ein frisch gepresster..."
      ]
    },
    {
      "id": "msg_0355_00168",
      "de_DE": [
        "Mmh, diese Häppchen sehen\n",
        "wirklich köstlich aus!\r",
        "Kann mir jemand ein Farbspray\n",
        "bringen? Dann geben wir ihnen\f",
        "noch mehr Farbe.\r"
      ]
    },
    {
      "id": "msg_0355_00169",
      "de_DE": [
        "Danke, das ging ja wirklich schnell!\r",
        "Äh... Warte... Wo hast du das\n",
        "Farbspray?\r",
        "Ach, du willst kämpfen?\n",
        "Nun, wenn du meinst. Ich bin\f",
        "bereit für die Herausforderung.\r"
      ]
    },
    {
      "id": "msg_0355_00170",
      "garbage": 0
    },
    {
      "id": "msg_0355_00171",
      "de_DE": [
        "Nahrungsmittel zu filmen ist \n",
        "wirklich nicht einfach.\f",
        "Es ist eine sehr technische Sache."
      ]
    },
    {
      "id": "msg_0355_00172",
      "de_DE": [
        "Dies sieht auch vorzüglich aus.\n",
        "Wir müssen mit der Kamera näher heran.\r"
      ]
    },
    {
      "id": "msg_0355_00173",
      "de_DE": [
        "Bitte sprich mich nicht an, während\n",
        "ich hier Aufnahmen mache!\r",
        "Obwohl...\r",
        "Ein Trainer, der unsere Atmosphäre\n",
        "und unser Essen stört...\r",
        "Das gefällt mir! Doch!\n",
        "Das sorgt für die richtige Dramatik!\r"
      ]
    },
    {
      "id": "msg_0355_00174",
      "garbage": 0
    },
    {
      "id": "msg_0355_00175",
      "de_DE": [
        "Rico, Liebling! Bist du bereit?\r",
        "Wenn ich einen Bissen nehme, möchte\n",
        "ich, dass die Kamera genau auf meinen\f",
        "Lippen ist, in Ordnung?"
      ]
    },
    {
      "id": "msg_0355_00176",
      "de_DE": [
        "Wow...\n",
        "Dies ist also das Hauptgericht? Ui!\r",
        "Lass uns schnell die Aufnahmen machen,\n",
        "damit ich es genießen kann!\r"
      ]
    },
    {
      "id": "msg_0355_00177",
      "de_DE": [
        "Du schnüffelst hier schon die\n",
        "ganze Zeit herum...\f",
        "Willst du unsere Aufnahmen stören?\r"
      ]
    },
    {
      "id": "msg_0355_00178",
      "garbage": 0
    },
    {
      "id": "msg_0355_00179",
      "de_DE": [
        "Oh, nein... Während wir gekämpft\n",
        "haben, ist das Essen kalt geworden..."
      ]
    },
    {
      "id": "msg_0355_00180",
      "de_DE": [
        "Mampf!\r",
        "Mmmh... Das ist...\n",
        "Oh... Leicht, doch voller Geschmack...\f",
        "Es zergeht auf der Zunge...\f",
        "Wunderbarer Nachgeschmack...\f",
        "Weder süß noch sauer...\f",
        "Worte reichen nicht aus,\f",
        "den Genuss zu beschreiben!\r"
      ]
    },
    {
      "id": "msg_0355_00181",
      "de_DE": [
        "Es ist wirklich nicht einfach, ein Essen\n",
        "zu beschreiben, während man es aufisst.\r",
        "Aber ich kann jederzeit kämpfen, selbst\n",
        "wenn ich Aufnahmen mache!\r"
      ]
    },
    {
      "id": "msg_0355_00182",
      "garbage": 0
    },
    {
      "id": "msg_0355_00183",
      "de_DE": [
        "Weißt du, was das Wichtigste ist, wenn\n",
        "man Reportagen für Gourmets macht?\r",
        "Ein Vokabular zu besitzen wie aus\n",
        "einem Synonymwörterbuch!"
      ]
    },
    {
      "id": "msg_0355_00184",
      "de_DE": [
        "Ich sage es nur einmal. Also hör gut zu!\n",
        "Ich werde es auch langsam sagen!\r",
        "Wenn du gegen 2 Trainer antreten\n",
        "willst, brauchst du mindestens\f",
        "2 Pokémon.\r",
        "Wenn du mehr Pokémon mitbringst,\n",
        "dann überlege ich mir dein Angebot\f",
        "nochmal!"
      ]
    },
    {
      "id": "msg_0355_00185",
      "de_DE": [
        "Wenn du gegen uns kämpfen willst,\n",
        "bring mehr Pokémon mit."
      ]
    },
    {
      "id": "msg_0355_00186",
      "de_DE": [
        "Und ein weiterer erfolgreicher Tag\n",
        "geht zu Ende!\f",
        "Einen Toast auf meine Glücksfee!\r"
      ]
    },
    {
      "id": "msg_0355_00187",
      "de_DE": [
        "Seit ich mit ihr zusammen bin, habe ich\n",
        "an der Börse viel Erfolg!\r",
        "Ich surfe auf einer Glückswelle!\n",
        "Willst du wirklich mit uns kämpfen?\r"
      ]
    },
    {
      "id": "msg_0355_00188",
      "garbage": 0
    },
    {
      "id": "msg_0355_00189",
      "de_DE": [
        "Das ist nur ein kleinerer Rückschritt.\n",
        "Den mache ich mit links wieder wett!"
      ]
    },
    {
      "id": "msg_0355_00190",
      "de_DE": [
        "Ooh! Die Bilanzen sehen wieder sehr gut\n",
        "aus? Da war die Vorhersage ja richtig!\r"
      ]
    },
    {
      "id": "msg_0355_00191",
      "de_DE": [
        "Mein Freund ist ein Magier\n",
        "an der Börse!\r",
        "Wusstest du, dass jemand, der so viel\n",
        "Glück hat, ein starker Trainer ist?\r",
        "Willst du dein Glück herausfordern?\r"
      ]
    },
    {
      "id": "msg_0355_00192",
      "garbage": 0
    },
    {
      "id": "msg_0355_00193",
      "de_DE": [
        "Das ist ein einmaliger Verlust. Den\n",
        "gleichen wir schnell wieder aus!"
      ]
    },
    {
      "id": "msg_0355_00194",
      "de_DE": [
        "Es geht hier nicht um Technik.\r",
        "Du musst nur erkennen, wie es im\n",
        "Herzen deines Gegners aussieht.\r"
      ]
    },
    {
      "id": "msg_0355_00195",
      "de_DE": [
        "Wenn ich “Herz” sage, meine ich nicht\n",
        "das, was jemand denkt. Sondern das\r",
        "Wesen, das andere an ihnen\n",
        "wahrnehmen sollen.\r",
        "Möchtest... Möchtest du, dass ich dich\n",
        "als starken Trainer wahrnehme?\r"
      ]
    },
    {
      "id": "msg_0355_00196",
      "garbage": 0
    },
    {
      "id": "msg_0355_00197",
      "de_DE": [
        "Bei diesem Trainer hatte\n",
        "ich ein ungutes Gefühl..."
      ]
    },
    {
      "id": "msg_0355_00198",
      "de_DE": [
        "Nein, echt?!? Oooooh! Das ist klasse!\n",
        "Wie kannst du so etwas nur erkennen?\r"
      ]
    },
    {
      "id": "msg_0355_00199",
      "de_DE": [
        "Mein Freund erkennt genau, dass ich\n",
        "tief in meinem Inneren in Wahrheit ein\f",
        "ängstliches und schüchternes Kind bin!\r",
        "Aber ich weiß, dass ich mit ihm an meiner\n",
        "Seite einfach nicht verlieren kann.\f",
        "Soll ich dir das beweisen?\r"
      ]
    },
    {
      "id": "msg_0355_00200",
      "garbage": 0
    },
    {
      "id": "msg_0355_00201",
      "de_DE": [
        "Es ist erstaunlich, dass du deine\n",
        "Niederlage vorhergesehen hast!"
      ]
    },
    {
      "id": "msg_0355_00202",
      "de_DE": [
        "Lass uns dieses außergewöhnliche\n",
        "Mahl genießen und daran denken,\f",
        "für was es steht.\r",
        "Nehmen wir es als Motivation, im\n",
        "Leben stets nur zu gewinnen!\r"
      ]
    },
    {
      "id": "msg_0355_00203",
      "de_DE": [
        "Ich persönlich bin ja der Meinung, dass\n",
        "es zwei Arten von Menschen gibt.\r",
        "Die, die sich jeder Herausforderung\n",
        "stellen, und die, die sich vor jeder\f",
        "Herausforderung drücken.\r",
        "Du bist der Typ, der sich\n",
        "Herausforderungen stellt, stimmt’s?\r"
      ]
    },
    {
      "id": "msg_0355_00204",
      "garbage": 0
    },
    {
      "id": "msg_0355_00205",
      "de_DE": [
        "Könnte ich in die Zukunft blicken, wäre\n",
        "ich der Schrecken der Börsen.\f",
        "Aber so eine Fähigkeit gibt es nicht."
      ]
    },
    {
      "id": "msg_0355_00206",
      "de_DE": [
        "Wie schafft man es, Dinge, die in der\n",
        "Zukunft liegen, korrekt vorherzusagen?\r",
        "Hast du vielleicht doch die Gabe, in\n",
        "die Zukunft blicken zu können?!?\r"
      ]
    },
    {
      "id": "msg_0355_00207",
      "de_DE": [
        "Ich bin davon überzeugt, dass er \n",
        "besondere Sensoren oder so\f",
        "etwas besitzt.\r",
        "Ich bilde mit ihm ein Team. Bist du\n",
        "sicher, dass du uns herausfordern\f",
        "willst?\r"
      ]
    },
    {
      "id": "msg_0355_00208",
      "garbage": 0
    },
    {
      "id": "msg_0355_00209",
      "de_DE": [
        "Wenn es keine Vorhersage war, was...\n",
        "Hah! Kommst du etwa aus der Zukunft?!?"
      ]
    },
    {
      "id": "msg_0355_00210",
      "de_DE": [
        "Ein Pokémon reicht nicht, wenn\n",
        "du gegen uns antreten willst."
      ]
    },
    {
      "id": "msg_0355_00211",
      "de_DE": [
        "Wenn du zwei oder mehr Pokémon\n",
        "hast, können wir gegen dich kämpfen."
      ]
