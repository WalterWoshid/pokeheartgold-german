{
  "key": 1026,
  "messages": [
    {
      "id": "msg_0213_00000",
      "de_DE": [
        "Hallo, mein Name ist Raissa.\n",
        "Und du bist...?\r",
        "Oh, du bist also {STRVAR_1 3, 0}.\n",
        "Es freut mich sehr, dich\f",
        "kennenzulernen.\r",
        "{STRVAR_1 3, 0}, darf ich dich um einen\n",
        "Gefallen bitten?\r",
        "Ich möchte durch den Wald gehen,\n",
        "aber allein habe ich Angst.\r",
        "Ich habe gehört, dass hier einige\n",
        "dunkle Gestalten herumlaufen, die\f",
        "sich Team Galaktik nennen.\r",
        "Ich denke, wenn man nicht allein\n",
        "geht, ist man auf jeden Fall sicherer.\f",
        "Kann ich bitte mit dir gehen?!?\r"
      ]
    },
    {
      "id": "msg_0213_00001",
      "de_DE": [
        "{STRVAR_1 3, 0} entscheidet sich, \n",
        "zusammen mit Raissa zu gehen!"
      ]
    },
    {
      "id": "msg_0213_00002",
      "de_DE": [
        "Raissa: Ich werde deine Pokémon\n",
        "stets in Topform halten."
      ]
    },
    {
      "id": "msg_0213_00003",
      "de_DE": [
        "Raissa: Oh, hi, {STRVAR_1 3, 0}!\r",
        "Ich habe hier auf dich gewartet,\n",
        "wie ich es versprochen hatte.\r",
        "Komm, gehen wir zusammen\n",
        "durch den Wald.\r"
      ]
    },
    {
      "id": "msg_0213_00004",
      "de_DE": [
        "Raissa: Oh? Gehst du schon zurück?\n",
        "Dann warte ich auf dich. Versprochen.\r"
      ]
    },
    {
      "id": "msg_0213_00005",
      "de_DE": [
        "Raissa: Oh! Da ist der Ausgang!\r",
        "Jetzt fällt mir ein Stein vom Herzen...\n",
        "Wir haben es echt geschafft!\r",
        "Allein wäre ich niemals durch\n",
        "den Wald gegangen.\r",
        "Vielen, vielen Dank, {STRVAR_1 3, 0}!\r"
      ]
    },
    {
      "id": "msg_0213_00006",
      "de_DE": [
        "Ich bin mir sicher, dass wir uns\n",
        "irgendwann nochmal begegnen.\f",
        "Bis dahin alles Gute!\r"
      ]
    },
    {
      "id": "msg_0213_00007",
      "de_DE": [
        "Mein Pokémon wurde vergiftet und\n",
        "kann daher jetzt nicht kämpfen.\r",
        "Ich wusste, ich hätte Gegengift im\n",
        "Pokémon-Supermarkt kaufen sollen!"
      ]
    },
    {
      "id": "msg_0213_00008",
      "de_DE": [
        "Der Stein ist von Moos bedeckt.\n",
        "Das fühlt sich herrlich kühl an."
      ]
    },
    {
      "id": "msg_0213_00009",
      "de_DE": [
        "Silvana: Hallo da! Hast du auch die\n",
        "vielen Gerüchte gehört und bist\f",
        "deshalb hier hergekommen?!?\r"
      ]
    },
    {
      "id": "msg_0213_00010",
      "de_DE": [
        "Du weißt schon, die Gerüchte über das\n",
        "Geist-Pokémon in der Alten Villa!\r",
        "Ich habe auch Gerüchte über\n",
        "unheimliche Schatten gehört.\r"
      ]
    },
    {
      "id": "msg_0213_00011",
      "de_DE": [
        "Ich würde ja selber hineingehen,\n",
        "aber das ist...\r",
        "...Äh, weißt du, ich bin nämlich ein\n",
        "Arenaleiter und immer sehr beschäftigt.\r",
        "Und da ich so beschäftigt bin, schaffe\n",
        "ich es nicht, in die Villa zu gehen.\r",
        "Das liegt aber nicht daran, dass ich\n",
        "Angst habe oder so!!!\r",
        "A-also viel Erfolg, wenn du die\n",
        "Villa erforschst!\r"
      ]
    },
    {
      "id": "msg_0213_00012",
      "de_DE": [
        "Ewigwald\n",
        "Und die Zeit steht still"
      ]
    },
    {
      "id": "msg_0213_00013",
      "de_DE": [
        "Tipps für Trainer\r",
        "In Wäldern und Höhlen gibt es\n",
        "viele Items, die man aufgrund der\f",
        "Dunkelheit nicht sofort entdeckt.\r",
        "Also nimm dir die Zeit, gründlich\n",
        "zu suchen!"
      ]
    }
  ]
}
