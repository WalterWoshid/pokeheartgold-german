      ]
    },
    {
      "id": "msg_0203_00079",
      "de_DE": [
        "Wir erwarten noch große Taten von dem\n",
        "Gewinnerteam {STRVAR_1 3, 0} und\f",
        "{STRVAR_1 1, 1}!\r"
      ]
    },
    {
      "id": "msg_0203_00080",
      "de_DE": [
