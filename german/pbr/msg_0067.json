{
  "key": 25627,
  "messages": [
    {
      "id": "msg_0067_00000",
      "de_DE": [
        "Du, hör mal! Hast du ein Pokémon\n",
        "namens MACHOLLO?!?\r",
        "Würdest du dein MACHOLLO vielleicht\n",
        "gegen mein ABRA tauschen?!?"
      ]
    },
    {
      "id": "msg_0067_00001",
      "de_DE": [
        "Sei nett zu meinem ABRA!\r",
        "Ich werde ganz sicher gut\n",
        "auf dein MACHOLLO aufpassen!"
      ]
    },
    {
      "id": "msg_0067_00002",
      "de_DE": "Ich möchte doch ein MACHOLLO haben..."
    },
    {
      "id": "msg_0067_00003",
      "de_DE": [
        "Oh, ja...\n",
        "Nun, dann können wir nicht tauschen.\r",
        "Aber wenn du es dir anders überlegst,\n",
        "dann komm einfach wieder. Ich bin hier!"
      ]
    },
    {
      "id": "msg_0067_00004",
      "de_DE": [
        "Dank unserer Pokémon habe ich mich\n",
        "mit dir angefreundet!"
      ]
    },
    {
      "id": "msg_0067_00005",
      "de_DE": [
        "Ein Pokémon, das du durch Tausch\n",
        "erhältst, wächst schnell.\r",
        "Aber wenn dir Orden von bestimmten\n",
        "Arenen fehlen, wird es dir eventuell\r",
        "nicht gehorchen."
      ]
    }
  ]
}
