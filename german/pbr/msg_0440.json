  "key": 21176,
  "messages": [
    {
      "id": "msg_0440_00000",
      "de_DE": [
        "Wusstest du, dass du im Trophäengarten\n",
        "Pokémon fangen kannst?\r",
        "Und wenn du das einem gefangenen\n",
        "Pokémon gibst, wird es schneller\f",
        "freundlich.\r",
        "Ich gebe dir etwas davon ab, also\n",
        "versuch es mal.\r"
      ]
    },
    {
      "id": "msg_0440_00001",
      "de_DE": [
        "Ich hoffe, du wirst ein Trainer,\n",
        "den die Pokémon lieben und\f",
        "dem sie vertrauen können."
      ]
    },
    {
      "id": "msg_0440_00002",
      "de_DE": [
        "Ich faulenze doch gar nicht!!!\n",
        "Ich mache nur eine kleine Pause!"
      ]
    }
  ]
}
