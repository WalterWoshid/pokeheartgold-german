    {
      "id": "msg_0576_00155",
      "de_DE": [
        "Willkommen im Konnex-Klub.\n",
        "Sag Bescheid, wenn ich dir helfen kann."
      ]
    },
    {
      "id": "msg_0576_00156",
      "de_DE": "Wie kann ich dir helfen?"
    },
    {
      "id": "msg_0576_00157",
      "de_DE": "Welches Thema soll ich dir erklären?"
    },
    {
      "id": "msg_0576_00158",
      "de_DE": [
        "Im Konnex-Klub kannst du mit zwei\n",
        "Pokémon deiner Wahl kämpfen, wenn\f",
        "ihr Level 30 oder niedriger ist.\r",
        "Wenn du also hierher kommst, solltest\n",
        "du entsprechende Pokémon mitbringen.\r"
      ]
    },
    {
      "id": "msg_0576_00159",
      "de_DE": [
        "Du kannst Pokémon mit anderen Spielern\n",
        "tauschen.\r",
        "Je mehr Spieler du kennst, desto eher\n",
        "könnte ein seltenes Pokémon dabei sein!\r"
      ]
    },
    {
      "id": "msg_0576_00160",
      "de_DE": [
        "Du kannst mit anderen Spielern\n",
        "kommunizieren und Statistiken\f",
        "austauschen.\r",
        "Was dieser Statistiktausch bringen soll,\n",
        "fragst du?\r",
        "Tja, versuch es doch einfach mal!\r",
        "Bis zu fünf Spieler können daran\n",
        "teilnehmen, also versuch es mal mit\f",
        "deinen Freunden!\r"
      ]
    },
    {
      "id": "msg_0576_00161",
      "garbage": 0
    },
    {
      "id": "msg_0576_00162",
      "de_DE": [
        "Du kannst dich mit anderen Spielern\n",
        "treffen, um zu zeichnen.\r",
        "Ihr könnt alle am gleichen Blatt\n",
        "arbeiten - und zwar gleichzeitig.\r",
        "Eine Zeichnung von Freunden ist ein\n",
        "wunderschönes Erinnerungsstück!\r",
        "Bis zu fünf Spieler können daran\n",
        "teilnehmen, also versuch es mal mit\f",
        "deinen Freunden!\r"
      ]
    },
    {
      "id": "msg_0576_00163",
      "de_DE": [
        "Beginne einen Chat mit anderen Spielern,\n",
        "indem du im Menü “CHAT” wählst.\r",
        "Im Konnex-Klub kannst du die\n",
        "unterschiedlichsten Leute treffen!\r",
        "Unterhalte dich mit ihnen. Plant, was ihr\n",
        "gemeinsam machen wollt.\r",
        "Erweitere deinen Freundeskreis -\n",
        "und deinen Horizont!\r"
      ]
    },
    {
      "id": "msg_0576_00164",
      "de_DE": [
        "Oh!\n",
        "Da kommt jemand!\r",
        "Sprich doch lieber mit dem Neuankömmling\n",
        "als mit mir.\r"
      ]
    },
    {
      "id": "msg_0576_00165",
      "de_DE": [
        "Es ist so langweilig, wenn niemand\n",
        "vorbeikommt...\r",
        "Womit könnten wir uns denn die Zeit\n",
        "vertreiben...?\r"
      ]
    },
    {
      "id": "msg_0576_00166",
      "de_DE": [
        "Wirst du manchmal mit einem\n",
        "echten {STRVAR_1 14, 0} verwechselt?\r",
        "So kommst du mir zumindest vor.\r"
      ]
    },
    {
      "id": "msg_0576_00167",
      "de_DE": [
        "Hallo!\r",
        "So ist es!\n",
        "Der Gruß ist wichtig!\r",
        "Wenn jemand neu ist und hereinkommt,\n",
        "sollte man immer freundlich sein!\r"
      ]
    },
    {
      "id": "msg_0576_00168",
      "de_DE": [
        "Grüß dich!\r",
        "{STRVAR_1 28, 0}?\n",
        "Wunderschön!\f",
        "Mir gefällt es auch!\r",
        "Wenn du jemanden zum ersten Mal\n",
        "triffst, solltest du so höflich sein und\f",
        "dich vorstellen.\r",
        "Dadurch erfährst du dann auch etwas\n",
        "über die andere Person!\r"
      ]
    },
    {
      "id": "msg_0576_00169",
      "de_DE": [
        "{STRVAR_1 28, 0}-Trainer?\n",
        "Das also bist du?\f",
        "Was du nicht sagst!\r",
        "Aber ich habe gar keine Pokémon...\r",
        "Ich schaue lieber zu, als selber zu\n",
        "kämpfen, weißt du?\r"
      ]
    },
    {
      "id": "msg_0576_00170",
      "de_DE": [
        "Oh! Dein {STRVAR_1 28, 0}!\n",
        "Ich würde es so gerne haben!\f",
        "Lass uns tauschen!\r",
        "...\r",
        "Nur ein Scherz.\r",
        "Ich habe gar keine Pokémon, also kann\n",
        "ich auch nicht tauschen...\r"
      ]
    },
    {
      "id": "msg_0576_00171",
      "de_DE": [
        "{STRVAR_1 28, 0}? Ich kann verstehen,\n",
        "dass du so etwas möchtest...\r",
        "Aber sei nicht egoistisch.\r",
        "Wenn du tauschst, musst du auch\n",
        "berücksichtigen, welches Pokémon\f",
        "die andere Person gerne hätte.\r"
      ]
    },
    {
      "id": "msg_0576_00172",
      "de_DE": [
        "Willkommen im Konnex-Klub!\r",
        "Ich bin zurzeit allein hier, also bring\n",
        "bitte alle deine Freunde mit.\r",
        "Dann haben wir hier unseren Spaß!\r",
        "Wenn du Zeit hast, bin ich auch hier, um\n",
        "ein wenig zu plaudern.\r",
        "Ich habe nämlich sehr viel Zeit...\r"
      ]
    },
    {
      "id": "msg_0576_00173",
      "de_DE": [
        "Ich kann besonders gut zeichnen!\r",
        "Wenn es um {STRVAR_1 28, 0} geht,\n",
        "überlass das nur mir!\f",
        "Das kann niemand besser als ich!\r"
      ]
    },
    {
      "id": "msg_0576_00174",
      "de_DE": [
        "Oh, du gehst schon...\r",
        "...\r",
        "Ich bin doch so einsam...\r",
        "Bitte komme wieder!\r"
      ]
    },
    {
      "id": "msg_0576_00175",
      "de_DE": [
        "Was ist denn los?\n",
        "Bist du traurig?\r",
        "Wenn du niedergeschlagen bist, solltest\n",
        "du Zeit mit deinen Freunden verbringen!\f",
        "Das ist schöner, als allein zu leiden.\r"
      ]
    },
    {
      "id": "msg_0576_00176",
      "de_DE": [
        "{STRVAR_1 28, 0}?\n",
        "Ja bitte!\r",
        "...Ich würde so gerne mitmachen, aber\n",
        "ich bin im Dienst...\r",
        "Seufz... {STRVAR_1 28, 0}...\n",
        "Ich wünschte, ich könnte...\r"
      ]
    },
    {
      "id": "msg_0576_00177",
      "de_DE": [
        "{STRVAR_1 28, 0}?\n",
        "Ich auch, bitte!\r",
        "Aber ich muss leider hierbleiben und\n",
        "mich um die Besucher kümmern...\r",
        "Hab du zumindest viel Spaß!\r"
      ]
    },
    {
      "id": "msg_0576_00178",
      "de_DE": [
        "{STRVAR_1 28, 0}?\n",
        "Du lädst mich ein?\r",
        "Oh, aber ich muss doch hierbleiben\n",
        "und mich um die Besucher kümmern.\r",
        "Tut mir leid. Ich würde gerne mitmachen,\n",
        "aber ich kann einfach nicht.\r"
      ]
    },
    {
      "id": "msg_0576_00179",
      "de_DE": [
        "So ist es!\r",
        "Manchmal muss man einfach andere\n",
        "Leute einladen.\r",
        "Aber sei nicht zu eifersüchtig,\n",
        "wenn du {STRVAR_1 28, 0} wählst.\r"
      ]
    },
    {
      "id": "msg_0576_00180",
      "de_DE": [
        "Ja!\n",
        "Schon in Ordnung!\r",
        "Unmöglich ist gar nichts.\r",
        "Positiv denken und den Kopf nicht\n",
        "hängen lassen!\r"
      ]
    },
    {
      "id": "msg_0576_00181",
      "de_DE": [
        "Jeder hat mindestens ein Gebiet, auf\n",
        "dem er oder sie nicht gut ist.\r",
        "Zwinge niemanden, etwas zu tun, das der\n",
        "andere nicht möchte.\r",
        "Ich zum Beispiel würde gerne\n",
        "{STRVAR_1 28, 0} wählen.\r"
      ]
    },
    {
      "id": "msg_0576_00182",
      "de_DE": [
        "Viel Glück! Ich hoffe, du magst\n",
        "ernsthafte, harte Kämpfe.\r",
        "Solche kannst du nämlich nicht im\n",
        "Konnex-Klub finden!\r"
      ]
    },
    {
      "id": "msg_0576_00183",
      "de_DE": [
        "Willst du plaudern?\r",
        "Verschwende deine Zeit doch nicht mit\n",
        "mir.\r",
        "Sei aktiv. Suche dir andere Spieler und\n",
        "plaudere mit ihnen.\r",
        "Ohne Kommunikation kannst du keine\n",
        "neuen Freunde kennenlernen.\r"
      ]
    },
    {
      "id": "msg_0576_00184",
      "de_DE": [
        "Wo du bist?\n",
        "Ähm... Direkt vor meiner Nase.\r",
        "Oh!\n",
        "Bist du ein Hochstapler?\r",
        "Ist der echte Spieler woanders?\r",
        "...Das ist ja lächerlich!\n",
        "Erzähl doch keinen Unsinn!\f",
        "Meine Güte!\r"
      ]
    },
    {
      "id": "msg_0576_00185",
      "de_DE": [
        "{STRVAR_1 28, 0}-Tausch?\n",
        "Klingt gut!\f",
        "Würde ich auch gerne machen.\r",
        "Aber bei mir bist du an der falschen\n",
        "Adresse. Ich kann nicht tauschen.\r"
      ]
    },
    {
      "id": "msg_0576_00186",
      "de_DE": [
        "Wenn du einen {STRVAR_1 28, 0}-Kampf\n",
        "möchtest, musst du andere Spieler\f",
        "direkt darauf ansprechen.\r",
        "Solange du keine Entschlossenheit\n",
        "zeigst, hast du gar keine Chance auf\f",
        "einen {STRVAR_1 28, 0}-Kampf!\r"
      ]
    },
