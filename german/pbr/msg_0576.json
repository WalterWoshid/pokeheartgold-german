    },
    {
      "id": "msg_0576_00058",
      "de_DE": [
        "Danke, dass du gewartet hast!\n",
        "Lass uns beginnen!"
      ]
    },
    {
      "id": "msg_0576_00059",
      "de_DE": [
        "Entschuldige, aber meine Pokémon\n",
        "fühlen sich momentan nicht wohl.\f",
        "Lass uns ein andermal kämpfen!"
      ]
    },
    {
      "id": "msg_0576_00060",
      "de_DE": [
        "Für einen Kampf benötigst du\n",
        "zwei Pokémon, deren Level\f",
        "höchstens 30 ist.\r"
      ]
    },
    {
      "id": "msg_0576_00061",
      "de_DE": [
        "Wow!\n",
        "Du bist aber stark!"
      ]
    },
    {
