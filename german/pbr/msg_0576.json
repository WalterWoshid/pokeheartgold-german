    {
      "id": "msg_0576_00037",
      "de_DE": [
        "{STRVAR_1 28, 2}{PAUSE 15}\r",
        "Hier ist {STRVAR_1 3, 0}!\n",
        "Was würdest du gerne machen?"
      ]
    },
    {
      "id": "msg_0576_00038",
      "de_DE": [
        "Oh! Entschuldige, aber ich\n",
        "muss noch etwas erledigen.\f",
        "Ein andermal, okay?"
      ]
    },
    {
      "id": "msg_0576_00039",
      "de_DE": "Möchtest du noch etwas tun?"
    },
    {
      "id": "msg_0576_00040",
      "de_DE": [
        "...\n",
        "Der Trainer scheint beschäftigt zu sein."
      ]
    },
    {
      "id": "msg_0576_00041",
      "garbage": 0
    },
    {
      "id": "msg_0576_00042",
      "de_DE": [
        "Gerne! Zum “Gruß” zeige\n",
        "ich dir meinen Trainerkoffer."
      ]
    },
    {
      "id": "msg_0576_00043",
      "de_DE": [
        "Häh? Mein Trainerkoffer...\n",
        "Wo ist er denn?\r",
        "Sorry, ich zeige ihn dir später!"
      ]
    },
    {
      "id": "msg_0576_00044",
      "de_DE": [
        "Ich zeige zur Begrüßung meinen\n",
        "Trainerkoffer."
      ]
    },
    {
      "id": "msg_0576_00045",
      "de_DE": [
        "Ich hoffe, ich lerne dich\n",
        "besser kennen!"
      ]
    },
    {
      "id": "msg_0576_00046",
      "de_DE": [
        "Oh, möchtest du mit mir zeichnen?\n",
        "Gerne. Einen Augenblick noch."
      ]
    },
    {
      "id": "msg_0576_00047",
      "de_DE": [
        "Danke, dass du gewartet hast.\n",
        "Lass uns zeichnen!"
      ]
    },
    {
      "id": "msg_0576_00048",
      "de_DE": [
        "Es tut mir leid, aber ich kann jetzt\n",
        "nicht. Ein andermal, okay?"
      ]
    },
    {
      "id": "msg_0576_00049",
      "de_DE": [
        "{STRVAR_1 3, 0}: Wir zeichnen gerade.\r",
        "Ach so! {STRVAR_1 3, 1}, möchtest du mit\n",
        "uns zusammen zeichnen?"
      ]
    },
    {
      "id": "msg_0576_00050",
      "de_DE": [
        "Oh, in Ordnung!\n",
        "Gib mir einfach Bescheid, okay?"
      ]
    },
    {
      "id": "msg_0576_00051",
      "de_DE": "Ja. Lass uns gemeinsam zeichnen!"
    },
    {
      "id": "msg_0576_00052",
      "garbage": 0
    },
    {
      "id": "msg_0576_00053",
      "de_DE": [
        "Der letzte Buchstabe deiner Zeichnung\n",
        "muss der erste Buchstabe meiner\f",
        "Zeichnung sein?"
      ]
    },
    {
      "id": "msg_0576_00054",
      "de_DE": [
