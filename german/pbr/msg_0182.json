{
  "key": 53290,
  "messages": [
    {
      "id": "msg_0182_00000",
      "de_DE": [
        "Eibe: Lange ist es her, dass ich\n",
        "diesen Raum betreten habe...\r"
      ]
    },
    {
      "id": "msg_0182_00001",
      "de_DE": [
        "Eibe: Egal, wie oft ich herkomme,\n",
        "es scheint, ich stehe aufrechter,\f",
        "als das sonst der Fall ist.\r"
      ]
    },
    {
      "id": "msg_0182_00002",
      "de_DE": [
        "Cynthia: Zuletzt war ich in diesem Raum,\n",
        "als ich zum Champ gekrönt wurde.\r",
        "Das ist auch schon ein gutes\n",
        "Weilchen her.\r"
      ]
    },
    {
      "id": "msg_0182_00003",
      "de_DE": [
        "Cynthia: Das ist eine nur zu natürliche\n",
        "Reaktion, Herr Professor.\r",
        "Dieser Raum steht für die\n",
        "Hoffnungen und Träume aller\f",
        "Pokémon und ihrer Trainer.\r",
        "Und für alle Hindernisse, die sie\n",
        "auf dem Weg überwinden mussten.\r"
      ]
    },
    {
      "id": "msg_0182_00004",
      "de_DE": [
        "Cynthia: {STRVAR_1 3, 0}, willkommen\n",
        "in der Ruhmeshalle.\r"
      ]
    },
    {
      "id": "msg_0182_00005",
      "de_DE": [
        "Cynthia: {STRVAR_1 3, 0}, willkommen\n",
        "in der Ruhmeshalle.\r"
      ]
    },
    {
      "id": "msg_0182_00006",
      "de_DE": [
        "Eure Namen werden hier für\n",
        "die Nachwelt festgehalten.\r",
        "Hier verewigst du die Erinnerungen\n",
        "an eure bisherigen Abenteuer.\r",
        "Wir werden nun eure Namen eintragen.\n",
        "Deinen und die deiner Pokémon.\r",
        "Vergiss nicht, deine Pokémon\n",
        "sind deine Partner.\r",
        "Zusammen seid ihr in zahlreichen Kämpfen\n",
        "zu dem herangewachsen, was ihr seid.\r",
        "Diese Maschine nimmt einen permanenten\n",
        "Eintrag eurer Errungenschaften vor.\r"
      ]
    }
  ]
}
