{
  "key": 18355,
  "messages": [
    {
      "id": "msg_0167_00000",
      "de_DE": [
        "Nur Auserwählte dürfen den\n",
        "Tempel von Blizzach betreten.\r",
        "Es tut mir leid, du musst wieder gehen.\r"
      ]
    },
    {
      "id": "msg_0167_00001",
      "de_DE": [
        "Nur Auserwählte dürfen den\n",
        "Tempel von Blizzach betreten.\r",
        "Es tut mir leid, du musst wieder gehen."
      ]
    },
    {
      "id": "msg_0167_00002",
      "de_DE": [
        "Der Tempel soll in der\n",
        "Antike errichtet worden sein.\r",
        "Zu Ehren der Gestein-, Eis- und\n",
        "Stahl-Pokémon, die das Land formten.\r",
        "Jedenfalls sagt man das."
      ]
    },
    {
      "id": "msg_0167_00003",
      "de_DE": [
        "Frida: Das ist in Ordnung!\n",
        "Diese Person darf hinein.\r"
      ]
    },
    {
      "id": "msg_0167_00004",
      "de_DE": [
        "Cynthia hat es mir erzählt.\r",
        "Du arbeitest an einem\n",
        "Pokédex, nicht wahr?\r",
        "Im Tempel wirst du bestimmt\n",
        "viele seltene Pokémon finden.\r",
        "Viel Spaß beim Erforschen!"
      ]
    },
    {
      "id": "msg_0167_00005",
      "de_DE": [
        "Brrr... In diesem eingeschneiten Ort\n",
        "herrscht immer bittere Eiseskälte.\r",
        "Aber der Kampfgeist der Trainer und\n",
        "ihrer Pokémon ist wie ein glühender\f",
        "Hitzestein, der uns alle wärmt.\r",
        "Besonders der der Arenaleiterin.\n"
      ]
    },
    {
      "id": "msg_0167_00006",
      "de_DE": [
        "Uuuh, sag mal, ist dir nicht kalt, nur so\n",
        "mit dem Schal um den Hals? Buarr!"
      ]
    },
    {
      "id": "msg_0167_00007",
      "de_DE": [
        "Willst du zum Tempel von Blizzach?\n",
        "Du weißt, dass du da nicht hineindarfst?"
      ]
    },
    {
      "id": "msg_0167_00008",
      "de_DE": [
        "Willst du zum Tempel von Blizzach?\n",
        "Da gibt es großartige Pokémon!"
      ]
    },
    {
      "id": "msg_0167_00009",
      "de_DE": [
        "Frida bringt mir alles über Pokémon bei!\r",
        "Sie sagt, dass man zu Beginn erst mal\n",
        "Freundschaft mit ihnen schließen muss."
      ]
    },
    {
      "id": "msg_0167_00010",
      "de_DE": [
        "Ja, was gibt’s? Soll ich dich\n",
        "zur Duellzone bringen?"
      ]
    },
    {
      "id": "msg_0167_00011",
      "de_DE": [
        "Also gut!\n",
        "Lichten wir den Anker!\r"
      ]
    },
    {
      "id": "msg_0167_00012",
      "de_DE": [
        "Nein?!?\n",
        "Nun, so einfach kommst du\f",
        "aber nicht zur Duellzone!\r",
        "Das Meer dort ist sehr rau\n",
        "und die Wellen meterhoch.\r",
        "Kein Pokémon kann dort\n",
        "Surfer einsetzen."
      ]
    },
    {
      "id": "msg_0167_00013",
      "de_DE": [
        "Ein großer Trainer, der von der\n",
        "Pokémon Liga anerkannt wird...\r",
        "Ich warte schon lange auf so einen\n",
        "Trainer, den ich hinausfahren darf!"
      ]
    },
    {
      "id": "msg_0167_00014",
      "de_DE": [
        "Hier gibt es nichts im Umkreis!\n",
        "Und das macht uns einzigartig."
      ]
    },
    {
      "id": "msg_0167_00015",
      "de_DE": [
        "Blizzach\n",
        "Heimat des Schnees"
      ]
    },
    {
      "id": "msg_0167_00016",
      "de_DE": [
        "Pokémon Arena Blizzach\n",
        "Leiterin: Frida\f",
        "Das Diamantstaub-Mädchen!"
      ]
    }
  ]
}
