  "messages": [
    {
      "id": "msg_0130_00000",
      "de_DE": [
        "Ich wandere durch ganz Sinnoh.\r",
        "Ich liebe es, überall Beeren\n",
        "zu pflanzen.\r",
        "Ich werde dir auch eine Beere geben.\n",
        "Bitte pflanz sie irgendwo ein.\r"
      ]
    },
    {
      "id": "msg_0130_00001",
      "de_DE": [
        "Das Pflanzen von Beeren ist gut\n",
        "für die Pokémon.\r",
        "Dadurch haben sie in der Wildnis\n",
        "mehr Nahrungsquellen."
      ]
    },
    {
      "id": "msg_0130_00002",
      "de_DE": [
        "Meine Schwester sammelt täglich\n",
        "Beeren! Bitte besuch uns bald wieder.\r",
        "Wir kochen auch Beeren!\n",
        "Wir mischen sie! Sie sind lecker!!!"
      ]
    }
  ]
}
