      "id": "msg_0480_00000",
      "de_DE": [
        "Hast du nach mir gesucht?\n",
        "Hast du mich etwa vermisst?\r",
        "Hätte ich doch nur eine weitere Weisheit\n",
        "für dich parat, aber Fehlanzeige!\r",
        "Also muss ich das hiermit\n",
        "wieder wettmachen!\r"
      ]
    },
    {
      "id": "msg_0480_00001",
      "de_DE": [
        "Ich kann dir keine weisen Ratschläge\n",
        "mitgeben, das hier muss ausreichen!\r",
        "Gold muss doch mehr wert sein\n",
        "als ein Quäntchen Weisheit!"
      ]
    },
    {
      "id": "msg_0480_00002",
      "de_DE": [
        "Route 229\n",
        "Erholungsgebiet"
      ]
    }
  ]
}
