    },
    {
      "id": "msg_0283_00070",
      "de_DE": [
        "Glückwunsch zum Erreichen von\n",
        "Rang {STRVAR_1 51, 0}.\r",
        "Dein Pokémon-Siegerteam erhält\n",
        "spezielle Bänder für diesen Erfolg!"
      ]
