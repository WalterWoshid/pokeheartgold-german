{
  "key": 9338,
  "messages": [
    {
      "id": "msg_0283_00000",
      "de_DE": [
        "Willkommen im Duellturm!\r",
        "Ich bin die Anweiserin für die\n",
        "Einzel- und Doppelkampfräume.\r"
      ]
    },
    {
      "id": "msg_0283_00001",
      "de_DE": [
        "Möchtest du die Herausforderung\n",
        "des Kampfraumes beginnen?"
      ]
    },
    {
      "id": "msg_0283_00002",
      "de_DE": "Hoffentlich kommst du bald wieder!"
    },
    {
      "id": "msg_0283_00003",
      "de_DE": [
        "In den Kampfräumen für Einzelkämpfe\n",
        "des Duellturms werden Einzelkämpfe\f",
        "mit 3 Pokémon ausgetragen.\r",
        "Es gibt aber auch Räume für\n",
        "Doppelkämpfe im Duellturm, in denen\f",
        "mit 4 Pokémon gekämpft wird.\r",
        "Es gibt viele Räume hier für Teamkämpfe.\r",
        "In jedem dieser Räume warten sieben\n",
        "Trainer auf deine Herausforderung.\r",
        "Schaffst du es, alle sieben zu besiegen,\n",
        "erhältst du Gewinnpunkte (GP).\r",
        "Willst du den Kampf unterbrechen,\n",
        "speichere bitte dein Spiel.\r",
        "Speicherst du es nicht, wirst du\n",
        "disqualifiziert.\r"
      ]
    },
    {
      "id": "msg_0283_00004",
      "de_DE": [
        "Welchen Kampfraum möchtest du wählen?\n",
        "Einzel oder Doppel?"
      ]
    },
    {
      "id": "msg_0283_00005",
      "garbage": 0
    },
    {
      "id": "msg_0283_00006",
      "garbage": 0
    },
    {
      "id": "msg_0283_00007",
      "garbage": 0
    },
    {
      "id": "msg_0283_00008",
      "de_DE": [
        "Wähle die Pokémon,\n",
        "die teilnehmen sollen.\r"
      ]
    },
    {
      "id": "msg_0283_00009",
      "de_DE": [
        "Du kannst nur mit unterschiedlichen\n",
        "Pokémon antreten!\r"
      ]
    },
    {
      "id": "msg_0283_00010",
      "de_DE": [
        "Nur unterschiedliche Items\n",
        "dürfen getragen werden.\r"
      ]
    },
    {
      "id": "msg_0283_00011",
      "de_DE": [
        "Ich werde dir jetzt den\n",
        "Kampfraum zeigen."
      ]
    },
    {
      "id": "msg_0283_00012",
      "de_DE": [
        "Herzlichen Glückwunsch!\n",
        "Alle 7 Kämpfe wurden gewonnen!\r"
      ]
    },
    {
      "id": "msg_0283_00013",
      "de_DE": [
        "Herzlichen Glückwunsch!\n",
        "Du hast den Kampfkoloss besiegt!\r",
        "In Anerkennung deines herausragenden\n",
        "Talents geben wir dir Gewinnpunkte.\r",
        "{STRVAR_1 3, 0} erhält {STRVAR_1 50, 1} GP.\r"
      ]
    },
    {
      "id": "msg_0283_00014",
      "de_DE": [
        "Speichervorgang...\n",
        "Bitte das System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0283_00015",
      "de_DE": "Komm bald wieder!"
    },
    {
      "id": "msg_0283_00016",
      "de_DE": [
        "Wir haben schon auf dich gewartet!\r",
        "Bevor du einen Kampfraum betrittst,\n",
        "wird dein Spiel gespeichert.\r",
        "Speichervorgang... Bitte das\n",
        "System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0283_00017",
      "garbage": 0
    },
    {
      "id": "msg_0283_00018",
      "garbage": 0
    },
    {
      "id": "msg_0283_00019",
      "de_DE": [
        "Entschuldigung!\r",
        "Du hast die letzte Herausforderung\n",
        "abgebrochen.\r",
        "Wir müssen dich daher für diese\n",
        "Herausforderung disqualifizieren!\r"
      ]
    },
    {
      "id": "msg_0283_00020",
      "de_DE": [
        "Willkommen im Duellturm!\r",
        "Ich begleite dich durch die\n",
        "Räume des Multikampfs.\r"
      ]
    },
    {
      "id": "msg_0283_00021",
      "de_DE": [
        "Möchtest du dich der Herausforderung\n",
        "im Multikampf stellen?"
      ]
    },
    {
      "id": "msg_0283_00022",
      "garbage": 0
    },
    {
      "id": "msg_0283_00023",
      "de_DE": [
        "In den Multikampf-Räumen des Duell-\n",
        "turms werden Multikämpfe ausgetragen.\r",
        "Um an einem Multikampf teilnehmen\n",
        "zu können, musst du mit einem\f",
        "Trainer im Turm ein Team bilden.\r",
        "Jeder von euch geht mit 2 Pokémon\n",
        "in den Kampf.\r",
        "Im Turm gibt es eine Teamlounge.\n",
        "Hier triffst du andere Trainer.\r",
        "Finde einen Partner, der mit dir\n",
        "an einem Multikampf teilnimmt.\r",
        "Hast du einen Partner gefunden, kannst\n",
        "du in den Multikampf-Raum gehen.\r",
        "Hier warten 7 Teams auf euch.\r",
        "Schafft ihr es, alle sieben zu besiegen,\n",
        "erhältst du Gewinnpunkte.\r",
        "Willst du den Kampf unterbrechen,\n",
        "speichere bitte dein Spiel.\r",
        "Speicherst du es nicht, wirst du\n",
        "disqualifiziert.\r",
        "Befindest du dich in einem\n",
        "Teamkampf mit einem Freund, kannst\f",
        "du den Kampf nicht unterbrechen.\r"
      ]
    },
    {
      "id": "msg_0283_00024",
      "garbage": 0
    },
    {
      "id": "msg_0283_00025",
      "garbage": 0
    },
    {
      "id": "msg_0283_00026",
      "de_DE": [
        "Möchtest du dich mit einem Freund\n",
        "verbinden, um ein Team zu bilden?"
      ]
    },
    {
      "id": "msg_0283_00027",
      "de_DE": [
        "Bitte legt fest, wer von euch der\n",
        "“LEITER” ist.\r",
        "Der andere Spieler wählt\n",
        "“MITSPIELER” aus."
      ]
    },
    {
      "id": "msg_0283_00028",
      "garbage": 0
    },
    {
      "id": "msg_0283_00029",
      "garbage": 0
    },
    {
      "id": "msg_0283_00030",
      "garbage": 0
    },
    {
      "id": "msg_0283_00031",
      "garbage": 0
    },
    {
      "id": "msg_0283_00032",
      "de_DE": [
        "Ich führe dich jetzt zum\n",
        "Kampfraum für den Multikampf."
      ]
    },
    {
      "id": "msg_0283_00033",
      "de_DE": [
        "Beide Trainer wählten das\n",
        "Pokémon {STRVAR_1 0, 0}.\r",
        "Bespreche dich mit dem\n",
        "anderen Trainer.\r",
        "Einer von euch muss ein\n",
        "anderes Pokémon wählen.\r"
      ]
    },
    {
      "id": "msg_0283_00034",
      "de_DE": [
        "Beide Trainer wählten die\n",
        "Pokémon {STRVAR_1 0, 0} und\f",
        "{STRVAR_1 0, 1}.\r",
        "Bespreche dich mit dem\n",
        "anderen Trainer.\r",
        "Einer von euch muss\n",
        "andere Pokémon wählen.\r"
      ]
    },
    {
      "id": "msg_0283_00035",
      "de_DE": "Ich zeige dir die Teamlounge.\r"
    },
    {
      "id": "msg_0283_00036",
      "de_DE": [
        "Willkommen im Duellturm!\r",
        "Ich bin deine Anweiserin für die\n",
        "Wi-Fi Kampfräume.\r"
      ]
    },
    {
      "id": "msg_0283_00037",
      "de_DE": [
        "Möchtest du die Herausforderung\n",
        "des Wi-Fi Kampfraumes beginnen?"
      ]
    },
    {
      "id": "msg_0283_00038",
      "de_DE": [
        "In den Wi-Fi Kampfräumen des Duellturms\n",
        "werden Kämpfe über die Nintendo Wi-Fi\f",
        "Connection (WFC) ausgetragen.\r",
        "Bei Wi-Fi Kämpfen trittst du mittels der\n",
        "Nintendo Wi-Fi Connection gegen Trainer\f",
        "aus der ganzen Welt an.\r",
        "Im Inneren des Duellturms findest\n",
        "du zahlreiche Kampfräume vor.\r",
        "In jedem Kampfraum gilt es,\n",
        "7 Trainer zu besiegen.\r",
        "Sollte dir das gelingen,\n",
        "erhältst du Gewinnpunkte.\r",
        "Wenn du besonders gut warst, kannst du\n",
        "sogar der Leiter des Raumes werden!\r",
        "Außerdem werden Wi-Fi Kampfräume\n",
        "über ein Rangsystem verwaltet.\r",
        "Gewinnt ein Trainer Wi-Fi Kämpfe,\n",
        "klettert er in der Rangliste nach oben.\r",
        "Umgekehrt sinkt seine Platzierung,\n",
        "sollte er häufiger verlieren.\r",
        "Deinen Rang steigerst du durch Siege,\n",
        "am besten gegen starke Trainer.\r",
        "Wenn du deine Herausforderung unter-\n",
        "brechen willst, speichere dein Spiel.\r",
        "Solltest du nicht speichern,\n",
        "wirst du disqualifiziert.\r"
      ]
    },
    {
      "id": "msg_0283_00039",
      "de_DE": "Komm bald wieder!"
    },
    {
      "id": "msg_0283_00040",
      "garbage": 0
    },
    {
