    {
      "id": "msg_0283_00071",
      "de_DE": [
        "Glückwunsch zum Erreichen von\n",
        "{STRVAR_1 52, 0} Siegen in Serie!\r",
        "Dein Pokémon-Siegerteam erhält eine\n",
        "spezielle Belohnung für diesen Erfolg!"
      ]
    },
    {
      "id": "msg_0283_00072",
      "de_DE": "{STRVAR_1 3, 0} erhält {STRVAR_1 8, 1}!"
    },
    {
      "id": "msg_0283_00073",
      "de_DE": [
        "Herzlichen Glückwunsch. Du hast nun\n",
        "50 Siege in Folge verbucht.\r",
        "Dein Pokémon-Siegerteam erhält\n",
        "spezielle Bänder für diesen Erfolg!"
      ]
    },
    {
      "id": "msg_0283_00074",
      "de_DE": [
        "Ja, ich habe früher in einer\n",
        "Region namens Hoenn gelebt.\r",
        "Einen Ort wie diesen gab es\n",
        "dort drüben auch."
      ]
    },
    {
      "id": "msg_0283_00075",
      "de_DE": [
        "Die Wi-Fi Kampfräume stecken\n",
        "voller Überraschungen.\r",
        "Stell dir vor, du könntest gegen einen\n",
        "alten Rivalen antreten, der vor langer\f",
        "Zeit fortgezogen ist!\r",
        "Wer weiß, was für coole\n",
        "Aufeinandertreffen dich erwarten?"
      ]
    },
    {
      "id": "msg_0283_00076",
      "de_DE": [
        "Wenn man hier einen Rekord schafft,\n",
        "kommt man ins Fernsehen.\r",
        "Das ist meine einzige Chance,\n",
        "ein Superstar zu werden!"
      ]
    },
    {
      "id": "msg_0283_00077",
      "de_DE": [
        "Ich habe mein Kleines bis\n",
        "zum Umfallen trainiert.\r",
        "Wenn einer 100 Siege in Folge schafft,\n",
        "dann mein Kleines, ich weiß es einfach...\r",
        "Nicht wahr, PIKACHU?"
      ]
    },
    {
      "id": "msg_0283_00078",
      "de_DE": "PIKACHU: ..."
    },
    {
      "id": "msg_0283_00079",
      "de_DE": [
        "Oh, là, là!\n",
        "Du siehst ziemlich stark aus!\r",
        "Wirklich, ich freue mich schon darauf,\n",
        "gegen dich anzutreten."
      ]
    },
    {
      "id": "msg_0283_00080",
      "de_DE": [
        "Es gibt so viele gute Trainer\n",
        "da draußen...\r",
        "Ganz schön beängstigend, aber wir\n",
        "geben unser Bestes, PIKACHU!"
      ]
    },
    {
      "id": "msg_0283_00081",
      "de_DE": "PKIACHU: Pika! Pikaaa!"
    },
    {
      "id": "msg_0283_00082",
      "de_DE": [
        "Herzlichen Glückwunsch. Du hast nun\n",
        "50 Siege in Folge verbucht.\r",
        "Die Pokémon deines Teams erhalten\n",
        "spezielle Bänder zur Erinnerung!"
      ]
    },
    {
      "id": "msg_0283_00083",
      "de_DE": [
