{
  "key": 18231,
  "messages": [
    {
      "id": "msg_0534_00000",
      "de_DE": [
        "Avenaro: Hey, wenn das\n",
        "nicht {STRVAR_1 3, 0} ist!\r",
        "Sag bloß, du gehst auch\n",
        "zum Kahlberg?\r",
        "Du siehst schwächlich aus...\n",
        "Kommst du auch wirklich zurecht?\r",
        "Hm, wieso frage ich das eigentlich?\n",
        "Interessiert mich doch gar nicht.\r",
        "Egal, wenn wir uns auf dem Kahlberg\n",
        "begegnen, sehen wir mal, wer als\f",
        "Erster den Magmastein erreicht!\r"
      ]
    },
    {
      "id": "msg_0534_00001",
      "de_DE": [
        "Hey, reisender Trainer.\n",
        "Ist dein Beutel voller Items?\f",
        "Oder vielleicht doch nur voller Träume?"
      ]
    },
    {
      "id": "msg_0534_00002",
      "de_DE": [
        "Trainer, die im Duellturm scheitern,\n",
        "kommen her, um zu trainieren."
      ]
    },
    {
      "id": "msg_0534_00003",
      "de_DE": [
        "Ich habe lange gesucht, aber ich weiß,\n",
        "wann ich mich geschlagen geben muss.\r",
        "Ein besserer Trainer muss den Vulkan\n",
        "genauer unter die Lupe nehmen!"
      ]
    },
    {
      "id": "msg_0534_00004",
      "de_DE": [
        "Wie du unschwer erkennen kannst,\n",
        "bin ich Kameramann.\r",
        "Schon mal die Sendung “Suche nach\n",
        "dem Roten GARADOS!” gesehen?\r",
        "“Das mysteriöse Auftauchen eines wilden\n",
        "Pokémon im See”... Du weißt schon!\r",
        "Genau, diese fantastische Doku\n",
        "meine ich! Die habe ich gedreht!"
      ]
    },
    {
      "id": "msg_0534_00005",
      "de_DE": [
        "Oje, oje. Das sieht gar nicht gut aus!\n",
        "Aber ich bin ja Kameramann!\r",
        "Ich muss eisern durchhalten und das\n",
        "für die Nachwelt festhalten!"
      ]
    },
    {
      "id": "msg_0534_00006",
      "de_DE": [
        "Wie du unschwer erkennen kannst,\n",
        "bin ich Kameramann.\r",
        "“Der Ausbruch des Kahlbergs?\n",
        "Das Geheimnis um das wilde Pokémon\f",
        "in den Tiefen des Vulkans!”\r",
        "Ich hatte das ganze Drehbuch meiner\n",
        "Doku schon lange im Kopf...\r",
        "Aber gedreht habe ich noch nichts.\n",
        "So viel zu meiner Doku...\r",
        "Ach, ja. Die Welt ist groß. Es gibt\n",
        "genügend Geheimnisse zu filmen!"
      ]
    },
    {
      "id": "msg_0534_00007",
      "de_DE": [
        "Überlebensareal\n",
        "Beweise dich"
      ]
    }
  ]
}
