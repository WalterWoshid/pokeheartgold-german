{
  "key": 9322,
  "messages": [
    {
      "id": "msg_0284_00000",
      "de_DE": [
        "Wir heilen deine Pokémon und machen\n",
        "sie wieder fit!"
      ]
    },
    {
      "id": "msg_0284_00001",
      "de_DE": [
        "Dein {STRVAR_1 50, 0}. Gegner erwartet dich!\n",
        "Bist du bereit?"
      ]
    },
    {
      "id": "msg_0284_00002",
      "de_DE": [
        "Möchtest du speichern und\n",
        "das Spiel beenden?"
      ]
    },
    {
      "id": "msg_0284_00003",
      "de_DE": [
        "Möchtest du deine Herausforderung\n",
        "im Kampfraum abbrechen?"
      ]
    },
    {
      "id": "msg_0284_00004",
      "de_DE": [
        "Speichervorgang... Bitte das Gerät\n",
        "nicht ausschalten."
      ]
    },
    {
      "id": "msg_0284_00005",
      "de_DE": [
        "Wir heilen deine Pokémon und machen\n",
        "sie wieder fit!"
      ]
    },
    {
      "id": "msg_0284_00006",
      "de_DE": [
        "Dein {STRVAR_1 50, 0}. Gegner erwartet dich!\n",
        "Bist du bereit?"
      ]
    },
    {
      "id": "msg_0284_00007",
      "de_DE": [
        "Möchtest du speichern und\n",
        "das Spiel beenden?"
      ]
    },
    {
      "id": "msg_0284_00008",
      "de_DE": [
        "Möchtest du deine Herausforderung\n",
        "im Kampfraum abbrechen?"
      ]
    },
    {
      "id": "msg_0284_00009",
      "de_DE": [
        "Ich beglückwünsche dich zu deiner\n",
        "Siegesserie, Herausforderer!\r",
        "Der Kampfkoloss ließ bestellen,\n",
        "dass er von dir beeindruckt ist.\r",
        "Er erkennt deine Fähigkeiten an und\n",
        "fordert dich zu einem Kampf heraus!\r",
        "Bist du bereit, es mit dem\n",
        "Kampfkoloss aufzunehmen?"
      ]
    },
    {
      "id": "msg_0284_00010",
      "de_DE": [
        "Hi!\n",
        "Ich heiße Viktor.\r",
        "Ich erinnere mich noch an dich aus \n",
        "Zweiblattdorf, {STRVAR_1 3, 0}.\r",
        "Du hast immer mit meinem Sohn\n",
        "{STRVAR_1 3, 1} gespielt, nicht wahr?\r",
        "Mensch, bist du gewachsen. Sehr\n",
        "beeindruckend, deine Entwicklung!\r",
        "Es ist an der Zeit, dass du es\n",
        "mir zeigst.\r",
        "Ich meine das Band, das dich untrennbar\n",
        "mit deinen Pokémon verbindet.\r",
        "Zeige mir die Fähigkeiten, die du\n",
        "dir als Trainer angeeignet hast!\r"
      ]
    },
    {
      "id": "msg_0284_00011",
      "de_DE": [
        "Viktor: Du hast es also\n",
        "bis hierher geschafft!\r",
        "In meiner Eigenschaft als Kampfkoloss\n",
        "muss ich immer mein Bestes geben.\r",
        "Auf diese Weise zollen die besten\n",
        "Trainer einander Respekt.\r",
        "Sie kämpfen bis zum Ende und widmen\n",
        "sich der Lehre der Pokémon!\r"
      ]
    },
    {
      "id": "msg_0284_00012",
      "de_DE": [
        "Bravo!\r",
        "Ich stelle mir vor, wie mein Sohn\n",
        "mich eines Tages herausfordert.\r",
        "Genau so, wie du es heute\n",
        "getan hast.\r",
        "Auf diesen besonderen Tag freue\n",
        "ich mich außerordentlich.\r",
        "Du wirst noch geschickter sein.\n",
        "Noch besser als dein eigener Vater.\r",
        "Fordere weiter Trainer aus der ganzen\n",
        "Welt heraus und lasse deine\f",
        "Persönlichkeit weiter wachsen!\r"
      ]
    },
    {
      "id": "msg_0284_00013",
      "de_DE": [
        "Bravo!\n",
        "Du hast mich wahrlich inspiriert!\r",
        "Das weckt Erinnerungen an\n",
        "einen Tag vor langer Zeit...\r",
        "An diesem Tag ging ich mit\n",
        "deinem Vater an den See...\r",
        "Plötzlich wurden wir von wilden\n",
        "Pokémon angegriffen.\r",
        "Wir konnten sie in einem erbitterten\n",
        "Kampf irgendwie zurückschlagen.\r",
        "Das war mein erster\n",
        "Kampf als Trainer.\r",
        "Ob es dem Professor\n",
        "wohl gut geht?\r",
        "...Doch genug der alten Geschichten.\r",
        "Mein junger Freund, die Welt und deine\n",
        "Zukunft haben Großes mit dir vor.\r",
        "Geh nun, du kannst alles werden,\n",
        "was du dir nur erträumen kannst!\r",
        "Es gibt nichts, was du nicht\n",
        "erreichen könntest.\f",
        "Für dich gibt es keine Grenzen!\r"
      ]
    }
  ]
}
