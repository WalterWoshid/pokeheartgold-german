{
  "key": 4043,
  "messages": [
    {
      "id": "msg_0584_00000",
      "de_DE": [
        "Hey, konnichiwa!\n",
        "Buon giorno, Trainer!\r",
        "Ich bin The Master.\r",
        "In der hiesigen Sprache würde man\n",
        "mich wohl Handwerker nennen.\r",
        "So in etwa, n’est çe pas?\n",
        "Comprende?\r"
      ]
    },
    {
      "id": "msg_0584_00001",
      "de_DE": [
        "Schnupper, schnupper, ich rieche es!\n",
        "Irgendetwas ist an dir!\r",
        "Zweifelsohne! Du liebst die\n",
        "Pokémon genauso wie ich!\r",
        "Das ist maravilloso!\n",
        "Also, lass uns Folgendes machen.\r",
        "Ich erweitere deinen Pokédex, damit du\n",
        "die Beschreibungen der Pokémon auch\f",
        "in anderen Sprachen lesen kannst!\r",
        "Je suis desolé, leider geht\n",
        "das nicht für alle Pokémon.\r",
        "Gilt nur für Pokémon aus Ländern, die\n",
        "ich, The Master, besucht habe.\r",
        "Und, kann ich deinen Pokédex mal sehen?\n",
        "Ah, an diesem Ding hier ziehen...\f",
        "An dem da rütteln... Und fertig!\r",
        "Du kannst dich jetzt über The Masters \n",
        "Lieblings-Pokémon in anderen Sprachen\f",
        "informieren. Isn’t it marvellous?"
      ]
    },
    {
      "id": "msg_0584_00002",
      "de_DE": [
        "Hey, konnichiwa!\n",
        "Bonjour und was weiß ich noch!\r",
        "Hast du das Pokémon FINNEON?\n",
        "C’est un Pokémon de pescado, non?\r",
        "Hättest du wohl die Güte, es gegen\n",
        "mein KARPADOR zu tauschen?"
      ]
    },
    {
      "id": "msg_0584_00003",
      "de_DE": [
        "Merci, arigatou, gracias,\n",
        "und Keineahnungwassonstnoch!\r",
        "Das KARPADOR hat mich auf dem ganzen\n",
        "Weg von meinem Heimatland begleitet.\r",
        "Sei nett zu ihm,\n",
        "ich verlasse mich darauf!"
      ]
    },
    {
      "id": "msg_0584_00004",
      "de_DE": [
        "Oh, non, non! Das ist kein FINNEON!\n",
        "Ich will ein FINNEON!\f",
        "The Master wird ganz melancholisch!"
      ]
    },
    {
      "id": "msg_0584_00005",
      "de_DE": [
        "Oh! Katastrofa, tragedia!\n",
        "Eine wahre Tragödie!\r",
        "Eines Tages wirst du mit mir das\n",
        "Pokémon tauschen, das ich möchte!\r",
        "The Master weiß so was, er ist\n",
        "welterfahren und sehr wai...\f",
        "sehr wey... sehr... klug! Ja, genau!"
      ]
    },
    {
      "id": "msg_0584_00006",
      "de_DE": [
        "Nur dank der Pokémon kann ich Freunde\n",
        "auf der ganzen Welt haben.\r",
        "Das finde ich so inspirierend.\n",
        "Es ist einfach nur wunderbar!"
      ]
    },
    {
      "id": "msg_0584_00007",
      "de_DE": [
        "Es ist ein Poster mit der\n",
        "Liste von Pokémon.\r",
        "Die Lieblings-Pokémon des\n",
        "welterfahrenen The Master.\r",
        "RETTAN{CURSOR_X 70}PIKACHU{CURSOR_X 140}ENTON\n",
        "PONITA{CURSOR_X 70}STERNDU{CURSOR_X 140}KARPADOR\f",
        "WOINGENAU{CURSOR_X 70}SKARABORN{CURSOR_X 140}SNIEBEL\f",
        "TEDDIURSA{CURSOR_X 70}HUNDUSTER{CURSOR_X 140}WINGULL\f",
        "BUMMELZ{CURSOR_X 70}ROSELIA"
      ]
    }
  ]
}
