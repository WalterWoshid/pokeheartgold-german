{
  "key": 50186,
  "messages": [
    {
      "id": "msg_0189_00000",
      "de_DE": [
        "Die Duellzone war früher ein Ort, wo\n",
        "sich die härtesten Trainer trafen.\r",
        "Man hat sie deshalb für verrückt\n",
        "und exzentrisch gehalten.\r",
        "Kaum zu glauben, wie sich das\n",
        "seitdem geändert hat.\r",
        "Nehmen wir doch mal Orte wie das\n",
        "Kampf- oder Überlebensareal.\r",
        "Sie sind praktisch über Nacht wie\n",
        "Pilze aus dem Boden geschossen."
      ]
    },
    {
      "id": "msg_0189_00001",
      "de_DE": [
        "Mein Mann war einer der ersten\n",
        "Exzentriker hier in der Duellzone.\r",
        "Nun ja, ich war’s auch."
      ]
    },
    {
      "id": "msg_0189_00002",
      "de_DE": "FLEMMLI: Flemmli, Flemmli!"
    }
  ]
}
