  "messages": [
    {
      "id": "msg_0253_00000",
      "de_DE": [
        "Ich bin Orisa...\r",
        "Ich wollte Pokémon fangen und habe\n",
        "mich verirrt...\r",
        "Ich habe Angst...\r",
        "Bitte!\n",
        "Bitte bring mich zum Ausgang!\r"
      ]
    },
    {
      "id": "msg_0253_00001",
      "de_DE": "{STRVAR_1 3, 0} begleitet Orisa!"
    },
    {
      "id": "msg_0253_00002",
      "de_DE": [
        "Orisa: Ich werde deine Pokémon immer bei\n",
        "guter Gesundheit halten!"
      ]
    },
    {
      "id": "msg_0253_00003",
      "de_DE": [
        "Trainer, dein Name ist {STRVAR_1 3, 0}?\r",
        "Ich heiße Orisa.\n",
        "Du hast einen schönen Namen!\r"
      ]
    },
    {
      "id": "msg_0253_00004",
      "de_DE": [
        "Orisa: Oh! {STRVAR_1 3, 0}...\n",
        "Ich habe... so lange gewartet...\r"
      ]
    },
    {
      "id": "msg_0253_00005",
      "de_DE": [
        "Orisa: Oh! Da ist ja der Ausgang!\r",
        "Ich will stärker werden, damit ich nicht\n",
        "mehr so ein Hasenfuß bin.\r",
        "{STRVAR_1 3, 0}, mach’s gut!\n",
        "Und vielen Dank!\r"
      ]
    },
