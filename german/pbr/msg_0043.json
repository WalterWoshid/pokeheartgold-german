    {
      "id": "msg_0043_00000",
      "de_DE": [
        "Ich habe mein PIKACHU in einem\n",
        "Tausch erhalten. Es kommt von\f",
        "irgendwo auf der Welt.\r",
        "Es wächst sehr schnell und hat\n",
        "bereits einen hohen Level...\f",
        "aber... es gehorcht mir nicht...\r",
        "Doch auch wenn es manchmal\n",
        "nicht einfach ist, ist es doch ein\f",
        "unersetzlicher Partner für mich!"
      ]
    },
    {
      "id": "msg_0043_00001",
      "de_DE": "PIKACHU: Pikapikapikaaah!"
    },
    {
      "id": "msg_0043_00002",
      "de_DE": [
        "Wenn jeder auf der Welt\n",
        "Pokémon hätte...\r",
        "Dann könnten alle auf der\n",
        "Welt miteinander kommunizieren!"
      ]
    }
  ]
}
