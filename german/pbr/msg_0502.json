{
  "key": 9234,
  "messages": [
    {
      "id": "msg_0502_00000",
      "de_DE": [
        "Trotz angestrengtester Bemühungen\n",
        "ist es dem Team nicht gelungen, das\n",
        "seltene, mit eigentümlichen Farben\n",
        "versehene Pokémon aufzuspüren.\n",
        "Das Rote GARADOS ist bisher nicht vor\n",
        "dem entmutigten Team aufgetaucht..."
      ]
    },
    {
      "id": "msg_0502_00001",
      "de_DE": [
        "Und damit beenden wir unsere\n",
        "Berichterstattung über die\r",
        "“Suche nach dem Roten GARADOS”!\n",
        "Ihr Jubelstadt TV!\r"
      ]
    },
    {
      "id": "msg_0502_00002",
      "de_DE": [
        "Wir sehen uns nächste Woche. Gleiche\n",
        "Welle, gleiche Stelle!"
      ]
    },
    {
      "id": "msg_0502_00003",
      "de_DE": [
        "Auf dem Fernseher ist der Titelbild-\n",
        "schirm eines Videospiels eingeblendet."
      ]
    },
    {
      "id": "msg_0502_00004",
      "de_DE": [
        "Der X-Knopf öffnet\n",
        "das Menü."
      ]
    },
    {
      "id": "msg_0502_00005",
      "de_DE": [
        "Das ist eine Wii-Konsole! Ihr Controller\n",
        "ist eine Wii-Fernbedienung!"
      ]
    },
    {
      "id": "msg_0502_00006",
      "de_DE": [
        "{STRVAR_1 3, 0} liest die Informationen.\r",
        "Grundwissen über Pokémon...\r",
        "Menschen und Pokémon leben in\n",
        "dieser Welt Seite an Seite.\r",
        "Diejenigen, die mit Pokémon an Kämpfen\n",
        "teilnehmen, nennt man Pokémon-Trainer."
      ]
    }
  ]
}
