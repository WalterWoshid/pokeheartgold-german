{
  "key": 29698,
  "messages": [
    {
      "id": "msg_0215_00000",
      "de_DE": [
        "Herr Feurio: Nun, hallo!!!\n",
        "Ich bekomme hier nicht oft Besuch.\r",
        "Ich versuche, die Arbeit hier zu\n",
        "verbessern, indem ich Bodenteile\f",
        "einsetze, die sich bewegen.\r",
        "Aber niemand ist so wirklich glücklich\n",
        "darüber. Sie sagen, die Bodenteile\f",
        "machen einen schwindelig!\r",
        "Nun, ich sollte dir hier nicht die\n",
        "Ohren volljammern. Hier ist ein\f",
        "Andenken an deinen Besuch!\r"
      ]
    },
    {
      "id": "msg_0215_00001",
      "de_DE": [
        "Herr Feurio: Meine Eisenhütte wäre\n",
        "nichts ohne Eisen.\r",
        "Daher bin ich der Natur auf ewig\n",
        "dankbar, dass sie mir Eisen schenkt."
      ]
    }
  ]
}
