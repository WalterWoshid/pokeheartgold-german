{
  "key": 17411,
  "messages": [
    {
      "id": "msg_0022_00000",
      "de_DE": [
        "Hallo, hi!\r",
        "Ich bin der Präsident der Pokétch\n",
        "Gesellschaft!\r"
      ]
    },
    {
      "id": "msg_0022_00001",
      "de_DE": [
        "Ich entwickle gerade ein neues\n",
        "Zubehör für den Pokétch, aber\f",
        "es ist noch nicht fertig.\r",
        "Ich denke, sobald du deinen ersten\n",
        "Orden hast, bin ich fertig damit."
      ]
    },
    {
      "id": "msg_0022_00002",
      "de_DE": [
        "Hallo, hi!\n",
        "Deine Geduld wird nun belohnt!\r",
        "Ich habe ein neues Zubehör für\n",
        "den Pokétch fertig!\r"
      ]
    },
    {
      "id": "msg_0022_00003",
      "de_DE": [
        "Das ist ein Notizblock!\n",
        "Er ist... nun, das, was er ist!"
      ]
    },
    {
      "id": "msg_0022_00004",
      "de_DE": [
        "Ich arbeite bereits emsig an einem\n",
        "neuen Zubehör für den Pokétch.\r",
        "Mh, ich denke, sobald du drei Orden\n",
        "bekommen hast, bin ich damit fertig."
      ]
    },
    {
      "id": "msg_0022_00005",
      "de_DE": [
        "Hallo, hi!\n",
        "Geduld zahlt sich aus!\r",
        "Ich habe ein neues Zubehör für\n",
        "den Pokétch entwickelt.\r"
      ]
    },
    {
      "id": "msg_0022_00006",
      "de_DE": [
        "Eine Karte, die ständig eingeblendet\n",
        "werden kann, ist schon sehr praktisch,\f",
        "findest du nicht?\r",
        "Du kannst dort auch Markierungen\n",
        "einzeichnen. Klasse, oder nicht?!?\n"
      ]
    },
    {
      "id": "msg_0022_00007",
      "de_DE": [
        "Ich entwickle gerade ein neues Zubehör\n",
        "für den Pokétch.\r",
        "Es wird wohl fertig sein, wenn du\n",
        "fünf Orden erhalten hast."
      ]
    },
    {
      "id": "msg_0022_00008",
      "de_DE": [
        "Hallo, hi!\n",
        "Vielen Dank für deine Geduld!\r",
        "Hier ist das neue Zubehör für\n",
        "den Pokétch.\r"
      ]
    },
    {
      "id": "msg_0022_00009",
      "de_DE": [
        "Ich denke schon, dass es sehr nützlich\n",
        "ist, wenn man sehen kann, wie viele\f",
        "Leute gerade miteinander kommunizieren.\r",
        "Zum Beispiel im Konnex-Klub."
      ]
    },
    {
      "id": "msg_0022_00010",
      "de_DE": [
        "Ich arbeite gerade an einem neuen\n",
        "Zubehör für den Pokétch.\r",
        "Und das wird wohl fertig sein, wenn\n",
        "du sieben Orden zusammenhast."
      ]
    },
    {
      "id": "msg_0022_00011",
      "de_DE": [
        "Hallo, hi!\n",
        "Deine Geduld soll belohnt werden!\r",
        "Ich habe das neue Zubehör für den\n",
        "Pokétch fertig gestellt!\r"
      ]
    },
    {
      "id": "msg_0022_00012",
      "de_DE": [
        "Überprüfe, wie die einzelnen Typen\n",
        "aufeinander wirken, damit eure Angriffe\f",
        "sehr effektiv werden!\r",
        "So werdet ihr stärker als je zuvor!"
      ]
    },
    {
      "id": "msg_0022_00013",
      "de_DE": [
        "Ja, ja. Es gibt viele Leute, die dir\n",
        "Zubehör für deinen Pokétch\f",
        "geben werden!\r",
        "Und so ist jeder glücklich! "
      ]
    },
    {
      "id": "msg_0022_00014",
      "de_DE": [
        "So, und was mache ich jetzt?\r",
        "Meinst du, ich sollte mir noch weiteres\n",
        "Zubehör für den Pokétch ausdenken?"
      ]
    },
    {
      "id": "msg_0022_00015",
      "de_DE": [
        "Oh, ich werde weiteres Zubehör\n",
        "für den Pokétch entwickeln.\f",
        "Darauf kannst du wetten!\r",
        "Genau wie ein Pokémon entwickelt\n",
        "sich auch mein Pokétch weiter!"
      ]
    },
    {
      "id": "msg_0022_00016",
      "de_DE": [
        "Willkommen in der Pokétch Gesellschaft.\r",
        "Wir sind ein Familienunternehmen und\n",
        "nicht sonderlich groß."
      ]
    }
  ]
}
