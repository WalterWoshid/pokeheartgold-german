{
  "key": 25606,
  "messages": [
    {
      "id": "msg_0529_00000",
      "de_DE": [
        "Woher kommst du?\r",
        "...\r",
        "Hm, Zweiblattdorf, sagst du? Ist das\n",
        "nicht in der Nähe vom See der Wahrheit?\r",
        "Man sagt, der See sei die Heimat\n",
        "von VESPRIT, dem Wesen der Emotionen."
      ]
    },
    {
      "id": "msg_0529_00001",
      "de_DE": [
        "Hm? Hast du den Orden der Arena von\n",
        "Herzhofen, kannst du Surfer jederzeit\f",
        "auch außerhalb eines Kampfes einsetzen.\r",
        "Mit Surfer kannst du zu Orten reisen,\n",
        "die normalerweise nicht zu erreichen\f",
        "wären.\r",
        "Du wirst bestimmt überrascht sein, wo\n",
        "du überallhin kannst."
      ]
    },
    {
      "id": "msg_0529_00002",
      "de_DE": [
        "Elyses ist der älteste Ort\n",
        "der Region Sinnoh.\r",
        "Der Ort entstand, um Pokémon\n",
        "aus weiter Vergangenheit zu ehren.\r",
        "So erzählt es jedenfalls die Legende..."
      ]
    },
    {
      "id": "msg_0529_00003",
      "de_DE": [
        "Oh, hallo!\n",
        "Gut siehst du aus!\r",
        "Ich habe selbst ein bisschen geforscht,\n",
        "nachdem es dieses Problem gab.\r",
        "Das Rumoren des Kraterbergs\n",
        "hat mir auch Sorgen bereitet.\r",
        "Dies hier habe ich im Schrein\n",
        "gefunden.\r",
        "Ein Buch. Es scheint sehr alt zu\n",
        "sein. Hier, sieh es dir selbst an.\r"
      ]
    },
    {
      "id": "msg_0529_00004",
      "de_DE": [
        "“PALKIA, das Band, das die\n",
        "Dimensionen verbindet.”, steht da...\r"
      ]
    },
    {
      "id": "msg_0529_00005",
      "de_DE": [
        "“DIALGA, Hüter der Zeit.”,\n",
        "steht da...\r"
      ]
    },
    {
      "id": "msg_0529_00006",
      "de_DE": [
        "Anscheinend gab es im alten\n",
        "Sinnoh zwei Pokémon.\r",
        "Das eine ist das Symbol der Zeit,\n",
        "das andere das Symbol der Dimensionen.\n"
      ]
    },
    {
      "id": "msg_0529_00007",
      "de_DE": [
        "Meine große Schwester studiert die\n",
        "Mythologie Sinnohs.\r",
        "Sie will wissen, wie Menschen und\n",
        "Pokémon in alten Zeiten miteinander\f",
        "lebten.\r",
        "War es damals anders als heute?\n",
        "Oder war es genauso wie heute?\r",
        "Sie sagt, dass sie sich bei ihren\n",
        "Forschungen auf diese Fragen stützt."
      ]
    },
    {
      "id": "msg_0529_00008",
      "de_DE": [
        "Mit Sicherheit kann man das nicht sagen,\n",
        "aber das scheint eine unbezahlbare\f",
        "Schrift zu sein."
      ]
    },
    {
      "id": "msg_0529_00009",
      "de_DE": [
        "Das ist ein altes Buch.\n",
        "{STRVAR_1 3, 0} fängt an zu lesen.\r",
        "“Als das Pokémon geboren wurde,\n",
        "bereicherte es unsere Intelligenz\f",
        "und damit unsere Leben.\r",
        "Als das Pokémon geboren wurde,\n",
        "bereicherte es unsere Gefühle,\f",
        "machte uns mit Freude und Leid bekannt.\r",
        "Als das Pokémon geboren wurde,\n",
        "stärkte es unsere Willenskraft\f",
        "und unsere Tatkraft...”"
      ]
    }
  ]
}
