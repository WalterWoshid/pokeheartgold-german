{
  "key": 21538,
  "messages": [
    {
      "id": "msg_0162_00000",
      "de_DE": [
        "Hmmm... BURMY sind das\n",
        "beste Beispiel...\r",
        "Sie zeigen, wie die Umgebung die\n",
        "Persönlichkeit eines Lebewesens\f",
        "formen kann."
      ]
    },
    {
      "id": "msg_0162_00001",
      "de_DE": [
        "Kennst du dich mit BURMY und ihren\n",
        "unterschiedlichen Formen aus?\r",
        "Besitzt du BURMY in all ihren Formen?\r"
      ]
    },
    {
      "id": "msg_0162_00002",
      "de_DE": [
        "Ooh, du hast ja nicht mal ein\n",
        "einziges BURMY!\r",
        "Magst du sie etwa nicht?!?\n",
        "Sie sind lustig und niedlich!"
      ]
    },
    {
      "id": "msg_0162_00003",
      "de_DE": [
        "Hmm...\r",
        "Es wäre echt cool, wenn du alle\n",
        "Formen von BURMY hättest."
      ]
    },
    {
      "id": "msg_0162_00004",
      "de_DE": [
        "COOL! Du hast ja alle\n",
        "Formen von BURMY!\r",
        "Oh, das macht mich ganz schwindelig!\n",
        "Daher schenke ich dir das hier!"
      ]
    },
    {
      "id": "msg_0162_00005",
      "de_DE": [
        "Hups, dein Beutel ist ja randvoll!\n",
        "Dann gebe ich es dir später."
      ]
    },
    {
      "id": "msg_0162_00006",
      "de_DE": [
        "Du bist gut! Du würdest einen\n",
        "guten Käfermaniac abgeben!"
      ]
    }
  ]
}
