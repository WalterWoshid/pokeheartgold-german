  "key": 54339,
  "messages": [
    {
      "id": "msg_0262_00000",
      "de_DE": [
        "Willkommen.\n",
        "Dies ist das Team Galaktik-Hauptqua...\r",
        "Ähem. Dies ist das Schleiede\n",
        "Team Galaktik-Gebäude.\r",
        "Kosmische Energie für alle!\r",
        "Wäre es nicht wundervoll, wenn wir diese\n",
        "mächtige Energie beherrschen könnten?"
      ]
    },
    {
      "id": "msg_0262_00001",
      "de_DE": [
        "Willkommen.\n",
        "Dies ist das Team Galaktik-Hauptqua...\r",
        "Ähem. Dies ist das Schleiede\n",
        "Team Galaktik-Gebäude.\r",
        "Im Moment finden keine\n",
        "öffentlichen Veranstaltungen statt."
      ]
    },
    {
      "id": "msg_0262_00002",
      "de_DE": [
        "Team Galaktik forscht hier Tag\n",
        "und Nacht.\r",
        "Wir konzentrieren uns auf\n",
        "neuartige Energieressourcen."
      ]
    },
    {
      "id": "msg_0262_00003",
      "de_DE": [
        "Hier arbeiten wir vom Team Galaktik.\n",
        "Was wir eigentlich machen?\r",
        "Unsere Träume verwirklichen. Auch\n",
        "wenn ich nicht genau weiß, wie...\r",
        "Auf jeden Fall träumen wir davon,\n",
        "eine schöne neue Welt zu erschaffen."
      ]
    },
    {
      "id": "msg_0262_00004",
      "de_DE": [
        "Wir, Team Galaktik, werden alles\n",
        "nehmen, was wir nur nehmen können!\r",
        "Und wir interessieren uns nicht für\n",
        "Dinge, die uns nicht weiterbringen!\r",
        "Das ist unsere Philosophie!"
      ]
    },
    {
      "id": "msg_0262_00005",
      "de_DE": [
        "Wir, Team Galaktik, werden alles\n",
        "nehmen, was wir nur nehmen können!\r",
        "Und wir interessieren uns nicht für\n",
        "Dinge, die uns nicht weiterbringen!\r",
        "Das ist unsere Philosophie!\r",
        "Zumindest war sie das.\n",
        "Jetzt ist nichts mehr übrig..."
      ]
    },
    {
      "id": "msg_0262_00006",
      "de_DE": [
        "Du bist zu jung für uns... Wenn du älter\n",
        "bist, kannst du bei uns mitmachen."
      ]
    },
    {
      "id": "msg_0262_00007",
      "de_DE": "Wo unser Boss wohl ist..."
    },
    {
      "id": "msg_0262_00008",
      "de_DE": [
        "Saturn: So, du bist es...\r",
        "Ich habe gehört, was an der Speersäule\n",
        "geschehen ist.\r",
        "Was unser Boss wirklich vorhatte...\n",
        "Das weiß nicht einmal ich.\r",
        "Er war immer so zuversichtlich...\n",
        "Seine Argumentation war perfekt...\r",
        "Er konnte die Menschen problemlos\n",
        "in seinen Bann ziehen.\r",
        "Ich habe ihm geglaubt, weil ich meinen\n",
        "Anteil an der Welt haben wollte, die er\f",
        "zu erschaffen versucht hat.\r",
        "Jetzt kümmere ich mich nur noch um\n",
        "unser Hauptquartier und alles, was von\f",
        "uns noch übrig ist...\r",
        "Ich muss entscheiden, was aus den\n",
        "restlichen Mitgliedern vom Team Galaktik\f",
        "wird...\r",
        "Aber ich habe gelernt, dass Extremismus\n",
        "keine Lösung sein kann..."
      ]
    },
    {
      "id": "msg_0262_00009",
      "de_DE": [
        "Die Tür ist verschlossen.\n",
        "Du brauchst einen speziellen Schlüssel."
      ]
    },
    {
      "id": "msg_0262_00010",
      "de_DE": [
        "Die Tür ist verschlossen.\n",
        "Du brauchst einen speziellen Schlüssel.\r",
        "Den G-Schlüssel verwenden?"
      ]
    },
    {
      "id": "msg_0262_00011",
      "de_DE": "Die Tür ist offen."
    },
    {
      "id": "msg_0262_00012",
      "de_DE": [
        "Das Credo des Teams Galaktik:\n",
        "Alles gehört uns!\r",
        "Und schau über die Welt hinaus -\n",
        "der ganze Weltraum wird\f",
        "Team Galaktik gehören!"
      ]
    }
  ]
}
