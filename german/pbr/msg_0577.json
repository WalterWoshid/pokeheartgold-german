  "messages": [
    {
      "id": "msg_0577_00000",
      "de_DE": [
        "Hast du eine Sphäre oder zwei parat?\n",
        "Dann lass uns doch handeln."
      ]
    },
    {
      "id": "msg_0577_00001",
      "de_DE": [
        "Welche Sphäre bietest du für\n",
        "{STRVAR_1 25, 2} an?"
      ]
    },
    {
      "id": "msg_0577_00002",
      "de_DE": [
        "Alles klar!\n",
        "Abgemacht!"
      ]
    },
    {
      "id": "msg_0577_00003",
      "de_DE": [
        "Ähm, Moment mal!\n",
        "Du hast ja nicht genug Platz!"
      ]
    },
    {
      "id": "msg_0577_00004",
      "de_DE": "Das ist nicht die richtige Art Sphäre!"
    },
    {
      "id": "msg_0577_00005",
      "de_DE": [
        "Hmmm...\n",
        "Nein, diese Sphäre ist nicht groß genug."
      ]
    },
    {
      "id": "msg_0577_00006",
      "de_DE": "{STRVAR_1 25, 2} erhalten!"
    },
    {
      "id": "msg_0577_00007",
      "de_DE": [
        "Du erhältst eine {STRVAR_1 25, 2},\n",
        "in der Größe {STRVAR_1 51, 6}."
      ]
    },
    {
      "id": "msg_0577_00008",
      "de_DE": "Sonst noch einen Wunsch?"
    },
    {
      "id": "msg_0577_00009",
      "de_DE": "Dann sieht man sich!"
    },
    {
      "id": "msg_0577_00010",
      "de_DE": [
        "{STRVAR_1 25, 2} für {STRVAR_1 25, 4},\n",
        "was meinst du?"
      ]
    },
    {
      "id": "msg_0577_00011",
      "de_DE": [
        "Geht klar!\n",
        "Lass uns tauschen!"
      ]
    },
    {
      "id": "msg_0577_00012",
      "de_DE": [
        "Ähm, Moment mal! Du hast nicht genug\n",
        "Platz für eine weitere Sphäre!"
      ]
    },
