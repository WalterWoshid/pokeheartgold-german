{
  "key": 37914,
  "messages": [
    {
      "id": "msg_0091_00000",
      "de_DE": [
        "Ich habe viele Beeren gesammelt und\n",
        "tausche sie gegen Accessoires.\r",
        "Ich bin fast so weit, dass ich den\n",
        "Wettbewerb in Herzhofen gewinne."
      ]
    },
    {
      "id": "msg_0091_00001",
      "de_DE": [
        "Orden der Arenen oder gewonnene\n",
        "Wettbewerbe...\r",
        "Es gibt offenbar verschiedene\n",
        "Möglichkeiten, ein Sieger zu sein.\r",
        "Und ich hoffe, du findest etwas, wobei\n",
        "du der strahlende Gewinner sein wirst."
      ]
    },
    {
      "id": "msg_0091_00002",
      "de_DE": [
        "Hahaha! Ich habe dich erwischt!\n",
        "Ich nehme jetzt deine Fahne!"
      ]
    },
    {
      "id": "msg_0091_00003",
      "de_DE": [
        "Du kannst mich nicht fangen!\n",
        "Ich habe Fallen aufgestellt!"
      ]
    }
  ]
}
