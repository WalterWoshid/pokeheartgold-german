        "im PC"
      ]
    },
    {
      "id": "msg_0580_00035",
      "de_DE": [
        "Sphären\n",
        "im PC"
      ]
    },
    {
      "id": "msg_0580_00036",
      "de_DE": [
        "{STRVAR_1 25, 2} wurde aus dem\n",
        "PC entnommen."
      ]
    },
    {
      "id": "msg_0580_00037",
      "de_DE": [
        "{STRVAR_1 25, 2} wurde im PC\n",
        "gelagert."
      ]
    },
    {
      "id": "msg_0580_00038",
      "de_DE": "Dein PC ist voll."
    },
    {
      "id": "msg_0580_00039",
      "de_DE": [
        "Du kannst keine Dekoartikel\n",
        "mehr tragen."
      ]
    },
    {
      "id": "msg_0580_00040",
      "de_DE": "SCHATZSUCHE"
    },
    {
      "id": "msg_0580_00041",
      "de_DE": "SPHÄRENSUCHE"
    },
    {
      "id": "msg_0580_00042",
      "de_DE": "FALLENSUCHE"
    },
    {
      "id": "msg_0580_00043",
      "de_DE": "ABBRUCH"
    },
    {
      "id": "msg_0580_00044",
      "de_DE": [
        "Scanne nach Schätzen, die im\n",
        "Untergrund verborgen sind."
      ]
    },
    {
      "id": "msg_0580_00045",
      "de_DE": [
        "Scanne nach Sphären, die du\n",
        "selbst vergraben hast."
      ]
    },
    {
      "id": "msg_0580_00046",
      "de_DE": [
        "Scanne nach Fallen, die im\n",
        "Untergrund verborgen sind."
      ]
    },
    {
      "id": "msg_0580_00047",
      "de_DE": "Schaltet das Radar aus."
    },
    {
      "id": "msg_0580_00048",
      "de_DE": [
        "System der Schatzsuche\n",
        "wurde hochgefahren.\r",
        "Radar scannt nach\n",
        "Schätzen und Sphären."
      ]
    },
    {
      "id": "msg_0580_00049",
      "de_DE": [
        "System der Sphärensuche\n",
        "wurde hochgefahren.\r",
        "Radar scannt nach Sphären,\n",
        "die du vergraben hast."
      ]
    },
    {
      "id": "msg_0580_00050",
      "de_DE": [
        "System der Fallensuche\n",
        "wurde hochgefahren.\r",
        "Radar scannt nach\n",
        "Fallen."
      ]
    },
    {
      "id": "msg_0580_00051",
      "de_DE": "-------"
    },
    {
      "id": "msg_0580_00052",
      "de_DE": "ID:-----"
    },
    {
      "id": "msg_0580_00053",
