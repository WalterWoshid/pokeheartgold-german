    },
    {
      "id": "msg_0580_00055",
      "de_DE": [
        "Ausgestellte Dekoartikel können\n",
        "nicht weggelegt werden."
      ]
    },
    {
      "id": "msg_0580_00056",
      "de_DE": [
        "Es ist gefährlich, wenn dich jemand\n",
        "während des Dekorierens besucht.\r",
        "Bitte schließe den Eingang."
      ]
    },
    {
      "id": "msg_0580_00057",
      "de_DE": [
        "System der Schatzsuche\n",
        "wurde hochgefahren.\r",
        "...\r",
        "Das Radar zeigt nichts an,\n",
        "da der Eingang verschlossen ist."
      ]
    },
    {
      "id": "msg_0580_00058",
      "de_DE": [
        "System der Sphärensuche\n",
        "wurde hochgefahren.\r",
        "...\r",
        "Das Radar zeigt nichts an,\n",
        "da der Eingang verschlossen ist."
      ]
    },
    {
      "id": "msg_0580_00059",
      "de_DE": [
        "System der Fallensuche\n",
        "wurde hochgefahren.\r",
        "...\r",
        "Das Radar zeigt nichts an,\n",
        "da der Eingang verschlossen ist."
      ]
    },
    {
      "id": "msg_0580_00060",
      "de_DE": [
        "Bitte lagere Dekoartikel im PC, bevor\n",
        "du mit dem Dekorieren beginnst."
      ]
    }
  ]
