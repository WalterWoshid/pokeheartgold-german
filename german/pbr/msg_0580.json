        "Schätze"
      ]
    },
    {
      "id": "msg_0580_00030",
      "de_DE": [
        "Verfügb.\n",
        "Fallen"
      ]
    },
    {
      "id": "msg_0580_00031",
      "de_DE": [
        "Verfügb.\n",
        "Sphären"
      ]
    },
    {
      "id": "msg_0580_00032",
      "de_DE": [
        "Deko im\n",
        "PC"
      ]
    },
    {
      "id": "msg_0580_00033",
