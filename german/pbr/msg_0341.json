{
  "key": 62160,
  "messages": [
    {
      "id": "msg_0341_00000",
      "de_DE": [
        "Hallo du!\n",
        "Freut mich, dich kennenzulernen!\r",
        "Willkommen in der Welt der Pokémon!\r"
      ]
    },
    {
      "id": "msg_0341_00001",
      "de_DE": [
        "Ich bin Professor Eibe.\r",
        "Aber jeder nennt mich einfach\n",
        "nur Pokémon-Professor.\r",
        "Zunächst möchte ich dich etwas fragen:\n",
        "Ist dies dein erstes Abenteuer?\r",
        "Wenn du Hilfe brauchst, bist du bei mir\n",
        "an der absolut richtigen Adresse.\r"
      ]
    },
    {
      "id": "msg_0341_00002",
      "de_DE": [
        "Bewegt Protagonisten. Wird auch\n",
        "bei der Auswahl der \n",
        "Datenüberschriften verwendet.\n",
        "\n",
        "Bestätigt Auswahl, überprüft\n",
        "Dinge, Dialoge, scrollt Text.\n",
        "\n",
        "Beendet eine Aktion, einen Modus\n",
        "und widerruft eine Auswahl."
      ]
    },
    {
      "id": "msg_0341_00003",
      "de_DE": [
        "Menü öffnen.\n",
        "\n",
        "Item verwenden, das auf\n",
        "diese Taste gelegt wurde,\n",
        "wie zum Beispiel das Fahrrad."
      ]
    },
    {
      "id": "msg_0341_00004",
      "de_DE": [
        "Der untere Bildschirm ist der\n",
        "so genannte Touchscreen.\n",
        "Hier findest du eine Anzahl von\n",
        "Schaltflächen, über die du durch\n",
        "Berührung Aktionen vornehmen\n",
        "kannst."
      ]
    },
    {
      "id": "msg_0341_00005",
      "de_DE": [
        "Erscheint dieses Zeichen auf dem\n",
        "Bildschirm, stehen dir ver-\n",
        "schiedene Schaltflächen zur\n",
        "Verfügung, die du auf dem\n",
        "Touchscreen berühren kannst,\n",
        "um Aktionen durchzuführen."
      ]
    },
    {
      "id": "msg_0341_00006",
      "de_DE": "{YESNO 0}"
    },
    {
      "id": "msg_0341_00007",
      "de_DE": "Hast du das so weit verstanden?{YESNO 0}"
    },
    {
      "id": "msg_0341_00008",
      "de_DE": [
        "Bitte berühre die Schaltfläche\n",
        "unten auf dem Touchscreen.{YESNO 0}"
      ]
    },
    {
      "id": "msg_0341_00009",
      "de_DE": "Möchtest du noch etwas wissen?\r"
    },
    {
      "id": "msg_0341_00010",
      "de_DE": [
        "In der Welt, die dir nun offensteht,\n",
        "wartet ein großes Abenteuer\n",
        "auf dich, in dem du der Held bist."
      ]
    },
    {
      "id": "msg_0341_00011",
      "de_DE": [
        "Rede mit den Leuten und überprüfe\n",
        "Dinge, wo immer du bist. In\n",
        "Städten, auf Straßen oder in\n",
        "Höhlen.\n",
        "Sammle überall Informationen,\n",
        "nutze jede erdenkliche Quelle."
      ]
    },
    {
      "id": "msg_0341_00012",
      "de_DE": [
        "Neue Wege werden sich auftun,\n",
        "indem du Menschen in Not hilfst,\n",
        "Herausforderungen meisterst und\n",
        "Rätsel löst."
      ]
    },
    {
      "id": "msg_0341_00013",
      "de_DE": [
        "Manchmal wirst du von anderen\n",
        "herausgefordert und von wilden\n",
        "Geschöpfen angegriffen werden.\n",
        "\n",
        "Meistere diese Herausforderungen\n",
        "und gewinne an Stärke."
      ]
    },
    {
      "id": "msg_0341_00014",
      "de_DE": [
        "Dennoch geht es nicht nur\n",
        "darum, stärker zu werden!"
      ]
    },
    {
      "id": "msg_0341_00015",
      "de_DE": [
        "Während deines Abenteuers\n",
        "interagierst du hoffentlich mit\n",
        "allen möglichen Personen, um\n",
        "deinen Charakter zu festigen.\n",
        "\n",
        "Das ist das eigentliche Ziel\n",
        "dieses Abenteuers."
      ]
    },
    {
      "id": "msg_0341_00016",
      "de_DE": [
        "Diese Welt wird von Wesen bewohnt,\n",
        "die man Pokémon nennt!\r"
      ]
    },
    {
      "id": "msg_0341_00017",
      "de_DE": [
        "Hier habe ich einen Pokéball.\r",
        "Bitte berühre den Pokéball in\n",
        "der Mitte.{YESNO 0}"
      ]
    },
    {
      "id": "msg_0341_00018",
      "de_DE": [
        "Nein, nein! Nicht so!\n",
        "Die Schaltfläche des Pokéballs!{YESNO 0}"
      ]
    },
    {
      "id": "msg_0341_00019",
      "de_DE": [
        "Wir Menschen leben mit den Pokémon\n",
        "ein Leben in Freundschaft.\r",
        "Wir teilen unsere Freizeit\n",
        "und wir arbeiten zusammen.\r",
        "Manche Menschen setzen Pokémon\n",
        "im Kampf ein und stärken so\f",
        "das Band, das sie verbindet.\r",
        "Und was ich tue, willst du wissen?\r",
        "Ich widme mich der Forschung, damit wir\n",
        "mehr und mehr über die Pokémon lernen.\r"
      ]
    },
    {
      "id": "msg_0341_00020",
      "de_DE": [
        "Aber warum erzählst du mir nicht ein\n",
        "bisschen über dich?\r"
      ]
    },
    {
      "id": "msg_0341_00021",
      "de_DE": [
        "Verrätst du mir, ob du ein\n",
        "Junge oder ein Mädchen bist?\r"
      ]
    },
    {
      "id": "msg_0341_00022",
      "de_DE": "Aha, du bist also ein Junge?\r"
    },
    {
      "id": "msg_0341_00023",
      "de_DE": "Aha, du bist also ein Mädchen?\r"
    },
    {
      "id": "msg_0341_00024",
      "de_DE": "Verrätst du mir auch deinen Namen?\r"
    },
    {
      "id": "msg_0341_00025",
      "de_DE": "Mh, du bist also {STRVAR_1 3, 0}?\r"
    },
    {
      "id": "msg_0341_00026",
      "de_DE": "Mh, du bist also {STRVAR_1 3, 0}?\r"
    },
    {
      "id": "msg_0341_00027",
      "de_DE": [
        "Sehr schön...\n",
        "Du bist also {STRVAR_1 3, 0}?\r",
        "Das ist aber mal ein schöner Name!\r",
        "Und dieser junge Mann hier...\n",
        "Ich glaube, das ist dein Freund.\r"
      ]
    },
    {
      "id": "msg_0341_00028",
      "de_DE": "Wie er wohl heißt?\r"
    },
    {
      "id": "msg_0341_00029",
      "de_DE": [
        "{STRVAR_1 3, 1}, sagst du?\n",
        "So heißt dein Freund also?\r"
      ]
    },
    {
      "id": "msg_0341_00030",
      "de_DE": [
        "Nun, {STRVAR_1 3, 0}, die Zeit ist\n",
        "gekommen.\r",
        "Du wirst nun Abenteuergeschichte\n",
        "schreiben.\r",
        "Auf deiner Reise wirst du unzählige\n",
        "Pokémon und Menschen treffen.\r",
        "Und auf deinem Weg durch die Welt\n",
        "wirst du viele interessante Dinge\f",
        "erleben.\r",
        "Aber du wirst auch viel über dich selbst\n",
        "erfahren, da bin ich mir sicher. Genug\f",
        "geredet! Die Welt der Pokémon wartet!\r"
      ]
    },
    {
      "id": "msg_0341_00031",
      "de_DE": "STEUERUNG"
    },
    {
