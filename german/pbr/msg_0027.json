{
  "key": 17427,
  "messages": [
    {
      "id": "msg_0027_00000",
      "de_DE": [
        "Der Raum für die Gruppenklassifizierung\n",
        "ist der in der Nähe der Treppen.\r",
        "Der Raum gegenüber ist der Raum\n",
        "der Internationalen Klassifizierung."
      ]
    },
    {
      "id": "msg_0027_00001",
      "de_DE": [
        "Ich habe etwas Großartiges\n",
        "herausgefunden!\r",
        "Wenn man viele Pokémon tauscht,\n",
        "hat man eine höhere Chance, die\f",
        "Pokémon-Lotterie zu gewinnen!"
      ]
    },
    {
      "id": "msg_0027_00002",
      "de_DE": [
        "Aufzeichnungen von Rekorden sind\n",
        "klasse. Sie erzählen uns Geschichten.\r",
        "Man spürt richtig die dramatischen\n",
        "Geschichten hinter all den Zahlen!"
      ]
    },
    {
      "id": "msg_0027_00003",
      "de_DE": [
        "Hey, du da!\n",
        "Wie geht es dir?\r",
        "Ich bin der Produzent hier.\n",
        "Siehst du oft fern?\r",
        "Verrätst du mir deine Meinung\n",
        "über die Fernsehsendungen?"
      ]
    },
    {
      "id": "msg_0027_00004",
      "de_DE": [
        "Oh, echt?\n",
        "Das ist in der Tat interessant.\r",
        "Nun, welchen Eindruck hinterlässt\n",
        "das Fernsehen bei dir?\r"
      ]
    },
    {
      "id": "msg_0027_00005",
      "de_DE": [
        "Oh, echt?\n",
        "Interessant, ja, wirklich.\r",
        "Danke, dass du meine Fragen\n",
        "beantwortet hast.\r",
        "Ich werde die Antworten speichern.\n",
        "Schalte auch in Zukunft\f",
        "Jubelstadt TV ein. "
      ]
    },
    {
      "id": "msg_0027_00006",
      "de_DE": [
        "Oh, na dann.\r",
        "Ich kann verstehen, wenn du\n",
        "beschäftigt bist.\r",
        "Ich fände es aber klasse, wenn du\n",
        "meine Fragen beantworten würdest,\f",
        "sobald du Zeit hast.\r",
        "Bis bald dann!\n"
      ]
    },
    {
      "id": "msg_0027_00007",
      "de_DE": [
        "...Oh?\r",
        "Du kennst diese Phrase. Das sagt mir,\n",
        "dass du den Durchblick hast!\r",
        "Du bist ein Trainer, richtig? Ich werde\n",
        "ein paar Fäden für dich ziehen!\r",
        "Ich denke, ich kann dir ein paar\n",
        "Hintergründe für die Boxen in\f",
        "deinem PC besorgen.\r",
        "Schalte auch weiterhin\n",
        "Jubelstadt TV ein."
      ]
    },
    {
      "id": "msg_0027_00008",
      "de_DE": [
        "...Oh?\r",
        "Du kennst diese Phrase. Das sagt mir,\n",
        "dass du den Durchblick hast!\r",
        "Du bist ein Trainer, richtig? Ich werde\n",
        "ein paar Fäden für dich ziehen!\r",
        "Ich denke, ich kann dir das\n",
        "Geheimgeschehen öffnen.\r",
        "Schalte auch weiterhin\n",
        "Jubelstadt TV ein."
      ]
    }
  ]
}
