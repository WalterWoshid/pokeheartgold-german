{
  "key": 18359,
  "messages": [
    {
      "id": "msg_0153_00000",
      "de_DE": [
        "Hey!\n",
        "Trainer-Kollege!\r",
        "Deine Pokémon sind in ihren\n",
        "Pokébällen gut aufgehoben.\r",
        "Aber das verbirgt ihre Aura nicht.\n",
        "Sie sind ganz schön zähe Kerlchen!\r",
        "Oh, entschuldige, ich sollte mich\n",
        "wohl erst mal vorstellen.\r",
        "Ich heiße Ignaz! Ich bin einer der\n",
        "Top Vier der Pokémon Liga!\r"
      ]
    },
    {
      "id": "msg_0153_00001",
      "de_DE": [
        "Ich hatte da so eine Idee.\n",
        "Vielleicht könntest du das erledigen.\r",
        "Es geht um den Arenaleiter\n",
        "dieser Stadt.\r",
        "Er hat neuerdings seinen Enthusiasmus\n",
        "für den Kampf vollends verloren.\r",
        "Der Mangel an würdigen Herausforderern\n",
        "ist ihm auf’s Gemüt geschlagen.\r",
        "Er ist so gelangweilt, dass er die ganze\n",
        "Zeit seine Arena renoviert.\r",
        "Dann der Stromausfall... Hat seiner\n",
        "Laune sicher auch nicht geholfen.\r",
        "Du weißt bestimmt, worauf ich\n",
        "hinauswill, nicht wahr?\r",
        "Ich möchte, dass du ihm einen Kampf\n",
        "lieferst, der seine Leidenschaft für\f",
        "Duelle wieder zum Leben erweckt.\r",
        "Ich verlasse mich auf dich, Heißsporn!\r"
      ]
    },
    {
      "id": "msg_0153_00002",
      "de_DE": [
        "Ignaz: Hey! Du da!\n",
        "Er ist noch nicht zurück.\r",
        "Wenn er wieder da ist, weißt du,\n",
        "was du zu tun hast.\r",
        "Liefere ihm einen Kampf, den er so\n",
        "schnell nicht vergessen wird!\r",
        "Das erinnert ihn an seine\n",
        "Passion für den Kampf.\r",
        "Ich verlasse mich auf dich, Heißsporn!"
      ]
    },
    {
      "id": "msg_0153_00003",
      "de_DE": [
        "Ignaz: Hey! Du da!\n",
        "Er ist endlich zurück!\r",
        "Außerdem scheint er motivierter\n",
        "zu sein als sonst.\r",
        "Vermutlich hat er schon bemerkt,\n",
        "wie hart es mit dir sein wird.\r",
        "Ich wette, er kann es kaum erwarten,\n",
        "gegen dich anzutreten.\r",
        "Denk dran, was du zu tun hast,\n",
        "Heißsporn.\r",
        "In der Hitze des Gefechts springt der\n",
        "Funke der Kampfeslust auf ihn über!\r",
        "Na dann los, Heißsporn! Ich warte auf\n",
        "dich in der Pokémon Liga!\r"
      ]
    },
    {
      "id": "msg_0153_00004",
      "de_DE": [
        "...Ähm... äh... I-ich heiße Jasmin,\n",
        "ich bin eine Arenaleiterin.\r",
        "Oh, tut mir leid, nicht in\n",
        "dieser Stadt...\r",
        "Ich bin Arenaleiterin in Johto...\n",
        "...Ähm... äh...\r",
        "Es wäre so schön, wenn du Johto\n",
        "ein wenig kennen würdest...\r"
      ]
    },
    {
      "id": "msg_0153_00005",
      "de_DE": [
        "Oh, wenn du den Arena-Orden nicht\n",
        "hast, musst du wieder umkehren."
      ]
    },
    {
      "id": "msg_0153_00006",
      "de_DE": [
        "Oh, das ist ja der Arena-Orden dieser\n",
        "Stadt. Du musst gut sein.\r",
        "...Ähm... äh...\n",
        "Nimm b-bitte auch das hier.\r"
      ]
    },
    {
      "id": "msg_0153_00007",
      "de_DE": [
        "...Diese Versteckte Maschine...\n",
        "Sie enthält Kaskade.\r",
        "Damit kommst du in die\n",
        "Pokémon Liga.\r",
        "...Ähm... Ich... weiß nicht, wie\n",
        "ich das sagen soll. Viel Glück!"
      ]
    },
    {
      "id": "msg_0153_00008",
      "de_DE": [
        "Jasmin: ...Irgendwie fühle ich mich\n",
        "in dieser Stadt zu Hause.\r",
        "Sie liegt am Meer, und da drüben\n",
        "steht ein Leuchtturm...\r"
      ]
    },
    {
      "id": "msg_0153_00009",
      "de_DE": [
        "Jasmin: ...Ich kam von weit her,\n",
        "da ich stärker werden wollte.\r",
        "Auf dem Weg hierher traf ich alle\n",
        "möglichen Leute mit ihren Pokémon...\r",
        "Sie schienen alle Spaß gehabt zu\n",
        "haben. Das machte mich glücklich."
      ]
    },
    {
      "id": "msg_0153_00010",
      "garbage": 0
    },
    {
      "id": "msg_0153_00011",
      "de_DE": [
        "Dieser riesige Fels...\n",
        "Ist das nicht ein Pokémon?"
      ]
    },
    {
      "id": "msg_0153_00012",
      "garbage": 0
    },
    {
      "id": "msg_0153_00013",
      "de_DE": [
        "Der Arenaleiter übertreibt es\n",
        "mit der Elektrizität!\r",
        "Er muss auch mal an die Stadt denken,\n",
        "die braucht doch auch Strom!"
      ]
    },
    {
      "id": "msg_0153_00014",
      "de_DE": [
        "Die Stadt verbraucht viel Strom,\n",
        "vor allem der Leuchtturm und die Arena.\r",
        "Schließlich haben sie alle Straßen\n",
        "mit riesigen Solarzellen gepflastert.\r",
        "In Sonnewik scheint ständig die Sonne,\n",
        "das System ist einfach perfekt!"
      ]
    },
    {
      "id": "msg_0153_00015",
      "de_DE": [
        "Dies hier ist eine große\n",
        "Stadt am Meer.\r",
        "Außerdem ist es das Tor zur\n",
        "Pokémon Liga."
      ]
    },
    {
      "id": "msg_0153_00016",
      "de_DE": [
        "Menschen und Pokémon passen ihr\n",
        "Leben jeder Umgebung an.\r",
        "Wir alle tun das, nur so überleben wir."
      ]
    },
    {
      "id": "msg_0153_00017",
      "de_DE": [
        "Sonnewik\n",
        "Solares Leben!"
      ]
    },
    {
      "id": "msg_0153_00018",
      "de_DE": [
        "Pokémon Arena Sonnewik\n",
        "Arenaleiter: Volkner\f",
        "Ein elektrisierendes Erlebnis!"
      ]
    },
    {
      "id": "msg_0153_00019",
      "de_DE": [
        "Leuchtturm\n",
        "Leuchtfeuer Sinnohs"
      ]
    },
    {
      "id": "msg_0153_00020",
      "de_DE": [
        "Sonnewik-Markt\n",
        "Große Auswahl an Stickern"
      ]
    },
    {
      "id": "msg_0153_00021",
      "de_DE": [
        "Monas Haus\n",
        "Bänder für jedes Pokémon"
      ]
    },
    {
      "id": "msg_0153_00022",
      "de_DE": "Ein weißes, unbeschriebenes Schild."
    },
    {
      "id": "msg_0153_00023",
      "de_DE": [
        "Pokémon-Fels\n",
        "Sonnewiks Kulturerbe"
      ]
    }
  ]
}
