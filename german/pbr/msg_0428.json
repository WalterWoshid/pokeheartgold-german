{
  "key": 28362,
  "messages": [
    {
      "id": "msg_0428_00000",
      "de_DE": [
        "Alle nennen mich den Beerenmeister.\r",
        "Ich verschenke täglich Beeren, weil ich\n",
        "möchte, dass die Menschen sie zu\f",
        "schätzen wissen.\r",
        "Du hast dir auch eine Beere verdient!\r"
      ]
    },
    {
      "id": "msg_0428_00001",
      "de_DE": [
        "Beeren sind Geschenke der Natur.\r",
        "Ich will dich ermuntern, deinen Pokémon\n",
        "Beeren zu fressen zu geben.\r",
        "Das macht deine Pokémon glücklich.\r",
        "Wenn die Leute das sehen, werden sie\n",
        "selber mehr Beeren pflanzen.\r",
        "Und das wird Sinnoh zu einem grüneren,\n",
        "natürlicheren Ort machen."
      ]
    },
    {
      "id": "msg_0428_00002",
      "de_DE": [
        "Vergisst du auch so leicht, wo du deine\n",
        "Beeren vergraben hast?"
      ]
    },
    {
      "id": "msg_0428_00003",
      "de_DE": [
        "Ja, das dachte ich mir!\n",
        "Das Problem kenne ich auch!\r",
        "Ich fühle mich dir verbunden!\n",
        "Dieses Zubehör für den Pokétch\f",
        "ist für dich!\r"
      ]
    },
    {
      "id": "msg_0428_00004",
      "de_DE": [
        "Ach, tatsächlich?\r",
        "Dann kommst du ja sicher\n",
        "ohne mein Geschenk zurecht."
      ]
    },
    {
      "id": "msg_0428_00005",
      "de_DE": [
        "Der {STRVAR_1 24, 0} zeigt dir,\n",
        "wo reife Beeren darauf warten,\f",
        "von dir gepflückt zu werden."
      ]
    },
    {
      "id": "msg_0428_00006",
      "de_DE": [
        "Manche Beeren brauchen\n",
        "viel, viel Wasser."
      ]
    },
    {
      "id": "msg_0428_00007",
      "de_DE": [
        "Ähm... Möchtest du ein wenig Mulch?\r",
        "Wenn du Beeren pflanzen möchtest, ist\n",
        "Mulch ein großartiger Dünger."
      ]
    },
    {
      "id": "msg_0428_00008",
      "de_DE": [
        "Dieser {STRVAR_1 8, 0}...\r",
        "Er besteht aus hochwertiger Erde und\n",
        "den, ähm... Hinterlassenschaften von\f",
        "Pokémon.\r",
        "Er sorgt für gesundes Beerenwachstum."
      ]
    },
    {
      "id": "msg_0428_00009",
      "de_DE": [
        "Ähm...\n",
        "Bis zum nächsten Mal."
      ]
    },
    {
      "id": "msg_0428_00010",
      "de_DE": "Du hast {STRVAR_1 8, 0} gekauft.\r"
    },
    {
      "id": "msg_0428_00011",
      "de_DE": [
        "Es tut mir so leid...\n",
        "Dein Beutel scheint voll zu sein..."
      ]
    },
    {
      "id": "msg_0428_00012",
      "de_DE": [
        "Ähm... Du scheinst nicht genügend Geld\n",
        "zu haben..."
      ]
    }
  ]
}
