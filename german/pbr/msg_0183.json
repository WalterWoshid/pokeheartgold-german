{
  "key": 17299,
  "messages": [
    {
      "id": "msg_0183_00000",
      "de_DE": [
        "{STRVAR_1 3, 0}: Oh, hey, {STRVAR_1 3, 1}!\n",
        "Wo warst du so lange?\f",
        "Das macht 100 Millionen $ Strafe!\r",
        "Hör zu. Ich werde der\n",
        "größte Trainer überhaupt.\r",
        "Und deshalb bin ich hier. Ich muss\n",
        "härter werden, meine Pokémon auch!\r"
      ]
    },
    {
      "id": "msg_0183_00001",
      "de_DE": [
        "Hehehe! Tut mir echt leid,\n",
        "aber das konnte ich nicht überhören.\f",
        "”Der größte Trainer überhaupt.”?!?\r",
        "Ihr redet von mir, was?!?\n",
        "Woher ich das weiß? Nun, weil\f",
        "man damit nur mich meinen kann!\r",
        "Als Beweis gehe ich jetzt\n",
        "in den Vulkan hinein.\r",
        "Du guckst so komisch. Du weißt\n",
        "wirklich von nichts, oder?\r",
        "Also gut, ich erzähle es dir.\n",
        "Das hier ist die Duellzone, klar?\r",
        "Am anderen Ende davon befindet\n",
        "sich der Vulkan.\r",
        "Und tief im Vulkan liegt ein\n",
        "Schatz verborgen.\r"
      ]
    },
    {
      "id": "msg_0183_00002",
      "de_DE": [
        "{STRVAR_1 3, 0}: Na und?\n",
        "Dass ich nicht lache!\r",
        "Wenn ich den Schatz zuerst finde, macht\n",
        "mich das dann zum größten Trainer?\r",
        "So mach ich’s, {STRVAR_1 3, 1}!\n",
        "Hör du auch gut zu, Fremder!\r",
        "Ich kralle mir den Schatz als Erster!\r",
        "Aber vorher gehe ich zum Duellturm!\n",
        "Man sieht sich!\r"
      ]
    },
    {
      "id": "msg_0183_00003",
      "de_DE": [
        "Dieser Typ...\n",
        "Der hat doch Hummeln im Hintern, nicht?\r"
      ]
    },
    {
      "id": "msg_0183_00004",
      "de_DE": [
        "Egal. Tag, ich bin Avenaro.\n",
        "Pah, diese Niete schlägt mich niemals.\r",
        "Und, kennst du dich im\n",
        "Trainer-Dingsbums gut aus?\r",
        "Du solltest den Typen lieber suchen und\n",
        "ihm sagen, er soll den Vulkan ja\f",
        "nicht unterschätzen.\r",
        "Ähm, weißt du was?\r",
        "Du solltest dich vielleicht auch im\n",
        "Duellturm in Form bringen.\r",
        "Ich glaube nicht, dass du sonst im\n",
        "Vulkan lange durchhältst.\r",
        "Bis später dann!\r"
      ]
    },
    {
      "id": "msg_0183_00005",
      "de_DE": [
        "Tag, Trainer!\n",
        "Hast du da einen Pokédex?!?\r",
        "Bestimmt will die Person, die ihn dir gab,\n",
        "dass er schnell vervollständigt wird."
      ]
    },
    {
      "id": "msg_0183_00006",
      "de_DE": [
        "Tag, Trainer!\n",
        "Du hast einen Pokédex, nicht wahr?\r",
        "Ein kleiner Tipp: Fordere möglichst\n",
        "viele andere Trainer heraus!\r",
        "Sie verwenden unterschiedlichste\n",
        "Pokémon.\r",
        "So füllt sich dein Pokédex ratzfatz!"
      ]
    },
    {
      "id": "msg_0183_00007",
      "de_DE": [
        "So wie der Duellturm da steht...\n",
        "Mächtig und groß...\r",
        "Ist er wie ein Hindernis, das zwischen\n",
        "dem Trainer und seinem Erfolg steht."
      ]
    },
    {
      "id": "msg_0183_00008",
      "de_DE": [
        "Ich habe in meiner Karriere gegen\n",
        "viele Trainer gekämpft.\r",
        "Mittlerweile habe ich großes\n",
        "Vertrauen in meine Fähigkeiten.\r",
        "Doch die Welt ist so riesig...\r",
        "Da ist es nicht leicht, den Kampf\n",
        "des Lebens zu bestreiten!"
      ]
    },
    {
      "id": "msg_0183_00009",
      "de_DE": [
        "Das Land in dieser Gegend ist\n",
        "wegen des Vulkans zerklüftet.\r",
        "Die Unebenheiten und das ständige Auf\n",
        "und Ab machen Wandern nicht einfach."
      ]
    },
    {
      "id": "msg_0183_00010",
      "de_DE": [
        "Die Top Vier aus der Pokémon Liga\n",
        "kommen auch manchmal hierher!"
      ]
    },
    {
      "id": "msg_0183_00011",
      "de_DE": [
        "Deine Pokémon stammen aus Sinnoh,\n",
        "habe ich Recht?\r",
        "Solche sehen wir hier in der\n",
        "Gegend nicht häufig."
      ]
    },
    {
      "id": "msg_0183_00012",
      "de_DE": [
        "Was mich härter macht,\n",
        "bringt mich nicht um!\r",
        "Das habe ich mir nur so ausgedacht.\n",
        "Klingt aber cool, oder?"
      ]
    },
    {
      "id": "msg_0183_00013",
      "de_DE": [
        "Wie geht’s? Möchtest\n",
        "du nach Blizzach?"
      ]
    },
    {
      "id": "msg_0183_00014",
      "de_DE": [
        "Aye, aye!\n",
        "Anker lichten!\r"
      ]
    },
    {
      "id": "msg_0183_00015",
      "de_DE": [
        "Oh, stimmt ja. Du würdest viel lieber\n",
        "mit irgendeiner Maschine dahin fliegen."
      ]
    },
    {
      "id": "msg_0183_00016",
      "de_DE": [
        "Wenn ich irgendwohin reise, bin ich schon\n",
        "Wochen vorher total aufgeregt und\f",
        "gespannt, was ich alles sehen werde!\r",
        "Sogar wenn es zu Orten geht, die ich\n",
        "schon kenne...\r",
        "Auch da mache ich mit leuchtenden\n",
        "Augen immer wieder Entdeckungen!"
      ]
    },
    {
      "id": "msg_0183_00017",
      "de_DE": [
        "Hmmm!\n",
        "Eine Superangel ist wirklich gut!\r",
        "Meinst du nicht auch?"
      ]
    },
    {
      "id": "msg_0183_00018",
      "de_DE": [
        "Hmmm!\n",
        "Da sind wir ja der gleichen Meinung!\r",
        "Hmmm!\n",
        "Ich schenke dir diese {STRVAR_1 8, 0}!\r"
      ]
    },
    {
      "id": "msg_0183_00019",
      "de_DE": [
        "Wo immer du Wasser findest,\n",
        "versuche dein Glück beim Angeln."
      ]
    },
    {
      "id": "msg_0183_00020",
      "de_DE": "Magst du keinen Fisch?"
    },
    {
      "id": "msg_0183_00021",
      "de_DE": [
        "Was gibt’s?\n",
        "Tipps zum Angeln gefällig?\r",
        "Von mir aus. Die kann ich dir geben.\r",
        "Alles hängt von der Rute\n",
        "und der Technik ab!"
      ]
    },
    {
      "id": "msg_0183_00022",
      "de_DE": [
        "Kampfareal\n",
        "Kämpfe en gros"
      ]
    },
    {
      "id": "msg_0183_00023",
      "de_DE": [
        "Duellpark\n",
        "1A Training"
      ]
    },
    {
      "id": "msg_0183_00024",
      "de_DE": [
        "Route 225 voraus\n",
        "Weg des Duells"
      ]
    },
    {
      "id": "msg_0183_00025",
      "de_DE": [
        "{STRVAR_1 3, 0}: Hey, {STRVAR_1 3, 1}!\r",
        "Du solltest wissen, nicht nur\n",
        "du wirst immer stärker!\r",
        "Hier der Beweis!\n",
        "Bereit zum Kampf?\r"
      ]
    },
    {
      "id": "msg_0183_00026",
      "de_DE": [
        "{STRVAR_1 3, 0}: ...!\n",
        "Das macht überhaupt nichts.\r",
        "{STRVAR_1 3, 1}, je besser du wirst,\n",
        "desto besser werden wir auch.\r",
        "Pokémon kennen kein Limit.\n",
        "Das ist meine Meinung, {STRVAR_1 3, 1}."
      ]
    }
  ]
}
