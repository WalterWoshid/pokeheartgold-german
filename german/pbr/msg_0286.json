{
  "key": 9314,
  "messages": [
    {
      "id": "msg_0286_00000",
      "de_DE": "Such dir hier bitte einen Partner aus.\r"
    },
    {
      "id": "msg_0286_00001",
      "de_DE": [
        "{STRVAR_1 3, 0}, du hast noch\n",
        "keinen Partner gefunden.\r",
        "Möchtest du die Suche aufgeben und\n",
        "zurück zur Rezeption gehen?"
      ]
    },
    {
      "id": "msg_0286_00002",
      "de_DE": [
        "Vielen Dank!\r",
        "Nun werde ich dir den Raum\n",
        "für die Multikämpfe zeigen.\r"
      ]
    },
    {
      "id": "msg_0286_00003",
      "de_DE": [
        "Urs: Meine jetzigen Partner?\r",
        "Nun, mein {STRVAR_1 0, 0} mit seiner\n",
        "Attacke {STRVAR_1 6, 1} hat es drauf.\r",
        "Dann wäre da noch {STRVAR_1 0, 2}.\n",
        "Beherrscht {STRVAR_1 6, 3} im Schlaf.\r",
        "Möchtest du dich mir anschließen?"
      ]
    },
    {
      "id": "msg_0286_00004",
      "de_DE": [
        "Urs: ...Oh, wirklich?\n",
        "Das ist aber schade."
      ]
    },
    {
      "id": "msg_0286_00005",
      "de_DE": [
        "Urs: Hahaha, super!\n",
        "Ich warte dann auf dich.\r"
      ]
    },
    {
      "id": "msg_0286_00006",
      "de_DE": [
        "Raissa: Mein {STRVAR_1 0, 0} setzt\n",
        "{STRVAR_1 6, 1} sehr geschickt ein.\r",
        "{STRVAR_1 0, 2} zeigt mit der Attacke\n",
        "{STRVAR_1 6, 3} seine ganze Klasse.\r",
        "Möchtest du dich mir anschließen?"
      ]
    },
    {
      "id": "msg_0286_00007",
      "de_DE": [
        "Raissa: Oh...\n",
        "Jammerschade..."
      ]
    },
    {
      "id": "msg_0286_00008",
      "de_DE": "Raissa: Dann gehe ich schon mal vor.\r"
    },
    {
      "id": "msg_0286_00009",
      "de_DE": [
        "Avenaro: Hey, suchst du einen\n",
        "Kampfpartner? Hör dir mal das an.\r",
        "Mein {STRVAR_1 0, 0} beherrscht\n",
        "{STRVAR_1 6, 1} wie kein anderes.\r",
        "Und {STRVAR_1 0, 2} zeigt mit\n",
        "{STRVAR_1 6, 3}, wo es lang geht.\r",
        "Du möchtest mich an deiner\n",
        "Seite haben, stimmt doch?"
      ]
    },
    {
      "id": "msg_0286_00010",
      "de_DE": [
        "Avenaro: Hä? Was?\n",
        "Wie kannst du nur so kalt sein!"
      ]
    },
    {
      "id": "msg_0286_00011",
      "de_DE": [
        "Avenaro: Hehehe! Gute Wahl!\n",
        "Mit mir ist vieles leichter!\r"
      ]
    },
    {
      "id": "msg_0286_00012",
      "de_DE": [
        "Charlie: ...Mein {STRVAR_1 0, 0} kann\n",
        "{STRVAR_1 6, 1} sehr gut einsetzen...\r",
        "Und {STRVAR_1 0, 2} ist wie besessen\n",
        "von der Attacke {STRVAR_1 6, 3}.\r",
        "...Wie entscheidest du dich?\n",
        "Möchtest du mich dabeihaben?"
      ]
    },
    {
      "id": "msg_0286_00013",
      "de_DE": "Charlie: ...Wenn du es so willst..."
    },
    {
      "id": "msg_0286_00014",
      "de_DE": [
        "Charlie: ...Gut, ich warte\n",
        "dann auf dich...\r"
      ]
    },
    {
      "id": "msg_0286_00015",
      "de_DE": [
        "Orisa: Hallihallo!\n",
        "Ich habe mein {STRVAR_1 0, 0} dabei!\f",
        "{STRVAR_1 6, 1} ist seine Spezialität!\r",
        "Das andere ist ein {STRVAR_1 0, 2} und\n",
        "mit {STRVAR_1 6, 3} besonders effektiv!\r",
        "{STRVAR_1 3, 4}, möchtest du mich\n",
        "an deiner Seite haben?"
      ]
    },
    {
      "id": "msg_0286_00016",
      "de_DE": [
        "Orisa: Oh, schon gut.\n",
        "Vielleicht ein anderes Mal!"
      ]
    },
    {
      "id": "msg_0286_00017",
      "de_DE": [
        "Orisa: Schön! Ich warte dann auf dich!\n",
        "{STRVAR_1 3, 0}, mach nicht zu lange, ja?\r"
      ]
    }
  ]
}
