{
  "key": 21522,
  "messages": [
    {
      "id": "msg_0160_00000",
      "de_DE": [
        "Warst du kürzlich im Untergrund?\r",
        "Je nachdem, wo du hinabsteigst,\n",
        "gelangst du an verschiedene Orte.\r",
        "Deshalb kommt mein Forschersack an\n",
        "möglichst vielen Orten zum Einsatz."
      ]
    },
    {
      "id": "msg_0160_00001",
      "de_DE": [
        "Die Sphären, die du unter der Erde\n",
        "gefunden hast, sind wie Edelsteine.\r",
        "Du kannst sie gegen allerlei\n",
        "Nützliches eintauschen."
      ]
    },
    {
      "id": "msg_0160_00002",
      "de_DE": [
        "Wenn du Sphären vergräbst, wachsen sie\n",
        "jeden Tag ein klein wenig.\r",
        "Das ist schon eine seltsame Sache.\r",
        "Oh, stimmt ja! Ich sollte meine auch mal\n",
        "ausgraben, habe sie fast vergessen!"
      ]
    },
    {
      "id": "msg_0160_00003",
      "de_DE": [
        "Erobere die Fahnen deiner Freunde,\n",
        "um deine Geheimbasis aufzupolieren.\r",
        "Versuche, deine Basis zu tarnen.\n",
        "Mach gleichzeitig die Basen deiner\f",
        "Freunde ausfindig."
      ]
    },
    {
      "id": "msg_0160_00004",
      "de_DE": [
        "Begib dich in den Untergrund und\n",
        "erlebe dort ein tolles Abenteuer!"
      ]
    },
    {
      "id": "msg_0160_00005",
      "de_DE": [
        "Manche Fallen dort unten entschärfst\n",
        "du mit dem Touchpen oder dem Mikrofon!"
      ]
    },
    {
      "id": "msg_0160_00006",
      "de_DE": [
        "Der Untergrundmann in Ewigenau und\n",
        "Adam aus Fleetburg sind verwandt.\r",
        "Nimmt man Adams Sohn Veit hinzu, hat\n",
        "man ein Trio hervorragender Bergleute."
      ]
    }
  ]
}
