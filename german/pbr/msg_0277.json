{
  "key": 9295,
  "messages": [
    {
      "id": "msg_0277_00000",
      "de_DE": [
        "{STRVAR_1 3, 0}: !\r",
        "Damit kommt ihr nicht davon,\n",
        "Team Galaktik!\r"
      ]
    },
    {
      "id": "msg_0277_00001",
      "de_DE": [
        "Jupiter: Oh?\n",
        "Bist du etwa schon fertig?\r",
        "Deine Pokémon sind gar nicht mal so\n",
        "übel, aber du bist lächerlich schwach.\r",
        "Hast du ernsthaft gedacht, du könntest\n",
        "das Pokémon im See retten?!?\r",
        "Und der Pokémon Champ werden?!?\n",
        "Träum weiter, Kindchen!\r",
        "Aber hier ist es recht kalt, brrr.\n",
        "Gehen wir zurück zum Hauptquartier\f",
        "in Schleiede.\r"
      ]
    },
    {
      "id": "msg_0277_00002",
      "de_DE": [
        "Oh? Dich kenn ich doch.\n",
        "Wir haben uns in Ewigenau getroffen.\r",
        "Hör mal. Team Galaktik hat etwas\n",
        "Großes vor, zum Wohle aller!\r",
        "Daher solltest du uns in Ruhe lassen!\r",
        "Hör auf, über Pokémon oder andere\n",
        "Nebensächlichkeiten zu jammern.\r",
        "Und verschwende deine Zeit nicht\n",
        "damit, ins Hauptquartier nach\f",
        "Schleiede zu gehen.\r",
        "Wenn du mich jetzt entschuldigen\n",
        "würdest.\r"
      ]
    },
    {
      "id": "msg_0277_00003",
      "de_DE": [
        "{STRVAR_1 3, 0}: ...\n",
        "...\r",
        "Ja, ja, ich weiß!\r",
        "Ich konnte nichts gegen\n",
        "Team Galaktik ausrichten!\r"
      ]
    },
    {
      "id": "msg_0277_00004",
      "de_DE": [
        "Das Pokémon namens SELFE...\n",
        "Es machte einen leidenden Eindruck...\r"
      ]
    },
    {
      "id": "msg_0277_00005",
      "de_DE": [
        "Ich werde stärker...\r",
        "Es geht nicht ums Gewinnen\n",
        "oder Verlieren...\r",
        "Das reicht nicht...\n",
        "Ich muss stärker werden...\r"
      ]
    }
  ]
}
