      "id": "msg_0191_00000",
      "de_DE": [
        "Wähle den Juror, der die\n",
        "Attacke bewerten soll."
      ]
    },
    {
      "id": "msg_0191_00001",
      "de_DE": [
        "Auftritt {COLOR 1}Nr. {STRVAR_1 50, 0}{COLOR 0}!\n",
        "Welche Attacke wählst du?"
      ]
    },
    {
      "id": "msg_0191_00002",
      "de_DE": [
        "Der {COLOR 1}letzte {COLOR 0}Auftritt!\n",
        "Wähle deine Attacke!"
      ]
    },
    {
      "id": "msg_0191_00003",
      "de_DE": [
        "{STRVAR_1 1, 0} führt\n",
        "{STRVAR_1 3, 1} die Attacke\f",
        "{STRVAR_1 6, 2} vor!\r"
      ]
    },
    {
      "id": "msg_0191_00004",
      "de_DE": [
        "Oh nein! Für diesen Juror hat\n",
        "schon jemand vorgeführt!\r"
