  "messages": [
    {
      "id": "msg_0129_00000",
      "de_DE": [
        "Das ist ein Fernglas...\n",
        "100 $ hineinwerfen?"
      ]
    },
    {
      "id": "msg_0129_00001",
      "de_DE": "Du hast nicht genug Geld..."
    },
    {
      "id": "msg_0129_00002",
      "de_DE": [
        "Sag mir, dass ich mir das\n",
        "nicht einbilde...\r",
        "Die Pokémon, die man heute im Großmoor\n",
        "sieht, sind andere als gestern..."
      ]
    },
    {
      "id": "msg_0129_00003",
      "de_DE": [
        "Sieh durch eines der Ferngläser, um\n",
        "über das Großmoor zu blicken.\r",
        "So siehst du, welche Pokémon du\n",
        "fangen kannst und wo du sie findest."
      ]
    },
    {
      "id": "msg_0129_00004",
      "de_DE": [
        "Im Großmoor gibt es eine Eilbahn.\r",
        "Sie bringt dich tiefer in das\n",
        "Gebiet hinein."
      ]
    },
    {
      "id": "msg_0129_00005",
      "de_DE": [
        "Als ich auf der Moorfläche lief,\n",
        "bin ich manchmal eingesunken.\r",
        "Ich habe voller Panik versucht,\n",
        "mich wieder zu befreien.\r",
        "Danach konnte ich vor lauter\n",
        "Aufregung gar keine Pokémon\f",
        "mehr fangen. "
      ]
    }
  ]
}
