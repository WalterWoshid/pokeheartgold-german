{
  "key": 32474,
  "messages": [
    {
      "id": "msg_0431_00000",
      "de_DE": [
        "Im Turm der Ruhenden ruhen die\n",
        "dahingegangenen Pokémon in Frieden.\r",
        "Jene, die sich eines langen Lebens\n",
        "erfreuen durften...\r",
        "Jene, deren Zeit kürzer bemessen\n",
        "war...\r",
        "Alle dahingegangenen Pokémon finden\n",
        "hier Trost und Ruhe...\r",
        "Es ist gut, dass du hier warst.\n",
        "Hier, nimm diese VM.\r"
      ]
    },
    {
      "id": "msg_0431_00001",
      "de_DE": [
        "Um die VM Stärke verwenden zu können...\r",
        "...Ich weiß es nicht mehr genau, aber du\n",
        "musst eine Pokémon Arena besuchen."
      ]
    },
    {
      "id": "msg_0431_00002",
      "de_DE": [
        "Diese Lamina...\n",
        "Sie ist nicht leicht zu begreifen...\r",
        "Aber in jedem Fall ist sie voller Mitleid.\n",
        "Sie kommt regelmäßig hierher."
      ]
    },
    {
      "id": "msg_0431_00003",
      "de_DE": [
        "Lass mich deine Abreise von hier weniger\n",
        "düster gestalten. Nimm dies.\r"
      ]
    },
    {
      "id": "msg_0431_00004",
      "de_DE": [
        "Das Schutzband... Gib es dem Pokémon,\n",
        "das in deinem Team an erster Stelle\f",
        "steht.\r",
        "Wilde Pokémon greifen seltener an,\n",
        "so dass ihr ungestört reisen könnt."
      ]
    }
  ]
}
