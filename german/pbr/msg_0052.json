{
  "key": 29711,
  "messages": [
    {
      "id": "msg_0052_00000",
      "de_DE": [
        "Die Bücher in der zweiten Etage\n",
        "sind einfache Lektüre.\r",
        "Die Bücher hier sind so schwer\n",
        "geschrieben, dass ich nichts verstehe."
      ]
    },
    {
      "id": "msg_0052_00001",
      "de_DE": [
        "Ich habe mir sofort das Buch\n",
        "“Überleben nach Katastrophen”\f",
        "ausgeliehen."
      ]
    },
    {
      "id": "msg_0052_00002",
      "de_DE": [
        "Die deckenhohen Regale sind\n",
        "vollgestopft mit Büchern."
      ]
    },
    {
      "id": "msg_0052_00003",
      "de_DE": [
        "Die Regale sind voll mit vom\n",
        "Lesen abgenutzten Büchern."
      ]
    },
    {
      "id": "msg_0052_00004",
      "de_DE": [
        "Der Verzehr von Speisen und Getränken\n",
        "ist innerhalb der Bibliothek untersagt!"
      ]
    }
  ]
}
