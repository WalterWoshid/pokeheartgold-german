{
  "key": 17419,
  "messages": [
    {
      "id": "msg_0024_00000",
      "de_DE": [
        "Hast du einen Pokétch?\r",
        "Es gibt ein Modell für Mädchen und\n",
        "eines für Jungen.\f",
        "Sie haben unterschiedliche Farben."
      ]
    },
    {
      "id": "msg_0024_00001",
      "de_DE": [
        "Mein Mann ist der Präsident der Firma.\r",
        "Wir haben in einer Garage angefangen,\n",
        "nun produzieren wir in großen Mengen!\r",
        "Wir fertigen etwas, das die Welt\n",
        "glücklich macht! Stell dir das mal vor!"
      ]
    },
    {
      "id": "msg_0024_00002",
      "de_DE": [
        "Überall auf der Welt denken sich die\n",
        "Leute neues Zubehör für den Pokétch\r",
        "aus. Du wirst erstaunt sein, wo und von\n",
        "wem du Zubehör bekommst.\r",
        "Auf dem PC hier findest du Informationen\n",
        "zu den verschiedenen Teilen."
      ]
    },
    {
      "id": "msg_0024_00003",
      "de_DE": [
        "Hier sind Beschreibungen des\n",
        "Zubehörs für den Pokétch.\r"
      ]
    },
    {
      "id": "msg_0024_00004",
      "de_DE": [
        "Über welches Zubehör\n",
        "möchtest du etwas lesen?"
      ]
    },
    {
      "id": "msg_0024_00005",
      "de_DE": [
        "Hier sind Beschreibungen des\n",
        "Zubehörs für den Pokétch.\r"
      ]
    },
    {
      "id": "msg_0024_00006",
      "de_DE": [
        "Über welches Zubehör\n",
        "möchtest du etwas lesen?"
      ]
    },
    {
      "id": "msg_0024_00007",
      "de_DE": [
        "Hier sind Beschreibungen des\n",
        "Zubehörs für den Pokétch.\r"
      ]
    },
    {
      "id": "msg_0024_00008",
      "de_DE": [
        "Über welches Zubehör\n",
        "möchtest du etwas lesen?"
      ]
    },
    {
      "id": "msg_0024_00009",
      "de_DE": [
        "Hier sind Beschreibungen des\n",
        "Zubehörs für den Pokétch.\r"
      ]
    },
    {
      "id": "msg_0024_00010",
      "de_DE": [
        "Über welches Zubehör\n",
        "möchtest du etwas lesen?"
      ]
    },
    {
      "id": "msg_0024_00011",
      "de_DE": [
        "Die Digitaluhr zeigt die aktuelle\n",
        "Zeit an.\r",
        "Verspäte dich nicht, wenn du mit\n",
        "Freunden verabredet bist!\r"
      ]
    },
    {
      "id": "msg_0024_00012",
      "de_DE": [
        "Die Analoguhr zeigt die aktuelle Zeit an.\r",
        "Der kurze Zeiger zeigt die Stunden, der\n",
        "lange Zeiger die Minuten an.\r"
      ]
    },
    {
      "id": "msg_0024_00013",
      "de_DE": [
        "Der Wecker kann so eingestellt werden,\n",
        "dass er ein Mal am Tag Alarm schlägt.\r",
        "Mit der unteren Schaltfläche stellst\n",
        "du die Weckzeit ein.\r",
        "Die obere Schaltfläche aktiviert sie.\r"
      ]
    },
    {
      "id": "msg_0024_00014",
      "de_DE": [
        "Mit der Stoppuhr kann die Zeit exakt\n",
        "gemessen werden.\r",
        "Wie schnell bist du? Zum Beispiel\n",
        "auf dem Radweg?\r"
      ]
    },
    {
      "id": "msg_0024_00015",
      "de_DE": [
        "Die Eieruhr misst die Zeit rückwärts von\n",
        "99 Minuten runter auf 0.\r",
        "Stell die Zeit über die mittlere\n",
        "Schaltfläche ein und starte die Uhr.\r"
      ]
    },
    {
      "id": "msg_0024_00016",
      "de_DE": [
        "Dies ist ein Monatskalender, auf dem du\n",
        "wichtige Ereignisse vormerken kannst.\r",
        "Berühre ein Datum und es bekommt eine\n",
        "andere Farbe.\r",
        "Berühre es erneut, um die Farbe\n",
        "zurückzusetzen.\r"
      ]
    },
    {
      "id": "msg_0024_00017",
      "de_DE": [
        "Mit dem Taschenrechner kannst du bis in\n",
        "den 10-stelligen Bereich rechnen.\r",
        "Perfekt, um mathematische Aufgaben, die\n",
        "dir vielleicht gestellt werden, zu lösen.\r"
      ]
    },
    {
      "id": "msg_0024_00018",
      "de_DE": [
        "Die Pokémon-Liste zeigt dir den Status\n",
        "deiner Team-Pokémon an.\r",
        "Berühre sie, um ihren Ruf zu hören.\n",
        "Ihre KP werden auch angezeigt.\r"
      ]
    },
    {
      "id": "msg_0024_00019",
      "de_DE": [
        "Der Freundschaftsstatus zeigt dir an,\n",
        "wie die Freundschaft zwischen dir\f",
        "und deinen Pokémon wächst.\r",
        "Berühre den Bildschirm. Die Pokémon,\n",
        "die dich mögen, werden näher kommen.\r"
      ]
    },
    {
      "id": "msg_0024_00020",
      "de_DE": [
        "Der Pension-Prüfer zeigt dir die\n",
        "Pokémon, die du in der Pension\r",
        "untergebracht hast.\n",
        "Sieh dir an, wie es ihnen geht.\r"
      ]
    },
    {
      "id": "msg_0024_00021",
      "de_DE": [
        "Beim Vergleich wird die Anziehung\n",
        "unter den Pokémon geprüft.\r",
        "Je größer die Zahl der Herzen,\n",
        "desto höher die Wahrscheinlichkeit,\f",
        "dass ein Ei entsteht.\r"
      ]
    },
    {
      "id": "msg_0024_00022",
      "de_DE": [
        "Die Historie der Pokémon zeigt dir\n",
        "die letzten 12 Pokémon, die du\f",
        "erhalten hast.\r"
      ]
    },
    {
      "id": "msg_0024_00023",
      "de_DE": [
        "Der Beerensucher ist eine Karte, auf\n",
        "der die Standorte von Beeren\f",
        "eingezeichnet sind.\r",
        "Und zwar in den Gegenden, die\n",
        "du bereits bereist hast.\r"
      ]
    },
    {
      "id": "msg_0024_00024",
      "de_DE": [
        "Der Notizblock ist hilfreich, wenn du\n",
        "dir schnell etwas notieren möchtest\f",
        "oder Lust hast zu kritzeln.\r",
        "Machst du einen Fehler, kannst du\n",
        "ihn wegradieren.\r"
      ]
    },
    {
      "id": "msg_0024_00025",
      "de_DE": [
        "Auf dem Zeichenbrett kannst du\n",
        "Bilder im Mosaikstil zeichnen.\r",
        "Berührst du einen Punkt mehrfach,\n",
        "wird er immer dunkler.\r"
      ]
    },
    {
      "id": "msg_0024_00026",
      "de_DE": [
        "Der Farbwechsler ändert die Farbe, in\n",
        "der dein Pokétch angezeigt wird.\r",
        "Mit dem Regler im unteren Bereich,\n",
        "kannst du zwischen acht Farben wählen.\r"
      ]
    },
    {
      "id": "msg_0024_00027",
      "de_DE": [
        "Auf der Landkarte kannst du\n",
        "Markierungen anbringen.\r",
        "Schiebe die Markierungen an Orte, \n",
        "die du dir merken möchtest.\r"
      ]
    },
    {
      "id": "msg_0024_00028",
      "de_DE": [
        "Das Roulette besitzt ein Rad, auf\n",
        "dem du schreiben kannst.\r",
        "Male Zahlen, Items oder was du\n",
        "möchtest, und dreh es dann!\r"
      ]
    },
    {
      "id": "msg_0024_00029",
      "de_DE": [
        "Beim Münzwurf entscheidet die\n",
        "Münze mit Kopf oder “Ball” für dich.\r",
        "Kannst du dich nicht entscheiden,\n",
        "dann lass die Münze sprechen.\r"
      ]
    },
    {
      "id": "msg_0024_00030",
      "de_DE": [
        "Der Schrittzähler zählt für dich die\n",
        "Schritte, die du bisher gegangen bist.\r",
        "Berühre den Schalter, um den Zähler\n",
        "zurückzusetzen.\r"
      ]
    },
    {
      "id": "msg_0024_00031",
      "de_DE": [
        "Das Itemradar sucht nach\n",
        "verborgenen Items.\r",
        "Berühre den Radarbildschirm.\n",
        "Befindet sich in der Nähe ein\f",
        "Item, wird es angezeigt.\r"
      ]
    },
    {
      "id": "msg_0024_00032",
      "de_DE": [
        "Mit dem Zähler kannst du Dinge der\n",
        "Reihe nach zählen.\r",
        "Berühre die Schaltfläche und zähle,\n",
        "was immer gezählt werden muss.\r"
      ]
    },
    {
      "id": "msg_0024_00033",
      "de_DE": [
        "Der Trainer-Zähler zeichnet die Werte\n",
        "des Pokéradars auf.\r",
        "Hier kannst du sehen, wie oft du ein\n",
        "Pokémon der gleichen Art gesehen hast.\r"
      ]
    },
    {
      "id": "msg_0024_00034",
      "de_DE": [
        "Der Linkfinder sucht nach Spielern,\n",
        "die im drahtlosen Modus spielen.\r",
        "Berühre den Bildschirm, um eine Liste\n",
        "aller Spieler zu sehen, die die\f",
        "Drahtlose Datenübertragung verwenden.\r"
      ]
    },
    {
      "id": "msg_0024_00035",
      "de_DE": [
        "Der Attackentester zeigt dir, wie\n",
        "effektiv eine Attacke ist, ausgehend\f",
        "vom jeweiligen Typ.\r",
        "Ändere die Typen der Attacken und\n",
        "der Verteidigung, um die Wirkungen\f",
        "zu sehen.\r"
      ]
    }
  ]
}
