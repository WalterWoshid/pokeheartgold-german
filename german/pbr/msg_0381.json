    {
      "id": "msg_0381_00000",
      "de_DE": [
        "Hallo!\r",
        "Hier kannst du Beeren kochen\n",
        "und aus ihnen Knurspe machen.\r"
      ]
    },
    {
      "id": "msg_0381_00001",
      "de_DE": [
        "Möchtest du allein kochen oder\n",
        "mit anderen zusammen?"
      ]
    },
    {
      "id": "msg_0381_00002",
      "de_DE": [
        "Drahtlose DS-Datenübertragung\n",
        "wird initialisiert."
      ]
    },
    {
      "id": "msg_0381_00003",
      "de_DE": "JA"
    },
    {
      "id": "msg_0381_00004",
      "de_DE": "NEIN"
    },
    {
      "id": "msg_0381_00005",
      "garbage": 0
    },
    {
      "id": "msg_0381_00006",
      "de_DE": "Oh, du hast keine Beeren!\r"
    },
    {
      "id": "msg_0381_00007",
      "de_DE": "Deine Knurspbox ist voll.\r"
    },
    {
      "id": "msg_0381_00008",
      "de_DE": [
        "Tut mir leid, du brauchst eine\n",
        "Knurspbox dafür!"
      ]
    },
    {
      "id": "msg_0381_00009",
      "de_DE": "ALLEIN"
    },
    {
      "id": "msg_0381_00010",
      "de_DE": "IN EINER GRUPPE"
    },
    {
      "id": "msg_0381_00011",
      "de_DE": "INFO"
    },
    {
      "id": "msg_0381_00012",
      "de_DE": "ZURÜCK"
    },
    {
      "id": "msg_0381_00013",
      "de_DE": [
        "Bitte legt fest, wer in der Gruppe\n",
        "der “LEITER” ist.\r",
        "Die anderen Spieler wählen\n",
        "“MITSPIELER” aus."
      ]
    },
