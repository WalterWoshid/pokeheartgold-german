{
  "key": 22265,
  "messages": [
    {
      "id": "msg_0330_00000",
      "de_DE": [
        "Willkommen! Dies ist die Globale\n",
        "Tauschstation - kurz gesagt: die GTS!\r",
        "Wir ermöglichen den weltweiten Pokémon-\n",
        "Tausch über die Nintendo WFC.\r",
        "Möchtest du an einem globalen\n",
        "Pokémon-Tausch teilnehmen?"
      ]
    },
    {
      "id": "msg_0330_00001",
      "de_DE": [
        "Hallo!\n",
        "Willkommen bei der GTS!\r",
        "Möchtest du über die Nintendo WFC\n",
        "global ein Pokémon tauschen?"
      ]
    },
    {
      "id": "msg_0330_00002",
      "de_DE": [
        "Es gibt zwei Arten, wie der Pokémon-\n",
        "Tausch hier bei der GTS funktioniert.\r",
        "Du kannst ein Pokémon zum Tausch\n",
        "anbieten oder nach einem suchen.\r",
        "Soll ich dir detailliertere Informationen\n",
        "dazu geben?"
      ]
    },
    {
      "id": "msg_0330_00003",
      "de_DE": [
        "Du musst das Pokémon, das du tauschen\n",
        "möchtest, auswählen.\r",
        "Dann wirst du gefragt, welches Pokémon\n",
        "du im Austausch dafür haben möchtest.\r",
        "Findet sich ein anderer Spieler, der dir\n",
        "dieses Pokémon im Tausch anbieten\f",
        "kann, wird der Tausch durchgeführt.\r",
        "Möchtest du noch etwas wissen?"
      ]
    },
    {
      "id": "msg_0330_00004",
      "de_DE": [
        "Du kannst dir die Pokémon, die von\n",
        "anderen Trainern angeboten werden,\f",
        "ansehen.\r",
        "Du siehst dabei auch, nach welchen\n",
        "Pokémon diese Trainer suchen.\r",
        "Wenn du ein Pokémon entdeckst, das\n",
        "du haben möchtest, musst du im Tausch\r",
        "dafür das Pokémon anbieten, das der\n",
        "entsprechende Trainer sucht.\r",
        "Möchtest du noch etwas wissen?"
      ]
    },
    {
      "id": "msg_0330_00005",
      "de_DE": [
        "Möchtest du am weltweiten\n",
        "Pokémon-Tausch teilnehmen?"
      ]
    },
    {
      "id": "msg_0330_00006",
      "de_DE": "Bitte komm bald wieder."
    },
    {
      "id": "msg_0330_00007",
      "de_DE": [
        "Ich hoffe, der Aufenthalt\n",
        "bei der GTS gefällt dir!"
      ]
    },
    {
      "id": "msg_0330_00008",
      "de_DE": [
        "Ist das nicht ein großer Globus?!?\r",
        "Ob ich wohl meinen Heimatort finde?\n",
        "Mal sehen..."
      ]
    },
    {
      "id": "msg_0330_00009",
      "de_DE": [
        "Wenn man mit jemandem Kontakt\n",
        "aufgenommen hat, wird sein Ort\f",
        "auf dem großen Globus eingezeichnet."
      ]
    },
    {
      "id": "msg_0330_00010",
      "de_DE": [
        "Alles, was ich tun muss, ist, ein Pokémon\n",
        "hierzulassen, das ich tauschen möchte.\r",
        "Wer weiß, vielleicht wird es ja schon\n",
        "heute gegen ein anderes ausgetauscht,\f",
        "während ich im Bett liege und träume."
      ]
    },
    {
      "id": "msg_0330_00011",
      "de_DE": [
        "Es ist ganz einfach, Pokémon mit\n",
        "Pokémon-Fans auf der ganzen Welt\f",
        "zu tauschen.\r",
        "Ist das nicht super?!?"
      ]
    },
    {
      "id": "msg_0330_00012",
      "de_DE": [
        "Auf dem großen Globus kannst\n",
        "du eintragen, wo du lebst.\r",
        "Danach wird der Ort jedem\n",
        "angezeigt, der mit dir kommuniziert."
      ]
    },
    {
      "id": "msg_0330_00013",
      "de_DE": [
        "Ist die Nintendo WFC wirklich so einfach\n",
        "zu verwenden, dass sogar ich das kann?\r",
        "Wenn das wirklich so einfach ist, würde\n",
        "ich supergerne ein Pokémon tauschen!"
      ]
    }
  ]
}
