{
  "key": 18211,
  "messages": [
    {
      "id": "msg_0513_00000",
      "de_DE": [
        "Ah, du besitzt einen Pokétch!\n",
        "Auf den wirst du bestimmt nicht\f",
        "mehr verzichten wollen!\r",
        "Wissenschaft ist in der Welt der\n",
        "Pokémon immer wichtiger geworden.\r"
      ]
    },
    {
      "id": "msg_0513_00001",
      "de_DE": [
        "Mein Name ist Zyrus.\r",
        "Ich bin einer jener Menschen, die\n",
        "Sinnohs bester Trainer werden wollen.\r",
        "Bist du auch ein Trainer, dann gib\n",
        "dein Bestes, um stark zu werden.\r",
        "Werde das, was du werden kannst!"
      ]
    },
    {
      "id": "msg_0513_00002",
      "garbage": 0
    },
    {
      "id": "msg_0513_00003",
      "garbage": 0
    },
    {
      "id": "msg_0513_00004",
      "garbage": 0
    },
    {
      "id": "msg_0513_00005",
      "de_DE": [
        "Rüpel 1: Sind wir vom Team Galaktik\n",
        "oder sind wir das nicht?!?\r",
        "Und doch müssen wir hier zwischen\n",
        "den Blumen herumstehen...\r",
        "Das ist kein bisschen cool.\r"
      ]
    },
    {
      "id": "msg_0513_00006",
      "de_DE": [
        "Rüpel 2: Hey! Hör auf zu motzen!\n",
        "Das ist eine ehrbare Aufgabe!\r",
        "Aber Käfer- und Pflanzen-Pokémon\n",
        "finde ich einfach nur gruselig...\r",
        "Und deshalb wäre ich auch lieber\n",
        "woanders."
      ]
    },
    {
      "id": "msg_0513_00007",
      "de_DE": [
        "Ich wollte in den Auen von Flori ein paar\n",
        "Blumen pflücken...\r",
        "Aber dann kamen ein paar Typen vom\n",
        "Team Galaktik in schicken Uniformen...\r"
      ]
    },
    {
      "id": "msg_0513_00008",
      "de_DE": [
        "Diese Typen vom Team Galaktik\n",
        "sind zu den Auen hinter diesem\f",
        "Blumenfeld hier gegangen..."
      ]
    },
    {
      "id": "msg_0513_00009",
      "de_DE": [
        "Ich werde immer ganz glücklich, wenn\n",
        "ich von Blumen umgeben bin."
      ]
    },
    {
      "id": "msg_0513_00010",
      "de_DE": [
        "Ich liebe es einfach, hier zu sein...\n",
        "Die Atmosphäre ist so wunderbar.\r",
        "Du bist auch hier, um deine Stimmung\n",
        "zu verbessern, nicht wahr?"
      ]
    },
    {
      "id": "msg_0513_00011",
      "de_DE": [
        "Willkommen in Flori, dem Ort der\n",
        "Blumen, Blumen und Blumen!\r",
        "Du solltest auch ein paar Blumenzwiebeln\n",
        "pflanzen! Es leben die Blumen!"
      ]
    },
    {
      "id": "msg_0513_00012",
      "de_DE": [
        "Beeren, die du pflückst, kannst\n",
        "du an Pokémon verfüttern.\r",
        "Du kannst sie außerdem beim\n",
        "Blumenhändler gegen\f",
        "Accessoires eintauschen."
      ]
    },
    {
      "id": "msg_0513_00013",
      "de_DE": [
        "Der süße Duft des Honigs hat mich\n",
        "hier hergebracht.\r",
        "Aber ich frage dich und mich... Bin ich\n",
        "ein Pokémon, oder was?!? Mmmh, Hooonig!"
      ]
    },
    {
      "id": "msg_0513_00014",
      "de_DE": [
        "Flori\n",
        "Lebendig & Duftend"
      ]
    },
    {
      "id": "msg_0513_00015",
      "de_DE": [
        "Blühende Pracht - Der Blumenladen\n",
        "Hier gibt es Beeren gratis"
      ]
    },
    {
      "id": "msg_0513_00016",
      "de_DE": [
        "Geradeaus: Auen von Flori\n",
        "Honig wieder vorrätig"
      ]
    }
  ]
}
