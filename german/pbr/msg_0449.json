{
  "key": 57034,
  "messages": [
    {
      "id": "msg_0449_00000",
      "de_DE": [
        "Wir sind reisende Straßenkünstler.\r",
        "Und da wir uns jetzt kennengelernt\n",
        "haben, schenken wir dir dies hier.\r"
      ]
    },
    {
      "id": "msg_0449_00001",
      "de_DE": [
        "Bizarroraum ist eine verrückte Attacke,\n",
        "die die Zeit verzerrt.\r",
        "Setzt du sie ein, wird für eine Weile\n",
        "das langsamste Pokémon zuerst\f",
        "angreifen.\r",
        "Bevor das schnellste angreifen kann,\n",
        "greift das langsamste Pokémon an!\r",
        "Wie du die Attacke einsetzt, bleibt\n",
        "natürlich dir als Trainer überlassen..."
      ]
    },
    {
      "id": "msg_0449_00002",
      "de_DE": [
        "Sieh mir in die Augen...\n",
        "Ich werde deine Zukunft darin lesen...\r",
        "...\r"
      ]
    },
    {
      "id": "msg_0449_00003",
      "de_DE": [
        "Eine magische Begegnung steht an...\r",
        "Aber ich kann nicht erkennen, ob\n",
        "sich das auf ein Pokémon oder\f",
        "einen Trainer bezieht..."
      ]
    },
    {
      "id": "msg_0449_00004",
      "de_DE": [
        "Ein kurzer Moment der Freude...\r",
        "Aber vergiss nicht: Freud und Leid\n",
        "liegen dicht beieinander..."
      ]
    },
    {
      "id": "msg_0449_00005",
      "de_DE": [
        "Im Verborgenen lauert ein Unglück...\r",
        "Es hängt von dir ab, ob du daran wächst\n",
        "oder dich davon unterkriegen lässt..."
      ]
    },
    {
      "id": "msg_0449_00006",
      "de_DE": [
        "Das Schicksal wird sich ändern...\r",
        "Aber ob zum Guten oder zum Schlechten\n",
        "liegt außerhalb meiner Kenntnis..."
      ]
    },
    {
      "id": "msg_0449_00007",
      "de_DE": [
        "In den Jahren habe ich in viele Augen\n",
        "geschaut, in menschliche und in die\f",
        "von Pokémon.\r",
        "In deinen Augen lese ich Leidenschaft,\n",
        "Stärke, Freude, Trauer und mehr...\r",
        "Es ist schwer, darin zu lesen, da\n",
        "die Farbe deiner Augen sich ändert..."
      ]
    },
    {
      "id": "msg_0449_00008",
      "de_DE": [
        "Ich, ich bin eine ganz einfache Seele.\n",
        "Meine Gitarre spricht für mich.\r",
        "Alles, was ich brauche, sind meine\n",
        "Musik und meine Pokémon.\r",
        "Ich fühle mich überall wohl, wenn\n",
        "ich sie nur bei mir habe."
      ]
    }
  ]
}
