{
  "key": 18239,
  "messages": [
    {
      "id": "msg_0519_00000",
      "de_DE": [
        "In dieser frischen Luft zu atmen...\r",
        "Sogar Pokémon atmen hier tief durch!\n",
        "Deswegen bin ich gerne hier."
      ]
    },
    {
      "id": "msg_0519_00001",
      "de_DE": [
        "Hallo, reisender Trainer.\r",
        "In dieser Stadt gibt es keine Arena.\n",
        "Versuch es in Schleiede oder Weideburg."
      ]
    },
    {
      "id": "msg_0519_00002",
      "de_DE": [
        "Hallo, reisender Trainer.\n",
        "Gehe es ruhig und entspannt an."
      ]
    },
    {
      "id": "msg_0519_00003",
      "de_DE": [
        "Ich bin so klein, deswegen weiß ich\n",
        "nicht, wie man kämpft.\r",
        "Die nette Pensionsleiterin zieht meine\n",
        "Pokémon für mich auf."
      ]
    },
    {
      "id": "msg_0519_00004",
      "de_DE": [
        "Jeden Sonntag besuche ich den Turm der\n",
        "Ruhenden..."
      ]
    },
    {
      "id": "msg_0519_00005",
      "de_DE": [
        "Früher war hier nur eine Straße.\n",
        "Sonst nichts.\r",
        "Dann kamen Pokémon und Menschen hier\n",
        "zusammen, und dieser Ort entstand."
      ]
    },
    {
      "id": "msg_0519_00006",
      "de_DE": [
        "Ein reisender Trainer, hm?\r",
        "Sag, wie viele verschiedene Pokémon\n",
        "hast du denn schon gesehen?\r",
        "Wenn du ein kompetenter Trainer bist,\n",
        "sollten es mindestens fünfzig sein.\r",
        "Falls nicht, dann mach dich auf die\n",
        "Socken und such weiter."
      ]
    },
    {
      "id": "msg_0519_00007",
      "de_DE": [
        "Deine Begegnungen mit Pokémon sind\n",
        "praktisch deine Geschichte.\r",
        "Es gibt ein Zubehör für den Pokétch\n",
        "namens Pokémon-Historie.\r",
        "Damit kannst du die Historie aller deiner\n",
        "Pokémon-Begegnungen einsehen.\r"
      ]
    },
    {
      "id": "msg_0519_00008",
      "de_DE": [
        "Du hast deine Geschichte und die\n",
        "Pokémon haben ihre Geschichte.\r",
        "Wenn zwei Welten kollidieren, erwächst\n",
        "daraus ein neues Drama."
      ]
    },
    {
      "id": "msg_0519_00009",
      "de_DE": [
        "Trostu\n",
        "Ohne Sorgen!"
      ]
    },
    {
      "id": "msg_0519_00010",
      "de_DE": [
        "Pokémon-Pension\n",
        "Lass uns deine Pokémon aufziehen"
      ]
    },
    {
      "id": "msg_0519_00011",
      "de_DE": [
        "Pokémon-Zeitung\n",
        "Gesucht: Profi-Pokémonfänger"
      ]
    }
  ]
}
