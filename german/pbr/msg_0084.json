{
  "key": 5123,
  "messages": [
    {
      "id": "msg_0084_00000",
      "de_DE": [
        "Danke, dass du mich gerettet hast!\n",
        "Lass mich dir etwas schenken!\r",
        "Das allerneueste Fahrradmodell!\n",
        "Bitte nimm es! Ich bestehe darauf!\r"
      ]
    },
    {
      "id": "msg_0084_00001",
      "de_DE": [
        "Es ist das neueste Modell. Ich lese dir\n",
        "die Gebrauchsanweisung vor.\r",
        "“Drücke den B-Knopf, um die Gänge\n",
        "zu wechseln.”\r",
        "Im ersten Gang bist du nicht schnell,\n",
        "aber du hast alles unter Kontrolle.\r",
        "Im zweiten Gang ist die Steuerung\n",
        "schwieriger, aber du bist sehr schnell."
      ]
    },
    {
      "id": "msg_0084_00002",
      "de_DE": "PIEPI: Piep piep!"
    },
    {
      "id": "msg_0084_00003",
      "de_DE": [
        "Der Manager ist zum Gebäude des\n",
        "Teams Galaktik gegangen.\r",
        "Aber er ist noch nicht zurück.\n",
        "Was hält ihn nur so lange auf...?"
      ]
    },
    {
      "id": "msg_0084_00004",
      "de_DE": [
        "Was hat Team Galaktik eigentlich\n",
        "mit den Pokémon anderer Leute vor?"
      ]
    },
    {
      "id": "msg_0084_00005",
      "de_DE": [
        "Da ist eine Gebrauchsanweisung des\n",
        "neuesten Fahrradmodells angebracht.\r",
        "Erster Gang: Steuern.\n",
        "Zweiter Gang: Geschwindigkeit!\r",
        "B-Knopf: Gangwechsel.\n",
        "Viel Spaß beim Fahrradfahren!"
      ]
    },
    {
      "id": "msg_0084_00006",
      "de_DE": [
        "Ein Fahrradkatalog...\r",
        "Eilrad: Das Klapprad für die\n",
        "wahnsinnige Geschwindigkeit!\r",
        "Kunstrad: Ein Klapprad für die\n",
        "verrücktesten Tricks."
      ]
    }
  ]
}
