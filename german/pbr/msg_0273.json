  "messages": [
    {
      "id": "msg_0273_00000",
      "de_DE": [
        "Was machst du hier?\r",
        "Bist du eine von diesen Nulpen, die\n",
        "dumm genug waren, sich für die Wache\f",
        "am Eingang einteilen zu lassen?\r",
        "Bah, ist ja auch egal, wer du bist.\n",
        "Das macht eh keinen Unterschied mehr.\r",
        "Denn jetzt brechen wirklich\n",
        "interessante Zeiten an.\r",
        "Alle Legendären Pokémon werden\n",
        "in unser Hauptquartier in Schleiede\f",
        "gebracht!!!"
      ]
    },
    {
      "id": "msg_0273_00001",
      "de_DE": [
        "Selbst Team Galaktik hat keinerlei\n",
        "Verwendung für KARPADOR!"
      ]
    },
    {
      "id": "msg_0273_00002",
      "de_DE": [
        "Hahaha!\n",
        "Nächster Halt: See der Wahrheit!\r",
        "Der nächste Ort, der einer Zivilisation\n",
        "am nächsten kommt, ist das Kaff\f",
        "Zweiblattdorf.\r",
        "Keiner wird sich uns also\n",
        "entgegenstellen!"
      ]
    },
    {
      "id": "msg_0273_00003",
      "de_DE": "Ein KARPADOR zappelt hilflos am Boden..."
    }
  ]
}
