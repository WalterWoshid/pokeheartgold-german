      "de_DE": [
        "Du benötigst ein Fahrrad, wenn du\n",
        "auf den Radweg möchtest!"
      ]
    },
    {
      "id": "msg_0424_00001",
      "de_DE": [
        "Du benötigst ein Fahrrad, wenn du\n",
        "auf den Radweg möchtest!\r"
      ]
    },
    {
      "id": "msg_0424_00002",
      "de_DE": [
        "Wenn du weißt, wie man die Gänge\n",
        "wechselt, kommst du überallhin."
      ]
    },
    {
      "id": "msg_0424_00003",
      "de_DE": [
        "Was wäre ein Fahrrad ohne Schmuck?\r",
        "Du brauchst eine Fahne!\n",
        "Das ist ein Pokémon-Accessoire!\r"
      ]
    },
    {
      "id": "msg_0424_00004",
      "de_DE": [
        "Gehe von hier über den Kraterberg,\n",
        "dann erreichst du Herzhofen.\r",
        "Dort finden die ganzen Pokémon\n",
        "Wettbewerbe statt.\r",
        "Für solche Wettbewerbe solltest du\n",
        "deine Pokémon mit Accessoires\f",
        "schmücken."
      ]
    }
  ]
}
