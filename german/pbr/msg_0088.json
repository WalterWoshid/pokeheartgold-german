{
  "key": 5135,
  "messages": [
    {
      "id": "msg_0088_00000",
      "de_DE": [
        "Hm? Wolltest du etwas?\r",
        "Ach, wieso frage ich so dumm?\n",
        "Du willst die Pokémon befreien.\f",
        "Ja klar. Als ob ich das erlauben würde!\r"
      ]
    },
    {
      "id": "msg_0088_00001",
      "de_DE": [
        "Hui, du bist ganz schön zäh...\r",
        "Macht aber nichts. Unsere Untersuchung\n",
        "der Pokémon-Statue ist beendet.\r",
        "Mars hat die Energie des Windkraftwerks\n",
        "gespeichert.\r",
        "Wir sind hier fertig.\n",
        "Aber eine Sache verrate ich dir.\r",
        "Unser Boss erforscht die alte Pokémon-\n",
        "Mythologie.\r",
        "Mit der Macht der mythischen Pokémon\n",
        "wird er ganz Sinnoh beherrschen...\r",
        "Also komm Team Galaktik nie wieder\n",
        "in die Quere, klar?\r",
        "Das ist meine letzte Warnung!\r"
      ]
    },
    {
      "id": "msg_0088_00002",
      "de_DE": "PIEPI: Pi..."
    },
    {
      "id": "msg_0088_00003",
      "de_DE": [
        "Was hat Team Galaktik nur vor?\r",
        "Warum stehlen sie unsere Pokémon?\n",
        "Was wollen sie damit erreichen?"
      ]
    },
    {
      "id": "msg_0088_00004",
      "de_DE": [
        "Ich habe mein PIEPI zurück. Und das\n",
        "ist allein dein Verdienst!\r",
        "Aber dieses Team Galaktik...\r",
        "Sie haben gesagt: “PIEPI kommt aus dem\n",
        "Weltraum. Her damit!”\r",
        "Was für eine krude Logik.\n",
        "Als kämen sie selbst aus dem Weltraum!\r",
        "Jedenfalls sind sie jetzt weg.\n",
        "Vielen Dank!\r",
        "Schau doch in meinem Fahrradgeschäft\n",
        "vorbei, wenn du in der Nähe bist, ja?\r"
      ]
    },
    {
      "id": "msg_0088_00005",
      "de_DE": "HASPIROR: Knabb..."
    }
  ]
}
