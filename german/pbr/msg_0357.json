{
  "key": 37905,
  "messages": [
    {
      "id": "msg_0357_00000",
      "de_DE": [
        "Ciao!\n",
        "Ich bin der Game Director!\r",
        "Du arbeitest daran, deinen Pokédex zu\n",
        "vervollständigen, habe ich Recht?\r",
        "Es ist schon klasse, dass du viele\n",
        "Pokémon treffen wirst.\r",
        "Komm doch bitte wieder, wenn dein\n",
        "Pokédex Tonnen von Einträgen hat!"
      ]
    },
    {
      "id": "msg_0357_00001",
      "de_DE": [
        "Ciao!\n",
        "Ich bin der Game Director!\r",
        "Du arbeitest daran, deinen Pokédex zu\n",
        "vervollständigen, habe ich Recht?\r",
        "Du hast aber schon viele Pokémon\n",
        "dieser Region getroffen.\r",
        "Ich bin beeindruckt.\n",
        "Hier, ich habe eine Belohnung für dich!"
      ]
    },
    {
      "id": "msg_0357_00002",
      "de_DE": [
        "Ciao!\n",
        "Ich bin der Game Director!\r",
        "Du hast alle Pokémon auf der\n",
        "Welt gesammelt!\r",
        "Dein Pokédex ist vollständig!\n",
        "Was für eine herausragende Leistung!\r",
        "Die Herausforderungen, denen du dich\n",
        "gestellt hast, um dies zu schaffen!\r",
        "Fantastisch! Cool!\n",
        "Vielen, vielen Dank!\r",
        "Bitte nimm diese Belohnung\n",
        "von Game Freak an!"
      ]
    },
    {
      "id": "msg_0357_00003",
      "de_DE": [
        "Wie und wo hast du all die Pokémon,\n",
        "die in deinem Pokédex verzeichnet\f",
        "sind, getroffen?\r",
        "Hast du lange gebraucht, sie zu\n",
        "fangen und aufzuziehen?\r",
        "Hast du sie als Geschenk von\n",
        "einem Freund bekommen?\r",
        "Vielleicht hast du das ein oder\n",
        "andere ja mit Leuten aus der\f",
        "ganzen Welt getauscht?\r",
        "Auch wenn alle Pokédexe der\n",
        "Welt gleich aussehen, so ist\f",
        "doch jeder einzigartig."
      ]
    }
  ]
}
