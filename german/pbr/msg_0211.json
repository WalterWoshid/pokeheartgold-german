{
  "key": 5122,
  "messages": [
    {
      "id": "msg_0211_00000",
      "de_DE": [
        "Wie bitte?!? Nee, oder?!?\n",
        "Du hast den Schlüssel?\r",
        "Da hätte man die Tür ja gar nicht\n",
        "abschließen müssen.\f",
        "Jetzt bin ich der große Verlierer!\r",
        "Aber ich habe keine Zeit für\n",
        "Selbstmitleid! Ich werde dem\f",
        "Commander Bescheid geben!\r"
      ]
    },
    {
      "id": "msg_0211_00001",
      "de_DE": [
        "Mein Pokémon kann nicht mehr kämpfen.\r",
        "Und dafür werden sie mir mit Sicherheit\n",
        "all meine Pokémon wegnehmen...\r",
        "Hmpf! Aber warte nur ab!!!\n",
        "Unser Commander wird dich in\r",
        "den Boden stampfen!"
      ]
    },
    {
      "id": "msg_0211_00002",
      "de_DE": [
        "Ich bin einer der drei\n",
        "Commander vom Team Galaktik.\r",
        "Wir werden eine neue Welt schaffen.\n",
        "Eine Welt, die besser ist als diese!\r",
        "Aber niemand versteht unsere Pläne\n",
        "und findet sie gut.\r",
        "Du verstehst uns auch nicht... oder?\n",
        "Das macht mich traurig...\r",
        "Kämpfen wir, um zu sehen, welche\n",
        "Schritte wir als Nächstes gehen werden.\r",
        "Wenn ich gewinne, verschwindest du hier.\n",
        "Gewinnst du, werden wir, Team\f",
        "Galaktik, hier verschwinden!\r"
      ]
    },
    {
      "id": "msg_0211_00003",
      "de_DE": [
        "Hups! Da habe ich aber\n",
        "ordentlich Mist gebaut!\r",
        "Aber das macht rein gar nichts.\n",
        "Ich habe den Kampf genossen.\r",
        "Und nun verabschiede ich mich und\n",
        "verschwinde von hier. Für’s Erste!\r"
      ]
    },
    {
      "id": "msg_0211_00004",
      "de_DE": [
        "Team Galaktik...\r",
        "Sie sagen, sie müssten einfach Pokémon\n",
        "und Energie sammeln. Egal wie!\r",
        "Sie wollen damit ein neues Universum\n",
        "schaffen. Das sagen sie wenigstens.\r",
        "Aber alles was sie sagen, ergibt für\n",
        "mich überhaupt keinen Sinn...\r",
        "Ich kann dir gar nicht sagen, wie\n",
        "dankbar ich dir für deine Hilfe bin!\r",
        "Nun kann ich endlich wieder zu\n",
        "meiner kleinen Tochter!\r"
      ]
    },
    {
      "id": "msg_0211_00005",
      "de_DE": [
        "Kleines Mädchen: Papaaa!\r",
        "Iiih! Papa! Du riiiechst!\n",
        "Papa, geh duschen! Igitt!\r"
      ]
    },
    {
      "id": "msg_0211_00006",
      "de_DE": [
        "Papa: Oh, tut mit leid! Ahahaha!\n",
        "Ich musste ohne Unterbrechung\f",
        "für sie arbeiten!\r"
      ]
    },
    {
      "id": "msg_0211_00007",
      "de_DE": [
        "Kleines Mädchen: Danke, Trainer!\r",
        "Du hast die ganzen bösen Leute\n",
        "weggejagt!\r",
        "Nun kommt das Ballonpokémon\n",
        "bestimmt wieder!"
      ]
    },
    {
      "id": "msg_0211_00008",
      "de_DE": [
        "Papa: Oh, ja! Bei den Windkraftanlagen\n",
        "hat man ein ballonförmiges Pokémon\f",
        "gesehen.\r",
        "Und zwar immer an einem bestimmten Tag.\n",
        "Aber welcher war das nochmal?!?\r",
        "Ob sein Erscheinen in Zusammenhang\n",
        "mit der Windkraftanlage steht, die\f",
        "Wind in Energie umwandelt?!?"
      ]
    },
    {
      "id": "msg_0211_00009",
      "de_DE": [
        "Der Wind, der von den Bergen in das Tal\n",
        "weht, wird von den Turbinen des\f",
        "Windkraftwerks in Energie umgewandelt.\r",
        "So wandeln wir die Kraft der Natur in\n",
        "Energie um. Eine wunderbare Sache!"
      ]
    },
    {
      "id": "msg_0211_00010",
      "de_DE": [
        "Das ballonförmige Pokémon wurde immer\n",
        "wieder vom Wind davongetragen!"
      ]
    }
  ]
}
