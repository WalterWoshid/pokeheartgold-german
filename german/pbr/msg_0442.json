{
  "key": 37243,
  "messages": [
    {
      "id": "msg_0442_00000",
      "de_DE": [
        "Ich habe Leute gesehen, die sind mit dem\n",
        "Rad gefahren und haben Baumstämme\f",
        "überquert, als wären diese Brücken."
      ]
    },
    {
      "id": "msg_0442_00001",
      "de_DE": [
        "...Ob ich im Moor feststecke?\n",
        "Natürlich nicht! Du bist lustig!\r",
        "Ich nehme ein Moorbad.\n",
        "Sonst würde ich doch auch\f",
        "versuchen, herauszukommen!\n"
      ]
    },
    {
      "id": "msg_0442_00002",
      "de_DE": [
        "Ich habe im Großmoor von Weideburg\n",
        "ein seltenes Pokémon gefangen.\r",
        "Du musst da unbedingt auch mal\n",
        "hingehen! Das kann ich dir ohne\f",
        "Zögern empfehlen."
      ]
    },
    {
      "id": "msg_0442_00003",
      "de_DE": [
        "Wir sind ständig auf Streife.\n",
        "Es ist sicher hier, selbst nachts."
      ]
    },
    {
      "id": "msg_0442_00004",
      "de_DE": [
        "Route 212\n",
        "Weideburg"
      ]
    },
    {
      "id": "msg_0442_00005",
      "de_DE": [
        "Scherben gesucht\n",
        "Technische Maschinen als Belohnung."
      ]
    },
    {
      "id": "msg_0442_00006",
      "de_DE": [
        "Tipps für Trainer\r",
        "Steckst du im Moor fest, kannst du\n",
        "damit rechnen, dass es eine Weile\r",
        "dauert, bis du wieder freikommst.\n",
        "Aber das ist kein Grund zur Panik.\r",
        "Beweg dich einfach ein bisschen.\n",
        "Mit dem Rad kannst du nicht auf\f",
        "Moorboden fahren!"
      ]
    }
  ]
}
