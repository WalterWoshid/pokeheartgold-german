{
  "key": 9239,
  "messages": [
    {
      "id": "msg_0141_00000",
      "de_DE": [
        "Hallo.\n",
        "Kann ich dir helfen?"
      ]
    },
    {
      "id": "msg_0141_00001",
      "de_DE": [
        "Hallo, {STRVAR_1 3, 0}.\n",
        "Kann ich dir helfen?"
      ]
    },
    {
      "id": "msg_0141_00002",
      "de_DE": "Viel Vergnügen!"
    },
    {
      "id": "msg_0141_00003",
      "de_DE": [
        "Möchtest du Protein?\n",
        "Das erhöht den Angriffs-Wert."
      ]
    },
    {
      "id": "msg_0141_00004",
      "de_DE": [
        "Darf ich Carbon empfehlen? Es\n",
        "erhöht die Initiative."
      ]
    },
    {
      "id": "msg_0141_00005",
      "de_DE": [
        "Wenn deine Attacken richtig sitzen\n",
        "müssen - dann brauchst du Angriffsplus."
      ]
    },
    {
      "id": "msg_0141_00006",
      "de_DE": [
        "Wenn dein Pokémon nicht gut zielen kann,\n",
        "verabreiche ihm X-Treffer."
      ]
    },
    {
      "id": "msg_0141_00007",
      "de_DE": [
        "Wo finde ich nur passende Kleider für\n",
        "mein Pokémon und mich?"
      ]
    },
    {
      "id": "msg_0141_00008",
      "de_DE": [
        "Ich gebe meinem ZIRPURZE KP-Plus.\n",
        "Das erhöht die KP. Oder etwa nicht?"
      ]
    },
    {
      "id": "msg_0141_00009",
      "de_DE": [
        "Wir verschenken Zubehör für den\n",
        "Pokétch als Werbeaktion.\r",
        "Möchtest du den Zähler für dein\n",
        "Pokétch haben?"
      ]
    },
    {
      "id": "msg_0141_00010",
      "de_DE": "So, hier bitte. Nun gehe hin und zähle!\r"
    },
    {
      "id": "msg_0141_00011",
      "de_DE": "Ich hoffe, der Zähler ist dir hilfreich."
    },
    {
      "id": "msg_0141_00012",
      "de_DE": [
        "Du hast kein Interesse? Komm\n",
        "wieder, wenn du deine Meinung\f",
        "geändert hast!"
      ]
    },
    {
      "id": "msg_0141_00013",
      "de_DE": [
        "EG: Alles für den Trainer\r",
        "1S: Alles für den Kampf\r",
        "2S: TM\r",
        "3S: Poképuppen und Deko\r",
        "4S: Dachterrasse"
      ]
    }
  ]
}
