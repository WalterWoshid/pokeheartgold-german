{
  "key": 18319,
  "messages": [
    {
      "id": "msg_0123_00000",
      "de_DE": [
        "Grr... Ich warte schon ewig\n",
        "auf das Paket aus Schleiede...\r",
        "Muss ich jetzt hier darauf warten?\n",
        "Ich werde noch ganz verrückt davon...\r",
        "Oh, ich würde gerne etwas unternehmen,\n",
        "etwas, das ganz viel Krach macht!\r",
        "Ja, ein krachender, knallender Job\n",
        "für Team Galaktik..."
      ]
    },
    {
      "id": "msg_0123_00001",
      "de_DE": [
        "Grr...\n",
        "Mann, ist das nervtötend...\r",
        "Was ist mit dir? Ein kleines Kind\n",
        "mit gerade mal drei Orden. Pfft.\r",
        "So kleine Frettchen wie du sollten\n",
        "wissen, dass sie sich besser vom\f",
        "Team Galaktik fernhalten!\r",
        "Aber ich habe Wichtigeres zu tun.\n",
        "Wo lasse ich dieses Paket jetzt \f",
        "am besten platzen?!?\r",
        "Ha, ein Bombenjob für Team Galaktik..."
      ]
    },
    {
      "id": "msg_0123_00002",
      "de_DE": [
        "Hahahaaaa! Endlich ist das Paket\n",
        "aus Schleiede angekommen!\r",
        "Und nun muss ich das zum\n",
        "See bringen.\r",
        "Das ist eine wichtige Mission.\n",
        "Versagen ist nicht erlaubt!\r",
        "Und keine Umwege, zum\n",
        "Beispiel durch das Großmoor!\r"
      ]
    },
    {
      "id": "msg_0123_00003",
      "de_DE": [
        "Du hast gelauscht! Ich habe übrigens\n",
        "nur mit mir selbst gesprochen!\r",
        "Und wenn ich nicht so in Eile wäre,\n",
        "würde mein Pokémon dir deine\f",
        "Ohren lang ziehen!\r",
        "Aber ich habe es mehr als eilig!\n",
        "Daher hast du mehr Glück als Verstand!\r",
        "Aber, Freundchen, wag es nicht,\n",
        "mir zu folgen!!!\r"
      ]
    },
    {
      "id": "msg_0123_00004",
      "de_DE": [
        "Argh!\n",
        "Du bist lästig wie eine Fliege!\r",
        "Wenn unser Plan gelingt, stehen\n",
        "wir kurz davor, dass sich der\f",
        "Traum vom Boss erfüllt!\r",
        "Die ideale Welt, von der er\n",
        "träumt, wird dann Realität.\r",
        "Daher werde ich mit Sicherheit\n",
        "jetzt nicht meine kostbare Zeit\f",
        "mit dir verschwenden!\r",
        "Und daher sage ich dir: Bleib\n",
        "wo du bist und folge mir nicht!\r"
      ]
    },
    {
      "id": "msg_0123_00005",
      "de_DE": [
        "{STRVAR_1 3, 0}: Rumms!\r",
        "Hehehe! Ich werde nicht mehr\n",
        "zurückhaltend sein!\r",
        "Also, wie geht es dir, {STRVAR_1 3, 1}?\n",
        "Trainierst wohl deine Pokémon, eh?\r",
        "Dann werde ich dich und deine Pokémon\n",
        "mal testen. Wie stark seid ihr wirklich?\r"
      ]
    },
    {
      "id": "msg_0123_00006",
      "de_DE": [
        "{STRVAR_1 3, 0}: Heh, yeah, vielleicht bist\n",
        "du seit unserem letzten Kampf\f",
        "tatsächlich etwas stärker geworden.\r",
        "Damit hatte ich nicht gerechnet.\n",
        "Ja, genau deswegen habe ich\f",
        "verloren, ich war zu leichtsinnig.\r",
        "Sag mal, was ist eigentlich mit\n",
        "dem komischen Typen vom Team\f",
        "Galaktik los?\r",
        "Ich weiß ja nicht, was er vorhat,\n",
        "aber ich an deiner Stelle würde ihn\f",
        "weiter verfolgen und beobachten!\r",
        "Wenn man kein Pokémon ist, aber so\n",
        "schnell rennt und hastet, dann...\f",
        "Gehört man bestimmt nicht zu den Guten.\r",
        "Also gut, {STRVAR_1 3, 1}!\n",
        "Nächstes Mal bin ich bestimmt nicht\f",
        "mehr leichtsinnig!\r"
      ]
    },
    {
      "id": "msg_0123_00007",
      "garbage": 0
    },
    {
      "id": "msg_0123_00008",
      "de_DE": [
        "Ich stehe hier mittenmang exakt in\n",
        "der mittleren Mitte des Ortes."
      ]
    },
    {
      "id": "msg_0123_00009",
      "de_DE": [
        "Ich studiere die seltenen Pokémon,\n",
        "die man nur im Großmoor findet."
      ]
    },
    {
      "id": "msg_0123_00010",
      "de_DE": [
        "Manche Trainer verhindern bewusst,\n",
        "dass sich ein Pokémon entwickelt.\r",
        "Sie warten damit ab, bis das Pokémon\n",
        "einen bestimmten Level erreicht\f",
        "und bestimmte Attacken gelernt hat."
      ]
    },
    {
      "id": "msg_0123_00011",
      "de_DE": [
        "Ich besuche diese Gegend, weil\n",
        "ich das Großmoor sehen will.\r",
        "Ich wohne im Hotel am See."
      ]
    },
    {
      "id": "msg_0123_00012",
      "de_DE": [
        "Weideburgs Arenaleiter ist...\n",
        "Auf eine seltsame Art... atemberaubend.\r",
        "Es ist schwer zu erklären.\n",
        "Aber du wirst bald sehen, was ich meine."
      ]
    },
    {
      "id": "msg_0123_00013",
      "de_DE": [
        "War der Arenaleiter von Weideburg nicht\n",
        "auf eine seltsame Art atemberaubend?\r",
        "Aber beurteile ihn nicht nach seinem\n",
        "Aussehen oder seinem Benehmen.\r",
        "Ich habe gehört, dass er Preisgelder\n",
        "verwendet, um Menschen und\f",
        "Pokémon in Not zu helfen."
      ]
    },
    {
      "id": "msg_0123_00014",
      "de_DE": [
        "Das Großmoor sorgt auch an heißen\n",
        "Sommertagen für eine kühle Brise.\r",
        "Dies ist der richtige Ort für\n",
        "Wasser-Pokémon."
      ]
    },
    {
      "id": "msg_0123_00015",
      "de_DE": "PIEPI: Pie-pieh?"
    },
    {
      "id": "msg_0123_00016",
      "de_DE": [
        "Du erinnerst mich an diesen\n",
        "ungeduldigen Jungen, den ich\f",
        "vor kurzem getroffen habe.\r",
        "Er hatte, genau wie du, ein sehr\n",
        "enges Verhältnis zu seinen Pokémon.\r",
        "Hey, danke, dass du mich zum\n",
        "Lächeln gebracht hast!\r",
        "Und hiermit zaubere ich vielleicht\n",
        "ein Lächeln auf dein Gesicht!\r",
        "Mit dieser {STRVAR_1 31, 0} wird dein\n",
        "Pokémon bestimmt bezaubernd aussehen.\r"
      ]
    },
    {
      "id": "msg_0123_00017",
      "de_DE": [
        "Jemand hat mir eine Beere gegeben,\n",
        "also habe ich sie eingepflanzt, damit\f",
        "noch mehr Beeren wachsen.\r",
        "Dann habe ich die Beeren gepflückt\n",
        "und sie zu einem Knursp verarbeitet.\r",
        "Und als ich sah, wie glücklich mein\n",
        "Pokémon darüber war, wusste ich,\f",
        "dass sich die Mühe gelohnt hatte!"
      ]
    },
    {
      "id": "msg_0123_00018",
      "de_DE": [
        "Jemand im Großmoor hat mir eine\n",
        "Versteckte Maschine angeboten,\f",
        "aber ich habe sie abgelehnt.\r",
        "Ich brauche sie nicht, denn unser\n",
        "Arenaleiter wird den Ort vom Nebel\f",
        "befreien, falls dies mal nötig ist."
      ]
    },
    {
      "id": "msg_0123_00019",
      "de_DE": [
        "Warst du schon mal auf dem\n",
        "Pokémon-Landgut?\r",
        "Der Besitzer, Herr Reichedel, \n",
        "liebt es, von seinen seltenen\f",
        "Pokémon zu schwärmen."
      ]
    },
    {
      "id": "msg_0123_00020",
      "de_DE": [
        "Weideburg\n",
        "Stadt des Moores"
      ]
    },
    {
      "id": "msg_0123_00021",
      "de_DE": [
        "Pokémon Arena Weideburg\n",
        "Leiter: Wellenbrecher Marinus\f",
        "Meister der Fluten!"
      ]
    },
    {
      "id": "msg_0123_00022",
      "de_DE": [
        "Weideburg - Großmoor\n",
        "Pokémonwarte"
      ]
    },
    {
      "id": "msg_0123_00023",
      "de_DE": [
        "Versuch dich im Safari-Spiel\n",
        "im Großmoor von Weideburg!"
      ]
    }
  ]
}
