  "messages": [
    {
      "id": "msg_0421_00000",
      "de_DE": [
        "Du siehst müde aus. Ich denke,\n",
        "du solltest dich etwas ausruhen."
      ]
    },
    {
      "id": "msg_0421_00001",
      "de_DE": [
        "Du und deine Pokémon... Ihr\n",
        "seht wieder richtig erfrischt aus!"
      ]
    },
    {
      "id": "msg_0421_00002",
      "de_DE": [
        "Nur weil du jung bist, heißt das nicht,\n",
        "dass du dich überfordern sollst."
      ]
    },
    {
      "id": "msg_0421_00003",
      "de_DE": [
        "Glaubst du, du schaffst es ganz allein,\n",
        "durch den Ewigwald zu laufen?"
      ]
    }
  ]
}
