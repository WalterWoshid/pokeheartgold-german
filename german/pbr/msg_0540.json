{
  "key": 18227,
  "messages": [
    {
      "id": "msg_0540_00000",
      "de_DE": [
        "Ich bin weit gereist, um mein geliebtes\n",
        "Pokémon noch hübscher zu machen.\r",
        "Dann liebt es mich sogar noch mehr."
      ]
    },
    {
      "id": "msg_0540_00001",
      "de_DE": [
        "Für mein Pokémon nur das Beste.\n",
        "Und wenn ich ans Ende der Welt\f",
        "reisen muss. So bin ich nun mal."
      ]
    },
    {
      "id": "msg_0540_00002",
      "de_DE": [
        "Bin hier irgendwie gestrandet...\n",
        "Es soll hier keinen Laden geben!\r",
        "Und wie soll ich mich dann auf die\n",
        "gefährliche Reise vorbereiten?"
      ]
    },
    {
      "id": "msg_0540_00003",
      "de_DE": [
        "Du weißt bestimmt, wie man unter der\n",
        "Erde coole Sachen ausgraben kann?\r",
        "Manche sagen, sie graben ganz neue\n",
        "unterschiedliche Dinge aus."
      ]
    },
    {
      "id": "msg_0540_00004",
      "de_DE": [
        "Ich verbringe viel Zeit im Pool.\r",
        "Verschmelze ich mit dem Wasser\n",
        "wie ein AQUANA?"
      ]
    },
    {
      "id": "msg_0540_00005",
      "de_DE": [
        "Erholungsgebiet\n",
        "Spiel und Spaß!"
      ]
    },
    {
      "id": "msg_0540_00006",
      "de_DE": [
        "Das Bänder Syndikat\n",
        "Zutritt nur für Mitglieder"
      ]
    }
  ]
}
