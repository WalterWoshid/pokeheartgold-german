{
  "key": 1099,
  "messages": [
    {
      "id": "msg_0115_00000",
      "de_DE": [
        "Aha. Du bist ein Trainer?\r",
        "Da hast du bestimmt eine enge\n",
        "Bindung zu deinen Pokémon.\r",
        "Du weißt, dass man viel Neues entdeckt,\n",
        "wenn man mit Pokémon unterwegs ist?"
      ]
    },
    {
      "id": "msg_0115_00001",
      "de_DE": "Kuufu fuu!"
    },
    {
      "id": "msg_0115_00002",
      "de_DE": [
        "Babys und Pokémon kommen wunderbar\n",
        "miteinander aus.\r",
        "Wenn das Baby schläft, legt sich das\n",
        "Pokémon daneben und schläft auch."
      ]
    },
    {
      "id": "msg_0115_00003",
      "de_DE": [
        "Wenn ich groß bin, will ich auch ein\n",
        "Trainer werden."
      ]
    },
    {
      "id": "msg_0115_00004",
      "de_DE": [
        "Wenn ich groß bin, möchte ich Pokémon-\n",
        "Koordinator werden."
      ]
    },
    {
      "id": "msg_0115_00005",
      "de_DE": [
        "...Meine Schwestern bekommen alle\n",
        "Aufmerksamkeit. Für mich interessiert\f",
        "sich keiner."
      ]
    },
    {
      "id": "msg_0115_00006",
      "de_DE": [
        "Oh, wow, du bist ein Pokémon-Trainer.\r",
        "Pokémon um sich zu haben bedeutet, viel\n",
        "Verantwortung zu übernehmen.\r",
        "Aber man hat auch viel Spaß und Freude\n",
        "mit ihnen."
      ]
    },
    {
      "id": "msg_0115_00007",
      "garbage": 0
    },
    {
      "id": "msg_0115_00008",
      "de_DE": "PIKACHU: Pikapii?"
    }
  ]
}
