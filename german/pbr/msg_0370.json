    {
      "id": "msg_0370_00021",
      "de_DE": [
        "Unser Lieferant hat eine ganze Menge\n",
        "Geschenke für dich!\r",
        "Bitte suche ihn in einem PKMN-Markt\n",
        "auf und hole deine Geschenke ab."
      ]
    },
    {
      "id": "msg_0370_00022",
      "de_DE": [
        "Du hast dieses Geschenk bereits\n",
        "erhalten."
      ]
    },
    {
      "id": "msg_0370_00023",
      "de_DE": "Es wurden keine Geschenke gefunden."
    },
    {
      "id": "msg_0370_00024",
