    },
    {
      "id": "msg_0370_00025",
      "de_DE": [
        "Du hast keinen Platz mehr für\n",
        "weitere Wunderkarten.\r",
        "Du kannst kein weiteres Geschenk\n",
        "annehmen."
      ]
    },
    {
      "id": "msg_0370_00026",
      "de_DE": [
        "Beim Empfang des Geschenks trat ein\n",
        "Problem auf.\r",
        "Drücke den A-Knopf, um zum\n",
        "Titelbildschirm zurückzukehren."
      ]
    },
    {
      "id": "msg_0370_00027",
      "de_DE": [
