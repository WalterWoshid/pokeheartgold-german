{
  "key": 25623,
  "messages": [
    {
      "id": "msg_0068_00000",
      "de_DE": [
        "Jedes Pokémon besitzt eine spezielle\n",
        "Fähigkeit, die es einsetzen kann."
      ]
    },
    {
      "id": "msg_0068_00001",
      "de_DE": [
        "Inwieweit mein Pokémon und ich\n",
        "uns ähnlich sind?\r",
        "Nun, das kann ich gar nicht so\n",
        "einfach beantworten."
      ]
    },
    {
      "id": "msg_0068_00002",
      "de_DE": [
        "Von hier oben hat man eine\n",
        "hervorragende Aussicht.\r",
        "Aber nach draußen zu gehen?\n",
        "Man kommt so schnell ins Schwitzen...\r",
        "Kannst du mir vielleicht ein Pokémon\n",
        "namens ZUBAT zeigen?"
      ]
    },
    {
      "id": "msg_0068_00003",
      "de_DE": [
        "Von hier oben hat man eine\n",
        "hervorragende Aussicht.\r",
        "Nur den Weg nach unten zu finden,\n",
        "ohne sich zu verlaufen...\r",
        "Kannst du mir vielleicht ein Pokémon\n",
        "namens ZUBAT zeigen?\r",
        "Oh! Das Pokémon da!\n",
        "Das ist ein ZUBAT!\r",
        "Wow, ist das cool!\n",
        "Das ist so niedlich!\r",
        "Hah, ich weiß!\n",
        "Ich werde auch Pokémon fangen!\r",
        "Vielen Dank, mein Freund!\n",
        "Hier, das ist mein Dankeschön!\r"
      ]
    },
    {
      "id": "msg_0068_00004",
      "de_DE": [
        "Ja, ja, es gibt schon sehr viele Arten\n",
        "von Pokémon dort draußen in der Welt.\r",
        "Und ich will sie alle sehen!"
      ]
    }
  ]
}
