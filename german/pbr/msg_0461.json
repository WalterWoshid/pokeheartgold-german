  "messages": [
    {
      "id": "msg_0461_00000",
      "de_DE": [
        "Junge, Junge...\n",
        "Hab ich einen Duuuurst!!!"
      ]
    },
    {
      "id": "msg_0461_00001",
      "garbage": 0
    },
    {
      "id": "msg_0461_00002",
      "de_DE": [
        "{STRVAR_1 3, 0}! Wir haben uns ja lange\n",
        "nicht gesehen!\r",
        "Oh? Jetzt sag nicht, du weißt\n",
        "nicht mehr, wer ich bin!\r",
        "Ich bin Professor Eibes Assistent\n",
        "und der Vater von {STRVAR_1 3, 1}.\r",
        "Der Professor hat mich gebeten,\n",
        "deinen Pokédex zu aktualisieren.\r",
        "Und meine Intuition sagte mir, dass\n",
        "ich dich genau hier treffen würde.\r",
        "Gibst du mir bitte kurz deinen\n",
        "Pokédex, {STRVAR_1 3, 0}?\r"
      ]
    },
    {
      "id": "msg_0461_00003",
      "de_DE": [
        "{STRVAR_1 3, 0}! Wir haben uns ja lange\n",
        "nicht gesehen!\r",
        "Oh? Jetzt sag nicht, du weißt\n",
        "nicht mehr, wer ich bin!\r",
        "Ich bin Professor Eibes Assistent\n",
        "und der Vater von {STRVAR_1 3, 1}.\r",
        "Der Professor hat mich gebeten,\n",
        "deinen Pokédex zu aktualisieren.\r",
        "Und meine Intuition sagte mir, dass\n",
        "ich dich genau hier treffen würde.\r",
        "Gibst du mir bitte kurz deinen\n",
        "Pokédex, {STRVAR_1 3, 0}?\r"
      ]
    },
    {
      "id": "msg_0461_00004",
      "de_DE": [
        "Mal sehen... Ich sollte die neue\n",
        "Software folgendermaßen installieren...\r",
        "Klick...\n",
        "Klick!\r",
        "So, das war’s schon! Dein Pokédex\n",
        "ist auf dem neuesten Stand!\r",
        "Ich sollte dir jetzt wohl erklären,\n",
        "was ich gerade gemacht habe, oder?\r",
        "Du kannst dir nun Bilder von männlichen\n",
        "und weiblichen Pokémon ansehen.\r",
        "Ja. Genau. Und nun lass ich dich\n",
        "wieder in Ruhe, damit du dem\f",
        "Professor weiterhin helfen kannst.\r",
        "Kannst du bitte auch ein Auge\n",
        "auf Team Galaktik haben?\r",
        "Der Professor macht sich Gedanken -\n",
        "nach dem, was in Jubelstadt\f",
        "passiert ist.\r",
        "Vielleicht ist das ja ganz\n",
        "unnötig, aber...\r",
        "Nun muss ich aber los. Bis dann.\r"
      ]
    }
  ]
