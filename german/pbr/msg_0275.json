{
  "key": 13387,
  "messages": [
    {
      "id": "msg_0275_00000",
      "de_DE": [
        "Die Mission verläuft wie am Schnürchen.\n",
        "Da wird der Boss sehr froh sein.\r",
        "Alles für alle und das Beste für\n",
        "Team Galaktik!\r"
      ]
    },
    {
      "id": "msg_0275_00001",
      "de_DE": [
        "Ich kenne dich doch!\r",
        "Du bist doch das Kind, das in\n",
        "Ewigenau das Gebäude vom\f",
        "Team Galaktik überfallen hat!\r",
        "Pfft! Jupiter sollte sich schämen,\n",
        "dass sie sich von einem Kind\f",
        "in die Knie zwingen lässt!\r",
        "Jeder, der sich Team Galaktik\n",
        "in den Weg stellt, wird die\f",
        "Konsequenzen spüren.\r",
        "Jeder noch so kleine Pieps gegen\n",
        "uns wird von uns übertönt!!!\r"
      ]
    },
    {
      "id": "msg_0275_00002",
      "de_DE": [
        "Hmpf! Selbst ich, ein Commander, kann\n",
        "uns gerade mal etwas Zeit verschaffen?\r",
        "Aber das ist schon in Ordnung so.\r",
        "Ein Kind wie du wird es niemals schaffen,\n",
        "gegen den Strom der Zeit zu schwimmen,\f",
        "ohne unterzugehen!\r",
        "Team Galaktik wird die drei\n",
        "Legendären Pokémon aus den\f",
        "Seen fangen!\r",
        "Und mit ihren Kräften werden wir ein\n",
        "vollkommen neues Universum schaffen!\r",
        "Mars sollte mittlerweile das Pokémon\n",
        "vom See der Wahrheit gefangen haben...\r"
      ]
    },
    {
      "id": "msg_0275_00003",
      "de_DE": "Kyuuun...\r"
    },
    {
      "id": "msg_0275_00004",
      "de_DE": [
        "TOBUTZ verschwand tief im\n",
        "Inneren der Höhle..."
      ]
    }
  ]
}
