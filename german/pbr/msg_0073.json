  "key": 58402,
  "messages": [
    {
      "id": "msg_0073_00000",
      "de_DE": [
        "Hast du schon mal etwas von einem\n",
        "unterschiedlich gefärbten Pokémon\f",
        "gehört, oder gar eines gesehen?\r",
        "Was ich meine? Ein PIKACHU! Ein\n",
        "PIKACHU zum Beispiel ist gelb, ja?\r",
        "Und ein PIKACHU in einer\n",
        "anderen Farbe ist orange."
      ]
    },
    {
      "id": "msg_0073_00001",
      "de_DE": [
        "Wusstest du, dass das Wesen der\n",
        "Pokémon genauso unterschiedlich\f",
        "ist wie bei uns Menschen?\r",
        "Daher überrascht es mich eigentlich\n",
        "nicht, dass es auch unterschiedliche\f",
        "Farben bei gleichen Pokémon gibt."
      ]
    },
    {
      "id": "msg_0073_00002",
      "de_DE": "PIKACHU: Bigaaah!"
    }
  ]
}
