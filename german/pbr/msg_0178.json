{
  "key": 54330,
  "messages": [
    {
      "id": "msg_0178_00000",
      "de_DE": [
        "Hey, Trainer!\r",
        "Ich konnte es schon kaum erwarten,\n",
        "bis du endlich hier auftauchst.\r",
        "Ich hörte, was du in Sonnewik mit\n",
        "Volkner gemacht hast.\r",
        "Du hast sein Feuer für\n",
        "Kämpfe wieder entfacht.\r",
        "Daher brenne ich vor Freude, dir\n",
        "endlich in einem Kampf zu begegnen.\r"
      ]
    },
    {
      "id": "msg_0178_00001",
      "de_DE": [
        "Wie du dir schon denken kannst,\n",
        "kämpfe ich mit Feuer-Pokémon.\r",
        "Zeige Ignaz, wie heiß dein Kampfesgeist\n",
        "in der Hitze des Gefechts ist!\r"
      ]
    },
    {
      "id": "msg_0178_00002",
      "de_DE": [
        "...\n",
        "...\r",
        "...\n",
        "...\r",
        "...\n",
        "...\r",
        "...Uff... ...Ich glaube, ich habe\n",
        "mir die Augenbrauen versengt..."
      ]
    },
    {
      "id": "msg_0178_00003",
      "de_DE": [
        "...\n",
        "...\r",
        "...\n",
        "...\r",
        "...\n",
        "...\r",
        "...Hör nicht auf..."
      ]
    },
    {
      "id": "msg_0178_00004",
      "de_DE": [
        "Herausforderer, ich habe\n",
        "auf dich gewartet!\r",
        "Ignaz, Herr über Flammen und Feuer,\n",
        "ist dein nächster Gegner!\r",
        "Bei Kämpfen kommt es darauf an, welche\n",
        "Pokémon heißer auf den Sieg sind.\r",
        "Es geht nicht darum, wer schön ist,\n",
        "oder schwach, oder stark.\r",
        "Es geht darum, wessen Kampfesflamme\n",
        "länger brennt.\r"
      ]
    },
    {
      "id": "msg_0178_00005",
      "de_DE": [
        "...\n",
        "...\r",
        "...Uff... ...Ich glaube, ich habe\n",
        "mir die Augenbrauen versengt..."
      ]
    },
    {
      "id": "msg_0178_00006",
      "de_DE": [
        "...\n",
        "...\r",
        "...Hör nicht auf...\r",
        "Ich weiß, die Flamme des Kampfes lodert\n",
        "in dir. Dein ganzes Team ist heiß!"
      ]
    }
  ]
}
