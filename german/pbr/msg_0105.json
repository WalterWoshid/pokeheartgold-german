      "de_DE": [
        "Hast du schon die GTS in Jubelstadt\n",
        "ausprobiert?\r",
        "Sie verwendet die Nintendo WFC!\r",
        "Ich kann es nicht erklären, aber es ist\n",
        "fantastisch!"
      ]
    },
    {
      "id": "msg_0105_00001",
      "de_DE": [
        "Hallo. Hast du eine Knurspbox?\r",
        "Falls nicht, musst du unbedingt den\n",
        "Pokémon-Fanclub besuchen."
      ]
    },
    {
      "id": "msg_0105_00002",
      "de_DE": [
        "Wenn du deinen Pokémon regelmäßig\n",
        "Knurspe gibst, können sie an jedem\f",
        "beliebigen Wettbewerb teilnehmen."
      ]
    },
    {
      "id": "msg_0105_00003",
      "de_DE": [
        "Es heißt, die Arenaleiterin Lamina ist\n",
        "im Moment nicht da.\r",
        "Ha! Sie hat bestimmt von mir gehört und\n",
        "ist geflüchtet!"
      ]
    },
    {
      "id": "msg_0105_00004",
      "de_DE": [
        "Tja, die Arenaleiterin kam zurück und\n",
        "ich habe sie herausgefordert.\r",
        "...Sie hat sozusagen den Boden mit uns\n",
        "aufgewischt.\r",
        "Jetzt muss ich mein Team erst mal\n",
        "heilen..."
      ]
    }
  ]
