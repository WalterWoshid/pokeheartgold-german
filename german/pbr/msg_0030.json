{
  "key": 17415,
  "messages": [
    {
      "id": "msg_0030_00000",
      "de_DE": [
        "Jemand hat meinen Rekord im Fangen von\n",
        "Pokémon gebrochen.\r",
        "Ich werde mir meinen Rekord zurückholen\n",
        "und meinen Platz zurückerobern!"
      ]
    },
    {
      "id": "msg_0030_00001",
      "de_DE": [
        "Mein Name steht nicht in der\n",
        "Rangliste?!?\f",
        "Was ist das denn für ein Unsinn?!?\r",
        "...Weil ich nie an einem Wettbewerb\n",
        "teilgenommen habe?!?\r",
        "Ich wette, es wäre ein irres Gefühl,\n",
        "wenn ich hier die Nummer eins\f",
        "werden könnte."
      ]
    },
    {
      "id": "msg_0030_00002",
      "de_DE": [
        "Ich gewinne wirklich nur wenige\n",
        "Kämpfe... Aber ich lasse mich\f",
        "trotzdem nicht entmutigen!\r",
        "Ich versuche einen Weltrekord\n",
        "aufzustellen:\f",
        "Den Weltrekord im Fischen von Pokémon!"
      ]
    },
    {
      "id": "msg_0030_00003",
      "de_DE": [
        "Oh, tut mir leid. Ich bin beschäftigt.\n",
        "Ich nehme gerade Feineinstellungen\f",
        "an diesem Ding hier vor."
      ]
    }
  ]
}
