{
  "key": 18407,
  "messages": [
    {
      "id": "msg_0354_00000",
      "de_DE": [
        "...Keuch... Japps...\r",
        "...Warum renne ich überhaupt\n",
        "in einem solchen Affentempo?!?\r",
        "Das neue Universum, von dem\n",
        "der Boss sprach...\r",
        "Ich bekomme richtig Gänsehaut,\n",
        "wenn ich nur daran denke...\f",
        "Also verwenden wir dies hier...\r"
      ]
    },
    {
      "id": "msg_0354_00001",
      "de_DE": [
        "Argh! Du hast spitze Ohren\n",
        "gemacht und mich belauscht!!!\r",
        "Du bist so nervtötend hartnäckig...\n",
        "Ich bin total kaputt vom Rennen...\r",
        "Und ich werde nicht...\n",
        "Gegen dich antreten...\r"
      ]
    },
    {
      "id": "msg_0354_00002",
      "de_DE": [
        "Aauu, nein...\n",
        "Bist du mir immer noch auf den Fersen?!?\f",
        "Der See ist in Sicht...\r",
        "Du lässt mir keine andere Wahl...\n",
        "Mein Pokémon wird es dir zeigen...\r"
      ]
    },
    {
      "id": "msg_0354_00003",
      "de_DE": [
        "Ich kann nicht mehr kämpfen...\n",
        "Ich pfeife aus dem letzten Loch...\r",
        "Ich muss dies dem Commander\n",
        "bringen...\r",
        "Ich wünschte...\n",
        "Ich könnte es am See einsetzen...\r"
      ]
    },
    {
      "id": "msg_0354_00004",
      "de_DE": [
        "Cynthia: Oh, hallo. Wir haben uns ja\n",
        "lange nicht gesehen!\r",
        "Wie geht es mit deinem Pokédex\n",
        "voran?\r",
        "Ich bin hier, weil ich mir den See\n",
        "ansehen will, um den sich eine\f",
        "alte Volkssage rankt, aber...\r",
        "Der See scheint für die Öffentlichkeit\n",
        "gesperrt zu sein.\f",
        "Kennst du die Volkssage?\r",
        "Sie berichtet, dass in der Mitte des\n",
        "Sees eine Insel sein soll.\r",
        "Und im Inneren der Höhle soll sich \n",
        "die Illusion eines Pokémon befinden.\r",
        "Niemand darf die Höhle des\n",
        "Pokémon betreten...\r",
        "Aber ich muss dich was fragen,\n",
        "das nicht zum Thema gehört.\r",
        "Hast du die Horde von ENTON\n",
        "an der Route 210 gesehen?"
      ]
    },
    {
      "id": "msg_0354_00005",
      "de_DE": [
        "Cynthia: Ja, genau!\n",
        "Hinter dem Café an der Route 210.\r",
        "Du hast die Gruppe ENTON gesehen,\n",
        "die sich ihre... äh, Köpfe halten?\r"
      ]
    },
    {
      "id": "msg_0354_00006",
      "de_DE": [
        "Cynthia: Du hast sie nicht gesehen?!?\n",
        "Hinter dem Café an der Route 210.\r",
        "Da ist eine Gruppe ENTON, die sich\n",
        "ihre... äh, Köpfe halten.\r"
      ]
    },
    {
      "id": "msg_0354_00007",
      "de_DE": [
        "Wie dem auch sei. Gib den\n",
        "ENTON diese Medizin.\r",
        "Du arbeitest an einem Pokédex,\n",
        "da wird sich das für dich lohnen.\r"
      ]
    },
    {
      "id": "msg_0354_00008",
      "de_DE": [
        "Cynthia: Als ich jünger war, bin ich auch\n",
        "mit einem Pokédex auf Abenteuerreise\f",
        "gegangen.\r",
        "Ich hoffe, du wirst jede Art Pokémon,\n",
        "die es gibt, wirklich sehen können.\r",
        "Vielleicht schaffst du es dann ja, das\n",
        "Illusion-Pokémon zu entdecken.\r",
        "Ich muss los! Bis bald mal!\r"
      ]
    },
    {
      "id": "msg_0354_00009",
      "de_DE": [
        "Uns wurde aufgetragen, niemanden in die\n",
        "Nähe des Sees zu lassen.\r",
        "Wieso das? Ich weiß nicht genau, aber\n",
        "wahrscheinlich, um den See zu schützen."
      ]
    },
    {
      "id": "msg_0354_00010",
      "de_DE": [
        "Den See schützen...\r",
        "Es ist gut zu wissen, dass es immer noch\n",
        "Menschen gibt, die man bewundern kann.\r",
        "Ich glaube, sein Name war Zyrus."
      ]
    },
    {
      "id": "msg_0354_00011",
      "de_DE": [
        "Stopp, stopp, stopp!\n",
        "Ja, dich meine ich!\r",
        "In Sonnewik, das sich am Ende\n",
        "dieser Straße befindet, hat es\f",
        "einen Stromausfall gegeben.\r",
        "Sie arbeiten bereits daran, die\n",
        "Störung zu beheben, aber die Straße\f",
        "bleibt trotzdem vorerst gesperrt.\r"
      ]
    },
    {
      "id": "msg_0354_00012",
      "de_DE": [
        "Stopp, stopp, stopp!\n",
        "Ja, dich meine ich!\r",
        "In Sonnewik, das sich am Ende\n",
        "dieser Straße befindet, hat es\f",
        "einen Stromausfall gegeben.\r",
        "Sie arbeiten bereits daran, die\n",
        "Störung zu beheben, aber die Straße\f",
        "bleibt trotzdem vorerst gesperrt."
      ]
    },
    {
      "id": "msg_0354_00013",
      "de_DE": [
        "Was soll ich nur tun?\r",
        "Ich habe es tatsächlich geschafft,\n",
        "meinen B-Schlüssel zu verlieren.\f",
        "Schon wieder...\r",
        "Die Leute dieser Ferienanlage\n",
        "werden nicht gerade entzückt sein...\r",
        "Ich bin mir sicher, ich hatte ihn\n",
        "noch, als ich die Rezeption\f",
        "verlassen habe..."
      ]
    },
    {
      "id": "msg_0354_00014",
      "de_DE": [
        "Was mache ich denn jetzt nur?!?\r",
        "Ich habe den B-Schlüssel verloren\n",
        "und weiß nicht wo...\r",
        "Oh! Das ist ja der Schlüssel zu\n",
        "meinem Bungalow!\r",
        "Du hast ihn für mich gefunden?!?\n",
        "Das ist aber süß von dir! Danke schön!\r"
      ]
    },
    {
      "id": "msg_0354_00015",
      "de_DE": [
        "7-Sterne-Restaurant\n",
        "Der Ort des guten Geschmacks."
      ]
    }
  ]
}
