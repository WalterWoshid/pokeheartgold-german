{
  "key": 54274,
  "messages": [
    {
      "id": "msg_0179_00000",
      "de_DE": [
        "Ah, gutes Timing.\n",
        "Ich habe gerade ein Buch beendet.\r",
        "Erlaube, dass ich mich vorstelle.\r",
        "Mein Name lautet Lucian.\n",
        "Ich bevorzuge Psycho-Pokémon.\r",
        "Ich muss schon sagen, ich bin\n",
        "ganz angetan von dir.\r",
        "Dass du es so weit geschafft hast,\n",
        "beweist mir einiges.\r",
        "Man sagt, ich wäre der härteste\n",
        "der Top Vier.\r",
        "Du siehst, für mich gilt es,\n",
        "einen Ruf zu verteidigen.\r",
        "Ich werde gegen dich also\n",
        "Vollgas geben müssen.\r"
      ]
    },
    {
      "id": "msg_0179_00001",
      "de_DE": [
        "Glückwunsch!\n",
        "Du hast die Top Vier geschlagen.\r",
        "Das heißt aber nicht, dass du mit\n",
        "der Pokémon Liga fertig bist.\r",
        "Da gibt es noch den Champ.\r",
        "Sei gewarnt - unser Champ ist\n",
        "viel stärker als die Top Vier.\r",
        "Na dann, geh durch diese Tür, um\n",
        "den letzten Kampf zu bestreiten."
      ]
    },
    {
      "id": "msg_0179_00002",
      "de_DE": [
        "Ich lese einfach Bücher, bis der\n",
        "nächste Herausforderer eintrifft.\r",
        "Das beruhigt meine Nerven und ich kann\n",
        "alle Situationen ohne Panik meistern."
      ]
    }
  ]
}
