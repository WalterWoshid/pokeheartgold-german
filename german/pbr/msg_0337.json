      "id": "msg_0337_00026",
      "de_DE": [
        "Geben wir den Teilnehmern Zeit, sich\n",
        "hinter der Bühne vorzubereiten!\r",
        "Du hast 60 Sekunden Zeit, um dein\n",
        "Pokémon mit Accessoires zu schmücken.\r",
        "Stimmen sie mit dem Motto des Wett-\n",
        "bewerbs überein, gibt es mehr Punkte!\r"
      ]
    },
    {
      "id": "msg_0337_00027",
      "garbage": 0
    },
    {
      "id": "msg_0337_00028",
      "de_DE": [
        "Gut! Fangen wir mit dem Training an.\n",
        "Zunächst der Model-Wettstreit!\r",
        "Mithilfe des Touchscreens kannst du\n",
        "Pokémon mit Accessoires ausstatten.\r",
        "Stimmt die Ausstattung mit dem Motto\n",
        "überein, bekommt ihr mehr Punkte!\r"
      ]
    },
    {
      "id": "msg_0337_00029",
      "de_DE": [
        "Und unser heutiges Motto ist...\n",
        "“Wohlgestalt”!\r"
      ]
    },
    {
      "id": "msg_0337_00030",
      "de_DE": [
        "Und unser heutiges Motto ist...\n",
        "“Gerissenheit”!\r"
      ]
    },
    {
      "id": "msg_0337_00031",
      "de_DE": [
        "Und unser heutiges Motto ist...\n",
        "“Erschaffung”!\r"
      ]
    },
    {
      "id": "msg_0337_00032",
      "de_DE": [
        "Und unser heutiges Motto ist...\n",
        "“Natürlichkeit”!\r"
      ]
    },
    {
      "id": "msg_0337_00033",
      "de_DE": [
        "Und unser heutiges Motto ist...\n",
        "“Farbenfroh”!\r"
      ]
    },
    {
      "id": "msg_0337_00034",
      "de_DE": [
