    },
    {
      "id": "msg_0337_00041",
      "de_DE": [
        "Du hast 60 Sekunden!\n",
        "Du darfst {STRVAR_1 51, 0} Accessoires verwenden!\r",
        "Befestige sie gut!\n",
        "Die Zeit läuft... ab jetzt!\r"
      ]
    },
    {
      "id": "msg_0337_00042",
      "de_DE": [
        "Du hast 60 Sekunden!\n",
        "Du darfst {STRVAR_1 51, 0} Accessoires verwenden!\r",
        "Zeig, ob du Modebewusstsein hast!\n",
        "Die Zeit läuft... ab jetzt!\r"
      ]
    },
    {
