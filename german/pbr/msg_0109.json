{
  "key": 1051,
  "messages": [
    {
      "id": "msg_0109_00000",
      "de_DE": [
        "Hallo, hallo!\n",
        "Ich sage mal, wie geht es dir?\r",
        "Ich bin der Vorsitzende des\n",
        "Pokémon-Fanclubs! Ja, das bin ich!\r",
        "Wenn du deine Pokémon, ich sage mal,\n",
        "belohnen willst, was wirst du dann tun?\r",
        "Nun, ich sage mal, was mich betrifft, ich\n",
        "gebe ihnen einen leckeren Knursp!\r",
        "Warum, fragst du?\r",
        "Weil ich damit, ich sage mal, meine\n",
        "Zuneigung zu ihnen ausdrücken kann!\r",
        "Ein Beispiel: Wenn ich, ich sage mal,\n",
        "meinem Pokémon einen süßen Knursp\f",
        "gebe, gewinnt es deutlich an Anmut.\r",
        "Anderes Beispiel: Ein scharfer Knursp,\n",
        "ich sage mal, schenkt meinem Pokémon\f",
        "Coolness.\r",
        "Deswegen sind Knurspe, ich sage mal,\n",
        "sehr wichtig und sehr gesund für alle\f",
        "Pokémon!\r",
        "Also dann...\r",
        "Ich sage mal, hiermit schenke ich\n",
        "dir diese Knurspbox.\f",
        "Viel Vergnügen, sage ich mal!\r"
      ]
    },
    {
      "id": "msg_0109_00001",
      "de_DE": [
        "Fülle sie, ich sage mal, mit vielen\n",
        "Knurspen und verteile sie großzügig\f",
        "an deine Pokémon!"
      ]
    },
    {
      "id": "msg_0109_00002",
      "de_DE": [
        "Fanclubs gibt es, ich sage mal, in der\n",
        "ganzen Welt, aber wir sind die\f",
        "Nummer eins!\r",
        "Und warum sind wir die Nummer eins?\n",
        "Weil ich, ich sage mal, mehr prahle als\f",
        "alle anderen zusammen!\r",
        "Aber ich muss mich ja zurückhalten...\r",
        "Es gab schon, ich sage mal, Beschwerden\n",
        "darüber, also darf ich nicht mehr\f",
        "so viel prahlen..."
      ]
    },
    {
      "id": "msg_0109_00003",
      "de_DE": [
        "Willkommen im Pokémon-Fanclub!\n",
        "Oh, dein {STRVAR_1 0, 0}...\r"
      ]
    },
    {
      "id": "msg_0109_00004",
      "de_DE": [
        "Es liebt dich über alles!\n",
        "Ich störe ja schon fast!"
      ]
    },
    {
      "id": "msg_0109_00005",
      "de_DE": [
        "Es mag dich wirklich sehr.\n",
        "Du behandelst es ausgesprochen gut."
      ]
    },
    {
      "id": "msg_0109_00006",
      "de_DE": [
        "Es mag dich.\n",
        "Es ist sicher gerne bei dir."
      ]
    },
    {
      "id": "msg_0109_00007",
      "de_DE": [
        "Es gewöhnt sich an dich.\n",
        "Das ist zumindest mein Eindruck."
      ]
    },
    {
      "id": "msg_0109_00008",
      "de_DE": [
        "Es ist recht neutral dir gegenüber.\n",
        "Es liegt an dir, das zu ändern."
      ]
    },
    {
      "id": "msg_0109_00009",
      "de_DE": [
        "Hmmm...\n",
        "Es mag dich nicht sonderlich."
      ]
    },
    {
      "id": "msg_0109_00010",
      "de_DE": [
        "Oh je... Dieses Pokémon hat ziemliche\n",
        "Schwierigkeiten mit dir."
      ]
    },
    {
      "id": "msg_0109_00011",
      "de_DE": "ENTON: Quak quak?"
    },
    {
      "id": "msg_0109_00012",
      "de_DE": "HASPIROR: Knabbknabb."
    },
    {
      "id": "msg_0109_00013",
      "de_DE": "PIEPI: Piep piep!"
    }
  ]
}
