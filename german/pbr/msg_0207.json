    {
      "id": "msg_0207_00044",
      "de_DE": [
        "Wählt einen Leiter für einen\n",
        "Multikampf aus."
      ]
    },
    {
      "id": "msg_0207_00045",
      "de_DE": [
        "{STRVAR_1 3, 0} wurde gebeten, dich als\n",
        "Mitglied aufzunehmen. Bitte warten!"
      ]
    },
    {
      "id": "msg_0207_00046",
      "de_DE": [
        "{STRVAR_1 3, 0} antwortet...\n",
        "“NEIN...”"
      ]
    },
    {
      "id": "msg_0207_00047",
      "de_DE": [
        "{STRVAR_1 3, 0} hat dich als Mitglied\n",
        "aufgenommen."
      ]
    },
    {
      "id": "msg_0207_00048",
      "de_DE": [
        "Multikampf! Warte auf weitere\n",
        "Mitglieder!"
      ]
    },
    {
      "id": "msg_0207_00049",
      "de_DE": "Multikampf! Warte auf einen Mitspieler."
    },
    {
      "id": "msg_0207_00050",
      "de_DE": [
        "Multikampf-Modus mit diesen Mitgliedern\n",
        "beenden?"
      ]
    },
    {
      "id": "msg_0207_00051",
      "de_DE": "{STRVAR_1 3, 0} kontaktiert dich."
    },
    {
      "id": "msg_0207_00052",
      "de_DE": [
        "Die Mitglieder sind vollzählig. Bitte\n",
        "betretet den Raum."
      ]
    },
