  "key": 35850,
  "messages": [
    {
      "id": "msg_0121_00000",
      "de_DE": [
        "Für den Modelwettstreit solltest du\n",
        "dein Pokémon mit Accessoires\f",
        "ausstatten, die zum Motto passen.\r",
        "Wenn du also viele verschiedene\n",
        "Accessoires hast, bist du im Vorteil."
      ]
    },
    {
      "id": "msg_0121_00001",
      "de_DE": [
        "Im Tanzwettstreit muss dein Pokémon\n",
        "die Schritte des Haupttänzers\f",
        "genau imitieren."
      ]
    },
    {
      "id": "msg_0121_00002",
      "de_DE": [
        "Beim Aktionswettstreit muss dein\n",
        "Pokémon die richtigen Attacken\f",
        "vorführen.\r",
        "Und noch wichtiger ist die korrekte\n",
        "Auswahl des Jurors.\r",
        "Wenn alle den gleichen Juror wählen,\n",
        "kann dein Pokémon ihn weniger\f",
        "beeindrucken."
      ]
    },
    {
      "id": "msg_0121_00003",
      "de_DE": [
        "In einem Coolness-Wettbewerb musst du\n",
        "coole Attacken vorführen! Die Juroren\f",
        "müssen bersten vor Spannung!\r",
        "Wenn die Spannung den Höhepunkt\n",
        "erreicht, erhältst du Bonuspunkte!"
      ]
    }
  ]
}
