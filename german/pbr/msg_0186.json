    {
      "id": "msg_0186_00027",
      "de_DE": "GETRAGENE ITEMS"
    },
    {
      "id": "msg_0186_00028",
      "de_DE": [
        "Da vorne liegt der Duellturm.\n",
        "Was für Trainer dort wohl kämpfen?"
      ]
    }
  ]
