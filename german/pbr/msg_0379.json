{
  "key": 1593,
  "messages": [
    {
      "id": "msg_0379_00000",
      "de_DE": [
        "Oh, hallo!\n",
        "Hier entlang, bitte!\r"
      ]
    },
    {
      "id": "msg_0379_00001",
      "de_DE": [
        "Hallo und willkommen.\n",
        "Schön, dich zu sehen.\r",
        "Mein Name ist Teala. Ich bin deine\n",
        "Führerin im Pokémon Wi-Fi-Klub.\r",
        "Zuerst darf ich dir das hier geben.\r"
      ]
    },
    {
      "id": "msg_0379_00002",
      "de_DE": [
        "Das ist dein Adressbuch. Damit kannst\n",
        "du deine Freunde registrieren.\r",
        "Erst dann kannst du mit ihnen über die\n",
        "Nintendo WFC Kontakt aufnehmen.\r",
        "Dann könnt ihr tauschen, kämpfen und\n",
        "vieles mehr.\r",
        "Möchtest du mehr darüber wissen?"
      ]
    },
    {
      "id": "msg_0379_00003",
      "de_DE": [
        "Im ersten Stock eines Pokémon-Centers\n",
        "triffst du Leute, die tauschen oder im\f",
        "Kolosseum kämpfen möchten.\r",
        "Diese Leute kannst du als Freunde in\n",
        "deinem Adressbuch registrieren.\r",
        "Außerdem kannst du manuell Freunde\n",
        "registrieren, indem du ihren Freundes-\f",
        "code in dein Adressbuch eingibst.\r",
        "Soll ich das nochmal wiederholen?"
      ]
    },
    {
      "id": "msg_0379_00004",
      "de_DE": [
        "Viel Spaß mit der Nintendo Wi-Fi\n",
        "Connection!"
      ]
    },
    {
      "id": "msg_0379_00005",
      "de_DE": [
        "Willkommen im Pokémon Wi-Fi-Klub!\n",
        "Kann ich dir helfen?"
      ]
    },
    {
      "id": "msg_0379_00006",
      "de_DE": [
        "Lass mich kurz erklären, wie der\n",
        "Pokémon Wi-Fi-Klub funktioniert.\r",
        "Am mittleren Schalter kannst du die\n",
        "Nintendo Wi-Fi Connection nutzen.\r",
        "Dadurch kannst du mit Freunden, die du\n",
        "in deinem Adressbuch registriert hast,\r",
        "nach Belieben tauschen und kämpfen."
      ]
    },
    {
      "id": "msg_0379_00007",
      "de_DE": [
        "Willkommen im Pokémon Wi-Fi-Klub!\r",
        "Möchtest du die Nintendo WFC nutzen?"
      ]
    },
    {
      "id": "msg_0379_00008",
      "de_DE": "Bitte besuche uns wieder!"
    },
    {
      "id": "msg_0379_00009",
      "de_DE": [
        "Möchtest du eine Verbindung zur\n",
        "Nintendo Wi-Fi Connection herstellen?"
      ]
    },
    {
      "id": "msg_0379_00010",
      "de_DE": "Komm bitte hier entlang.\r"
    },
    {
      "id": "msg_0379_00011",
      "de_DE": [
        "...Oh?\r",
        "Es tut mir leid, aber du hast keine\n",
        "Freunde registriert.\r",
        "Der Klub ist nur zugänglich, wenn in\n",
        "deinem Adressbuch Freunde sind.\r",
        "Möchtest du zumindest deinen eigenen\n",
        "Freundescode erfahren?"
      ]
    },
    {
      "id": "msg_0379_00012",
      "de_DE": [
        "...Oh?\r",
        "Es tut mir leid, aber du hast keine\n",
        "Freunde registriert.\r",
        "Der Klub ist nur zugänglich, wenn in\n",
        "deinem Adressbuch Freunde sind.\r",
        "Bitte registriere deine Freunde, indem\n",
        "du ihre Freundescodes in dein\f",
        "Adressbuch eingibst. Komme dann wieder."
      ]
    }
  ]
}
