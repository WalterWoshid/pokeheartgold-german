{
  "key": 54275,
  "messages": [
    {
      "id": "msg_0158_00000",
      "de_DE": [
        "Oh?\n",
        "Dein {STRVAR_1 0, 0}...\r"
      ]
    },
    {
      "id": "msg_0158_00001",
      "de_DE": [
        "Es hat sich enorm angestrengt!\r",
        "Gib ihm als Belohnung bitte dieses\n",
        "Fleiß-Band.\r"
      ]
    },
    {
      "id": "msg_0158_00002",
      "de_DE": "{STRVAR_1 3, 1} erhält das Fleiß-Band.\r"
    },
    {
      "id": "msg_0158_00003",
      "de_DE": [
        "{STRVAR_1 3, 1} steckt {STRVAR_1 0, 0} das\n",
        "Fleiß-Band an."
      ]
    },
    {
      "id": "msg_0158_00004",
      "de_DE": [
        "Du musst dich mehr anstrengen.\r",
        "Dann gebe ich dir und deinem Pokémon\n",
        "ein schönes Geschenk."
      ]
    },
    {
      "id": "msg_0158_00005",
      "de_DE": [
        "Oh! Dein {STRVAR_1 0, 0} sieht gut mit dem\n",
        "Fleiß-Band aus!"
      ]
    },
    {
      "id": "msg_0158_00006",
      "de_DE": [
        "Der Sonnewik-Markt ist bekannt für\n",
        "seine große Auswahl an Stickern."
      ]
    },
    {
      "id": "msg_0158_00007",
      "de_DE": [
        "Ah, darf ich ein wenig deiner Zeit in\n",
        "Anspruch nehmen? Du bereust es nicht.\r"
      ]
    },
    {
      "id": "msg_0158_00008",
      "de_DE": [
        "Ah, darf ich ein wenig deiner Zeit in\n",
        "Anspruch nehmen? Du bereust es nicht.\r",
        "...Oh, nein! Das geht nicht!\n",
        "Du hast keinen Stick.Koffer?\r",
        "Kehre in die Stadt der Ruinen zurück\n",
        "und besorge dir einen Stick.Koffer!"
      ]
    },
    {
      "id": "msg_0158_00009",
      "de_DE": "Siehst du den Sticker-Händler da?\r"
    },
    {
      "id": "msg_0158_00010",
      "de_DE": [
        "Er hatte die Sticker, die ich wollte,\n",
        "heute nicht auf Lager...\f",
        "Vielleicht habe ich morgen mehr Glück."
      ]
    },
    {
      "id": "msg_0158_00011",
      "de_DE": [
        "Heute hatte er neue Sticker auf Lager!\n",
        "So und nicht anders gefällt’s mir!"
      ]
    }
  ]
}
