{
  "key": 17419,
  "messages": [
    {
      "id": "msg_0029_00000",
      "garbage": 0
    },
    {
      "id": "msg_0029_00001",
      "de_DE": [
        "Ooh, deinä Pokémon sind aber\n",
        "’erzallerliebst! Ganz entzückend!\r",
        "Sie sind so bezaubärnd, isch wärde ein\n",
        "Bild von i’nen neben misch ’ängen!\f",
        "Aufregend, nischt wahr?\r",
        "Kostümiere dein Pokémon in meinäm\n",
        "Boudoir ünd lass es alle verzaubärn!\r",
        "Ünd wenn dü damit fertig bisdö, mache\n",
        "isch ein Fotto von i’m.\f",
        "Machen wir das so, oui?"
      ]
    },
    {
      "id": "msg_0029_00002",
      "de_DE": [
        "Oh, dü dümmes Ding...\n",
        "Wo bleibt dänn dein Sinn fürs Abänteuär?"
      ]
    },
    {
      "id": "msg_0029_00003",
      "de_DE": [
        "Oh jaaa! Das ist fein!\n",
        "Lass üns keinä Zeit verlierän!\r",
        "Soll isch dir erklärä, wie dü dein\n",
        "Pokémon kostümierän kannst?"
      ]
    },
    {
      "id": "msg_0029_00004",
      "de_DE": [
        "Oh, wähle ein Pokémon aus, das\n",
        "dü kostümierän möschtest."
      ]
    },
    {
      "id": "msg_0029_00005",
      "de_DE": [
        "Te’e’e’e... Isch ’offe, dü wirscht\n",
        "äs nett kostümierän!\r"
      ]
    },
    {
      "id": "msg_0029_00006",
      "de_DE": [
        "Dü ’ast einä Modekoffär, nischt wa’r?\n",
        "Ah, oui, wünderbar!\r",
        "Dü süchst dir die Accessoire aus ünd\n",
        "zie’st sie deinäm Pokémon an.\r",
        "Dann isch werdä einä Fotto machän\n",
        "ünd ’ier näben misch ’ängen!\r",
        "Wenn dü deinä Statistik mit andärän\n",
        "Trainörn tauscht, bekommst dü einä\f",
        "Fotto von i’nen.\r",
        "Isch denkä, dü solltäst äs einfach\n",
        "mal probierän!"
      ]
    },
    {
      "id": "msg_0029_00007",
      "de_DE": [
        "Ooh, oui, das ist so schönn! Isch ’änge\n",
        "das Fotto gleisch an die Wand!\f",
        "Abär dü müsst ihm einän Titäl gebän."
      ]
    },
    {
      "id": "msg_0029_00008",
      "de_DE": [
        "{STRVAR_1 28, 0}...\r",
        "Ooh, oui, oui! Isch sähe schon!\n",
        "Dein Sinn für Schön’eit ist erkännbar!"
      ]
    },
    {
      "id": "msg_0029_00009",
      "de_DE": [
        "Oh, non, non, non!\n",
        "Es wird värgäbens sein ohne einä Titäl!"
      ]
    },
    {
      "id": "msg_0029_00010",
      "de_DE": [
        "Oh... Dü ’ast gar nischts gemacht.\n",
        "Wie enttäuschänd!"
      ]
    },
    {
      "id": "msg_0029_00011",
      "de_DE": [
        "Wenn dü ein anderäs odär diesäs\n",
        "Pokémon nochmal kostümierst,\f",
        "wird das Fotto ’ier ausgätauscht.\r",
        "Möschtescht dü ein Pokémon\n",
        "kostümierän?"
      ]
    },
    {
      "id": "msg_0029_00012",
      "garbage": 0
    },
    {
      "id": "msg_0029_00013",
      "de_DE": [
        "Ooh, non, non, non! Das ist ein Ei!\n",
        "Das ischt zü jüng.\r"
      ]
    },
    {
      "id": "msg_0029_00014",
      "de_DE": [
        "Isch wärdä dein Fotto diräkt ’ier\n",
        "neben misch ’ängen! Pärfäkt!"
      ]
    },
    {
      "id": "msg_0029_00015",
      "de_DE": "Das ist ein Fotorahmen."
    },
    {
      "id": "msg_0029_00016",
      "de_DE": [
        "Sie stellen die Fotos von Trainern aus,\n",
        "die am Statistiktausch teilnehmen.\r",
        "Ich hoffe, du sammelst viele Fotos von\n",
        "kostümierten Pokémon."
      ]
    },
    {
      "id": "msg_0029_00017",
      "de_DE": [
        "Ich habe in der Pokémon-Lotterie eine\n",
        "neue Kulisse gewonnen."
      ]
    }
  ]
}
