  "messages": [
    {
      "id": "msg_0259_00000",
      "de_DE": [
        "Adam: Hm?\n",
        "Du trainierst, wie ich sehe.\r",
        "Mein Sohn trainiert\n",
        "genauso hart wie du.\r",
        "Trotzdem behandele ich ihn\n",
        "immer noch wie ein Kind.\r",
        "Es ist wirklich lächerlich.\n",
        "Immerhin ist er ja ein Arenaleiter.\r",
        "Offenbar ist eine Beziehung zwischen\n",
        "Vater und Sohn niemals leicht.\r",
        "Hmpf, ich verschwende deine Zeit.\n",
        "Nimm das als Entschuldigung!\r"
      ]
    },
    {
      "id": "msg_0259_00001",
      "de_DE": [
        "Manche Pokémon verwandeln sich\n",
        "in den Typ Stahl, wenn sie den\f",
        "Metallmantel verwenden.\r",
        "Sie müssen dieses Item tragen,\n",
        "wenn sie getauscht werden,\f",
        "um das zu ermöglichen.\r",
        "Versuch’s doch mal selbst, wenn’s dich\n",
        "interessiert. Auf Wiedersehen!\r"
      ]
    }
  ]
}
