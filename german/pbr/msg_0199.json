    {
      "id": "msg_0199_00036",
      "de_DE": [
        "Prof. Eibe sagt immer...\n",
        "“{STRVAR_1 3, 0}, dies ist weder der\f",
        "rechte Ort noch die rechte Zeit dafür!”"
      ]
    },
    {
      "id": "msg_0199_00037",
      "de_DE": [
        "Willkommen!\n",
        "Kann ich helfen?"
      ]
    },
    {
      "id": "msg_0199_00038",
      "garbage": 0
    },
    {
      "id": "msg_0199_00039",
      "de_DE": [
        "Deine Pokémon wurden vollständig\n",
        "geheilt.\r",
        "Wir hoffen, du kommst groß raus!"
      ]
    },
    {
      "id": "msg_0199_00040",
      "de_DE": [
        "Mutter: {STRVAR_1 3, 0}!\n",
        "Willkommen zu Hause.\r",
        "Offenbar hast du viele aufregende\n",
        "Dinge da draußen erlebt.\r",
        "Vielleicht solltest du dich etwas\n",
        "ausruhen und wieder zu Kräften kommen.\r",
        "...\n",
        "..."
      ]
    },
    {
      "id": "msg_0199_00041",
      "de_DE": [
        "Mutter: Sehr gut! Du und dein\n",
        "Pokémon sehen großartig aus!\r",
        "Prof. Eibe hat sich soeben\n",
        "bei mir gemeldet.\r",
        "Er erklärte mir, dass die Energie\n",
        "der Pokémon in KP gemessen wird.\r",
        "Falls dein Pokémon seine KP\n",
        "verliert, kannst du sie in einem\f",
        "Pokémon-Center auffüllen lassen.\r",
        "Falls du dich auf lange Reisen\n",
        "begibst, solltest du deinen Vorrat\f",
        "mit Tränken vom Pokémon-\f",
        "Supermarkt auffüllen.\r",
        "Lass mich stolz auf dich sein!\n",
        "Pass auf dich auf!"
      ]
    },
    {
      "id": "msg_0199_00042",
      "de_DE": [
        "Mutter: Schön! Du und dein\n",
        "Pokémon sehen großartig aus.\r",
        "{STRVAR_1 3, 0}, dein Pokémon wird\n",
        "ohnmächtig, wenn ihm KP ausgehen.\r",
        "Sollte dein Pokémon KP verlieren,\n",
        "komm nach Hause, bevor es zu spät ist.\r",
        "Ich heile es dann vollständig,\n",
        "indem ich ihm Ruhe verordne.\r",
        "Mach mich stolz!\n",
        "Und pass auf dich auf!"
      ]
    },
    {
      "id": "msg_0199_00043",
      "de_DE": [
        "Zunächst solltest du deine Pokémon\n",
        "vollständig heilen."
      ]
    },
    {
      "id": "msg_0199_00044",
      "de_DE": [
        "Deine Pokémon wurden vollständig\n",
        "geheilt."
      ]
    },
    {
      "id": "msg_0199_00045",
      "de_DE": [
        "Falls deine Pokémon ihre KP\n",
        "verlieren, kannst du sie in einem\f",
        "Pokémon-Center auffüllen lassen.\r",
        "Falls du dich auf lange Reisen\n",
        "begibst, solltest du deinen Vorrat\r",
        "mit Tränken vom Pokémon-Supermarkt\n",
        "auffüllen. Viel Glück, Trainer!"
      ]
    },
