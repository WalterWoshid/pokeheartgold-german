      ]
    },
    {
      "id": "msg_0199_00110",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Als das Universum entstand, entstand\n",
        "diese Tafel aus einem Splitter.”\r"
      ]
    },
    {
      "id": "msg_0199_00111",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Die Kraft besiegter Giganten\n",
        "speist diese Tafel mit Energie.”\r"
      ]
    },
    {
      "id": "msg_0199_00112",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Zwei Wesen von Zeit und Raum wurden\n",
        "aus dem Ursprünglichen geboren.”\r"
      ]
    },
    {
      "id": "msg_0199_00113",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Um Zeit und Raum miteinander zu\n",
        "vereinen, wurden drei Wesen geboren.”\r"
      ]
    },
    {
      "id": "msg_0199_00114",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Zwei sind Materie, drei sind Geist\n",
        "und bilden gemeinsam die Welt.”\r"
      ]
    },
    {
      "id": "msg_0199_00115",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Das Ursprüngliche atmete, da war\n",
        "das Universum noch nicht geboren.”\r"
      ]
    },
    {
      "id": "msg_0199_00116",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
        "Inschrift eingraviert...\r",
        "“Die Kräfte der Tafeln werden\n",
        "von allen Pokémon geteilt.”\r"
      ]
    },
    {
      "id": "msg_0199_00117",
      "de_DE": [
        "Auf der erhaltenen Tafel ist eine\n",
