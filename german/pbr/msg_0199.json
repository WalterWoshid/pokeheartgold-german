    {
      "id": "msg_0199_00005",
      "de_DE": [
        "D-dieser Trainerpass!\r",
        "Diese intensive Farbe!\n",
        "Und dann all diese Sterne!\r",
        "Ich habe ja schon einige Trainer mit\n",
        "silbernem Trainerpass getroffen...\r",
        "Aber du stellst sie mit deinem\n",
        "Trainerpass alle in den Schatten.\r",
        "{STRVAR_1 3, 0}, erweist du mir die Ehre,\n",
        "deine Pokémon heilen zu dürfen, bitte?"
      ]
    },
    {
      "id": "msg_0199_00006",
      "de_DE": [
        "Ich freue mich, dich zu sehen,\n",
        "{STRVAR_1 3, 0}! Das Übliche, nicht wahr?"
      ]
    },
    {
      "id": "msg_0199_00007",
      "de_DE": [
        "Okay, ich nehme deine Pokémon für einen\n",
        "Moment in meine Obhut."
      ]
    },
    {
      "id": "msg_0199_00008",
      "de_DE": "Danke!"
    },
    {
      "id": "msg_0199_00009",
      "de_DE": "Komm bald wieder!"
    },
    {
      "id": "msg_0199_00010",
      "de_DE": [
        "Dein Pokémon scheint von dem\n",
        "Pokérus befallen zu sein.\r",
        "Über den Pokérus ist bisher wenig be-\n",
        "kannt, außer dass es Mikroorganismen\f",
        "sind, die Pokémon befallen.\r",
        "Sind deine Pokémon infiziert,\n",
        "wachsen sie besonders gut."
      ]
    },
    {
      "id": "msg_0199_00011",
      "de_DE": [
        "{STRVAR_1 3, 0} hat kein\n",
        "kampffähiges Pokémon mehr!\r",
        "{STRVAR_1 3, 0} wird ohnmächtig!"
      ]
    },
    {
      "id": "msg_0199_00012",
      "garbage": 0
    },
    {
      "id": "msg_0199_00013",
      "de_DE": "Möchtest du das Spiel speichern?"
    },
    {
      "id": "msg_0199_00014",
      "de_DE": [
        "Es gibt bereits einen Spielstand.\n",
        "Spielstand überschreiben?"
      ]
    },
    {
      "id": "msg_0199_00015",
      "de_DE": [
        "Speichervorgang... Bitte das\n",
        "System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0199_00016",
      "de_DE": "{STRVAR_1 3, 0} hat das Spiel gespeichert."
    },
    {
      "id": "msg_0199_00017",
      "de_DE": [
        "Achtung!\n",
        "Es gibt bereits einen Spielstand.\r",
        "Wenn jetzt gespeichert wird, geht der\n",
        "andere Spielstand mit allen Items\f",
        "und Pokémon für immer verloren.\r",
        "Bist du sicher, dass du speichern\n",
        "und den anderen Spielstand\f",
        "überschreiben möchtest?"
      ]
    },
    {
      "id": "msg_0199_00018",
      "de_DE": "Fehler beim Speichern!"
    },
    {
      "id": "msg_0199_00019",
      "de_DE": [
        "Speichervorgang... Bitte das\n",
        "System nicht ausschalten."
      ]
    },
    {
      "id": "msg_0199_00020",
      "de_DE": [
        "Es gibt bereits einen Spielstand.\n",
        "Speichern nicht möglich.\r",
        "Weitere Details findest du\n",
        "in der Spielanleitung.\r",
        "Drücke im Titelbildschirm\n",
        "Oben + SELECT + B-Knopf, wenn du den\f",
        "aktuellen Spielstand löschen willst."
      ]
    },
    {
      "id": "msg_0199_00021",
      "de_DE": [
        "Speichere eine Menge Daten...\n",
        "Bitte das System nicht ausschalten."
      ]
    },
