{
  "key": 10899,
  "messages": [
    {
      "id": "msg_0157_00000",
      "de_DE": [
        "Einst träumte ich davon,\n",
        "Arenaleiter zu werden...\r",
        "Mein Traum hat sich zwar nie erfüllt...\n",
        "Aber ich lebe mit all den\f",
        "wunderbaren Pokémon.\r",
        "Es ist ein gesegnetes und\n",
        "glückliches Leben."
      ]
    },
    {
      "id": "msg_0157_00001",
      "de_DE": [
        "Unglaublich, du bist so was von cool!\n",
        "Du hast ja schon sieben Orden!"
      ]
    },
    {
      "id": "msg_0157_00002",
      "de_DE": [
        "Wow! Du bist unglaublich!\n",
        "Du hast ja schon acht Orden!\r",
        "Jetzt musst du die Pokémon Liga\n",
        "in Angriff nehmen!"
      ]
    },
    {
      "id": "msg_0157_00003",
      "de_DE": [
        "Sonnewik liegt an einer schmalen\n",
        "Landzunge, umgeben von Meer und\f",
        "den Bergen.\r",
        "Den Mangel an Raum macht die Stadt mit\n",
        "Solarfeldern wett, die als\f",
        "Stromquelle und Straßen dienen.\r",
        "Es ist ein Ort, an dem Natur, Pokémon\n",
        "und Menschen ein Ganzes bilden!"
      ]
    }
  ]
}
