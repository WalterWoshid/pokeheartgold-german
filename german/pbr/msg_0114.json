  "key": 1075,
  "messages": [
    {
      "id": "msg_0114_00000",
      "de_DE": [
        "Die Wettbewerbe sind interessant,\n",
        "aber die Ruinen von Trostu auch..."
      ]
    },
    {
      "id": "msg_0114_00001",
      "de_DE": [
        "Als Kameramann macht es mich glücklich,\n",
        "so viele verschiedene Pokémon in den\f",
        "Wettbewerben zu sehen."
      ]
    },
    {
      "id": "msg_0114_00002",
      "de_DE": [
        "Ich bin weit gereist, um an diesen\n",
        "Wettbewerben teilnehmen zu können."
      ]
    },
    {
      "id": "msg_0114_00003",
      "de_DE": [
        "Lamina ist die Arenaleiterin.\n",
        "Diese Frau fasziniert mich."
      ]
    },
    {
      "id": "msg_0114_00004",
      "de_DE": [
        "Ich gab meinen Pokémon viele Knurspe.\r",
        "Jetzt bin ich zuversichtlich, dass wir\n",
        "die Wettbewerbe gewinnen werden."
      ]
    },
    {
      "id": "msg_0114_00005",
      "de_DE": [
        "In Trostu gibt es eine Pokémon-Pension,\n",
        "die deine Pokémon für dich großzieht."
      ]
    }
  ]
}
