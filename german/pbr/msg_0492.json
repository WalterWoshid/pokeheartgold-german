{
  "key": 39226,
  "messages": [
    {
      "id": "msg_0492_00000",
      "de_DE": [
        "Ich bin der Pensionsleiter.\r",
        "Ich kümmere mich um die wertvollen\n",
        "Pokémon der Trainer.\r",
        "Wenn ich eines deiner Pokémon auf-\n",
        "ziehen soll, sprich mit meiner Frau."
      ]
    },
    {
      "id": "msg_0492_00001",
      "de_DE": [
        "Ach, du bist es!\r",
        "Wir haben deine Pokémon aufgezogen\n",
        "und wurden überrascht!\r",
        "Deine Pokémon haben nun ein Ei!\r",
        "Wir wissen nicht, wie das passiert\n",
        "ist, aber nun ist es da.\r",
        "Möchtest du es haben?"
      ]
    },
    {
      "id": "msg_0492_00002",
      "de_DE": [
        "Ach, du bist es! Schön, dich zu sehen.\n",
        "Deinem {STRVAR_1 0, 0} geht es sehr gut."
      ]
    },
    {
      "id": "msg_0492_00003",
      "de_DE": "Ich werde es behalten."
    },
    {
      "id": "msg_0492_00004",
      "de_DE": [
        "Du hast keinen Platz dafür... Komm\n",
        "wieder, wenn du Platz geschaffen hast."
      ]
    },
    {
      "id": "msg_0492_00005",
      "de_DE": [
        "{STRVAR_1 3, 0} erhält das Ei vom\n",
        "Pensionsleiter."
      ]
    },
    {
      "id": "msg_0492_00006",
      "de_DE": "Kümmere dich gut darum."
    },
    {
      "id": "msg_0492_00007",
      "de_DE": [
        "Übrigens, dein {STRVAR_1 0, 0} scheint\n",
        "sich gut mit dem {STRVAR_1 0, 2} von\f",
        "{STRVAR_1 3, 1} zu verstehen.\r",
        "Ich habe gesehen, wie sie einen Brief\n",
        "ausgetauscht haben..."
      ]
    },
    {
      "id": "msg_0492_00008",
      "de_DE": [
        "Wenn du deine Pokémon zurückhaben\n",
        "möchtest, sprich doch mit meiner Frau."
      ]
    },
    {
      "id": "msg_0492_00009",
      "de_DE": [
        "Ah, du bist es! Deinen Pokémon\n",
        "{STRVAR_1 0, 0} und {STRVAR_1 0, 1}\f",
        "geht es prächtig.\r"
      ]
    },
    {
      "id": "msg_0492_00010",
      "de_DE": [
        "Dann werde ich es behalten.\n",
        "Oder möchtest du es doch haben?"
      ]
    },
    {
      "id": "msg_0492_00011",
      "de_DE": [
        "Die beiden scheinen sich sehr zu\n",
        "mögen."
      ]
    },
    {
      "id": "msg_0492_00012",
      "de_DE": [
        "Die beiden scheinen sich zu\n",
        "vertragen."
      ]
    },
    {
      "id": "msg_0492_00013",
      "de_DE": "Die beiden mögen sich nicht sehr."
    },
    {
      "id": "msg_0492_00014",
      "de_DE": [
        "Die beiden spielen lieber mit\n",
        "anderen Pokémon als miteinander."
      ]
    },
    {
      "id": "msg_0492_00015",
      "de_DE": [
        "Ich bin die Pensionsleiterin.\n",
        "Wir ziehen Pokémon für dich auf.\r",
        "Sollen wir eines aufziehen?"
      ]
    },
    {
      "id": "msg_0492_00016",
      "de_DE": [
        "Welches Pokémon sollen\n",
        "wir für dich aufziehen?\r"
      ]
    },
    {
      "id": "msg_0492_00017",
      "de_DE": [
        "Fein, dann nehmen wir dein {STRVAR_1 0, 0}\n",
        "für eine Weile in Pflege.\r",
        "Schau später mal nach ihm.\r"
      ]
    },
    {
      "id": "msg_0492_00018",
      "de_DE": [
        "Wir können zwei deiner Pokémon\n",
        "nehmen. Möchtest du noch eines in\f",
        "Pflege geben?"
      ]
    },
    {
      "id": "msg_0492_00019",
      "de_DE": "Mein Mann hat dich schon gesucht."
    },
    {
      "id": "msg_0492_00020",
      "de_DE": [
        "Oh, gut.\n",
        "Komm bald wieder."
      ]
    },
    {
      "id": "msg_0492_00021",
      "de_DE": "Du hast nicht genug Geld..."
    },
    {
      "id": "msg_0492_00022",
      "de_DE": [
        "Möchtest du das andere auch wieder\n",
        "mitnehmen?"
      ]
    },
    {
      "id": "msg_0492_00023",
      "de_DE": [
        "Gut.\n",
        "Komm bald wieder."
      ]
    },
    {
      "id": "msg_0492_00024",
      "de_DE": [
        "Ach, du bist es! Schön, dich zu sehen.\n",
        "Wie es deinem Pokémon geht, fragst du?\r"
      ]
    },
    {
      "id": "msg_0492_00025",
      "de_DE": [
        "Dein {STRVAR_1 0, 0} ist um {STRVAR_1 51, 1} Level\n",
        "gewachsen.\r"
      ]
    },
    {
      "id": "msg_0492_00026",
      "de_DE": [
        "Dein Pokémon-Team ist vollzählig.\n",
        "Schaffe Platz und komm dann wieder."
      ]
    },
    {
      "id": "msg_0492_00027",
      "de_DE": [
        "Welches Pokémon möchtest du wieder an\n",
        "dich nehmen?"
      ]
    },
    {
      "id": "msg_0492_00028",
      "de_DE": [
        "Wenn du dein {STRVAR_1 0, 0} mitnehmen\n",
        "willst, kostet das {STRVAR_1 53, 1} $."
      ]
    },
    {
      "id": "msg_0492_00029",
      "de_DE": [
        "Sehr schön!\n",
        "Hier ist dein Pokémon!\r"
      ]
    },
    {
      "id": "msg_0492_00030",
      "de_DE": [
        "{STRVAR_1 3, 1} hat {STRVAR_1 0, 0} von der\n",
        "Pensionsleiterin zurückerhalten.\r"
      ]
    },
    {
      "id": "msg_0492_00031",
      "de_DE": [
        "Oh! Du hast aber nur ein Pokémon.\r",
        "Du kannst nicht ohne Pokémon unterwegs\n",
        "sein.\r",
        "Komm einfach später wieder."
      ]
    },
    {
      "id": "msg_0492_00032",
      "de_DE": [
        "Möchtest du dein Pokémon wieder\n",
        "mitnehmen?"
      ]
    },
    {
      "id": "msg_0492_00033",
      "de_DE": [
        "Wenn du das Pokémon hier lässt,\n",
        "womit willst du denn dann kämpfen?\r",
        "Komm einfach später wieder."
      ]
    },
    {
      "id": "msg_0492_00034",
      "de_DE": [
        "Wie bitte?\n",
        "Aber, aber...\r",
        "Wenn du das Pokémon bei mir lässt, dann\n",
        "hast du ja nur noch ein einziges bei dir!\r",
        "Fang doch einfach ein paar Pokémon,\n",
        "dann sehen wir weiter."
      ]
    },
    {
      "id": "msg_0492_00035",
      "de_DE": [
        "Mhm, mhm...\n",
        "Das ist doch nur ein Ei!"
      ]
    },
    {
      "id": "msg_0492_00036",
      "de_DE": [
        "Fein, dann nehmen wir dein {STRVAR_1 0, 0}\n",
        "für eine Weile in Pflege.\r",
        "Schau später mal nach ihm."
      ]
    },
    {
      "id": "msg_0492_00037",
      "de_DE": "Nanu?"
    },
    {
      "id": "msg_0492_00038",
      "de_DE": "Lv. {STRVAR_1 52, 1}"
    },
    {
      "id": "msg_0492_00039",
      "de_DE": "{STRVAR_1 0, 0} ♂"
    },
    {
      "id": "msg_0492_00040",
      "de_DE": "{STRVAR_1 0, 0} ♀"
    },
    {
      "id": "msg_0492_00041",
      "de_DE": "{STRVAR_1 0, 0}"
    }
  ]
}
