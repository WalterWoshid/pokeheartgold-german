  "messages": [
    {
      "id": "msg_0220_00000",
      "de_DE": [
        "Etwas Gewaltiges steht unmittelbar\n",
        "bevor.\f",
        "Vielleicht... Glaube ich... Stimmt’s?\r",
        "Komm uns nicht in die Quere! Natürlich\n",
        "wirst du es trotzdem tun, nicht wahr?\r",
        "Also müssen wir beide dich vorher\n",
        "besiegen!\r"
      ]
    },
    {
      "id": "msg_0220_00001",
      "de_DE": [
        "Etwas Gewaltiges steht unmittelbar\n",
        "bevor.\f",
        "Vielleicht... Glaube ich... Stimmt’s?\r",
        "Komm uns nicht in die Quere! Natürlich\n",
        "wirst du es trotzdem tun, nicht wahr?\r",
        "Also müssen wir beide dich vorher\n",
        "besiegen!\r",
        "Oh, du hast nur ein einziges Pokémon?\n",
        "Ha ha ha. Komm, verschwinde lieber!\r"
      ]
    },
    {
      "id": "msg_0220_00002",
      "de_DE": [
        "Mann, war das jämmerlich...\r",
        "Wir lassen dich jetzt durch. Dann\n",
        "können unsere Bosse dich fertigmachen!"
      ]
    },
    {
      "id": "msg_0220_00003",
      "de_DE": [
        "Boss: ...\r",
        "Jetzt wird alles enden.\n",
        "Und alles wird beginnen.\r",
        "Mit dieser Roten Kette öffne ich das\n",
        "Portal in eine andere Dimension.\r",
        "Ich befehle dir, deine Macht für mich\n",
        "zu entfesseln...\r",
        "DIALGA, das mythische Pokémon,\n",
        "Meister der Zeit!\r"
      ]
    },
    {
      "id": "msg_0220_00004",
      "de_DE": [
