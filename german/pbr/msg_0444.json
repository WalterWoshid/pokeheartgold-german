{
  "key": 39572,
  "messages": [
    {
      "id": "msg_0444_00000",
      "de_DE": [
        "Wir benötigten die Energie, die im\n",
        "Windkraftwerk erzeugt wird, um\f",
        "das hier herzustellen...\r",
        "Man muss schon ein wissenschaftliches\n",
        "Genie sein, um so etwas entwickeln\f",
        "zu können...\r",
        "Und da unser Boss dies entwickelt\n",
        "hat, ist er ein wissenschaftliches\f",
        "Genie!\r"
      ]
    },
    {
      "id": "msg_0444_00001",
      "de_DE": [
        "ARGH! Du hast gelauscht!\n",
        "Ich habe nur laut gedacht!\r",
        "Du bist anhänglicher als Kleister...\n",
        "Und ich habe es satt, immer\f",
        "vor dir wegzulaufen...\r",
        "Aber ich werde dennoch nicht\n",
        "meine wertvolle Energie verschwenden,\f",
        "nur um dir eine Lektion zu erteilen...\r"
      ]
    },
    {
      "id": "msg_0444_00002",
      "de_DE": [
        "Es gibt da ein extravagantes Hotel\n",
        "an einem extravaganten Ort, worin sich\f",
        "ein extravagantes Restaurant befindet.\r",
        "Dieses extravagante Restaurant\n",
        "besuchen extravagante Leute, die sich\f",
        "für so extravagant halten, dass sie\r",
        "nicht allein kämpfen wollen."
      ]
    },
    {
      "id": "msg_0444_00003",
      "de_DE": [
        "Ich schwimme lieber in einem\n",
        "Swimmingpool als im Meer.\r",
        "Das Meerwasser schmeckt so salzig\n",
        "wie meine Tränen, die ich am Ende\f",
        "eines langen Urlaubs vergieße...\n"
      ]
    },
    {
      "id": "msg_0444_00004",
      "de_DE": [
        "Oben auf diesem großen Kliff\n",
        "ist irgendetwas!\r",
        "Das sagt mir meine innere Stimme,\n",
        "aber wie soll ich nur da hinaufkommen?"
      ]
    },
    {
      "id": "msg_0444_00005",
      "de_DE": [
        "Route 213\n",
        "Weideburg"
      ]
    },
    {
      "id": "msg_0444_00006",
      "de_DE": [
        "Hotel Prachtsee\n",
        "Betreten Sie eine andere Welt"
      ]
    },
    {
      "id": "msg_0444_00007",
      "de_DE": [
        "Schrittritt-Haus\n",
        "Fußabdrücke überall"
      ]
    }
  ]
}
