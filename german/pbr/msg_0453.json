    {
      "id": "msg_0453_00001",
      "de_DE": [
        "Was dir angetan wurde, das füge\n",
        "auch anderen zu... Der Gegenstoß!\r",
        "Das ist gut für Pokémon-Kämpfe,\n",
        "aber im wirklichen Leben...\r",
        "Da würden die Kämpfe kein Ende\n",
        "nehmen, so viel steht fest.\r"
      ]
    },
    {
      "id": "msg_0453_00002",
      "de_DE": [
        "Verwende sie nach der Aktion eines\n",
        "anderen, und die Kraft wird verdoppelt."
      ]
    },
    {
      "id": "msg_0453_00003",
      "de_DE": [
        "Jogging ist sehr gesund. Aber man\n",
        "soll es auch nicht übertreiben."
      ]
    },
    {
      "id": "msg_0453_00004",
      "de_DE": [
        "Zwischendurch gehe ich auch langsamer.\n",
        "Ich bin doch auch nur ein Mensch."
      ]
    },
    {
      "id": "msg_0453_00005",
      "de_DE": [
        "Elyses\n",
        "Trostu"
      ]
    },
    {
      "id": "msg_0453_00006",
      "de_DE": [
        "Route 215\n",
        "Schleiede"
      ]
    },
    {
      "id": "msg_0453_00007",
      "de_DE": [
        "Tipps für Trainer\r",
        "Pokémon-Attacken sind entweder\n",
        "physische oder Spezial-Attacken.\r",
        "Die Stärke der physischen Attacken\n",
        "hängt vom Angriffs-Wert des Pokémon\f",
        "ab.\r",
        "Und die Stärke der Spezial-Attacken\n",
        "wird vom Spezial-Angriffs-Wert des\f",
        "Pokémon bestimmt."
      ]
    }
  ]
}
