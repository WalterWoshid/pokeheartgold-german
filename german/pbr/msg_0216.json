  "messages": [
    {
      "id": "msg_0216_00000",
      "de_DE": [
        "Laut einer Theorie wurde der\n",
        "Kraterberg als Erstes in Sinnoh\f",
        "geschaffen.\r"
      ]
    },
    {
      "id": "msg_0216_00001",
      "de_DE": [
        "...In einer neu erschaffenen Welt...\r",
        "In einer Welt, wo nur die Zeit floss und\n",
        "der Raum sich dehnte...\f",
        "Sollte es keine Zwiste geben.\r"
      ]
    },
    {
      "id": "msg_0216_00002",
      "de_DE": [
        "Doch was wurde aus dieser Welt?\r",
        "Durch die Schwäche des menschlichen\n",
        "Geistes verbreitete sich Streit...\r",
        "Die Welt wird durch Streit zugrunde\n",
        "gerichtet...\r",
        "Es ist eine sehr traurige Geschichte...\r"
      ]
    },
    {
      "id": "msg_0216_00003",
      "garbage": 0
    },
