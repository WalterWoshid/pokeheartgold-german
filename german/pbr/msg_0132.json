{
  "key": 13355,
  "messages": [
    {
      "id": "msg_0132_00000",
      "de_DE": [
        "Alle nennen mich Attackenmaniac.\n",
        "Aber ich bevorzuge den Namen\f",
        "Attacken-Helfer.\r",
        "Ich kenne alle Attacken, die ein\n",
        "Pokémon lernen kann.\r",
        "Sollte dein Pokémon eine vergessen\n",
        "haben, bist du bei mir richtig.\r",
        "Ich kann auch deinen Pokémon\n",
        "Attacken beibringen, wenn du magst.\r",
        "Als Gegenleistung hätte ich gerne eine\n",
        "Herzschuppe. Die sammle ich nämlich.\r"
      ]
    },
    {
      "id": "msg_0132_00001",
      "de_DE": [
        "Oh! Das ist es! Das ist ehrlich und\n",
        "wahrhaftig eine Herzschuppe!\f",
        "Lass mich raten...\r",
        "Ich soll einem Pokémon eine\n",
        "alte Attacke beibringen?!?\r"
      ]
    },
    {
      "id": "msg_0132_00002",
      "de_DE": [
        "Falls eines deiner Pokémon eine\n",
        "Attacke lernen soll, komm\f",
        "mit einer Herzschuppe wieder."
      ]
    },
    {
      "id": "msg_0132_00003",
      "de_DE": [
        "Welches Pokémon soll sich an\n",
        "eine alte Attacke erinnern?\r"
      ]
    },
    {
      "id": "msg_0132_00004",
      "de_DE": "Welche Attacke soll ich es lehren?\r"
    },
    {
      "id": "msg_0132_00005",
      "de_DE": [
        "Tut mir leid...\r",
        "Anscheinend gibt es keine Attacke, die\n",
        "ich dem Pokémon erneut beibringen kann."
      ]
    },
    {
      "id": "msg_0132_00006",
      "de_DE": [
        "Bitte?\r",
        "Ich kann einem Ei nicht eine\n",
        "einzige Attacke beibringen!"
      ]
    },
