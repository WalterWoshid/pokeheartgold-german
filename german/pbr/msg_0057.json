{
  "key": 62498,
  "messages": [
    {
      "id": "msg_0057_00000",
      "de_DE": [
        "Ich werde mal ein Seemann wie mein Papa!\n",
        "Er ist ein echter Mann unter Männern!\r",
        "Selbst hohe Wellen machen ihm keine\n",
        "Angst!\r",
        "Aber Arenaleiter sein ist auch cool!\n",
        "Adam ist absolut klasse!"
      ]
    },
    {
      "id": "msg_0057_00001",
      "de_DE": [
        "Der kleine Junge scheint in einem\n",
        "Alptraum gefangen zu sein.\r",
        "Er scheint ihn zu quälen...\n",
        "Er murmelt etwas...\r",
        "“DAR...\n",
        "DARK... beobachtet... mich...”"
      ]
    },
    {
      "id": "msg_0057_00002",
      "de_DE": [
        "Der kleine Junge ist in einem\n",
        "Alptraum gefangen.\r",
        "Die Lunarfeder, die {STRVAR_1 3, 0}\n",
        "mitgebracht hat, beginnt zu strahlen...\r",
        "Das Gesicht des Jungen entspannt\n",
        "sich und wird ganz friedlich!\r"
      ]
    },
    {
      "id": "msg_0057_00003",
      "de_DE": "Der kleine Junge ist aufgewacht!"
    },
    {
      "id": "msg_0057_00004",
      "de_DE": [
        "Ich konnte einfach nicht aufwachen...\n",
        "Ich habe es gesehen...\r",
        "Es war so ein schrecklicher Traum...\n",
        "Da war ein dunkler Ort...\f",
        "Und da war ein dunkles Pokémon...\r",
        "Aber, Mama...\n",
        "Ich konnte eure Stimmen hören..."
      ]
    },
    {
      "id": "msg_0057_00005",
      "de_DE": [
        "Lieber Himmel!\n",
        "Du bist aufgewacht!\r",
        "Oh, mein kleiner Junge...\n",
        "I-ich weiß nicht, was ich sagen soll...\r"
      ]
    },
    {
      "id": "msg_0057_00006",
      "de_DE": [
        "Vielen Dank!\n",
        "Das werden wir dir nie vergessen!!!\r"
      ]
    },
    {
      "id": "msg_0057_00007",
      "de_DE": [
        "Dass es dir wieder gut geht, macht\n",
        "mich so glücklich!\r",
        "Das gibt mir Kraft, wieder\n",
        "ein Seemann zu sein!\r",
        "Mein Schiff steht für dich bereit!\r"
      ]
    },
    {
      "id": "msg_0057_00008",
      "de_DE": [
        "Unser Junge hat zu viel Energie! Ich\n",
        "wünschte, er wäre ein bisschen ruhiger."
      ]
    },
    {
      "id": "msg_0057_00009",
      "de_DE": [
        "Ich hätte niemals gedacht, dass unser\n",
        "Junge einmal in einem solchen Alptraum\f",
        "gefangen sein würde...\r",
        "Es ist schon einmal in Fleetburg\n",
        "passiert, vor langer Zeit...\r",
        "Es gab Menschen, die nie wieder aus\n",
        "diesem Alptraum erwacht sind..."
      ]
    },
    {
      "id": "msg_0057_00010",
      "de_DE": [
        "Vielen Dank! Wir können dir gar nicht\n",
        "genug danken! Vielen, vielen Dank!"
      ]
    }
  ]
}
