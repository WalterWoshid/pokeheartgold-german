      "de_DE": [
        "Ich bringe meinen Pokémon mithilfe\n",
        "Technischer Maschinen Attacken bei.\r",
        "Ich versuche, verschiedene Attacken-\n",
        "Typen miteinander zu kombinieren.\r",
        "Ich habe gehört, die Top Vier der\n",
        "Pokémon Liga sollen weitaus stärker\f",
        "sein als jeder Arenaleiter."
      ]
    },
    {
      "id": "msg_0168_00001",
      "de_DE": [
        "Wird dein Pokémon eingefroren, so\n",
        "taut es nach einer Weile wieder auf.\r",
        "Aber ich an deiner Stelle würde doch\n",
        "einige Eisheiler bei mir haben."
      ]
    }
  ]
}
