      ]
    },
    {
      "id": "msg_0135_00021",
      "de_DE": [
        "Lucius: Vielen Dank, {STRVAR_1 3, 0},\n",
        "ganz ehrlich.\r",
        "Wenn Prof. Eibe jemals herausfinden\n",
        "sollte, dass ich meinen Pokédex\f",
        "verloren hatte...\r",
        "Uuuuh...\n",
        "Ich mag gar nicht daran denken.\r",
        "Und, {STRVAR_1 3, 0}? Was hast du\n",
        "nun vor?\r",
        "Ich überlege, nach Weideburg\n",
        "zu gehen.\r",
        "In dem Großmoor dort leben\n",
        "viele Arten von Pokémon.\r"
      ]
    },
    {
      "id": "msg_0135_00022",
      "de_DE": [
        "Sieh mal!\n",
        "Schau dir mal diese Antennen an!!!\r",
        "Ich weiß ja nicht, wofür sie gut sind,\n",
        "aber sie sind schon beeindruckend!\r"
      ]
    },
    {
      "id": "msg_0135_00023",
      "de_DE": [
        "Hey!\n",
        "Du bist es!\r",
        "Ich wette, du erinnerst dich nicht an\n",
        "mich, aber ich erinnere mich an dich!\r",
        "Deinetwegen haben sie mir\n",
        "mein PIEPI weggenommen...\r",
        "Mein Partner hat die Brocken\n",
        "hingeschmissen und ist nach\f",
        "Hause zurückgegangen.\r",
        "Ich weiß nichts von einem\n",
        "Schlüssel zum Lager!\r"
      ]
    },
    {
      "id": "msg_0135_00024",
      "de_DE": [
        "Wir haben die Versteckte Maschine\n",
        "Fliegen hier in unserem Gebäude\f",
        "gelagert.\r",
        "Sie sagen, ich darf sie haben, wenn\n",
        "ich ihnen beweise, dass ich es wert bin."
      ]
    },
    {
      "id": "msg_0135_00025",
      "de_DE": [
        "Oh ja, Team Galaktik lagert alle\n",
        "möglichen interessanten Sachen\f",
        "in seinem Gebäude.\r",
        "Ich habe gehört, sie haben dort\n",
        "sogar eine Versteckte Maschine!"
      ]
    },
    {
      "id": "msg_0135_00026",
      "de_DE": [
        "Die Spielhalle ist gefährlich!\r",
        "Warum? Nun, man hat dort so viel\n",
        "Spaß, dass man völlig die Zeit vergisst!"
      ]
    },
    {
      "id": "msg_0135_00027",
      "de_DE": [
        "Ich habe in der Spielhalle\n",
        "eine TM gewonnen!\r",
        "Und ich habe sie auch gleich\n",
        "einem meiner Pokémon beigebracht!"
      ]
    },
    {
      "id": "msg_0135_00028",
      "garbage": 0
    },
    {
      "id": "msg_0135_00029",
      "de_DE": [
        "Hilda ist die Arenaleiterin in Schleiede.\n",
        "Marinus ist der Leiter in Weideburg.\f",
        "Dann haben wir Lamina in Herzhofen...\r",
        "Die sind alle viel zu stark.\n",
        "Ich bin nicht mal annähernd so stark."
      ]
    },
    {
      "id": "msg_0135_00030",
      "de_DE": [
        "Ich bin in diese Stadt gekommen,\n",
        "um im Kaufhaus Geld auszugeben.\r",
        "Aber mit all den Felswänden hier\n",
        "wirkt der Ort recht kalt. "
      ]
    },
    {
      "id": "msg_0135_00031",
      "de_DE": [
        "Ich habe einen neuen\n",
        "Sonnenschirm gekauft.\r",
        "Aber ich will nicht, dass er vom\n",
        "Regen nass wird, daher sehe ich\f",
        "mir immer die Wettervorhersage an."
      ]
    },
    {
      "id": "msg_0135_00032",
      "de_DE": [
        "Weißt du vielleicht, wo ich einen\n",
        "Münzkorb bekommen kann?\r",
        "Angeblich gibt es da einen Clown, der\n",
        "welche hat, aber ich weiß nicht wo..."
      ]
    },
    {
      "id": "msg_0135_00033",
      "garbage": 0
    },
    {
      "id": "msg_0135_00034",
      "de_DE": [
        "Schleiede ist die Stadt der Felsen.\n",
        "Wir haben hier sogar Meteoriten!\r",
        "Das hat zwar nichts damit zu tun, aber\n",
        "ich gebe dir eine Technische Maschine!\r"
      ]
    },
    {
      "id": "msg_0135_00035",
      "de_DE": [
        "Wenn dein Gegner Itemsperre auf dein\n",
        "Pokémon anwendet, kannst du bei diesem\f",
        "Pokémon keine Items mehr einsetzen.\r",
        "Nun, genieß deinen Aufenthalt in\n",
        "Schleiede, der Stadt der... Felsen."
      ]
    },
    {
      "id": "msg_0135_00036",
      "de_DE": [
        "Das ist ein mysteriöser Meteorit, der\n",
        "vom Himmel gefallen ist..."
      ]
    },
    {
      "id": "msg_0135_00037",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "wird die Initiative eines\f",
        "bestimmten Pokémon erhöht."
      ]
    },
    {
      "id": "msg_0135_00038",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "wird die Verteidigung eines\f",
        "bestimmten Pokémon erhöht."
      ]
    },
    {
      "id": "msg_0135_00039",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "wird der Angriffs-Wert eines\f",
        "bestimmten Pokémon erhöht."
      ]
    },
    {
      "id": "msg_0135_00040",
      "de_DE": [
        "Berührt man den Meteoriten,\n",
        "werden die Attribute eines\f",
        "bestimmten Pokémon ausbalanciert."
      ]
    },
    {
      "id": "msg_0135_00041",
      "de_DE": [
        "Schleiede\n",
        "Aus Stein gehauen"
      ]
    },
    {
      "id": "msg_0135_00042",
      "de_DE": [
        "Pokémon Arena Schleiede\n",
        "Leiterin: Hilda\f",
        "Das barfüßige Kampfgenie!"
      ]
    },
    {
      "id": "msg_0135_00043",
      "de_DE": [
        "Team Galaktik Privatbesitz\n",
        "DURCHGANG VERBOTEN!"
      ]
    },
    {
      "id": "msg_0135_00044",
      "de_DE": [
        "Schleiede Team Galaktik-Gebäude\n",
        "Wir träumen vom Universum!"
      ]
    },
    {
      "id": "msg_0135_00045",
      "de_DE": [
        "Schleiede-Kaufhaus\n",
        "Wir machen Träume wahr!"
      ]
    },
    {
      "id": "msg_0135_00046",
      "de_DE": [
        "Schleiede Spielhalle\n",
        "Fordere das Glück heraus!"
      ]
    },
    {
      "id": "msg_0135_00047",
      "de_DE": [
        "Wechselstube\n",
        "Gib uns Münzen, wir geben dir Preise!"
      ]
    },
    {
      "id": "msg_0135_00048",
      "de_DE": [
        "Besuche den See der Kühnheit!\n",
        "Gleich an der Route 214!"
      ]
    }
  ]
