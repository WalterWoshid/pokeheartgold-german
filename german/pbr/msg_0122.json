{
  "key": 35866,
  "messages": [
    {
      "id": "msg_0122_00000",
      "de_DE": [
        "Hier sehe ich meinen Vater. Und meinen\n",
        "Sohn. Und mein Leben.\r",
        "Und dort sehe ich die Natur. Und\n",
        "Pokémon. Und die Welt."
      ]
    },
    {
      "id": "msg_0122_00001",
      "de_DE": [
        "Sachen herzustellen ist eine Kunst, die\n",
        "den menschlichen Geist erschöpft.\r",
        "Und wenn der Geist wieder geheilt ist,\n",
        "kehrt auch der Wunsch nach dem\f",
        "Erschaffen zurück.\r",
        "Ein wundervoller Kreislauf."
      ]
    },
    {
      "id": "msg_0122_00002",
      "de_DE": [
        "Wenn Menschen und Pokémon sich die\n",
        "Hände reichen, sind alle glücklich.\r",
        "Es bringt uns näher zusammen.\n",
        "Es bringt der Welt Harmonie!"
      ]
    },
    {
      "id": "msg_0122_00003",
      "de_DE": [
        "Einsamkeit ist ganz alltäglich.\n",
        "Sie verleiht mir Mitleid mit anderen.\r",
        "So freue ich mich auf eine\n",
        "glücklichere Zukunft.\r",
        "Und ich genieße die schönen\n",
        "Erinnerungen der Vergangenheit.\f",
        "Ja, die Zeit heilt viele Wunden..."
      ]
    },
    {
      "id": "msg_0122_00004",
      "de_DE": [
        "Es gibt Worte, deren Bedeutung noch\n",
        "nicht jeder erfassen kann...\f",
        "Sie lauten “Liebe” und “Freude”."
      ]
    },
    {
      "id": "msg_0122_00005",
      "de_DE": [
        "Pokémon... Menschen... Es ist ganz\n",
        "normal, dass wir uns voneinander\f",
        "unterscheiden.\r",
        "Beurteile ein Pokémon nie nach seinem\n",
        "Aussehen oder seiner Stärke.\r",
        "Suche nach seinen inneren Werten,\n",
        "seinem Charakter. Nur das zählt!"
      ]
    }
  ]
}
