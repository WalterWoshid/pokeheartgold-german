{
  "key": 3454,
  "messages": [
    {
      "id": "msg_0420_00000",
      "de_DE": [
        "Hilfe! Hilfe, Trainer!\r",
        "Kannst du meinen Papa holen?!?\n",
        "Er arbeitet in dem Windkraftwerk.\r",
        "Aber die Leute, die aussehen wie aus\n",
        "dem All, sind ganz fies und wollen\f",
        "mich nicht hineinlassen..."
      ]
    },
    {
      "id": "msg_0420_00001",
      "de_DE": [
        "Bitte, Trainer! Hol meinen Papa\n",
        "aus dem Windkraftwerk!"
      ]
    },
    {
      "id": "msg_0420_00002",
      "garbage": 0
    },
    {
      "id": "msg_0420_00003",
      "de_DE": [
        "Wir, Team Galaktik, erforschen\n",
        "den Ewigwald.\r",
        "Keinen Schritt weiter!\r"
      ]
    },
    {
      "id": "msg_0420_00004",
      "de_DE": [
        "Zu unseren Forschungen gehört es\n",
        "auch, Pokémon in den Blumenfeldern\f",
        "von Flori aufzuspüren.\r",
        "Wir nutzen die Energie, die im\n",
        "Windkraftwerk entsteht, ebenfalls.\r",
        "Aber das geht dich gar nichts an!\r"
      ]
    },
    {
      "id": "msg_0420_00005",
      "de_DE": [
        "Zu unseren Forschungen gehört es\n",
        "auch, Pokémon in den Blumenfeldern\f",
        "von Flori aufzuspüren.\r",
        "Wir nutzen die Energie, die im\n",
        "Windkraftwerk entsteht, ebenfalls.\r",
        "Aber das geht dich gar nichts an!"
      ]
    },
    {
      "id": "msg_0420_00006",
      "de_DE": [
        "Im Ewigwald sind viele Gift-Pokémon\n",
        "zu Hause.\r",
        "Aber ich habe kein Gegengift gekauft.\n",
        "Was mach ich denn jetzt nur?\r",
        "Gehe ich weiter oder doch\n",
        "lieber zurück?"
      ]
    },
    {
      "id": "msg_0420_00007",
      "de_DE": [
        "Schmierst du süßen Honig\n",
        "auf die Rinde eines Baumes...\r",
        "Lockst du mit dem süßen\n",
        "Duft vielleicht Pokémon an."
      ]
    },
    {
      "id": "msg_0420_00008",
      "de_DE": [
        "Route 205\n",
        "Flori"
      ]
    },
    {
      "id": "msg_0420_00009",
      "de_DE": [
        "Ewigwald\n",
        "Route 205"
      ]
    },
    {
      "id": "msg_0420_00010",
      "de_DE": [
        "Tipps für Trainer\r",
        "Die Items in deinem Beutel werden\n",
        "automatisch der richtigen Tasche\f",
        "zugeordnet.\r",
        "Das ist sehr praktisch!\n",
        "Der beste Freund des Trainers!"
      ]
    }
  ]
}
