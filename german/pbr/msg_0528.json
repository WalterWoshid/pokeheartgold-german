{
  "key": 44786,
  "messages": [
    {
      "id": "msg_0528_00000",
      "de_DE": [
        "Was bringt dich an einen Ort, der so\n",
        "weit vom Rest der Welt entfernt ist?\r",
        "Hier gibt es doch nichts zu sehen außer\n",
        "ein paar verwitterten Pokémon-Reliefs."
      ]
    },
    {
      "id": "msg_0528_00001",
      "de_DE": [
        "Dieser Ort soll bereits seit der\n",
        "Entstehung Sinnohs existieren."
      ]
    },
    {
      "id": "msg_0528_00002",
      "de_DE": [
        "Oh. Das ist interessant!\n",
        "Zeig mir mal dein Pokémon.\r"
      ]
    },
    {
      "id": "msg_0528_00003",
      "de_DE": [
        "Es ist ganz offensichtlich. Es mag dich\n",
        "wirklich sehr. Hier, das ist für dich.\r"
      ]
    },
    {
      "id": "msg_0528_00004",
      "de_DE": [
        "Es kommt auf das Vertrauen\n",
        "zwischen Trainer und Pokémon an.\r",
        "Gegenseitiges Vertrauen\n",
        "ist der Schlüssel zum Sieg."
      ]
    },
    {
      "id": "msg_0528_00005",
      "de_DE": [
        "Es freundet sich langsam mit dir an.\r",
        "Und wenn du es auf Reisen mitnimmst,\n",
        "wird es noch schneller dein Freund."
      ]
    },
    {
      "id": "msg_0528_00006",
      "de_DE": [
        "Es hat sich noch nicht so sehr an dich\n",
        "gewöhnt.\r",
        "Ihr beide müsst erst Vertrauen\n",
        "zueinander aufbauen."
      ]
    }
  ]
}
